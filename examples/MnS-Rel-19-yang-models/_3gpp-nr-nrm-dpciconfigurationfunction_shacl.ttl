@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction> a owl:Ontology .

<urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/DPCIConfigurationFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/DPCIConfigurationFunction/id> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute determines whether the Distributed SON PCI
configuration Function is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/DPCIConfigurationFunction/dPciConfigurationControl> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/nRPciList> ;
            sh:description """This holds a list of physical cell identities that can be
assigned to the NR cells. This attribute shall be supported if D-SON
PCI configuration function is supported.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/DPCIConfigurationFunction/nRPciList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/DPCIConfigurationFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/nRPciListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/nRPciList/NRPci> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/nRPciList> .

