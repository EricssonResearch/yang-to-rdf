@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrnetwork> a owl:Ontology .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrnetwork/NRNetworkShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-nrnetwork/NRNetwork/id> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-nrnetwork/NRNetwork> .

