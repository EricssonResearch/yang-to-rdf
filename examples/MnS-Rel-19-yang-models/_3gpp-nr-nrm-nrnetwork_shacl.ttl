<urn:3gpp:sa5:_3gpp-nr-nrm-nrnetwork> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-nrnetwork" ;
    dcterms:description """Defines the YANG mapping of the NRNetwork Information Object
