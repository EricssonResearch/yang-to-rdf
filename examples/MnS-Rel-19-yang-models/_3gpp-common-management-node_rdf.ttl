@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix magent3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-mnsagent#> .
@prefix mmgmtnode3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-management-node#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

mmgmtnode3gpp:ManagementNode a rdfs:Class ;
    rdfs:label "ManagementNode" ;
    rdfs:comment """Represents a telecommunications management system (EM) within
the TMN that contains functionality for managing a number of
ManagedElements (MEs). The management system communicates with the MEs
directly or indirectly over one or more interfaces for the purpose
of monitoring and/or controlling these MEs.

This class has similar characteristics as the ManagedElement. The
main difference between these two classes is that the ManagementNode
has a special association to the managed elements that it is
responsible for managing.""" ;
    y2r:nameContains magent3gpp:MnsAgent .

<https://semantics.ericsson.com/yang/_3gpp-common-management-node> a owl:Ontology ;
    rdfs:label "_3gpp-common-management-node" ;
    dcterms:description """Defines ManagementNode IOCs
Copyright 2023, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source """3GPP TS 28.623
Generic Network Resource Model (NRM)
Integration Reference Point (IRP);
Solution Set (SS) definitions

3GPP TS 28.622
Generic Network Resource Model (NRM)
Integration Reference Point (IRP);
Information Service (IS)

3GPP TS 28.620
Umbrella Information Model (UIM)""" ;
    dcterms:title "_3gpp-common-management-node" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2023-09-18 (CR-0271)" ;
    y2r:yangModuleName "_3gpp-common-management-node" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-common-management-node> .

mmgmtnode3gpp:ManagementNode.id a rdf:Property ;
    rdfs:label "ManagementNode.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain mmgmtnode3gpp:ManagementNode ;
    rdfs:range xsd:string .

mmgmtnode3gpp:ManagementNode.locationName a rdf:Property ;
    rdfs:label "ManagementNode.locationName" ;
    rdfs:comment "The physical location of this entity (e.g. an address)." ;
    rdfs:domain mmgmtnode3gpp:ManagementNode ;
    rdfs:range xsd:string .

mmgmtnode3gpp:ManagementNode.managedElements a owl:ObjectProperty ;
    rdfs:label "ManagementNode.managedElements" ;
    rdfs:comment """Contains a list of the DN(s) of the related subclasses of
ManagedElement_ instance(s).""" ;
    rdfs:domain mmgmtnode3gpp:ManagementNode ;
    y2r:isReference true .

mmgmtnode3gpp:ManagementNode.swVersion a rdf:Property ;
    rdfs:label "ManagementNode.swVersion" ;
    rdfs:domain mmgmtnode3gpp:ManagementNode ;
    rdfs:range xsd:string .

mmgmtnode3gpp:ManagementNode.userDefinedState a rdf:Property ;
    rdfs:label "ManagementNode.userDefinedState" ;
    rdfs:comment "An operator defined state for operator specific usage" ;
    rdfs:domain mmgmtnode3gpp:ManagementNode ;
    rdfs:range xsd:string .

mmgmtnode3gpp:ManagementNode.userLabel a rdf:Property ;
    rdfs:label "ManagementNode.userLabel" ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain mmgmtnode3gpp:ManagementNode ;
    rdfs:range xsd:string .

mmgmtnode3gpp:ManagementNode.vendorName a rdf:Property ;
    rdfs:label "ManagementNode.vendorName" ;
    rdfs:domain mmgmtnode3gpp:ManagementNode ;
    rdfs:range xsd:string .

