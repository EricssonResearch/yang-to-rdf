@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qmc3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-qmcjob#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix trace3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-trace#> .
@prefix types5g3gpp: <https://semantics.ericsson.com/yang/_3gpp-5g-common-yang-types#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

qmc3gpp:QMCJob a rdfs:Class ;
    rdfs:label "QMCJob" ;
    rdfs:comment """The QoE Measurement Collection provides capability for
collecting QoE information from:
- UEs which are in the specified area in case of Management Based
Activation or
- an individual UE in case of Signalling Based Activation.
The QoE Measurement Collection enables collection of application layer
measurements from the UE for specified end user service type.
The supported service types are:
- Streaming services, see TS 26.247
- MTSI services, see TS 26.114
- VR services, see TS 26.118
A QMCJob instance represents the job for collecting QoE measurements
according to the job parameters. For details of the QoE measurement
collection configuration parameters see clause 5 of TS 28.405.
QMCJob instance can be name-contained by SubNetwork or ManagedElement.
A QMC Job is activated by creating a QMCJob object instance in the
producer. For details of Management Based Activation of QoE Measurement
Collection see clause 4.5 and for details of Signalling Based
Activation of QoE Measurement Collection see clause 4.6 of TS 28.405.
The attribute  pLMNTarget is only relevant when
Management Based Activation is used and the attribute qoETarget is
only relevant when Signalling Based Activation is used. All other
attributes are common for both Management Based Activation and
Signalling Based Activation.

The areaScope attribute defines the area scope of QoE, which is
specified in clause 5.4 of TS 28.405.

When a MnS consumer wishes to deactivate a QMC Job, the MnS consumer
shall delete the corresponding QMCJob instance.
NOTE:  If the reporting is ongoing, when a request to delete a QMCJob
is received, the reporting does not end. The QMCJob instance is deleted,
when the last reporting for the QMC Job expires.

The jobId attribute presents the job identifier of a QMCJob instance.
jobId can be used to associate  multiple QMCJob instances. For example,
it is possible to configure the same jobId value for multiple QMCJob
instances required to produce the data (e.g. Streaming services and
MTSI reports) for a specific network analysis.""" ;
    y2r:hasAttribute types5g3gpp:AreaScope,
        qmc3gpp:pLMNTarget,
        qmc3gpp:sliceScope,
        trace3gpp:TraceReference .

qmc3gpp:pLMNTarget a rdfs:Class ;
    rdfs:label "_3gpp-common-qmcjob:pLMNTarget" ;
    rdfs:comment """Defines the PLMN for which sessions shall be selected in
the network request session in case of area based QMC when several
PLMNs are supported in the RAN (this means that shared cells and not
shared cells are allowed for the specified PLMN. Furthermore, several
PLMNs can be used for not shared RAN cases as well as for shared RAN
cases.). Only the sessions may be selected where the PLMN that the
UE reports as selected PLMN is the same as the PLMN Target.""" .

qmc3gpp:sliceScope a rdfs:Class ;
    rdfs:label "sliceScope" ;
    rdfs:comment """Contains a list of S-NSSAIs (Single Network Slice Selection
Assistance Information).  A Network Slice end to end is identified by
S-NSSAI.""" .

<https://semantics.ericsson.com/yang/_3gpp-common-qmcjob> a owl:Ontology ;
    rdfs:label "_3gpp-common-qmcjob" ;
    dcterms:description """Quality of Experience Measurement Collection Job handling
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source """3GPP TS 28.623
Generic Network Resource Model (NRM)
Integration Reference Point (IRP);
Solution Set (SS) definitions

3GPP TS 28.622
Generic Network Resource Model (NRM)
Integration Reference Point (IRP);
Information Service (IS)""" ;
    dcterms:title "_3gpp-common-qmcjob" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-11-07 (CR-0586)" ;
    y2r:yangModuleName "_3gpp-common-qmcjob" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-common-qmcjob> .

qmc3gpp:QMCJob.areaScope a owl:ObjectProperty ;
    rdfs:label "QMCJob.areaScope" ;
    rdfs:comment """It defines the area scope of QoE, which is specified
in clause 5.4 of TS 28.405.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range types5g3gpp:AreaScope .

qmc3gpp:QMCJob.availableRANqoEMetrics a rdf:Property ;
    rdfs:label "QMCJob.availableRANqoEMetrics" ;
    rdfs:comment """This parameter indicates available RAN visible QoE metrics
to the gNB. This parameter is optional and is valid for NR only.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range xsd:string .

qmc3gpp:QMCJob.id a rdf:Property ;
    rdfs:label "QMCJob.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range xsd:string .

qmc3gpp:QMCJob.jobId a rdf:Property ;
    rdfs:label "QMCJob.jobId" ;
    rdfs:comment """The jobId attribute presents the job identifier of a
QMCJob instance. The jobId can be used to associate  multiple QMCJob
instances. For example, it is possible to configure the same jobId
for multiple QMCJob instances required to produce the data
(e.g. Streaming services and MTSI reports) for a specific network
analysis.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

qmc3gpp:QMCJob.mBSCommunicationServiceType a rdf:Property ;
    rdfs:label "QMCJob.mBSCommunicationServiceType" ;
    rdfs:comment """This attribute indicates which type of MBS communication
service the QoE measurement configuration pertains to.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range xsd:string .

qmc3gpp:QMCJob.mDTAlignmentInformation a owl:ObjectProperty ;
    rdfs:label "QMCJob.mDTAlignmentInformation" ;
    rdfs:comment """This parameter indicates the MDT measurements with which
alignment of QoE measurement is required. This parameter is optional
and is valid for NR only.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range trace3gpp:TraceReference .

qmc3gpp:QMCJob.pLMNTarget a owl:ObjectProperty ;
    rdfs:label "QMCJob.pLMNTarget" ;
    rdfs:comment """Defines the PLMN for which sessions shall be selected in
the network request session in case of area based QMC when several
PLMNs are supported in the RAN (this means that shared cells and not
shared cells are allowed for the specified PLMN. Furthermore, several
PLMNs can be used for not shared RAN cases as well as for shared RAN
cases.). Only the sessions may be selected where the PLMN that the
UE reports as selected PLMN is the same as the PLMN Target.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range qmc3gpp:pLMNTarget .

qmc3gpp:QMCJob.qMCConfigFile a rdf:Property ;
    rdfs:label "QMCJob.qMCConfigFile" ;
    rdfs:comment """Provides a reference to a file including the parameters for
configuration of application layer measurements, known as Container
for Application Layer Measurement Configuration.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range xsd:string .

qmc3gpp:QMCJob.qoECollectionEntityAddress a rdf:Property ;
    rdfs:label "QMCJob.qoECollectionEntityAddress" ;
    rdfs:comment """Specifies the address to which the QMC records shall be
transferred.  Ipv4 or Ipv6 address(es) may be used.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range xsd:string .

qmc3gpp:QMCJob.qoEReference a rdf:Property ;
    rdfs:label "QMCJob.qoEReference" ;
    rdfs:comment """Identifies the QoE measurement collection job in the
Managed Elements and in the measurement collection entity.  The QoE
reference shall be globally unique therefore it is composed as follows:
MCC+MNC+QMC ID, where the MCC and MNC are coming with the QMC
activation request from the management system to identify one PLMN
containing the management system, and QMC ID is a 3 byte Octet String.
The QMC ID is generated by the management system or the operator.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range xsd:string .

qmc3gpp:QMCJob.qoETarget a rdf:Property ;
    rdfs:label "QMCJob.qoETarget" ;
    rdfs:comment """Specifies the target object of the QMC in case of
signalling based QMC.  The qoETarget attribute shall be able
to carry IMSI or SUPI.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range xsd:string .

qmc3gpp:QMCJob.serviceType a rdf:Property ;
    rdfs:label "QMCJob.serviceType" ;
    rdfs:comment "Specifies an end user service type for QoE measurements." ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range xsd:string .

qmc3gpp:QMCJob.sliceScope a owl:ObjectProperty ;
    rdfs:label "QMCJob.sliceScope" ;
    rdfs:comment """Contains a list of S-NSSAIs (Single Network Slice Selection
Assistance Information).  A Network Slice end to end is identified by
S-NSSAI.""" ;
    rdfs:domain qmc3gpp:QMCJob ;
    rdfs:range qmc3gpp:sliceScope .

qmc3gpp:pLMNTarget.mcc a rdf:Property ;
    rdfs:label "_3gpp-common-qmcjob:pLMNTarget.mcc" ;
    rdfs:domain qmc3gpp:pLMNTarget ;
    rdfs:range xsd:string .

qmc3gpp:pLMNTarget.mnc a rdf:Property ;
    rdfs:label "_3gpp-common-qmcjob:pLMNTarget.mnc" ;
    rdfs:domain qmc3gpp:pLMNTarget ;
    rdfs:range xsd:string .

qmc3gpp:sliceScope.sd a rdf:Property ;
    rdfs:label "sliceScope.sd" ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain qmc3gpp:sliceScope ;
    rdfs:range xsd:string .

qmc3gpp:sliceScope.sst a rdf:Property ;
    rdfs:label "sliceScope.sst" ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain qmc3gpp:sliceScope ;
    rdfs:range xsd:unsignedByte .

