            sh:maxCount 1 ;
            sh:path trace3gpp:TraceConfig.triggeringEvents ] ;
    sh:targetClass trace3gpp:TraceConfig .

trace3gpp-shapes:TraceReference a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path trace3gpp:TraceReference.mcc ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path trace3gpp:TraceReference.mnc ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path trace3gpp:TraceReference.traceId ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass trace3gpp:TraceReference .

trace3gpp-shapes:TrsrPrefixCfg a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path trace3gpp:TrsrPrefixCfg.trsrPrefix ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path trace3gpp:TrsrPrefixCfg.trsrPrefixLength ] ;
    sh:targetClass trace3gpp:TrsrPrefixCfg .

trace3gpp-shapes:UECoreMeasConfig a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path trace3gpp:UECoreMeasConfig.ueCoreMeasurements ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path trace3gpp:UECoreMeasConfig.ueCoreMeasGranularityPeriod ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path trace3gpp:UECoreMeasConfig.nfTypeToMeasure ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path trace3gpp:UECoreMeasConfig.objectInstances ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path trace3gpp:UECoreMeasConfig.rootObjectInstances ] ;
    sh:targetClass trace3gpp:UECoreMeasConfig .

