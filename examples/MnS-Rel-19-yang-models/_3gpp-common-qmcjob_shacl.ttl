qmc3gpp-shapes:QMCJob a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path qmc3gpp:QMCJob.id ],
        [ sh:description "Specifies an end user service type for QoE measurements." ;
            sh:in ( "DASH" "MTSI" "VR" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qmc3gpp:QMCJob.serviceType ],
        [ sh:class qmc3gpp:pLMNTarget ;
            sh:description """Defines the PLMN for which sessions shall be selected in
the network request session in case of area based QMC when several
PLMNs are supported in the RAN (this means that shared cells and not
shared cells are allowed for the specified PLMN. Furthermore, several
PLMNs can be used for not shared RAN cases as well as for shared RAN
cases.). Only the sessions may be selected where the PLMN that the
UE reports as selected PLMN is the same as the PLMN Target.""" ;
            sh:maxCount 1 ;
            sh:path qmc3gpp:QMCJob.pLMNTarget ],
        [ sh:class qmc3gpp:sliceScope ;
            sh:description """Contains a list of S-NSSAIs (Single Network Slice Selection
Assistance Information).  A Network Slice end to end is identified by
S-NSSAI.""" ;
            sh:path qmc3gpp:QMCJob.sliceScope ],
        [ sh:class trace3gpp:TraceReference ;
            sh:description """This parameter indicates the MDT measurements with which
alignment of QoE measurement is required. This parameter is optional
and is valid for NR only.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qmc3gpp:QMCJob.mDTAlignmentInformation ],
        [ sh:datatype xsd:string ;
            sh:description """Specifies the address to which the QMC records shall be
transferred.  Ipv4 or Ipv6 address(es) may be used.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qmc3gpp:QMCJob.qoECollectionEntityAddress ],
        [ sh:datatype xsd:string ;
            sh:description """Specifies the target object of the QMC in case of
signalling based QMC.  The qoETarget attribute shall be able
to carry IMSI or SUPI.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qmc3gpp:QMCJob.qoETarget ],
        [ sh:datatype xsd:string ;
            sh:description """Identifies the QoE measurement collection job in the
Managed Elements and in the measurement collection entity.  The QoE
reference shall be globally unique therefore it is composed as follows:
MCC+MNC+QMC ID, where the MCC and MNC are coming with the QMC
activation request from the management system to identify one PLMN
containing the management system, and QMC ID is a 3 byte Octet String.
The QMC ID is generated by the management system or the operator.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qmc3gpp:QMCJob.qoEReference ],
        [ sh:datatype xsd:string ;
            sh:description """The jobId attribute presents the job identifier of a
QMCJob instance. The jobId can be used to associate  multiple QMCJob
instances. For example, it is possible to configure the same jobId
for multiple QMCJob instances required to produce the data
(e.g. Streaming services and MTSI reports) for a specific network
analysis.""" ;
            sh:maxCount 1 ;
            sh:path qmc3gpp:QMCJob.jobId ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a reference to a file including the parameters for
configuration of application layer measurements, known as Container
for Application Layer Measurement Configuration.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qmc3gpp:QMCJob.qMCConfigFile ],
        [ sh:description """This parameter indicates available RAN visible QoE metrics
to the gNB. This parameter is optional and is valid for NR only.""" ;
            sh:in ( "APP_LAYER_BUFFER_LEVEL_LIST" "PLAYOUT_DELAY_FOR_MEDIA_STARTUP" ) ;
            sh:maxCount 2 ;
            sh:path qmc3gpp:QMCJob.availableRANqoEMetrics ],
        [ sh:description """This attribute indicates which type of MBS communication
service the QoE measurement configuration pertains to.""" ;
            sh:in ( "BROADCAST" "MULTICAST" ) ;
            sh:maxCount 1 ;
            sh:path qmc3gpp:QMCJob.mBSCommunicationServiceType ],
        [ sh:class types5g3gpp:AreaScope ;
            sh:description """It defines the area scope of QoE, which is specified
in clause 5.4 of TS 28.405.""" ;
            sh:path qmc3gpp:QMCJob.areaScope ] ;
    sh:targetClass qmc3gpp:QMCJob .

qmc3gpp-shapes:pLMNTarget a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qmc3gpp:pLMNTarget.mcc ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qmc3gpp:pLMNTarget.mnc ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass qmc3gpp:pLMNTarget .

qmc3gpp-shapes:sliceScope a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path qmc3gpp:sliceScope.sd ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path qmc3gpp:sliceScope.sst ] ;
    sh:targetClass qmc3gpp:sliceScope .

