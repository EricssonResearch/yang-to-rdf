@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nropcelld3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nroperatorcelldu#> .
@prefix nropcelld3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-nr-nrm-nroperatorcelldu#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

nropcelld3gpp-shapes:NROperatorCellDU a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nropcelld3gpp:NROperatorCellDU.id ],
        [ sh:datatype xsd:long ;
            sh:description """Identifies a gNB within a PLMN. The gNB Identifier (gNB ID)
is part of the NR Cell Identifier (NCI) of the gNB cells.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nropcelld3gpp:NROperatorCellDU.gNBId ],
        [ sh:datatype xsd:int ;
            sh:description "Indicates the number of bits for encoding the gNB ID." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nropcelld3gpp:NROperatorCellDU.gNBIdLength ],
        [ sh:description """DN of the Configurable5QISet that the OperatorDU
supports (is associated to).""" ;
            sh:maxCount 1 ;
            sh:path nropcelld3gpp:NROperatorCellDU.configurable5QISetRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """DN of the Dynamic5QISet that the OperatorDU
supports (is associated to).""" ;
            sh:maxCount 1 ;
            sh:path nropcelld3gpp:NROperatorCellDU.dynamic5QISetRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:int ;
            sh:description """Identifies an NR cell of a gNB. Together with the
corresponding gNB identifier in forms the NR Cell Identity (NCI).""" ;
            sh:maxCount 1 ;
            sh:path nropcelld3gpp:NROperatorCellDU.cellLocalId ],
        [ sh:description """Administrative state of the NROperatorCellDU. Indicates the
permission to use or prohibition against using the cell, imposed
through the OAM services.""" ;
            sh:in ( "LOCKED" "UNLOCKED" "SHUTTINGDOWN" ) ;
            sh:maxCount 1 ;
            sh:path nropcelld3gpp:NROperatorCellDU.administrativeState ],
        [ sh:datatype xsd:string ;
            sh:description "The common 5GS Tracking Area Code for the PLMNs." ;
            sh:maxCount 1 ;
            sh:path nropcelld3gpp:NROperatorCellDU.nRTAC ],
        [ sh:description "Reference to corresponding NRCellDU instance." ;
            sh:path nropcelld3gpp:NROperatorCellDU.nRCellDURef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class nropcelld3gpp:pLMNInfoList ;
            sh:description """The PLMNInfoList is a list of PLMNInfo data type. It
defines which PLMNs that can be served by the NR cell, and which
S-NSSAIs that can be supported by the NR cell for corresponding PLMN
in case of network slicing feature is supported. The plMNId of the
first entry of the list is the PLMNId used to construct the nCGI for
the NR cell.""" ;
            sh:minCount 1 ;
            sh:path nropcelld3gpp:NROperatorCellDU.pLMNInfoList ] ;
    sh:targetClass nropcelld3gpp:NROperatorCellDU .

nropcelld3gpp-shapes:pLMNInfoList a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nropcelld3gpp:pLMNInfoList.mcc ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nropcelld3gpp:pLMNInfoList.mnc ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path nropcelld3gpp:pLMNInfoList.sd ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path nropcelld3gpp:pLMNInfoList.sst ] ;
    sh:targetClass nropcelld3gpp:pLMNInfoList .

<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nroperatorcelldu> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-nroperatorcelldu" ;
    dcterms:description """Defines the YANG mapping of the OperatorDU Information Object
Class (IOC) that is part of the NR Network Resource Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-nroperatorcelldu" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-05-06 (CR-1526 CR-1527)" ;
    y2r:yangModuleName "_3gpp-nr-nrm-nroperatorcelldu" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-nr-nrm-nroperatorcelldu> .

