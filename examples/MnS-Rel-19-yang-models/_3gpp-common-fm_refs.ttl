@prefix y2r: <https://semantics.ericsson.com/vocab#> .

<https://semantics.ericsson.com/yang/_3gpp-common-fm> a owl:Ontology ;
    rdfs:label "_3gpp-common-fm" ;
    dcterms:description """Defines a Fault Management model
Copyright 2026, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.111" ;
    dcterms:title "_3gpp-common-fm" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-01-25 (CR-0060)" ;
    y2r:yangModuleName "_3gpp-common-fm" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-common-fm> .

fm3gpp:AlarmRecord.backUpObject y2r:candidate "BackUpObject" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

fm3gpp:AlarmRecord.objectInstance y2r:candidate "ObjectInstance" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

