            sh:description """This attribute represents network Identity;
Shall be present if PlmnIdNid identifies an SNPN.
(see clauses 5.30.2.3, 5.30.2.9, 6.3.4, and 6.3.8 in TS 23.501""" ;
            sh:maxCount 1 ;
            sh:path smf3gpp:snpns.nid ] ;
    sh:targetClass smf3gpp:snpns .

smf3gpp-shapes:snssai a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
