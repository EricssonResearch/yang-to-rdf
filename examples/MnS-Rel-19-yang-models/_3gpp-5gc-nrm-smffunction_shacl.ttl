            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/gpsiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/gpsiRangeList> .

