    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
