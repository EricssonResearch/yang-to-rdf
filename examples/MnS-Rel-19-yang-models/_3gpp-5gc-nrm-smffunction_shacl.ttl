    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/impuRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPointsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPoints/ipv4Address> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPoints/ipv6Address> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPoints/ipv6Prefix> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ],
        [ sh:in ( "TCP" "STCP" "UDP" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPoints/transport> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPoints/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPoints> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/pLMNIdListShape> a sh:NodeShape ;
