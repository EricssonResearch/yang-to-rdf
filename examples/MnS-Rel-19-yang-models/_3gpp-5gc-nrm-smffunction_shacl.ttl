    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssaiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssaiList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssaiList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssaiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssaisShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssais/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssais/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssais> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
