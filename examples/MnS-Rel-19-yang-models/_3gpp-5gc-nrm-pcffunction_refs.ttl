<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-pcffunction> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-pcffunction" ;
    dcterms:description """This IOC represents the PCF function in 5GC. For more
information about the PCF, see 3GPP TS 23.501.
Copyright 2026, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-pcffunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-03-25 (CR-1694)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-pcffunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction> .

pcf3gpp:File.jobRef y2r:candidate "Job" ;
