    dcterms:title "_3gpp-5gc-nrm-nrffunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-05-25 (CR-1702)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-nrffunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction> .

