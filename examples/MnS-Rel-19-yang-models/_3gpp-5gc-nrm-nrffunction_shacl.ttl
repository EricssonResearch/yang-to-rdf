@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-nrffunction" ;
    dcterms:description """This IOC represents the NRF function in 5GC.
For more information about the NRF, see 3GPP TS 23.501 [2].
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-nrffunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-11-01 (CR-1640)" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMappingShape> a sh:NodeShape ;
    sh:property [ sh:description """Represents the distinguished name (DN) identifier of the
AIOTF that serves the (internal) target area provided by NEF to NRF""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMapping/aIOTFdN> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID> ;
            sh:description """It is the (internal) target area used by NRF (as provided
by NEF) to accurately locate the AIOTF instance. It is mapped to aIOTFdN.
It could refer to a list of AIoT Areas.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMapping/internalTargetArea> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMapping> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute defines the identity of the HSS group
that is served by the HSS instance.If not provided, the HSS instance
does not pertain to any HSS group.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/groupID> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges> ;
            sh:description """This attribute defines the list of ranges of IMSIs whose
profile data is available in the HSS instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/imsiRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPrivateIdentityRanges> ;
            sh:description """This attribute defines the list of ranges of IMS Private
Identities whose profile data is available in the HSS instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/imsPrivateIdentityRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPublicIdentityRanges> ;
            sh:description """This attribute defines the list of ranges of MSISDNs whose
profile data is available in the HSS instance. """ ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/imsPublicIdentityRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges> ;
            sh:description """This attribute defines the list of ranges of IMS Public
Identities whose profile data is available in the HSS instance """ ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/msisdnRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges> ;
            sh:description """This attribute defines the list of ranges of external
group IDs that can be served by this HSS instance.If not provided,
the HSS instance does not serve any external groups. """ ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/externalGroupIdentifiersRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress> ;
            sh:description "This attribute defines the Diameter Address of the HSS " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/hssDiameterAddress> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses> ;
            sh:description """This attribute defines the Additional Diameter Addresses
of the HSS;may be present if hssDiameterAddress is present """ ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/additionalDiamAddresses> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/userLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
            sh:description """It is a set of NFProfile(s) to be registered in the NRF
instance. NFProfile is defined in 3GPP TS 29.510 """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/nFProfileList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
            sh:description "Represents information of an NRF NF Instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/nrfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
            sh:description "This parameter defines profile for managed NF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/managedNFProfile> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMapping> ;
            sh:description """Represents mapping information between (Internal) target
area (provided by NEF) and AIOTF DN.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/aIoTNRFMapping> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It is used to indicate the FQDN of the registered NF instance
in service-based interface, for example, NF instance FQDN structure is:
nftype<nfnum>.slicetype<sliceid>.mnc<MNC>.mcc<MCC>.3gppnetwork.org""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/sBIFQDN> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """NSI ID. NSI ID is an identifier for identifying the Core
Network part of a Network Slice instance when multiple Network Slice
instances of the same Network Slice are deployed, and there is a need
to differentiate between them in the 5GC, see clause 3.1 of TS 23.501
and subclause 6.1.6.2.7 of 3GPP TS 29.531""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/cNSIIdList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/SupportedPerfMetricGroups> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList> ;
            sh:description "It defines the PLMN(s) of a Network Function." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/pLMNInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfoShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo> ;
            sh:description """This attribute contains all the udrInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedUdrInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> ;
            sh:description """This attribute contains all the udmInfo
attributes
locally configured in the NRF or the NRF
received during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedUdmInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
            sh:description """This attribute contains all the pcscfInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId to which
the map entry belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedPcscfInfoList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GmlcInfo> ;
            sh:description """This attribute contains all the gmlcInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId of which
the nefInfo belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedGmlcInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> ;
            sh:description """This attribute contains all the lmfInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId of which
the lmfInfo belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedLmfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfInfo> ;
            sh:description """This attribute contains information of other NFs
without corresponding NF type specific Info extensions locally
configured in the NRF or the NRF received during NF registration.
The key of the map is the nfInstanceId of the NF. The map entry
is the NfInfo as defined in clause 5.3.229 representing the
information of a generic NF instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedNfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
            sh:description """This attribute contains list of HssInfo attribute
locally configured in the NRF or that the NRF received during NF
registration. The key of the map is the nfInstanceId to which the
map entry belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedHssInfoList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/served5gDdnmfInfo> ;
            sh:description """This attribute contains all the 5gDdnmfInfo
attribute locally configured in the NRF or that the NRF
received during NF registration. The key of the map is
the nfInstanceId to which the map entry belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/served5gDdnmfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/AusfInfo> ;
            sh:description """This attribute contains all the
ausfInfo attributes
locally configured in the NRF or the NRF
received during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedAusfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
            sh:description """This attribute contains all the amfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedAmfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
            sh:description """This attribute contains all the smfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedSmfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
            sh:description """This attribute contains all the upfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedUpfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo> ;
            sh:description """This attribute contains all the pcfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedPcfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
            sh:description """This attribute contains all the bsfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedBsfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
            sh:description """This attribute contains all the bsfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedChfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
            sh:description """This attribute contains all the nwdafInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId of which
the nwdafInfo belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedNwdafInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> .

