@prefix cco3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-cco#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

cco3gpp:CCOFunction a rdfs:Class ;
    rdfs:label "CCOFunction" ;
    rdfs:comment """This IOC contains attributes to support the C-SON
function of Capacity and Coverage optimization
(See clause 7.2.3 in TS 28.313).
NOTE: in the case where multiple CCOFunction MOIs exist at different
levels of the containment tree, the CCOFunction MOI at the lower
level overrides the CCOFunction MOIs at higher level(s) of the same
containment tree.""" ;
    y2r:nameContains cco3gpp:CCOOvershootCoverageParameters,
        cco3gpp:CCOPilotPollutionParameters,
        cco3gpp:CCOWeakCoverageParameters .

cco3gpp:CCOOvershootCoverageParameters a rdfs:Class ;
    rdfs:label "CCOOvershootCoverageParameters" ;
    rdfs:comment """This IOC represents the properties of
CCOOvershootCoverageParameters. CCOOvershootCoverageParameters is
one realization of abstract CCOParameters IOC.""" ;
    y2r:hasAttribute cco3gpp:ParameterRange .

cco3gpp:CCOPilotPollutionParameters a rdfs:Class ;
    rdfs:label "CCOPilotPollutionParameters" ;
    rdfs:comment """This IOC represents the properties of
CCOPilotPollutionParameters. CCOPilotPollutionParameters is one
realization of abstract CCOParameters IOC.""" ;
    y2r:hasAttribute cco3gpp:ParameterRange .

cco3gpp:CCOWeakCoverageParameters a rdfs:Class ;
    rdfs:label "CCOWeakCoverageParameters" ;
    rdfs:comment """This IOC represents the properties of
CCOWeakCoverageParameters. CCOWeakCoverageParameters is one
realization of abstract CCOParameters IOC.""" ;
    y2r:hasAttribute cco3gpp:ParameterRange .

cco3gpp:ParameterRange a rdfs:Class ;
    rdfs:label "ParameterRange" ;
    rdfs:comment """It indicates adjustment range (including maximum value,
minimum value) of downlinkTransmitPower to optimize radio coverage.""" .

<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-cco> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-cco" ;
    dcterms:description """Implements support the C-SON function of Capacity and
Coverage optimization .
Copyright 2024, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-nr-nrm-cco" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2024-05-24 (CR-1273)" ;
    y2r:yangModuleName "_3gpp-nr-nrm-cco" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-nr-nrm-cco> .

cco3gpp:CCOFunction.cCOControl a rdf:Property ;
    rdfs:label "CCOFunction.cCOControl" ;
    rdfs:comment """This attribute determines whether the centralized
SON CCO Function is enabled or disabled.""" ;
    rdfs:domain cco3gpp:CCOFunction ;
    rdfs:range xsd:boolean .

cco3gpp:CCOFunction.id a rdf:Property ;
    rdfs:label "CCOFunction.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain cco3gpp:CCOFunction ;
    rdfs:range xsd:string .

cco3gpp:CCOOvershootCoverageParameters.antennaAzimuthRange a owl:ObjectProperty ;
    rdfs:label "CCOOvershootCoverageParameters.antennaAzimuthRange" ;
    rdfs:comment """It indicates adjustment range (including maximum value,
minimum value) of antennaAzimuth to optimize radio coverage.
units 0.1 degree""" ;
    rdfs:domain cco3gpp:CCOOvershootCoverageParameters ;
    rdfs:range cco3gpp:ParameterRange .

cco3gpp:CCOOvershootCoverageParameters.antennaTiltRange a owl:ObjectProperty ;
    rdfs:label "CCOOvershootCoverageParameters.antennaTiltRange" ;
    rdfs:comment """It indicates adjustment range (including maximum value,
minimum value) of antennaTilt to optimize radio coverage.
units 0.1 degree""" ;
    rdfs:domain cco3gpp:CCOOvershootCoverageParameters ;
    rdfs:range cco3gpp:ParameterRange .

cco3gpp:CCOOvershootCoverageParameters.coverageShapeList a rdf:Property ;
    rdfs:label "CCOOvershootCoverageParameters.coverageShapeList" ;
    rdfs:comment """It indicates the coverage shape of specific sites which
can be selected to optimize radio coverage.""" ;
    rdfs:domain cco3gpp:CCOOvershootCoverageParameters ;
    rdfs:range xsd:unsignedShort .

cco3gpp:CCOOvershootCoverageParameters.digitalAzimuthRange a owl:ObjectProperty ;
    rdfs:label "CCOOvershootCoverageParameters.digitalAzimuthRange" ;
    rdfs:comment """It indicates adjustment range (including maximum value,
minimum value) of digitalAzimuth to optimize radio coverage.
units 0.1 degree""" ;
    rdfs:domain cco3gpp:CCOOvershootCoverageParameters ;
    rdfs:range cco3gpp:ParameterRange .

cco3gpp:CCOOvershootCoverageParameters.digitalTiltRange a owl:ObjectProperty ;
    rdfs:label "CCOOvershootCoverageParameters.digitalTiltRange" ;
    rdfs:comment """It indicates adjustment range (including maximum value,
