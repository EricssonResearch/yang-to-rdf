<urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters/id> a rdf:Property ;
    rdfs:label "id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters> ;
