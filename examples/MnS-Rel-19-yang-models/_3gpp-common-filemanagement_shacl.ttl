            sh:maxCount 1 ;
            sh:path filemgmt3gpp:jobMonitor.startTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time when status changed to 'SUCCESS', 'CANCELLED',
'FAILED' or 'PARTIALLY_FAILED'.

If the time is in the future, it is the estimated time
the process will end.""" ;
            sh:maxCount 1 ;
            sh:path filemgmt3gpp:jobMonitor.endTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:unsignedInt ;
