            sh:maxCount 1 ;
            sh:path filemgmt3gpp:FileDownloadJob.notificationRecipientAddress ],
        [ sh:datatype xsd:boolean ;
            sh:description """Setting this attribute to TRUE cancels the file download job.
As specified in the definition of ProcessMonitor, cancellation is
possible in the NOT_STARTED and RUNNING state. Setting the attribute
to FALSE has no observable result.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path filemgmt3gpp:FileDownloadJob.cancelJob ],
        [ sh:class filemgmt3gpp:jobMonitor ;
            sh:description "Provides monitoring for the file download job." ;
