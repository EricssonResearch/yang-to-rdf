@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix meas3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-measurements#> .
@prefix mf3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-managed-function#> .
@prefix nrcelldu3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nrcelldu#> .
@prefix nrcelldu3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-nr-nrm-nrcelldu#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix stm3gpp: <https://semantics.ericsson.com/yang/_3gpp-stm-nrm-stmfunction#> .
@prefix trace3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-trace#> .
@prefix types3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-yang-types#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

nrcelldu3gpp-shapes:File a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:File.id ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:File.fileLocation ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:File.jobId ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:File.fileContent ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:File.fileCompression ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:File.fileSize ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:File.fileDataType ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:File.fileFormat ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:File.fileReadyTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:File.fileExpirationTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path nrcelldu3gpp:File.jobRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass nrcelldu3gpp:File .

nrcelldu3gpp-shapes:Files a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:Files.id ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:Files.numberOfFiles ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path nrcelldu3gpp:Files.jobRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:Files.jobId ] ;
    sh:targetClass nrcelldu3gpp:Files .

nrcelldu3gpp-shapes:ManagedNFService a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:ManagedNFService.id ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:ManagedNFService.userLabel ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:ManagedNFService.nFServiceType ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:ManagedNFService.administrativeState ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:ManagedNFService.operationalState ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:ManagedNFService.usageState ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:ManagedNFService.registrationState ],
        [ sh:class types3gpp:SAP ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:ManagedNFService.sAP ],
        [ sh:class mf3gpp:Operation ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:ManagedNFService.operations ] ;
    sh:targetClass nrcelldu3gpp:ManagedNFService .

nrcelldu3gpp-shapes:NRCellDU a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.id ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.userLabel ],
        [ sh:datatype xsd:string ;
            sh:description """It is the list of Tracking Area Codes which is only present
in an NTN cell. If this field is present, network does not configure
trackingAreaCode, see TS 38.331).""" ;
            sh:maxCount 12 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.nTNTAClist ],
        [ sh:datatype xsd:int ;
            sh:description """NR Absolute Radio Frequency Channel Number (NR-ARFCN) for
downlink.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.arfcnDL ],
        [ sh:datatype xsd:int ;
            sh:description """NR Absolute Radio Frequency Channel Number (NR-ARFCN) for
uplink.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.arfcnUL ],
        [ sh:datatype xsd:int ;
            sh:description """NR Absolute Radio Frequency Channel Number (NR-ARFCN) for
supplementary uplink.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.arfcnSUL ],
        [ sh:datatype xsd:int ;
            sh:description "Base station channel bandwidth for downlink." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.bSChannelBwDL ],
        [ sh:datatype xsd:string ;
            sh:description """Configures the UTC time when the gNB attempts to start
RIM-RS monitoring.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.rimRSMonitoringStartTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """Configures the UTC time when the gNB stops RIM-RS
monitoring.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.rimRSMonitoringStopTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Configures a duration of the monitoring window  in which
gNB monitors the RIM-RS, in unit of P_t, where P_t is the RIM-RS
transmission periodicity in units of uplink-downlink switching period (
see 38.211 subclause 7.4.1.6).

This field is configured together with rimRSMonitoringInterval,
rimRSMonitoringWindowStartingOffset, rimRSMonitoringOccasionInterval
and rimRSMonitoringOccasionStartingOffset.
The duration of the monitoring window is expected to be larger than
or equal to M*P_t, where M is the interval between adjacent monitoring
occasions within the monitoring window
(configured by rimRSMonitoringInterval).
The absolute duration of the monitoring window is not expected to be
larger than the periodicity of the monitoring window (configured by
rimRSMonitoringWindowPeriodicity).

See 3GPP TS 28.541 attribute descrition rimRSMonitoringWindowDuration
for the exact math formulas.

Only the earliest N_T consecutive detection durations in each RIM-RS
transmission periodicity (P_t) in the monitoring window are taken as
valid time for monitoring potential interference, and they are
consecutively monitored in the monitoring window, while the residual
part of each RIM-RS transmission periodicity is not used for
discovering potential interference, where, a consecutive detection
duration spans P1*R1 (if only P1 is configured) or ((P1+P2))/2*R1 (
if both P1 and P2 are configured), where,
R1 is the number of consecutive uplink-downlinkswitching periods
for RS-1 (configured by nrofConsecutiveRIMRS1),
P1 is the first uplink-downlinkswitching period (configured by
dlULSwitchingPeriod1),
P2 is the second uplink-downlink switching period (configured by
dlULSwitchingPeriod2), and
N_T=
((N_setID # RIM,1)/(N_f # RI N_s # RIM,1)
if enableEnoughNotEnoughIndication is 'disable'

(2N_setID # RIM,1)/(N_f # RIM N_s # RIM,1)
if enableEnoughNotEnoughIndication is 'enable'

N_setID # 'RIM,1'  is the total number of set IDs for RIM RS-1
(configured by totalnrofSetIdofRS1),
N_f # RIM  is the number of candidate frequency resources in the whole
network (configured by nrofGlobalRIMRSFrequencyCandidates), and
N_s # 'RIM,1'  is the number of candidate sequences assigned for
RIM RS-1 (configured by nrofRIMRSSequenceCandidatesofRS1).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.rimRSMonitoringWindowDuration ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Configures the start offset of the first monitoring window
within one day, in unit of hours.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.rimRSMonitoringWindowStartingOffset ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Configures the periodicity of the monitoring window, in
unit of hours""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.rimRSMonitoringWindowPeriodicity ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.priorityLabel ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Configures the interval between adjacent monitoring
occasions (M) within the monitoring window, in unit of consecutive
detection duration.
M is expected to be prime to N_T, where N_T is given in above
attribute rimRSMonitoringWindowDuration.
allowedValues: 1,2..N_T-1""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.rimRSMonitoringOccasionInterval ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Configures the start offset of the first monitoring occasions
within the monitoring window (S_M), in unit of consecutive detection
duration.
gNB starts monitoring potential interference from the S_M-th consecutive
detection duration in the first complete RIM-RS transmission
periodicity (P_t) within the monitoring window.

allowedValues: 0,1,2..M-1

where M is the the interval between adjacent monitoring occasions
within the monitoring window
(configured by rimRSMonitoringOccasionInterval)""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.rimRSMonitoringOccasionStartingOffset ],
        [ sh:datatype xsd:int ;
            sh:description """Indicates cell defining SSB frequency domain position.
Frequency (in terms of NR-ARFCN) of the cell defining SSB transmission.
The frequency identifies the position of resource element RE=#0
(subcarrier #0) of resource block RB#10 of the SS block. The frequency
must be positioned on the NR global frequency raster, as defined in
3GPP TS 38.101-1, and within bSChannelBwDL.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.ssbFrequency ],
        [ sh:datatype xsd:int ;
            sh:description """Indicates cell defined SSB periodicity. The SSB periodicity
is used for the rate matching purpose.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.ssbPeriodicity ],
        [ sh:datatype xsd:int ;
            sh:description """Subcarrier spacing of SSB. Only the values 15 kHz or 30 kHz
(< 6 GHz), 120 kHz or 240 kHz (> 6 GHz) are applicable.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.ssbSubCarrierSpacing ],
        [ sh:datatype xsd:int ;
            sh:description """Indicates cell defining SSB time domain position. Defined
as the offset of the measurement window, in which to receive SS/PBCH
blocks, where allowed values depend on the ssbPeriodicity
(ssbOffset < ssbPeriodicity).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.ssbOffset ],
        [ sh:datatype xsd:int ;
            sh:description """Duration of the measurement window in which to receive
SS/PBCH blocks.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.ssbDuration ],
        [ sh:datatype xsd:int ;
            sh:description "Base station channel bandwidth for uplink." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.bSChannelBwUL ],
        [ sh:datatype xsd:int ;
            sh:description "Base station channel bandwidth for supplementary uplink." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.bSChannelBwSUL ],
        [ sh:description """Represents whether the NR Cell bars access to a UE type
(e.g. RedCap UE).
If present, a value indicates the UE type is not allowed access to
the cell.
allowedValues:
- REDCAP_1RX and REDCAP_2RX for RedCap UE(s),
- EREDCAP_1RX and EREDCAP_2RX for eRedCap UE(s).""" ;
            sh:in ( "REDCAP_1RX" "REDCAP_2RX" "EREDCAP_1RX" "EREDCAP_2RX" ) ;
            sh:path nrcelldu3gpp:NRCellDU.uECellBarredAccess ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path nrcelldu3gpp:NRCellDU.supportedTraceMetrics ],
        [ sh:description """This attribute contains the DN of the referenced
NRSectorCarrier.""" ;
            sh:path nrcelldu3gpp:NRCellDU.nRSectorCarrierRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Reference to corresponding BWP instance." ;
            sh:path nrcelldu3gpp:NRCellDU.bWPRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Reference to corresponding BWPSet instance." ;
            sh:path nrcelldu3gpp:NRCellDU.bWPSetRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Reference to corresponding NRFrequency instance." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.nRFrequencyRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """DN of a victim Set (RimRSSet)
Implemented if RIM feature is supported""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.victimSetRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "DN of an aggressor Set (RimRSSet)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.aggressorSetRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """This attribute contains the DN of the redCapAccessCriteria
MOI """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.redCapAccessCriteriaRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class mf3gpp:VnfParameters ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path nrcelldu3gpp:NRCellDU.vnfParametersList ],
        [ sh:class mf3gpp:PeeParameters ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path nrcelldu3gpp:NRCellDU.peeParameterslist ],
        [ sh:class nrcelldu3gpp:SupportedPerfMetricGroups ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path nrcelldu3gpp:NRCellDU.SupportedPerfMetricGroups ],
        [ sh:datatype xsd:int ;
            sh:description """Identifies an NR cell of a gNB. Together with the
corresponding gNB identifier in forms the NR Cell Identity (NCI).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.cellLocalId ],
        [ sh:class nrcelldu3gpp:pLMNInfoList ;
            sh:description """The PLMNInfoList is a list of PLMNInfo data type. It
defines which PLMNs that can be served by the NR cell, and which
S-NSSAIs that can be supported by the NR cell for corresponding PLMN
in case of network slicing feature is supported. The plMNId of the
first entry of the list is the PLMNId used to construct the nCGI for
the NR cell.""" ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.pLMNInfoList ],
        [ sh:class types3gpp:NpnId ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.""" ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.nPNIdentityList ],
        [ sh:description """Operational state of the NRCellDU instance. Indicates
whether the resource is installed and partially or fully operable
(ENABLED) or the resource is not installed or not operable
(DISABLED).""" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.operationalState ],
        [ sh:description """Administrative state of the NRCellDU. Indicates the
permission to use or prohibition against using the cell, imposed
through the OAM services.""" ;
            sh:in ( "LOCKED" "UNLOCKED" "SHUTTINGDOWN" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.administrativeState ],
        [ sh:description """Cell state of the NRCellDU instance. Indicates whether the
cell is not currently in use (IDLE), or currently in use but not
configured to carry traffic (INACTIVE), or currently in use and is
configured to carry traffic (ACTIVE).""" ;
            sh:in ( "IDLE" "INACTIVE" "ACTIVE" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.cellState ],
        [ sh:datatype xsd:int ;
            sh:description "The Physical Cell Identity (PCI) of the NR cell." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.nRPCI ],
        [ sh:datatype xsd:string ;
            sh:description "The common 5GS Tracking Area Code for the PLMNs." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:NRCellDU.nRTAC ] ;
    sh:targetClass nrcelldu3gpp:NRCellDU .

nrcelldu3gpp-shapes:PerfMetricJob a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.id ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.administrativeState ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.notificationRecipientAddress ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.streamTarget ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob._linkToFiles ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.schedulerRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.conditionMonitorRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.operationalState ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.jobId ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.performanceMetrics ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.granularityPeriod ],
        [ sh:path nrcelldu3gpp:PerfMetricJob.objectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path nrcelldu3gpp:PerfMetricJob.rootObjectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.fileReportingPeriod ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:PerfMetricJob.fileLocation ] ;
    sh:targetClass nrcelldu3gpp:PerfMetricJob .

nrcelldu3gpp-shapes:StmCtrl a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:StmCtrl.id ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path nrcelldu3gpp:StmCtrl.reportingNFList ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:StmCtrl.stmTargetUri ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:StmCtrl.administrativeState ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:StmCtrl.operationalState ],
        [ sh:class stm3gpp:NetworkInterface ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path nrcelldu3gpp:StmCtrl.targetInterfaceInfoList ] ;
    sh:targetClass nrcelldu3gpp:StmCtrl .

nrcelldu3gpp-shapes:SupportedPerfMetricGroups a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:SupportedPerfMetricGroups.performanceMetrics ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path nrcelldu3gpp:SupportedPerfMetricGroups.granularityPeriods ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:SupportedPerfMetricGroups.reportingMethods ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path nrcelldu3gpp:SupportedPerfMetricGroups.reportingPeriods ] ;
    sh:targetClass nrcelldu3gpp:SupportedPerfMetricGroups .

nrcelldu3gpp-shapes:ThresholdMonitor a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:ThresholdMonitor.id ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:ThresholdMonitor.administrativeState ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:ThresholdMonitor.operationalState ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:ThresholdMonitor.monitorGranularityPeriod ],
        [ sh:path nrcelldu3gpp:ThresholdMonitor.objectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path nrcelldu3gpp:ThresholdMonitor.rootObjectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class meas3gpp:ThresholdInfo ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:ThresholdMonitor.thresholdInfoList ] ;
    sh:targetClass nrcelldu3gpp:ThresholdMonitor .

nrcelldu3gpp-shapes:TraceJob a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.id ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.jobType ],
        [ sh:class nrcelldu3gpp:traceTarget ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.traceTarget ],
        [ sh:class trace3gpp:TraceConfig ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.traceConfig ],
        [ sh:class trace3gpp:MdtConfig ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed. For NTN MDT, if the list of plmnList is included, it will
only log measurements for the cells belonging to the listed PLMNs.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.mdtConfig ],
        [ sh:class trace3gpp:UECoreMeasConfig ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.ueCoreMeasConfig ],
        [ sh:class types3gpp:NpnId ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.nPNTarget ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path nrcelldu3gpp:TraceJob.rrcReportType ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path nrcelldu3gpp:TraceJob.listOfTraceMetrics ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.traceCollectionEntityIPAddress ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.traceReportingConsumerUri ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.jobId ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.traceReportingFormat ],
        [ sh:class nrcelldu3gpp:pLMNTarget ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path nrcelldu3gpp:TraceJob.pLMNTarget ],
        [ sh:class trace3gpp:TraceReference ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:TraceJob.traceReference ] ;
    sh:targetClass nrcelldu3gpp:TraceJob .

nrcelldu3gpp-shapes:pLMNInfoList a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:pLMNInfoList.mcc ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:pLMNInfoList.mnc ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:pLMNInfoList.sd ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:pLMNInfoList.sst ] ;
    sh:targetClass nrcelldu3gpp:pLMNInfoList .

nrcelldu3gpp-shapes:pLMNTarget a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:pLMNTarget.mcc ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrcelldu3gpp:pLMNTarget.mnc ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass nrcelldu3gpp:pLMNTarget .

nrcelldu3gpp-shapes:traceTarget a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path nrcelldu3gpp:traceTarget.traceTargetType ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path nrcelldu3gpp:traceTarget.traceTargetValueList ] ;
    sh:targetClass nrcelldu3gpp:traceTarget .

