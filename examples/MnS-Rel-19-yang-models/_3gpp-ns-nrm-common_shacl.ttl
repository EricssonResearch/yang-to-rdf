@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-ns-nrm-common> a owl:Ontology ;
    owl:versionInfo "revision 2023-09-18 (CR-1043)" .

<urn:3gpp:sa5:_3gpp-ns-nrm-common/ServAttrComShape> a sh:NodeShape ;
    sh:property [ sh:description """This attribute specifies the category of a service
requirement/attribute of GST""" ;
            sh:in ( "character" "scalability" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-ns-nrm-common/ServAttrCom/category> ],
        [ sh:description """This attribute specifies the tagging of a service
requirement/attribute of GST in character category""" ;
            sh:in ( "performance" "function" "operation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-ns-nrm-common/ServAttrCom/tagging> ],
        [ sh:description """This attribute specifies exposure mode of a service
requirement/attribute of GST""" ;
            sh:in ( "API" "KPI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-ns-nrm-common/ServAttrCom/exposure> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-ns-nrm-common/ServAttrCom> .

<urn:3gpp:sa5:_3gpp-ns-nrm-common/XLThptShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedLong ;
            sh:description "This attribute describes the guaranteed data rate." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-ns-nrm-common/XLThpt/guaThpt> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "This attribute describes the maximum data rate." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-ns-nrm-common/XLThpt/maxThpt> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-ns-nrm-common/ServAttrCom> ;
            sh:description """This list represents the common properties of service
requirement related attributes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-ns-nrm-common/XLThpt/servAttrCom> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-ns-nrm-common/XLThpt> .

