@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qFQMCtrl3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-QFQoSMonitoringControl#> .
@prefix qFQMCtrl3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-5gc-nrm-QFQoSMonitoringControl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

qFQMCtrl3gpp-shapes:QFPacketDelayThresholdsType a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "Downlink threshold" ;
            sh:maxCount 1 ;
            sh:path qFQMCtrl3gpp:QFPacketDelayThresholdsType.thresholdDl ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Uplink threshold" ;
            sh:maxCount 1 ;
            sh:path qFQMCtrl3gpp:QFPacketDelayThresholdsType.thresholdUl ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Round trip threshold" ;
            sh:maxCount 1 ;
            sh:path qFQMCtrl3gpp:QFPacketDelayThresholdsType.thresholdRtt ] ;
    sh:targetClass qFQMCtrl3gpp:QFPacketDelayThresholdsType .

qFQMCtrl3gpp-shapes:QFQoSMonitoringControl a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.id ],
        [ sh:description "The state of QoS monitoring per QoS flow per UE." ;
            sh:in ( "ENABLED" "DISABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.qFQoSMonitoringState ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """The 5QIs for which the QoS monitoring per QoS flow
per UE is to be performed.""" ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.qFMonitored5QIs ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the event based QoS monitoring
reporting per QoS flow per UE is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.isEventTriggeredQFMonitoringSupported ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the periodic QoS monitoring reporting
per QoS flow per UE is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.isPeriodicQFMonitoringSupported ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the session release based QoS monitoring
reporting  per QoS flow per UE is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.isSessionReleasedQFMonitoringSupported ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the minimum waiting time (in seconds) between
two consecutive reports for event triggered QoS monitoring reporting
per QoS flow per UE.""" ;
            sh:maxCount 1 ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.qFMinimumWaitTime ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the period (in seconds) for reporting the
packet delay for QoS monitoring per QoS flow per UE.""" ;
            sh:maxCount 1 ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.qFMeasurementPeriod ],
        [ sh:class qFQMCtrl3gpp:qFMonitoredSNSSAIs ;
            sh:description """The S-NSSAIs for which the QoS monitoring per QoS flow
per UE is to be performed.""" ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.qFMonitoredSNSSAIs ],
        [ sh:class qFQMCtrl3gpp:QFPacketDelayThresholdsType ;
            sh:description """It specifies the thresholds for reporting the packet delay
between PSA and UE for QoS monitoring per QoS flow per UE.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path qFQMCtrl3gpp:QFQoSMonitoringControl.qFPacketDelayThresholds ] ;
    sh:targetClass qFQMCtrl3gpp:QFQoSMonitoringControl .

qFQMCtrl3gpp-shapes:qFMonitoredSNSSAIs a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path qFQMCtrl3gpp:qFMonitoredSNSSAIs.sd ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path qFQMCtrl3gpp:qFMonitoredSNSSAIs.sst ] ;
    sh:targetClass qFQMCtrl3gpp:qFMonitoredSNSSAIs .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-QFQoSMonitoringControl> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-QFQoSMonitoringControl" ;
    dcterms:description """This IOC represents the capabilities and properties for control
of QoS monitoring per QoS flow per UE for URLLC service defined

in 3GPP TS 23.501.
Copyright 2023, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-QFQoSMonitoringControl" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2023-09-18 (CR-1043)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-QFQoSMonitoringControl" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl> .

