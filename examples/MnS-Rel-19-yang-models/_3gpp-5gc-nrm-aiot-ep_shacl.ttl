<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-aiot-ep" ;
    dcterms:description """Defines AIOT related endpoint Classes (IOCs).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-aiot-ep" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-11-01 (CR-1640)" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/EP_AIOT2Shape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/EP_AIOT2/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/EP_AIOT2/userLabel> ],
        [ sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/EP_AIOT2/farEndEntity> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Remote IP address." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/EP_AIOT2/remoteAddress> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/EP_AIOT2/SupportedPerfMetricGroups> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/localAddress> ;
            sh:description "Local IP address and VLAN ID." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/EP_AIOT2/localAddress> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/EP_AIOT2> .

