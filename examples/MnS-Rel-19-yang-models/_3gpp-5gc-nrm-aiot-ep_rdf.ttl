aiotep3gpp:SupportedPerfMetricGroups a rdfs:Class ;
    rdfs:label "_3gpp-5gc-nrm-aiot-ep:SupportedPerfMetricGroups" ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" .

aiotep3gpp:localAddress a rdfs:Class ;
    rdfs:label "_3gpp-5gc-nrm-aiot-ep:localAddress" ;
    rdfs:comment "Local IP address and VLAN ID." .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-aiot-ep> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-aiot-ep" ;
    dcterms:description """Defines AIOT related endpoint Classes (IOCs).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-aiot-ep" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-11-01 (CR-1640)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-aiot-ep" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep> .

aiotep3gpp:EP_AIOT2.SupportedPerfMetricGroups a owl:ObjectProperty ;
    rdfs:label "EP_AIOT2.SupportedPerfMetricGroups" ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain aiotep3gpp:EP_AIOT2 ;
    rdfs:range aiotep3gpp:SupportedPerfMetricGroups .

aiotep3gpp:EP_AIOT2.farEndEntity a owl:ObjectProperty ;
    rdfs:label "EP_AIOT2.farEndEntity" ;
    rdfs:domain aiotep3gpp:EP_AIOT2 ;
    y2r:isReference true .

