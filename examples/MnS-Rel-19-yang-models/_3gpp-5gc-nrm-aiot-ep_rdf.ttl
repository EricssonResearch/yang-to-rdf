@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

aiotep3gpp:EP_AIOT2 a rdfs:Class ;
    rdfs:label "EP_AIOT2" ;
    rdfs:comment """This IOC represents the AIOT2 interface between NG-RAN and
AIOTF, which is defined in 3GPP TS 23.369.""" ;
    y2r:hasAttribute aiotep3gpp:SupportedPerfMetricGroups,
        aiotep3gpp:localAddress .

aiotep3gpp:EP_AIOT3 a rdfs:Class ;
    rdfs:label "EP_AIOT3" ;
    rdfs:comment """This IOC represents the AIOT3 interface between AMF and
AIOTF, which is defined in 3GPP TS 23.369.""" ;
    y2r:hasAttribute aiotep3gpp:SupportedPerfMetricGroups,
        aiotep3gpp:localAddress .

aiotep3gpp:EP_AIOT4 a rdfs:Class ;
    rdfs:label "EP_AIOT4" ;
    rdfs:comment """This IOC represents the AIOT4 interface between AIOTF and
NEF, which is defined in 3GPP TS 23.369.""" ;
    y2r:hasAttribute aiotep3gpp:SupportedPerfMetricGroups,
        aiotep3gpp:localAddress .

aiotep3gpp:EP_AIOT5 a rdfs:Class ;
    rdfs:label "EP_AIOT5" ;
    rdfs:comment """This IOC represents the AIOT5 interface between AIOTF and
NRF, which is defined in 3GPP TS 23.369.""" ;
    y2r:hasAttribute aiotep3gpp:SupportedPerfMetricGroups,
        aiotep3gpp:localAddress .

aiotep3gpp:EP_AIOT6 a rdfs:Class ;
    rdfs:label "EP_AIOT6" ;
    rdfs:comment """This IOC represents the AIOT6 interface between AIOTF and
ADM, which is defined in 3GPP TS 23.369.""" ;
