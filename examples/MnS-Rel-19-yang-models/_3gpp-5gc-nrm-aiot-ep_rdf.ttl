aiotep3gpp:EP_AIOT8 a rdfs:Class ;
    rdfs:label "EP_AIOT8" ;
    rdfs:comment """This IOC represents the AIOT8 interface between NEF and ADM,
which is defined in 3GPP TS 23.369.""" ;
