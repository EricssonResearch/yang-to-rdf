aiotep3gpp:EP_AIOT7 a rdfs:Class ;
    rdfs:label "EP_AIOT7" ;
    rdfs:comment """This IOC represents the AIOT7 interface between UDR and ADM,
which is defined in 3GPP TS 23.369.""" ;
