    rdfs:range xsd:string .

aiotep3gpp:SupportedPerfMetricGroups.reportingPeriods a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-aiot-ep:SupportedPerfMetricGroups.reportingPeriods" ;
    rdfs:comment """Reporting periods supported for the associated
