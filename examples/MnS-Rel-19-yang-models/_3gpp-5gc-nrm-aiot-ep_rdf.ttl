<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/EP_AIOT2> a rdfs:Class ;
    rdfs:label "EP_AIOT2" ;
    rdfs:comment """This IOC represents the AIOT2 interface between NG-RAN and
AIOTF, which is defined in 3GPP TS 23.369.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/SupportedPerfMetricGroups>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot-ep/localAddress> .

