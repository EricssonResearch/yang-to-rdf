<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-seppfunction" ;
    dcterms:description """This IOC represents the SEPP function which support message filtering
and policing on inter-PLMN control plane interface. For more information about the SEPP, see 3GPP TS 23.501.
Copyright 2023, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-seppfunction" ;
    owl:versionInfo "revision 2023-09-18 (CR-1043)" .

