@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance> a rdfs:Class ;
    rdfs:label "CollocatedNfInstance" ;
    rdfs:comment """It represents information related to collocated NF
type(s) and corresponding NF Instances when the NF is collocated
with NFs supporting other NF types.""" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> a rdfs:Class ;
    rdfs:label "ConditionItem" ;
    rdfs:comment """It represent a single condition item that shall be
evaluated Instance shall be selected.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/gpsiRangeList>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/impiRangeList>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/impuRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> a rdfs:Class ;
    rdfs:label "ManagedNFProfile" ;
    rdfs:comment "Profile definition of a Managed NF (See TS 23.501)" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SelectionConditions>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAIs>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPlmns>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/perPlmnSnssaiList>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnList>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssais>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/supportedVendorSpecificFeatures> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId> a rdfs:Class ;
    rdfs:label "SPNInfoId" ;
    rdfs:comment """SNPN(s) of the Network Function. This attributeIE shall be
present if the NF pertains to one or more SNPNs.""" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SelectionConditions> a rdfs:Class ;
    rdfs:label "SelectionConditions" ;
    rdfs:comment """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> a rdfs:Class ;
    rdfs:label "SupiRange" ;
    rdfs:comment """It represents a set of SUPIs for which
the NF (Service) instance under CANARY_RELEASE status shall
be selected.""" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-managed-nfprofile" ;
    dcterms:description """NF profile class.
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 29.510" ;
    dcterms:title "_3gpp-5gc-nrm-managed-nfprofile" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-07-25 (CR-1558)" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance/nfInstanceId> a rdf:Property ;
    rdfs:label "nfInstanceId" ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance/nfType> a rdf:Property ;
    rdfs:label "nfType" ;
    rdfs:comment "Type of Network Function." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/consumerNfTypes> a rdf:Property ;
    rdfs:label "consumerNfTypes" ;
    rdfs:comment """It represents the NF types of the consumers for
which the conditions included in this ConditionItem apply.
If this attribute is absent, the conditions are applicable
to all NF consumer types.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/dnnList> a rdf:Property ;
    rdfs:label "dnnList" ;
    rdfs:comment """ It represents a set of TAIs where the NF
(Service) instance under CANARY_RELEASE status shall be
selected for a certain UE""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/gpsiRangeList> a owl:ObjectProperty ;
    rdfs:label "gpsiRangeList" ;
    rdfs:comment """It represents a set of GPSIs for which the NF
(Service)
instance under CANARY_RELEASE status shall be selected""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/gpsiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/id> a rdf:Property ;
    rdfs:label "id" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/impiRangeList> a owl:ObjectProperty ;
    rdfs:label "impiRangeList" ;
    rdfs:comment """It represents a set of IMS Private Identities
for which theNF (Service) instance under
CANARY_RELEASE status shall be selected.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/impiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/impuRangeList> a owl:ObjectProperty ;
    rdfs:label "impuRangeList" ;
    rdfs:comment """It represents a set of IMS Public Identities
for which the NF (Service) instance under CANARY_RELEASE
status shall be selected""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/impuRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/peiList> a rdf:Property ;
    rdfs:label "peiList" ;
    rdfs:comment """It represents a set of PEIs of the UEs for
which the NF(Service) instance under CANARY_RELEASE status
shall be selected""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/serviceFeature> a rdf:Property ;
    rdfs:label "serviceFeature" ;
    rdfs:comment """It represents a feature number of that NF Service
Instance,under CANARY_RELEASE status. This attribute only
applies when the          selectionConditions, where this
ConditionItem is included, is included in a NF Service Instance
This condition is evaluated to <true> when the service requests
froma consumer of this NF Service Instance require the support
of the indicated feature on the NF Service Instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/supiRangeList> a owl:ObjectProperty ;
    rdfs:label "supiRangeList" ;
    rdfs:comment """It represents a set of SUPIs for which
the NF (Service) instance under CANARY_RELEASE status shall
be selected.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/taiRangeList> a owl:ObjectProperty ;
    rdfs:label "taiRangeList" ;
    rdfs:comment """It represents a set of TAIs where the
NF(Service) instance under CANARY_RELEASE status shall
be selected for a certain UE""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/vsServiceFeature> a rdf:Property ;
    rdfs:label "vsServiceFeature" ;
    rdfs:comment """It represents a Vendor-Specific feature
number of thatNF Service Instance, under CANARY_RELEASE
status. This attribute only applies when the
selectionConditions, where this ConditionItem is included,
is included in a NF Service Instance.This condition is
evaluated to true when the service requests from a
consumer of this NF Service Instance require the support
of the indicated Vendor-Specific feature on the NF
Service Instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedNSSAIs> a owl:ObjectProperty ;
    rdfs:label "allowedNSSAIs" ;
    rdfs:comment """S-NSSAI of the allowed slices to access the NF instance.
If not provided, any slice is allowed to access the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAIs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedNfDomains> a rdf:Property ;
    rdfs:label "allowedNfDomains" ;
    rdfs:comment """Pattern (regular expression according to the ECMA-262
dialect [75]) representing the NF domain names within the PLMN of
the NRF allowed to access the NF instance If not provided,
any NF domain is allowed to access the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedNfTypes> a rdf:Property ;
    rdfs:label "allowedNfTypes" ;
    rdfs:comment """Type of the NFs allowed to access the NF instance.
If not provided, any NF type is allowed to access the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedPlmns> a owl:ObjectProperty ;
    rdfs:label "allowedPlmns" ;
    rdfs:comment """PLMNs allowed to access the NF instance.
If not provided, any PLMN is allowed to access the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPlmns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedSNPNs> a owl:ObjectProperty ;
    rdfs:label "allowedSNPNs" ;
    rdfs:comment """SNPNs allowed to access the NF instance.
The absence of this attribute in the NF profile indicates that no SNPN,
other than the SNPN(s) registered in the snpnList attribute of the
NF Profile, is allowed to access the service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/authzInfo> a rdf:Property ;
    rdfs:label "authzInfo" ;
    rdfs:comment """This parameter defines NF Specific Service authorization
information. It shall include the NF type (s) and NF realms/origins
allowed to consume NF Service(s) of NF Service Producer """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/canaryPrecedenceOverPreferred> a rdf:Property ;
    rdfs:label "canaryPrecedenceOverPreferred" ;
    rdfs:comment """ManagedNFProfile.canaryPrecedenceOverPreferred  This
attribute indicates whether the NRF shall prioritize the NF Service
Producer in Canary Release condition over the preferences
(preferred-xxx, ext-preferred-xxx) present in NF discovery requests.
allowedValues:
True NRF shall prioritize NF Service Producers in Canary Release
condition at NF discovery requests, i.e. NF Service Producers
determined according to preferred-xxx and/or ext-preferred-xxx
shall be prioritized after the NF Service Producers in Canary
Release condition. The associated NF (service) priorities for Service
Producers in Canary Release condition shall not be modified by NRF.
False NRF shall prioritize the NF Service Producers according to
preferred-xxx and/or ext-preferred-xxx (i.e. Canary Release condition
in NF Service Producers shall not be prioritized over NF Service
Consumer preferences at NF discovery requests)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/canaryRelease> a rdf:Property ;
    rdfs:label "canaryRelease" ;
    rdfs:comment """This attribute indicates whether an NF instance whose
nfStatus is set to REGISTERED is in Canary Release condition,
i.e. it should only be selected by NF Service Consumers under the
conditions indicated by the selectionConditions attribute.
True: the NF is under Canary Release condition, even if the
nfStatus is set to REGISTERED
False: the NF instance indicates its Canary Release condition
via the nfStatus attribute""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/capacity> a rdf:Property ;
    rdfs:label "capacity" ;
    rdfs:comment """Static capacity information in the range of 0-65535,
expressed as a weight relative to other NF instances of
the same type; if capacity is also present in the nfServiceList
parameters, those will have precedence over this value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/collocatedNfInstances> a owl:ObjectProperty ;
    rdfs:label "collocatedNfInstances" ;
    rdfs:comment """It represents information related to collocated NF
type(s) and corresponding NF Instances when the NF is collocated
with NFs supporting other NF types.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/defaultNotificationSubscriptions> a owl:ObjectProperty ;
    rdfs:label "defaultNotificationSubscriptions" ;
    rdfs:comment """Notification endpoints for different notification types.
This attribute may contain multiple default subscriptions for a same
notification type; in that case, those default subscriptions are used
as alternative notification endpoints.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/exclusiveCanaryReleaseSelection> a rdf:Property ;
    rdfs:label "exclusiveCanaryReleaseSelection" ;
    rdfs:comment """This attribute indicates whether an NF Service
Consumer should only select an NF Service Producer in Canary
Release condition.
True: the consumer shall only select producers in Canary Release
condition
False: the consumer may select producers not in Canary Release
condition""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/extLocality> a rdf:Property ;
    rdfs:label "extLocality" ;
    rdfs:comment """It indicates the operator defined information about the
location of the NF instance. The key of the map shall be a (unique)
valid JSON string per clause 7 of IETF RFC 8259 [92], with a maximum
of 32 characters, representing a type of locality as defined in
clause 6.1.6.3.18.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/fqdn> a rdf:Property ;
    rdfs:label "fqdn" ;
    rdfs:comment """FQDN of the Network Function. For AMF, the
FQDN registered with the NRF shall be that of the AMF Name.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/heartBeatTimer> a rdf:Property ;
    rdfs:label "heartBeatTimer" ;
    rdfs:comment """Time in seconds expected between 2 consecutive
heart-beat messages from an NF Instance to the NRF.
It may be included in the registration request.
When present in the request it shall contain the
heartbeat time proposed by the NF service consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/hniList> a rdf:Property ;
    rdfs:label "hniList" ;
    rdfs:comment """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/hostAddr> a rdf:Property ;
    rdfs:label "hostAddr" ;
    rdfs:comment "Host address of a NF" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/interPlmnFqdn> a rdf:Property ;
    rdfs:label "interPlmnFqdn" ;
    rdfs:comment """If the NF needs to be discoverable by other
NFs in a different PLMN, then an FQDN that is used
for inter-PLMN routing is specified.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/lcHSupportInd> a rdf:Property ;
    rdfs:label "lcHSupportInd" ;
    rdfs:comment """This parameter indicates whether the NF supports or does
not support Load Control based on LCI Header.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/load> a rdf:Property ;
    rdfs:label "load" ;
    rdfs:comment """Dynamic load information, ranged from 0 to 100,
indicates the current load percentage of the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/loadTimeStamp> a rdf:Property ;
    rdfs:label "loadTimeStamp" ;
    rdfs:comment """It indicates the point in time in which the latest load
information (sent by the NF in the load attribute of the NF Profile)
was generated at the NF Instance.If the NF did not provide a timestamp,
the NRF should set it to the instant when the NRF received the message
where the NF provided the latest load information.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/locality> a rdf:Property ;
    rdfs:label "locality" ;
    rdfs:comment """Operator defined information about the location
of the NF instance (e.g. geographic location, data center).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfInstanceId> a rdf:Property ;
    rdfs:label "nfInstanceId" ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfInstanceName> a rdf:Property ;
    rdfs:label "nfInstanceName" ;
    rdfs:comment "It represents human readable name of the NF Instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfProfileChangesInd> a rdf:Property ;
    rdfs:label "nfProfileChangesInd" ;
    rdfs:comment """NF Profile Changes Indicator. This IE shall be absent
in the request to the NRF and may be included by the NRF
in NFRegister or NFUpdate (NF Profile Complete Replacement) response.
true: the NF Profile contains NF Profile changes.
false (default): complete NF Profile.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfProfileChangesSupportInd> a rdf:Property ;
    rdfs:label "nfProfileChangesSupportInd" ;
    rdfs:comment """This parameter indicates if the NF Service Consumer supports
or does not support receiving NF Profile Changes. It may be present in
the NFRegister or NFUpdate (NF Profile Complete Replacement) request and
shall be absent in the response (see Annex B 3GPP TS 29.510 [23]).  """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfProfilePartialUpdateChangesSupportInd> a rdf:Property ;
    rdfs:label "nfProfilePartialUpdateChangesSupportInd" ;
    rdfs:comment """It represents NF Profile Partial Update Changes Support
Indicator. TRUE: the NF Service Consumer supports receiving NF Profile
Changes in the response to an NF Profile Partial Update operation.
FALSE (default): the NF Service Consumer does not support receiving
NF Profile Changes in the response to an NF Profile Partial Update
operation""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfServicePersistence> a rdf:Property ;
    rdfs:label "nfServicePersistence" ;
    rdfs:comment """This parameter indicates whether the different service
instances of a same NF Service in the NF instance, supporting a same
API version, are capable to persist their resource state in shared
storage and therefore these resources are available after a new NF
service instance supporting the same API version is selected by a NF
Service Consumer """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfServices> a owl:ObjectProperty ;
    rdfs:label "nfServices" ;
    rdfs:comment """List of NF Service Instances. It shall include
the services produced by the NF that can be
discovered by other NFs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfSetIdList> a rdf:Property ;
    rdfs:label "nfSetIdList" ;
    rdfs:comment """A NF Set Identifier is a globally unique identifier of
a set of equivalent and interchangeable CP NFs from a given network
that provide distribution, redundancy and scalability
(see clause 5.21.3 of 3GPP TS 23.501 [2]).An NF Set Identifier shall
be constructed from the MCC, MNC, NID (for SNPN), NF type and a Set ID.
A NF Set Identifier shall be formatted as the following string:
set<Set ID>.<nftype>set.5gc.mnc<MNC>.mcc<MCC> for a NF Set in a PLMN, or
set<Set ID>.<nftype>set.5gc.nid<NID>.mnc<MNC>.mcc<MCC> for a NF Set
in a SNPN.At most one NF Set ID shall be indicated per PLMN-ID or SNPN
of the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfSetRecoveryTimeList> a rdf:Property ;
    rdfs:label "nfSetRecoveryTimeList" ;
    rdfs:comment """This parameter contains the recovery time of NF Set(s)
indicated by the NfSetId, where the NF instance belongs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfStatus> a rdf:Property ;
    rdfs:label "nfStatus" ;
    rdfs:comment "Status of the NF Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfType> a rdf:Property ;
    rdfs:label "nfType" ;
    rdfs:comment "Type of Network Function." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/olcHSupportInd> a rdf:Property ;
    rdfs:label "olcHSupportInd" ;
    rdfs:comment """This parameter indicates whether the NF supports or does
not support Overload Control based on OCI Header .""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/perPlmnSnssaiList> a owl:ObjectProperty ;
    rdfs:label "perPlmnSnssaiList" ;
    rdfs:comment """It includes the S-NSSAIs supported by the Network Function
for each PLMN supported by the Network Function. When present, it shall
override sNssais IE.If the perPlmnSnssaiList attribute is provided in
at least one NF Service, the S-NSSAIs supported per PLMN in the
NF Profile shall be the set or a superset of the perPlmnSnssaiList
of the NFService(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/perPlmnSnssaiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/plmnList> a owl:ObjectProperty ;
    rdfs:label "plmnList" ;
    rdfs:comment """PLMN(s) of the Network Function.
This IE shall be present if this information
is available for the NF. If not provided, PLMN ID(s)
of the PLMN of the NRF are assumed for the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/recoveryTime> a rdf:Property ;
    rdfs:label "recoveryTime" ;
    rdfs:comment """Timestamp when the NF was (re)started. The NRF shall notify
NFs subscribed to receiving notifications of changes of the NF profile,
if the NF recoveryTime is changed""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/sNPNList> a owl:ObjectProperty ;
    rdfs:label "sNPNList" ;
    rdfs:comment """SNPN(s) of the Network Function. This attributeIE shall be
present if the NF pertains to one or more SNPNs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/sNssais> a owl:ObjectProperty ;
    rdfs:label "sNssais" ;
    rdfs:comment """S-NSSAIs of the Network Function. If not
provided, the NF can serve any S-NSSAI. When present
this IE represents the list of S-NSSAIs supported in
all the PLMNs listed in the plmnList IE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssais> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/scpDomains> a rdf:Property ;
    rdfs:label "scpDomains" ;
    rdfs:comment """This parameter shall carry the list of SCP domains the
SCP belongs to, or the SCP domain the NF (other than SCP) or the SEPP
belongs to..""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/selectionConditions> a owl:ObjectProperty ;
    rdfs:label "selectionConditions" ;
    rdfs:comment """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SelectionConditions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/serviceSetRecoveryTimeList> a rdf:Property ;
    rdfs:label "serviceSetRecoveryTimeList" ;
    rdfs:comment """This parameter contains the recovery time of NF Service
Set(s) configured in the NF instance, which are indicated by the
NfServiceSetId""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/servingScope> a rdf:Property ;
    rdfs:label "servingScope" ;
    rdfs:comment """This parameter indicates the served geographical areas
of a NF instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/sharedProfileDataId> a rdf:Property ;
    rdfs:label "sharedProfileDataId" ;
    rdfs:comment """This attribute indicates a string uniquely identifying
Shared Profile Data. The format of the sharedProfileDataId shall be
a Universally Unique Identifier (UUID) version 4, as described in
IETF RFC 4122 [44]. The hexadecimal letters should be formatted as
lower-case characters by the sender, and they shall be handled as
case-insensitive by the receiver.
Example: 4ace9d34-2c69-4f99-92d5-a73a3fe8e23b""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/shutdownTime> a rdf:Property ;
    rdfs:label "shutdownTime" ;
    rdfs:comment """It indicates the timestamp when the NF Instance is
planned to be shut down. This attribute may be present if the
nfStatus is set to UNDISCOVERABLE due to scheduled shutdown""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/supportedRcfs> a rdf:Property ;
    rdfs:label "supportedRcfs" ;
    rdfs:comment "It represents a list of Resource Content Filter IDs" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/supportedVendorSpecificFeatures> a owl:ObjectProperty ;
    rdfs:label "supportedVendorSpecificFeatures" ;
    rdfs:comment """It indicates a map of Vendor-Specific features, where the
key of the map is the IANA-assigned SMI Network Management Private
Enterprise Codes and the value of each entry of the map shall be
a list (array) of VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/supportedVendorSpecificFeatures> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/vendorId> a rdf:Property ;
    rdfs:label "vendorId" ;
    rdfs:comment """Vendor ID of the NF instance, according to the
IANA-assigned SMI Network Management Private Enterprise Codes [77].
allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits 0 to complete
a 6-digit string value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId/mcc> a rdf:Property ;
    rdfs:label "mcc" ;
    rdfs:comment "Mobile Country Code (MCC) of the SNPN." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId/mnc> a rdf:Property ;
    rdfs:label "mnc" ;
    rdfs:comment "Mobile Network Code (MNC) of the SNPN." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId/nId> a rdf:Property ;
    rdfs:label "nId" ;
    rdfs:comment "Network Identifier (NID) of the SNPN." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SelectionConditions/conditionItem> a owl:ObjectProperty ;
    rdfs:label "conditionItem" ;
    rdfs:comment """It represent a single condition item that shall be
evaluated Instance shall be selected.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SelectionConditions> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange/end> a rdf:Property ;
    rdfs:label "end" ;
    rdfs:comment """Last value identifying the end of a SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g. IMSI ranges).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange/pattern> a rdf:Property ;
    rdfs:label "pattern" ;
    rdfs:comment """Pattern representing the set of SUPI's belonging to
this range.A SUPI value is considered part of the range if and
only if the SUPI string fully matches the regular expression.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange/start> a rdf:Property ;
    rdfs:label "start" ;
    rdfs:comment """First value identifying the start ofa SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g., IMSI ranges).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> ;
    rdfs:range xsd:string .

