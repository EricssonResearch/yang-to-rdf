@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> a rdfs:Class ;
    rdfs:comment "This is the list of Ephemeris related information." ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital>,
        <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSet> a rdfs:Class ;
    rdfs:comment """This IOC represents the satellite ephemeris information
describing the orbital trajectory information or coordinates for the
NTN vehicles.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig> a rdfs:Class ;
    rdfs:comment """It contains a list of configuration
updates to be applied to specified NTN entities.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction> a rdfs:Class ;
    rdfs:comment """This IOC contains attributes to support the non-terrestrial
NR access.  This IOC contains instances of NTNTimeBasedConfig to support
time-based configuration of the following NTN related entities:
EP_NgC, NRCellCU, NRCellDU, NRSectorCarrier, SectorEquipmentFunction,
and NRCellRelation.  The IP Configuration of the feeder links may be
configured via IP Autoconfiguration services [x] and/or configured via
instances of NTNTimeBasedConfig in anticipation of feeder link
switchovers.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList> ;
    nrm:nameContains <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSet>,
        <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig> a rdfs:Class ;
    rdfs:comment """This IOC represents the NTN time-based configuration.
""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow>,
        <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> a rdfs:Class ;
    rdfs:comment """It indicates ephemeris is in orbital parameter ephemeris
format, as specified in NIMA TR 8350.2""" .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> a rdfs:Class ;
    rdfs:comment """It indicates ephemeris is in format of NTN payload
position and velocity state vectors.""" .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList> a rdfs:Class ;
    rdfs:comment """Specifies the list of configuration parameters and values.
The content of the attribute is a list of attributeName- attributeValue
pairs.  AttributeValues may be complex types.""" .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList> a rdfs:Class ;
    rdfs:comment """It defines which PLMNs that can be served by the NR NTN cell,
and which S-NSSAIs can be supported by the NR NTN cell for
corresponding PLMN in case of network slicing feature is supported.
The pLMNId of the first entry of the list is the PLMNId used to
construct the nCGI for the NR cell.""" .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction> a owl:Ontology ;
    owl:versionInfo "revision 2026-02-02 (CR-1682 CR-1683)" .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris/epochTime> a rdf:Property ;
    rdfs:comment "It defines the ephemeris reference time." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris/orbital> a owl:ObjectProperty ;
    rdfs:comment """It indicates ephemeris is in orbital parameter ephemeris
format, as specified in NIMA TR 8350.2""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris/positionVelocity> a owl:ObjectProperty ;
    rdfs:comment """It indicates ephemeris is in format of NTN payload
position and velocity state vectors.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris/satelliteId> a rdf:Property ;
    rdfs:comment """This attribute indicates satellite Id.number.
It shall be formatted as a fixed 5-digit string, padding with
leading digits '0' to complete a 5-digit length.
allowedValues: 00000..00255""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSet/EphemerisInfos> a owl:ObjectProperty ;
    rdfs:comment "This is the list of Ephemeris related information." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSet> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSet/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSet> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig/nTNConfEntity> a owl:ObjectProperty ;
    rdfs:comment """Specifies the DN of a specific NTN related MOI.
allowedValues:  DN of of the following MOIs:
EP_NgC, NRCellCU, NRCellDU, NRSectorCarrier,
SectorEquipmentFunction, NRCellRelation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig/nTNConfigList> a owl:ObjectProperty ;
    rdfs:comment """Specifies the list of configuration parameters and values.
The content of the attribute is a list of attributeName- attributeValue
pairs.  AttributeValues may be complex types.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction/nTNTAClist> a rdf:Property ;
    rdfs:comment """It is the list of Tracking Area Codes (either legacy TAC or
extended TAC) for NR NTN.
Legacy TAC and Extended TAC are defined in clause 9.3.3.10 of
TS 38.413.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction/nTNpLMNInfoList> a owl:ObjectProperty ;
    rdfs:comment """It defines which PLMNs that can be served by the NR NTN cell,
and which S-NSSAIs can be supported by the NR NTN cell for
corresponding PLMN in case of network slicing feature is supported.
The pLMNId of the first entry of the list is the PLMNId used to
construct the nCGI for the NR cell.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig/nTNEntityConfigList> a owl:ObjectProperty ;
    rdfs:comment """It contains a list of configuration
updates to be applied to specified NTN entities.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig/timeWindow> a owl:ObjectProperty ;
    rdfs:comment "It defines the time window." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/eccentricity> a rdf:Property ;
    rdfs:comment """Satellite orbital parameter: eccentricity e,
see NIMA TR 8350.2.
Step 1.431 * 10**-8.
Actual value = field value * (1.431 * 10**-8).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/inclination> a rdf:Property ;
    rdfs:comment """Satellite orbital parameter: inclination i,
see NIMA TR 8350.2.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/longitude> a rdf:Property ;
    rdfs:comment """Satellite orbital parameter: longitude of ascending node
OMEGA, see NIMA TR 8350.2.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/meanAnomaly> a rdf:Property ;
    rdfs:comment """Satellite orbital parameter: Mean anomaly M at epoch time,
see NIMA TR 8350.2.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/periapsis> a rdf:Property ;
    rdfs:comment """Satellite orbital parameter: argument of periapsis omega,
see NIMA TR 8350.2.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/semiMajorAxis> a rdf:Property ;
    rdfs:comment """Satellite orbital parameter: semi major axis alpha,
see NIMA TR 8350.2.
Step of 4.249 * 10**-3 m.
Actual value = 6500000 + field value * (4.249 * 10**-3).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/positionX> a rdf:Property ;
    rdfs:comment """X, Y, Z coordinate of satellite position state vector
in ECEF. Unit is meter.
Step of 1.3 m. Actual value = field value * 1.3.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/positionY> a rdf:Property ;
    rdfs:comment """X, Y, Z coordinate of satellite position state vector
in ECEF. Unit is meter.
Step of 1.3 m. Actual value = field value * 1.3.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/positionZ> a rdf:Property ;
    rdfs:comment """X, Y, Z coordinate of satellite position state vector
in ECEF. Unit is meter.
Step of 1.3 m. Actual value = field value * 1.3.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/velocityVX> a rdf:Property ;
    rdfs:comment """X, Y, Z coordinate of satellite velocity state vector
in ECEF.
Step of 0.06 m/s. Actual value = field value * 0.06.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/velocityVY> a rdf:Property ;
    rdfs:comment """X, Y, Z coordinate of satellite velocity state vector
in ECEF.
Step of 0.06 m/s. Actual value = field value * 0.06.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/velocityVZ> a rdf:Property ;
    rdfs:comment """X, Y, Z coordinate of satellite velocity state vector
in ECEF.
Step of 0.06 m/s. Actual value = field value * 0.06.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList/name> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList/value> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList> ;
    rdfs:range xsd:unsignedByte .

