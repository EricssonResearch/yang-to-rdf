ntn3gpp:NTNEntityConfig a rdfs:Class ;
    rdfs:label "NTNEntityConfig" ;
    rdfs:comment """It contains a list of configuration
updates to be applied to specified NTN entities.""" ;
    y2r:hasAttribute ntn3gpp:nTNConfigList .

ntn3gpp:NTNFunction a rdfs:Class ;
    rdfs:label "NTNFunction" ;
    rdfs:comment """This IOC contains attributes to support the non-terrestrial
NR access.  This IOC contains instances of NTNTimeBasedConfig to support
time-based configuration of the following NTN related entities:
EP_NgC, NRCellCU, NRCellDU, NRSectorCarrier, SectorEquipmentFunction,
and NRCellRelation.  The IP Configuration of the feeder links may be
configured via IP Autoconfiguration services [x] and/or configured via
instances of NTNTimeBasedConfig in anticipation of feeder link
switchovers.""" ;
    y2r:hasAttribute ntn3gpp:nTNpLMNInfoList ;
    y2r:nameContains ntn3gpp:EphemerisInfoSet,
        ntn3gpp:NTNTimeBasedConfig .

ntn3gpp:NTNTimeBasedConfig a rdfs:Class ;
    rdfs:label "_3gpp-nr-nrm-ntnfunction:NTNTimeBasedConfig" ;
    rdfs:comment """This IOC represents the NTN time-based configuration.
""" ;
    y2r:hasAttribute types3gpp:TimeWindow,
        ntn3gpp:NTNEntityConfig .

ntn3gpp:Orbital a rdfs:Class ;
    rdfs:label "Orbital" ;
    rdfs:comment """It indicates ephemeris is in orbital parameter ephemeris
format.""" .

ntn3gpp:PositionVelocity a rdfs:Class ;
    rdfs:label "PositionVelocity" ;
    rdfs:comment """It indicates ephemeris is in format of NTN payload
position and velocity state vectors.""" .

ntn3gpp:nTNConfigList a rdfs:Class ;
    rdfs:label "nTNConfigList" ;
    rdfs:comment """Specifies the list of configuration parameters and values.
The content of the attribute is a list of attributeName- attributeValue
pairs.  AttributeValues may be complex types.""" .

ntn3gpp:nTNpLMNInfoList a rdfs:Class ;
    rdfs:label "nTNpLMNInfoList" ;
    rdfs:comment """It defines which PLMNs that can be served by the NR NTN cell,
and which S-NSSAIs can be supported by the NR NTN cell for
corresponding PLMN in case of network slicing feature is supported.
The pLMNId of the first entry of the list is the PLMNId used to
construct the nCGI for the NR cell.""" .

