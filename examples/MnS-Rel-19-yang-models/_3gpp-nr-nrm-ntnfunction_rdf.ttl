ntn3gpp:Orbital.eccentricity a rdf:Property ;
    rdfs:label "Orbital.eccentricity" ;
    rdfs:comment """Satellite orbital parameter: eccentricity e.
Step 1.431 * 10**-8.
Actual value = field value * (1.431 * 10**-8).""" ;
    rdfs:domain ntn3gpp:Orbital ;
    rdfs:range xsd:int .

ntn3gpp:Orbital.inclination a rdf:Property ;
    rdfs:label "Orbital.inclination" ;
    rdfs:comment """Satellite orbital parameter: inclination i.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
    rdfs:domain ntn3gpp:Orbital ;
    rdfs:range xsd:int .

ntn3gpp:Orbital.longitude a rdf:Property ;
    rdfs:label "Orbital.longitude" ;
    rdfs:comment """Satellite orbital parameter: longitude of ascending node
omega.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
    rdfs:domain ntn3gpp:Orbital ;
    rdfs:range xsd:unsignedInt .

ntn3gpp:Orbital.meanAnomaly a rdf:Property ;
    rdfs:label "Orbital.meanAnomaly" ;
    rdfs:comment """Satellite orbital parameter: Mean anomaly M at epoch time.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
    rdfs:domain ntn3gpp:Orbital ;
    rdfs:range xsd:unsignedInt .

ntn3gpp:Orbital.periapsis a rdf:Property ;
    rdfs:label "Orbital.periapsis" ;
    rdfs:comment """Satellite orbital parameter: argument of periapsis omega.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
    rdfs:domain ntn3gpp:Orbital ;
    rdfs:range xsd:unsignedInt .

ntn3gpp:Orbital.semiMajorAxis a rdf:Property ;
    rdfs:label "Orbital.semiMajorAxis" ;
    rdfs:comment """Satellite orbital parameter: semi major axis alpha.
Step of 4.249 * 10**-3 m.
Actual value = 6500000 + field value * (4.249 * 10**-3).""" ;
    rdfs:domain ntn3gpp:Orbital ;
    rdfs:range xsd:unsignedLong .

