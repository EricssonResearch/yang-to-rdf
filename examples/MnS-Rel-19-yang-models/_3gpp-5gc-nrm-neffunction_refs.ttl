<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-neffunction> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-neffunction" ;
    dcterms:description """This IOC represents the NEF function in 5GC. For more
information about the NEF, see 3GPP TS 23.501.
Copyright 2026, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-neffunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-03-25 (CR-1694)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-neffunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction> .

nef3gpp:File.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

nef3gpp:Files.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

nef3gpp:PerfMetricJob.conditionMonitorRef rdfs:range util3gpp:ConditionMonitor ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

nef3gpp:PerfMetricJob.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

nef3gpp:PerfMetricJob.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

nef3gpp:PerfMetricJob.schedulerRef rdfs:range util3gpp:Scheduler ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

nef3gpp:StmCtrl.reportingNFList y2r:candidate "ReportingNF" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

nef3gpp:ThresholdMonitor.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

nef3gpp:ThresholdMonitor.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

