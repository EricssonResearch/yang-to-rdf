@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-externalnrffunction" ;
    dcterms:description """This IOC represents external NRF function controlled
by another management domain.
Copyright 2023, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:title "_3gpp-5gc-nrm-externalnrffunction" ;
    owl:versionInfo "revision 2023-09-18 (CR-1043)" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/jobRef> nrm:candidate "Job" ;
    nrm:confidence "unresolved" ;
    nrm:inferredBy "dn-name-suffix" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/Files/jobRef> nrm:candidate "Job" ;
    nrm:confidence "unresolved" ;
    nrm:inferredBy "dn-name-suffix" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/conditionMonitorRef> rdfs:range <urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor> ;
    nrm:confidence "unambiguous" ;
    nrm:inferredBy "dn-name-suffix" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/objectInstances> nrm:candidate "ObjectInstances" ;
    nrm:confidence "unresolved" ;
    nrm:inferredBy "dn-name-suffix" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/rootObjectInstances> nrm:candidate "RootObjectInstances" ;
    nrm:confidence "unresolved" ;
    nrm:inferredBy "dn-name-suffix" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/schedulerRef> rdfs:range <urn:3gpp:sa5:_3gpp-common-util/Scheduler> ;
    nrm:confidence "unambiguous" ;
    nrm:inferredBy "dn-name-suffix" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl/reportingNFList> nrm:candidate "ReportingNF" ;
    nrm:confidence "unresolved" ;
    nrm:inferredBy "dn-name-suffix" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor/objectInstances> nrm:candidate "ObjectInstances" ;
    nrm:confidence "unresolved" ;
    nrm:inferredBy "dn-name-suffix" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor/rootObjectInstances> nrm:candidate "RootObjectInstances" ;
    nrm:confidence "unresolved" ;
    nrm:inferredBy "dn-name-suffix" .

