@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix extnrf3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-externalnrffunction#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix util3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-util#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-externalnrffunction> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-externalnrffunction" ;
    dcterms:description """This IOC represents external NRF function controlled
by another management domain.
Copyright 2023, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:title "_3gpp-5gc-nrm-externalnrffunction" ;
    owl:versionInfo "revision 2023-09-18 (CR-1043)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-externalnrffunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction> .

extnrf3gpp:File.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

extnrf3gpp:Files.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

extnrf3gpp:PerfMetricJob.conditionMonitorRef rdfs:range util3gpp:ConditionMonitor ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

extnrf3gpp:PerfMetricJob.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

extnrf3gpp:PerfMetricJob.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

extnrf3gpp:PerfMetricJob.schedulerRef rdfs:range util3gpp:Scheduler ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

extnrf3gpp:StmCtrl.reportingNFList y2r:candidate "ReportingNF" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

extnrf3gpp:ThresholdMonitor.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

extnrf3gpp:ThresholdMonitor.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

