@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dmrof3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-dmrofunction#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

dmrof3gpp:DMROFunction a rdfs:Class ;
    rdfs:label "DMROFunction" ;
    rdfs:comment """This IOC contains attributes to support the D-SON function
of MRO.

In the case where multiple DMRO MOIs exist at different levels of the
containment tree, the DMRO MOI at the lower level overrides the DMRO
MOIs at higher level(s) of the same containment tree.""" .

<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-dmrofunction> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-dmrofunction" ;
    dcterms:description """Defines the YANG mapping of the DMROFunction
Information Object Class (IOC) that is part of the NR Network Resource
Model (NRM).
Copyright 2024, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-dmrofunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2024-08-07 (CR-1331)" ;
    y2r:yangModuleName "_3gpp-nr-nrm-dmrofunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction> .

dmrof3gpp:DMROFunction.aIMLInferenceFunctionRefList a owl:ObjectProperty ;
    rdfs:label "DMROFunction.aIMLInferenceFunctionRefList" ;
    rdfs:comment """This attribute holds a DN list of AIMLInferenceFunction
(See TS 28.105) .""" ;
    rdfs:domain dmrof3gpp:DMROFunction ;
    y2r:isReference true .

dmrof3gpp:DMROFunction.dmroControl a rdf:Property ;
    rdfs:label "DMROFunction.dmroControl" ;
    rdfs:comment """This attribute determines whether the MRO function is
enabled or disabled.""" ;
    rdfs:domain dmrof3gpp:DMROFunction ;
    rdfs:range xsd:boolean .

dmrof3gpp:DMROFunction.id a rdf:Property ;
    rdfs:label "DMROFunction.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain dmrof3gpp:DMROFunction ;
    rdfs:range xsd:string .

dmrof3gpp:DMROFunction.mLModelRefList a owl:ObjectProperty ;
    rdfs:label "DMROFunction.mLModelRefList" ;
    rdfs:comment """This attribute holds a DN list of MLModel ¨
(See TS 28.105).""" ;
    rdfs:domain dmrof3gpp:DMROFunction ;
    y2r:isReference true .

dmrof3gpp:DMROFunction.maximumDeviationHoTriggerHigh a rdf:Property ;
    rdfs:label "DMROFunction.maximumDeviationHoTriggerHigh" ;
    rdfs:comment """This parameter defines the maximum allowed upper
deviation of the Handover Trigger, from the default point of
operation.""" ;
    rdfs:domain dmrof3gpp:DMROFunction ;
    rdfs:range xsd:int .

dmrof3gpp:DMROFunction.maximumDeviationHoTriggerLow a rdf:Property ;
    rdfs:label "DMROFunction.maximumDeviationHoTriggerLow" ;
    rdfs:comment """This parameter defines the maximum allowed lower
deviation of the Handover Trigger, from the default point of
operation.""" ;
    rdfs:domain dmrof3gpp:DMROFunction ;
    rdfs:range xsd:int .

dmrof3gpp:DMROFunction.minimumTimeBetweenHoTriggerChange a rdf:Property ;
    rdfs:label "DMROFunction.minimumTimeBetweenHoTriggerChange" ;
    rdfs:comment """This parameter defines the minimum allowed time interval
between two Handover Trigger change performed by MRO. This is used to
control the stability and convergence of the algorithm.""" ;
    rdfs:domain dmrof3gpp:DMROFunction ;
    rdfs:range xsd:unsignedInt .

dmrof3gpp:DMROFunction.tstoreUEcntxt a rdf:Property ;
    rdfs:label "DMROFunction.tstoreUEcntxt" ;
    rdfs:comment """The timer used for detection of too early HO, too late HO
and HO to wrong cell.""" ;
    rdfs:domain dmrof3gpp:DMROFunction ;
    rdfs:range xsd:unsignedInt .

