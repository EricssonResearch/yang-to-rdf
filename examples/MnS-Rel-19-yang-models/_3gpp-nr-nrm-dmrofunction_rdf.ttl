@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction> a rdfs:Class ;
    rdfs:comment """This IOC contains attributes to support the D-SON function
of MRO.

In the case where multiple DMRO MOIs exist at different levels of the
containment tree, the DMRO MOI at the lower level overrides the DMRO
MOIs at higher level(s) of the same containment tree.""" .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction> a owl:Ontology .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction/aIMLInferenceFunctionRefList> a owl:ObjectProperty ;
    rdfs:comment """This attribute holds a DN list of AIMLInferenceFunction
(See TS 28.105) .""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction/dmroControl> a rdf:Property ;
    rdfs:comment """This attribute determines whether the MRO function is
enabled or disabled.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction/mLModelRefList> a owl:ObjectProperty ;
    rdfs:comment """This attribute holds a DN list of MLModel ¨
(See TS 28.105).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction/maximumDeviationHoTriggerHigh> a rdf:Property ;
    rdfs:comment """This parameter defines the maximum allowed upper
deviation of the Handover Trigger, from the default point of
operation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction/maximumDeviationHoTriggerLow> a rdf:Property ;
    rdfs:comment """This parameter defines the maximum allowed lower
deviation of the Handover Trigger, from the default point of
operation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction/minimumTimeBetweenHoTriggerChange> a rdf:Property ;
    rdfs:comment """This parameter defines the minimum allowed time interval
between two Handover Trigger change performed by MRO. This is used to
control the stability and convergence of the algorithm.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction/tstoreUEcntxt> a rdf:Property ;
    rdfs:comment """The timer used for detection of too early HO, too late HO
and HO to wrong cell.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dmrofunction/DMROFunction> ;
    rdfs:range xsd:unsignedInt .

