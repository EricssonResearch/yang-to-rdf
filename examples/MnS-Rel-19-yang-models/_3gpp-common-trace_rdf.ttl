    rdfs:domain trace3gpp:EventTriggerConfig ;
    rdfs:range xsd:int .

trace3gpp:EventTriggerConfig.thresholdRAN a rdf:Property ;
    rdfs:label "EventTriggerConfig.thresholdRAN" ;
    rdfs:comment """Threshold parameter for an event. It is used to define the
entering and leaving condition of the event. For further details see
RSRP-Range in TS 38.331. See also clause 5.10.45 of TS 32.422""" ;
    rdfs:domain trace3gpp:EventTriggerConfig ;
    rdfs:range xsd:unsignedByte .

trace3gpp:EventTriggerConfig.timeToTriggerRAN a rdf:Property ;
    rdfs:label "EventTriggerConfig.timeToTriggerRAN" ;
    rdfs:comment """It defines the time during which specific criteria for the
event needs to be met in order to trigger an action.
For further details see TimeToTrigger in TS 38.331 and clause 5.10.45 of TS 32.422.""" ;
    rdfs:domain trace3gpp:EventTriggerConfig ;
    rdfs:range xsd:string .

