trace3gpp:EventTriggerConfig.eventType a rdf:Property ;
    rdfs:label "EventTriggerConfig.eventType" ;
    rdfs:comment """It indicates the event type. Either Event A1 or Event A2
can be configured. See also clause 5.10.45 of TS 32.422.""" ;
    rdfs:domain trace3gpp:EventTriggerConfig ;
    rdfs:range xsd:string .

trace3gpp:EventTriggerConfig.hysteresisRAN a rdf:Property ;
    rdfs:label "EventTriggerConfig.hysteresisRAN" ;
    rdfs:comment """Hysteresis parameter for an event. It is used to define the
entering and leaving condition of the event. For further details see
Hysteresis in TS 38.331. See also clause 5.10.45 of TS 32.422""" ;
    rdfs:domain trace3gpp:EventTriggerConfig ;
    rdfs:range xsd:unsignedByte .

trace3gpp:EventTriggerConfig.measurementQuantityRAN a rdf:Property ;
    rdfs:label "EventTriggerConfig.measurementQuantityRAN" ;
    rdfs:comment """It indicates the measurement quantity. For further details
