trace3gpp:ImmediateMdtConfig.collectionPeriodM6LTE a rdf:Property ;
    rdfs:label "ImmediateMdtConfig.collectionPeriodM6LTE" ;
    rdfs:comment """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
    rdfs:domain trace3gpp:ImmediateMdtConfig ;
    rdfs:range xsd:unsignedInt .

trace3gpp:ImmediateMdtConfig.collectionPeriodM6NR a rdf:Property ;
    rdfs:label "ImmediateMdtConfig.collectionPeriodM6NR" ;
    rdfs:comment """It specifies the collection period for the Packet Delay
