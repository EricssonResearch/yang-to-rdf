trace3gpp:ImmediateMdtConfig.collectionPeriodRRMLTE a rdf:Property ;
    rdfs:label "ImmediateMdtConfig.collectionPeriodRRMLTE" ;
    rdfs:comment """Specifies the collection period for collecting RRM configured
