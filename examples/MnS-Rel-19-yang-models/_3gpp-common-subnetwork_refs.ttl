@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix subnet3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-subnetwork#> .
@prefix util3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-util#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

<https://semantics.ericsson.com/yang/_3gpp-common-subnetwork> a owl:Ontology ;
    rdfs:label "_3gpp-common-subnetwork" ;
    dcterms:description """Defines basic SubNetwork which will be augmented by other IOCs
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source """3GPP TS 28.623
Generic Network Resource Model (NRM)
Integration Reference Point (IRP);
Solution Set (SS) definitions

3GPP TS 28.622
Generic Network Resource Model (NRM)
Integration Reference Point (IRP);
Information Service (IS)

3GPP TS 28.620
Umbrella Information Model (UIM)""" ;
    dcterms:title "_3gpp-common-subnetwork" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-08-13 (CR-0561)" ;
    y2r:yangModuleName "_3gpp-common-subnetwork" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-common-subnetwork> .

subnet3gpp:AlarmList.unreliableAlarmScope y2r:candidate "UnreliableAlarmScope" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:File.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:Files.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:PerfMetricJob.conditionMonitorRef rdfs:range util3gpp:ConditionMonitor ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:PerfMetricJob.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:PerfMetricJob.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:PerfMetricJob.schedulerRef rdfs:range util3gpp:Scheduler ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:StmCtrl.reportingNFList y2r:candidate "ReportingNF" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:SubNetwork.dnPrefix y2r:candidate "DnPrefix" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:ThresholdMonitor.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

subnet3gpp:ThresholdMonitor.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

