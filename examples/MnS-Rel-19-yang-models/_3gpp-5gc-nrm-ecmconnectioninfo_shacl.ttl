@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix econn3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-ecmconnectioninfo#> .
@prefix econn3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-5gc-nrm-ecmconnectioninfo#> .
@prefix me3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-managed-element#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix types3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-yang-types#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

econn3gpp-shapes:GeoLoc a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path econn3gpp:GeoLoc.civicLocations ],
        [ sh:class me3gpp:geographicalCoordinates ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.8).""" ;
            sh:maxCount 1 ;
            sh:path econn3gpp:GeoLoc.geographicalCoordinates ] ;
    sh:targetClass econn3gpp:GeoLoc .

econn3gpp-shapes:ServingLocation a sh:NodeShape ;
    sh:property [ sh:class econn3gpp:GeoLoc ;
            sh:description """This refers to the Geographical Service Area,
(see clause 7.3.3.3 in TS 23.558 that is defined as a datatype
(see clause 6.3.4).""" ;
            sh:maxCount 1 ;
            sh:path econn3gpp:ServingLocation.geographicalLocation ],
        [ sh:class econn3gpp:TopologicalServiceArea ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.7). """ ;
            sh:maxCount 1 ;
            sh:path econn3gpp:ServingLocation.topologicalLocation ] ;
    sh:targetClass econn3gpp:ServingLocation .

econn3gpp-shapes:TopologicalServiceArea a sh:NodeShape ;
    sh:property [ sh:datatype xsd:int ;
            sh:description """It represents the list of NR cells.

The cell ID, together with the gNB Identifier (using gNBId of the
parent GNBCUCPFunction or GNBDUFunction or ExternalCUCPFunction),
identifies a NR cell within a PLMN. This is the NR Cell Identity(NCI).
See subclause 8.2 of TS 38.300""" ;
            sh:path econn3gpp:TopologicalServiceArea.cellIDList ],
        [ sh:class types3gpp:Tai ;
            sh:description "It represents the list of tracking areas within a PLMN." ;
            sh:minCount 1 ;
            sh:path econn3gpp:TopologicalServiceArea.trackingAreaIdList ],
        [ sh:class me3gpp:servingPLMN ;
            sh:description "It specifies the PLMN to be served." ;
            sh:maxCount 1 ;
            sh:path econn3gpp:TopologicalServiceArea.servingPLMN ] ;
    sh:targetClass econn3gpp:TopologicalServiceArea .

econn3gpp-shapes:UPFConnInfo a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of an UPF instance,
It can be IP address (either IPv4 address (See RFC 791) or
IPv6 address (See RFC 2373) or FQDN (See TS 23.003). """ ;
            sh:maxCount 1 ;
            sh:path econn3gpp:UPFConnInfo.uPFIpAddress ],
        [ sh:description "This attribute holds the DN of an UPF instance." ;
            sh:maxCount 1 ;
            sh:path econn3gpp:UPFConnInfo.uPFRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass econn3gpp:UPFConnInfo .

econn3gpp-shapes:_5GCNfConnEcmInfo a sh:NodeShape ;
    sh:property [ sh:description "It indicates the type of a NF instance." ;
            sh:in ( "PCF" "NEF" "SCEF" ) ;
            sh:maxCount 1 ;
            sh:path econn3gpp:_5GCNfConnEcmInfo._5GCNFType ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of a NF instance,
It can be IP address (either IPv4 address (See RFC 791) or
IPv6 address (See RFC 2373) or FQDN (See TS 23.003). """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path econn3gpp:_5GCNfConnEcmInfo._5GCNFIpAddress ],
        [ sh:description "This attribute holds the DN of a NF instance." ;
            sh:maxCount 1 ;
            sh:path econn3gpp:_5GCNfConnEcmInfo._5GCNFRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass econn3gpp:_5GCNfConnEcmInfo .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-ecmconnectioninfo> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-ecmconnectioninfo" ;
    dcterms:description """Defines the YANG mapping of the EcmConnectionInfo Information
Object Class (IOC) that is part of the NR Network Resource Model (NRM).
Copyright 2024, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-5gc-nrm-ecmconnectioninfo" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2024-01-29 (CR-1166)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-ecmconnectioninfo" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo> .

