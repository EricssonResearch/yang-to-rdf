@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix extgnbcucp3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-externalgnbcucpfunction#> .
@prefix extgnbcuup3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-externalgnbcuupfunction#> .
@prefix extgnbdu3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-externalgnbdufunction#> .
@prefix nrfreq3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nrfrequency#> .
@prefix nrnet3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nrnetwork#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

nrnet3gpp:NRNetwork a rdfs:Class ;
    rdfs:label "NRNetwork" ;
    rdfs:comment """Represents a set of NR frequencies and external NR entities
(e.g. ExternalGNBCUCPFunction). This is used to differentiate these
entities and frequencies from those in EUTRAN.""" ;
    y2r:nameContains extgnbcucp3gpp:ExternalGNBCUCPFunction,
        extgnbcuup3gpp:ExternalGNBCUUPFunction,
        extgnbdu3gpp:ExternalGNBDUFunction,
        nrfreq3gpp:NRFrequency .

<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nrnetwork> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-nrnetwork" ;
    dcterms:description """Defines the YANG mapping of the NRNetwork Information Object
Class (IOC) that is part of the NR Network Resource Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-nrnetwork" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-04-25 (CR-1526 CR-1527)" ;
    y2r:yangModuleName "_3gpp-nr-nrm-nrnetwork" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-nr-nrm-nrnetwork> .

nrnet3gpp:NRNetwork.id a rdf:Property ;
    rdfs:label "NRNetwork.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain nrnet3gpp:NRNetwork ;
    rdfs:range xsd:string .

