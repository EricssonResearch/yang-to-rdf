@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns3cmn3gpp: <https://semantics.ericsson.com/yang/_3gpp-ns-nrm-common#> .
@prefix ns3gpp: <https://semantics.ericsson.com/yang/_3gpp-ns-nrm-networkslice#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

ns3gpp:NetworkSlice a rdfs:Class ;
    rdfs:label "NetworkSlice" ;
    rdfs:comment """Represents the properties of a network slice instance in
a 5G network.""" ;
    y2r:hasAttribute ns3gpp:ServiceProfile .

ns3gpp:ServiceProfile a rdfs:Class ;
    rdfs:label "ServiceProfile" ;
    rdfs:comment """A list of service profiles supported by the network
slice instance.""" ;
    y2r:hasAttribute ns3cmn3gpp:XLThpt,
        ns3gpp:delayTolerance,
        ns3gpp:deterministicComm,
        ns3gpp:kPIMonitoring,
        ns3gpp:maxNumberofPDUSessions,
        ns3gpp:maxPktSize,
        ns3gpp:nBIoT,
        ns3gpp:pLMNIdList,
        ns3gpp:sNSSAIList,
        ns3gpp:termDensity,
        ns3gpp:userMgmtOpen,
        ns3gpp:v2XCommModels .

ns3gpp:delayTolerance a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslice:delayTolerance" ;
    rdfs:comment """An attribute specifies the properties of service delivery
flexibility, especially for the vertical services that are not
chasing a high system performance.""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

ns3gpp:deterministicComm a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslice:deterministicComm" ;
    rdfs:comment """This list represents the properties of the deterministic
communication for periodic user traffic. Periodic traffic refers to the
type of traffic with periodic transmissions.""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

ns3gpp:kPIMonitoring a rdfs:Class ;
    rdfs:label "kPIMonitoring" ;
    rdfs:comment "Represents performance monitoring" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

ns3gpp:maxNumberofPDUSessions a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslice:maxNumberofPDUSessions" ;
    rdfs:comment """Represents the maximum number of
concurrent PDU sessions supported by the network slice""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

ns3gpp:maxPktSize a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslice:maxPktSize" ;
    rdfs:comment """This parameter specifies the maximum packet size
supported by the network slice""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

ns3gpp:nBIoT a rdfs:Class ;
    rdfs:label "nBIoT" ;
    rdfs:comment """An attribute specifies whether NB-IoT is supported in
the RAN in the network slice""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

ns3gpp:pLMNIdList a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslice:pLMNIdList" ;
    rdfs:comment "List of PLMN IDs." .

ns3gpp:sNSSAIList a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslice:sNSSAIList" ;
    rdfs:comment """The S-NSSAI list to be supported by the new NSI to be
created or the existing NSI to be re-used.""" .

ns3gpp:termDensity a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslice:termDensity" ;
    rdfs:comment """An attribute specifies the overall user density over
the coverage area of the network slice""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

ns3gpp:userMgmtOpen a rdfs:Class ;
    rdfs:label "userMgmtOpen" ;
    rdfs:comment """An attribute specifies whether or not the network slice
supports the capability for the NSC to manage their users or groups
of users' network services and corresponding requirements.""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

ns3gpp:v2XCommModels a rdfs:Class ;
    rdfs:label "v2XCommModels" ;
    rdfs:comment """An attribute specifies whether or not the V2X
communication mode is supported by the network slice.""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

<https://semantics.ericsson.com/yang/_3gpp-ns-nrm-networkslice> a owl:Ontology ;
    rdfs:label "_3gpp-ns-nrm-networkslice" ;
    dcterms:description """A network slice instance in a 5G network.
Copyright 2023, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source """3GPP TS 28.541
Management and orchestration;
5G Network Resource Model (NRM);
Information model definitions for network slice NRM (chapter 6)
""" ;
    dcterms:title "_3gpp-ns-nrm-networkslice" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2023-09-18 (CR-1043)" ;
    y2r:yangModuleName "_3gpp-ns-nrm-networkslice" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-ns-nrm-networkslice> .

ns3gpp:NetworkSlice.administrativeState a rdf:Property ;
    rdfs:label "NetworkSlice.administrativeState" ;
    rdfs:comment """The administrative state of the network slice instance.
It describes the permission to use or prohibition against
using the instance, imposed through the OAM services.""" ;
    rdfs:domain ns3gpp:NetworkSlice ;
    rdfs:range xsd:string .

ns3gpp:NetworkSlice.id a rdf:Property ;
    rdfs:label "NetworkSlice.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain ns3gpp:NetworkSlice ;
    rdfs:range xsd:string .

ns3gpp:NetworkSlice.networkSliceSubnetRef a owl:ObjectProperty ;
    rdfs:label "NetworkSlice.networkSliceSubnetRef" ;
    rdfs:comment """DN of NetworkSliceSubnet relating to the
NetworkSlice instance""" ;
    rdfs:domain ns3gpp:NetworkSlice ;
    y2r:isReference true .

ns3gpp:NetworkSlice.operationalState a rdf:Property ;
    rdfs:label "NetworkSlice.operationalState" ;
    rdfs:comment """The operational state of the network slice instance.
It describes whether or not the resource is installed
and working.""" ;
    rdfs:domain ns3gpp:NetworkSlice ;
    rdfs:range xsd:string .

ns3gpp:NetworkSlice.serviceProfileList a owl:ObjectProperty ;
    rdfs:label "NetworkSlice.serviceProfileList" ;
    rdfs:comment """A list of service profiles supported by the network
slice instance.""" ;
    rdfs:domain ns3gpp:NetworkSlice ;
    rdfs:range ns3gpp:ServiceProfile .

ns3gpp:ServiceProfile.activityFactor a rdf:Property ;
    rdfs:label "ServiceProfile.activityFactor" ;
    rdfs:comment """An attribute specifies the percentage value of the
amount of simultaneous active UEs to the total number of UEs where
active means the UEs are exchanging data with the network""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:decimal .

ns3gpp:ServiceProfile.availability a rdf:Property ;
    rdfs:label "ServiceProfile.availability" ;
    rdfs:comment """The availability requirement for a network slice
instance, expressed as a percentage.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:decimal .

ns3gpp:ServiceProfile.coverageArea a rdf:Property ;
    rdfs:label "ServiceProfile.coverageArea" ;
    rdfs:comment "A list of TrackingAreas where the NSI can be selected." ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:string .

ns3gpp:ServiceProfile.dLThptPerSlice a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.dLThptPerSlice" ;
    rdfs:comment """This attribute defines achievable data rate of the
network slice in downlink that is available ubiquitously across
the coverage area of the slice""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3cmn3gpp:XLThpt .

ns3gpp:ServiceProfile.dLThptPerUE a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.dLThptPerUE" ;
    rdfs:comment """This attribute defines data rate supported by the network
slice per UE""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3cmn3gpp:XLThpt .

ns3gpp:ServiceProfile.delayTolerance a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.delayTolerance" ;
    rdfs:comment """An attribute specifies the properties of service delivery
flexibility, especially for the vertical services that are not
chasing a high system performance.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:delayTolerance .

ns3gpp:ServiceProfile.deterministicComm a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.deterministicComm" ;
    rdfs:comment """This list represents the properties of the deterministic
communication for periodic user traffic. Periodic traffic refers to the
type of traffic with periodic transmissions.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:deterministicComm .

ns3gpp:ServiceProfile.jitter a rdf:Property ;
    rdfs:label "ServiceProfile.jitter" ;
    rdfs:comment """An attribute specifies the deviation from the desired
value to the actual value when assessing time parameters""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:unsignedInt .

ns3gpp:ServiceProfile.kPIMonitoring a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.kPIMonitoring" ;
    rdfs:comment "Represents performance monitoring" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:kPIMonitoring .

ns3gpp:ServiceProfile.latency a rdf:Property ;
    rdfs:label "ServiceProfile.latency" ;
    rdfs:comment """The packet transmission latency (milliseconds) through
the RAN, CN, and TN part of 5G network, used to evaluate utilization
performance of the end-to-end network slice instance.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:unsignedShort .

ns3gpp:ServiceProfile.maxDLDataVolume a rdf:Property ;
    rdfs:label "ServiceProfile.maxDLDataVolume" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:string .

ns3gpp:ServiceProfile.maxNumberofPDUSessions a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.maxNumberofPDUSessions" ;
    rdfs:comment """Represents the maximum number of
concurrent PDU sessions supported by the network slice""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:maxNumberofPDUSessions .

ns3gpp:ServiceProfile.maxNumberofUEs a rdf:Property ;
    rdfs:label "ServiceProfile.maxNumberofUEs" ;
    rdfs:comment """The maximum number of UEs that may simultaneously
access the network slice instance.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:unsignedLong .

ns3gpp:ServiceProfile.maxPktSize a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.maxPktSize" ;
    rdfs:comment """This parameter specifies the maximum packet size
supported by the network slice""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:maxPktSize .

ns3gpp:ServiceProfile.maxULDataVolume a rdf:Property ;
    rdfs:label "ServiceProfile.maxULDataVolume" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:string .

ns3gpp:ServiceProfile.nBIoT a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.nBIoT" ;
    rdfs:comment """An attribute specifies whether NB-IoT is supported in
the RAN in the network slice""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:nBIoT .

ns3gpp:ServiceProfile.pLMNIdList a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.pLMNIdList" ;
    rdfs:comment "List of PLMN IDs." ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:pLMNIdList .

ns3gpp:ServiceProfile.reliability a rdf:Property ;
    rdfs:label "ServiceProfile.reliability" ;
    rdfs:comment """An attribute specifies in the context of network layer
packet transmissions, percentage value of the amount of sent
network layer packets successfully delivered to a given system
entity within the time constraint required by the targeted service,
divided by the total number of sent network layer packets.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:string .

ns3gpp:ServiceProfile.resourceSharingLevel a rdf:Property ;
    rdfs:label "ServiceProfile.resourceSharingLevel" ;
    rdfs:comment """Specifies whether the resources to be allocated to the
network slice instance may be shared with another network slice
instance(s).""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:string .

ns3gpp:ServiceProfile.sNSSAIList a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.sNSSAIList" ;
    rdfs:comment """The S-NSSAI list to be supported by the new NSI to be
created or the existing NSI to be re-used.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:sNSSAIList .

ns3gpp:ServiceProfile.sST a rdf:Property ;
    rdfs:label "ServiceProfile.sST" ;
    rdfs:comment """Specifies the slice/service type. See 3GPP TS 23.501
for defined values.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:unsignedInt .

ns3gpp:ServiceProfile.serviceProfileId a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.serviceProfileId" ;
    rdfs:comment "Service profile identifier." ;
    rdfs:domain ns3gpp:ServiceProfile ;
    y2r:isReference true .

ns3gpp:ServiceProfile.survivalTime a rdf:Property ;
    rdfs:label "ServiceProfile.survivalTime" ;
    rdfs:comment """An attribute specifies the time that an application
consuming a communication service may continue without an
anticipated message.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:string .

ns3gpp:ServiceProfile.termDensity a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.termDensity" ;
    rdfs:comment """An attribute specifies the overall user density over
the coverage area of the network slice""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:termDensity .

ns3gpp:ServiceProfile.uEMobilityLevel a rdf:Property ;
    rdfs:label "ServiceProfile.uEMobilityLevel" ;
    rdfs:comment """The mobility level of UE accessing the network slice
instance.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:string .

ns3gpp:ServiceProfile.uESpeed a rdf:Property ;
    rdfs:label "ServiceProfile.uESpeed" ;
    rdfs:comment """An attribute specifies the maximum speed (in km/hour)
supported by the network slice at which a defined QoS can be
achieved""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range xsd:unsignedInt .

ns3gpp:ServiceProfile.uLThptPerSlice a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.uLThptPerSlice" ;
    rdfs:comment """This attribute defines achievable data rate of the
network slice in uplink that is available ubiquitously across
the coverage area of the slice""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3cmn3gpp:XLThpt .

ns3gpp:ServiceProfile.uLThptPerUE a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.uLThptPerUE" ;
    rdfs:comment """This attribute defines data rate supported by the
network slice per UE""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3cmn3gpp:XLThpt .

ns3gpp:ServiceProfile.userMgmtOpen a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.userMgmtOpen" ;
    rdfs:comment """An attribute specifies whether or not the network slice
supports the capability for the NSC to manage their users or groups
of users' network services and corresponding requirements.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:userMgmtOpen .

ns3gpp:ServiceProfile.v2XCommModels a owl:ObjectProperty ;
    rdfs:label "ServiceProfile.v2XCommModels" ;
    rdfs:comment """An attribute specifies whether or not the V2X
communication mode is supported by the network slice.""" ;
    rdfs:domain ns3gpp:ServiceProfile ;
    rdfs:range ns3gpp:v2XCommModels .

ns3gpp:delayTolerance.servAttrCom a owl:ObjectProperty ;
    rdfs:label "_3gpp-ns-nrm-networkslice:delayTolerance.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain ns3gpp:delayTolerance ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

ns3gpp:delayTolerance.support a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:delayTolerance.support" ;
    rdfs:comment """An attribute specifies whether or not the network
slice supports service delivery flexibility, especially for the
vertical services that are not chasing a high system performance.""" ;
    rdfs:domain ns3gpp:delayTolerance ;
    rdfs:range xsd:string .

ns3gpp:deterministicComm.availability a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:deterministicComm.availability" ;
    rdfs:domain ns3gpp:deterministicComm ;
    rdfs:range xsd:string .

ns3gpp:deterministicComm.periodicityList a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:deterministicComm.periodicityList" ;
    rdfs:domain ns3gpp:deterministicComm ;
    rdfs:range xsd:string .

ns3gpp:deterministicComm.servAttrCom a owl:ObjectProperty ;
    rdfs:label "_3gpp-ns-nrm-networkslice:deterministicComm.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain ns3gpp:deterministicComm ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

ns3gpp:kPIMonitoring.kPIList a rdf:Property ;
    rdfs:label "kPIMonitoring.kPIList" ;
    rdfs:comment """An attribute specifies the name list of KQIs and KPIs
available for performance monitoring""" ;
    rdfs:domain ns3gpp:kPIMonitoring ;
    rdfs:range xsd:string .

ns3gpp:kPIMonitoring.servAttrCom a owl:ObjectProperty ;
    rdfs:label "kPIMonitoring.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain ns3gpp:kPIMonitoring ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

ns3gpp:maxNumberofPDUSessions.nOofPDUSessions a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:maxNumberofPDUSessions.nOofPDUSessions" ;
    rdfs:domain ns3gpp:maxNumberofPDUSessions ;
    rdfs:range xsd:unsignedInt .

ns3gpp:maxNumberofPDUSessions.servAttrCom a owl:ObjectProperty ;
    rdfs:label "_3gpp-ns-nrm-networkslice:maxNumberofPDUSessions.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain ns3gpp:maxNumberofPDUSessions ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

ns3gpp:maxPktSize.maxSize a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:maxPktSize.maxSize" ;
    rdfs:domain ns3gpp:maxPktSize ;
    rdfs:range xsd:unsignedInt .

ns3gpp:maxPktSize.servAttrCom a owl:ObjectProperty ;
    rdfs:label "_3gpp-ns-nrm-networkslice:maxPktSize.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain ns3gpp:maxPktSize ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

ns3gpp:nBIoT.servAttrCom a owl:ObjectProperty ;
    rdfs:label "nBIoT.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain ns3gpp:nBIoT ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

ns3gpp:nBIoT.support a rdf:Property ;
    rdfs:label "nBIoT.support" ;
    rdfs:comment """An attribute specifies whether NB-IoT is supported
in the RAN in the network slice""" ;
    rdfs:domain ns3gpp:nBIoT ;
    rdfs:range xsd:string .

ns3gpp:pLMNIdList.mcc a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:pLMNIdList.mcc" ;
    rdfs:domain ns3gpp:pLMNIdList ;
    rdfs:range xsd:string .

ns3gpp:pLMNIdList.mnc a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:pLMNIdList.mnc" ;
    rdfs:domain ns3gpp:pLMNIdList ;
    rdfs:range xsd:string .

ns3gpp:sNSSAIList.sd a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:sNSSAIList.sd" ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain ns3gpp:sNSSAIList ;
    rdfs:range xsd:string .

ns3gpp:sNSSAIList.sst a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:sNSSAIList.sst" ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain ns3gpp:sNSSAIList ;
    rdfs:range xsd:unsignedByte .

ns3gpp:termDensity.density a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslice:termDensity.density" ;
    rdfs:domain ns3gpp:termDensity ;
    rdfs:range xsd:unsignedInt .

ns3gpp:termDensity.servAttrCom a owl:ObjectProperty ;
    rdfs:label "_3gpp-ns-nrm-networkslice:termDensity.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain ns3gpp:termDensity ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

ns3gpp:userMgmtOpen.servAttrCom a owl:ObjectProperty ;
    rdfs:label "userMgmtOpen.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain ns3gpp:userMgmtOpen ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

ns3gpp:userMgmtOpen.support a rdf:Property ;
    rdfs:label "userMgmtOpen.support" ;
    rdfs:domain ns3gpp:userMgmtOpen ;
    rdfs:range xsd:string .

ns3gpp:v2XCommModels.servAttrCom a owl:ObjectProperty ;
    rdfs:label "v2XCommModels.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain ns3gpp:v2XCommModels ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

ns3gpp:v2XCommModels.v2XMode a rdf:Property ;
    rdfs:label "v2XCommModels.v2XMode" ;
    rdfs:domain ns3gpp:v2XCommModels ;
    rdfs:range xsd:string .

