requirement related attributes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-ns-nrm-networkslice/userMgmtOpen> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-ns-nrm-common/ServAttrCom> .

<urn:3gpp:sa5:_3gpp-ns-nrm-networkslice/userMgmtOpen/support> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-ns-nrm-networkslice/userMgmtOpen> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-ns-nrm-networkslice/v2XCommModels/servAttrCom> a owl:ObjectProperty ;
