@prefix FiveQiDscpM3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-FiveQiDscpMappingSet#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

FiveQiDscpM3gpp:FiveQiDscpMappingSet a rdfs:Class ;
    rdfs:label "FiveQiDscpMappingSet" ;
    rdfs:comment "Specifies the mapping between 5QIs and DSCPs." ;
    y2r:hasAttribute FiveQiDscpM3gpp:fiveQiDscpMappingList .

FiveQiDscpM3gpp:fiveQiDscpMappingList a rdfs:Class ;
    rdfs:label "fiveQiDscpMappingList" ;
    rdfs:comment "It provides the list of mapping between 5QIs and DSCP." .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-FiveQiDscpMappingSet> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-FiveQiDscpMappingSet" ;
    dcterms:description """ This IOC represents the set of mapping between 5QIs and DSCP.
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-FiveQiDscpMappingSet" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-07-25 (CR-1558)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-FiveQiDscpMappingSet" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet> .

FiveQiDscpM3gpp:FiveQiDscpMappingSet.fiveQiDscpMappingList a owl:ObjectProperty ;
    rdfs:label "FiveQiDscpMappingSet.fiveQiDscpMappingList" ;
    rdfs:comment "It provides the list of mapping between 5QIs and DSCP." ;
    rdfs:domain FiveQiDscpM3gpp:FiveQiDscpMappingSet ;
    rdfs:range FiveQiDscpM3gpp:fiveQiDscpMappingList .

FiveQiDscpM3gpp:FiveQiDscpMappingSet.id a rdf:Property ;
    rdfs:label "FiveQiDscpMappingSet.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain FiveQiDscpM3gpp:FiveQiDscpMappingSet ;
    rdfs:range xsd:string .

FiveQiDscpM3gpp:fiveQiDscpMappingList.dscp a rdf:Property ;
    rdfs:label "fiveQiDscpMappingList.dscp" ;
    rdfs:domain FiveQiDscpM3gpp:fiveQiDscpMappingList ;
    rdfs:range xsd:unsignedInt .

FiveQiDscpM3gpp:fiveQiDscpMappingList.fiveQIValues a rdf:Property ;
    rdfs:label "fiveQiDscpMappingList.fiveQIValues" ;
    rdfs:comment " Identifies the 5QI values that are mapped to a same DSCP" ;
    rdfs:domain FiveQiDscpM3gpp:fiveQiDscpMappingList ;
    rdfs:range xsd:unsignedInt .

