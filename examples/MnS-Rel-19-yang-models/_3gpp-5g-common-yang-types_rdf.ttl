@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> a rdfs:Class ;
    rdfs:label "AreaScope" ;
    rdfs:comment "It specifies the area where data shall be collected. " ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sliceIdList>,
        <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea>,
        <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId>,
        <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> a rdfs:Class ;
    rdfs:label "CaraConfiguration" ;
    rdfs:comment """configuration used for  an NR mobile node (e.g., IAB-node or MWAB),
to perform certificate enrolment procedure as specified in
TS 28.315.""" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssai> a rdfs:Class ;
    rdfs:label "ExtSnssai" ;
    rdfs:comment "Supported S-NSSAI." ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface> a rdfs:Class ;
    rdfs:label "IpInterface" ;
    rdfs:comment """Indicate that the UPF is collocated with W-AGF. If not
present, the UPF is not collocated with Wireline Access Gateway
Function (W-AGF).""" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> a rdfs:Class ;
    rdfs:label "LocationInfo" ;
    rdfs:comment """This parameter specifies the current location
of mobile NR node (e.g., IAB-node, MWAB-node).""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId>,
        <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea>,
        <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfo> a rdfs:Class ;
    rdfs:label "_3gpp-5g-common-yang-types:MappedCellIdInfo" ;
    rdfs:comment """It provides the list of mapping between GEO area and
Mapped Cell ID.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi>,
        <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig> a rdfs:Class ;
    rdfs:label "MnrOamIPConfig" ;
    rdfs:comment """It is IP configutation for OAM connectivity used
by a mobile NR node (e.g., IAB-node, MWAB-node)
to establish connection with management system as specified
in TS 28.314[x] clause 6.1.2""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi> a rdfs:Class ;
    rdfs:label "Ncgi" ;
    rdfs:comment """This attribute is in format of NCGI to indicate a fixed
geographical area (See subclause 16.14.5 in TS 38.300""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange> a rdfs:Class ;
    rdfs:label "SdRange" ;
    rdfs:comment """It shall contain the range(s) of Slice Differentiator values
supported for the Slice/Service Type value indicated in the sst
attribute of the Snssai data type (see clause 5.4.4.2 in TS 29.571).""" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension> a rdfs:Class ;
    rdfs:label "SnssaiExtension" ;
    rdfs:comment "It represents extensions to the Snssai." ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> a rdfs:Class ;
    rdfs:label "TaiRange" ;
    rdfs:comment """It represents a set of TAIs where the
NF(Service) instance under CANARY_RELEASE status shall
be selected for a certain UE""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/tacRangeList> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature> a rdfs:Class ;
    rdfs:label "VendorSpecificFeature" ;
    rdfs:comment """VendorSpecificFeature objects as defined
in the clause 5.3.247.""" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types> a owl:Ontology ;
    rdfs:label "_3gpp-5g-common-yang-types" ;
    dcterms:description """The model defines common types for 5G networks and
network slicing.
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5g-common-yang-types" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-01-07 (CR-)" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/cAGIdList> a rdf:Property ;
    rdfs:label "AreaScope.cAGIdList" ;
    rdfs:comment """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/eutraCellIdList> a rdf:Property ;
    rdfs:label "AreaScope.eutraCellIdList" ;
    rdfs:comment "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/nPNIdentityList> a owl:ObjectProperty ;
    rdfs:label "AreaScope.nPNIdentityList" ;
    rdfs:comment """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/nrCellIdList> a rdf:Property ;
    rdfs:label "AreaScope.nrCellIdList" ;
    rdfs:comment "List of NR cells identified by NG-RAN CGI" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/ntnGeoAreaList> a owl:ObjectProperty ;
    rdfs:label "AreaScope.ntnGeoAreaList" ;
    rdfs:comment "geographical areas for NTN MDT" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/sliceIdList> a owl:ObjectProperty ;
    rdfs:label "AreaScope.sliceIdList" ;
    rdfs:comment "Network Slice Id list" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/tacList> a rdf:Property ;
    rdfs:label "AreaScope.tacList" ;
    rdfs:comment "Tracking Area Code list" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/taiList> a owl:ObjectProperty ;
    rdfs:label "AreaScope.taiList" ;
    rdfs:comment "Tracking Area Identity list" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/caraAddress> a rdf:Property ;
    rdfs:label "CaraConfiguration.caraAddress" ;
    rdfs:comment """IP address or FQDN of the CMP (Certificate Management
Protocol)
server""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/path> a rdf:Property ;
    rdfs:label "CaraConfiguration.path" ;
    rdfs:comment """This parameter specifies the path (in ASCII string) to
the CMP server directory. A CMP server may be located in an
arbitrary path other than root.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/portNumber> a rdf:Property ;
    rdfs:label "CaraConfiguration.portNumber" ;
    rdfs:comment """This parameter specifies the port number used by
CMP (Certificate Management Protocol) server. The port for HTTP/HTTPSs
transfer of CMP messages is not explicitly given in RFC 9811, therefore
this parameter is required. The port number is usually
represented as 2 octets.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/protocol> a rdf:Property ;
    rdfs:label "CaraConfiguration.protocol" ;
    rdfs:comment """This parameter specifies the protocol (HTTP or HTTPS)
to be used for certificate enrolment. The use is described in
3GPP TS 33.310 clause 9.6.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/subjectName> a rdf:Property ;
    rdfs:label "CaraConfiguration.subjectName" ;
    rdfs:comment """This parameter specifies the subject name (in ASCII
string) of the CA/RA. The use is described in 3GPP TS 33.310
clause 9.5.3.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/CommModelType> a rdfs:Datatype ;
    rdfs:label "CommModelType" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/DayOfWeekT> a rdfs:Datatype ;
    rdfs:label "DayOfWeekT" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/EnergySavingLoadThresholdT> a rdfs:Datatype ;
    rdfs:label "EnergySavingLoadThresholdT" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/EnergySavingTimeDurationT> a rdfs:Datatype ;
    rdfs:label "EnergySavingTimeDurationT" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssai/snssai> a owl:ObjectProperty ;
    rdfs:label "ExtSnssai.snssai" ;
    rdfs:comment """It represents the S-NSSAI the NetworkSlice managed object
is supporting. The S-NSSAI is defined in TS 23.003 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssai> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssai/snssaiExtension> a owl:ObjectProperty ;
    rdfs:label "ExtSnssai.snssaiExtension" ;
    rdfs:comment "It represents extensions to the Snssai." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssai> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface/fqdn> a rdf:Property ;
    rdfs:label "IpInterface.fqdn" ;
    rdfs:comment """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface/ipv4EndpointAddresses> a rdf:Property ;
    rdfs:label "IpInterface.ipv4EndpointAddresses" ;
    rdfs:comment """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface/ipv6EndpointAddresses> a rdf:Property ;
    rdfs:label "IpInterface.ipv6EndpointAddresses" ;
    rdfs:comment """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/cellLocalId> a rdf:Property ;
    rdfs:label "LocationInfo.cellLocalId" ;
    rdfs:comment """Identifies an NR cell where IAB-MT or MWAB-UE
is connected to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/gNBId> a rdf:Property ;
    rdfs:label "LocationInfo.gNBId" ;
    rdfs:comment """It is either the gNB ID of the IAB-donor-CU that target IAB-DU
connects to or the gNB Id of the IAB-nonor-CU that serves IAB-MT, or
the gNBId of the gNB that serves MWAB-UE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> ;
    rdfs:range xsd:long .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/geoArea> a owl:ObjectProperty ;
    rdfs:label "LocationInfo.geoArea" ;
    rdfs:comment """It specifies geographical area of mobile NR node
(e.g., IAB-node or MWAB-node).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/id> a rdf:Property ;
    rdfs:label "LocationInfo.id" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/nRTAC> a rdf:Property ;
    rdfs:label "LocationInfo.nRTAC" ;
    rdfs:comment """It is TAC pertaining to the cells where IAB-MT or MWAB-UE is
connected.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/pLMNId> a owl:ObjectProperty ;
    rdfs:label "LocationInfo.pLMNId" ;
    rdfs:comment "The PLMN ID where IAB-MT or MWAB-UE is connected to" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/tAI> a owl:ObjectProperty ;
    rdfs:label "LocationInfo.tAI" ;
    rdfs:comment """It is the TAI (see subclause 9.3.3.11 in TS 38.413) pertaining
to the cells where IAB-MT or MWAB-UE is connected""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfo/mappedCellId> a owl:ObjectProperty ;
    rdfs:label "_3gpp-5g-common-yang-types:MappedCellIdInfo.mappedCellId" ;
    rdfs:comment """This attribute is in format of NCGI to indicate a fixed
geographical area (See subclause 16.14.5 in TS 38.300)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfo/ntnGeoArea> a owl:ObjectProperty ;
    rdfs:label "_3gpp-5g-common-yang-types:MappedCellIdInfo.ntnGeoArea" ;
    rdfs:comment """This attribute indicates a specific geographical location
mapped to Mapped Cell ID(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig/caraConfiguration> a owl:ObjectProperty ;
    rdfs:label "MnrOamIPConfig.caraConfiguration" ;
    rdfs:comment """configuration used for  an NR mobile node (e.g., IAB-node or MWAB),
to perform certificate enrolment procedure as specified in
TS 28.315.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig/id> a rdf:Property ;
    rdfs:label "MnrOamIPConfig.id" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig/scsConfiguration> a rdf:Property ;
    rdfs:label "MnrOamIPConfig.scsConfiguration" ;
    rdfs:comment """this parameter specifies IP address or FQDN of
configuration server (SCS) used for
an NR mobile node (e.g., IAB-node or MWAB)
to establish connection as specified in TS 28.315.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig/seGwConfiguration> a rdf:Property ;
    rdfs:label "MnrOamIPConfig.seGwConfiguration" ;
    rdfs:comment """this parameter specifies IP address or
FQDN of security gateway (SeGW) used for an
an NR mobile node (e.g., IAB-node or MWAB)
to establish secure connection as specified in TS 28.315.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/NRTAC> a rdfs:Datatype ;
    rdfs:label "NRTAC" ;
    rdfs:comment """This holds the identity of the common Tracking Area Code
for the PLMNs.

allowedValues:
a) It is the TAC or Extended-TAC.
b) A cell can only broadcast one TAC or Extended-TAC. See TS 36.300,
subclause 10.1.7 (PLMNID and TAC relation).
c) TAC is defined in subclause 19.4.2.3 of 3GPP TS 23.003
and Extended-TAC is defined in subclause 9.3.1.29 of 3GPP TS 38.473.
d) For a 5G SA (Stand Alone), it has a non-null value.""" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi/nId> a rdf:Property ;
    rdfs:label "Ncgi.nId" ;
    rdfs:comment """Network Identity; Shall be present if PlmnIdNid identifies
an SNPN (see clauses 5.30.2.3, 5.30.2.9, 6.3.4, and 6.3.8 in
3GPP TS 23.501.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi/nrCellId> a rdf:Property ;
    rdfs:label "Ncgi.nrCellId" ;
    rdfs:comment """This attribute represents NR Cell Identity.
It's a 36-bit string identifying an NR Cell Id as specified in
clause 9.3.1.7 of TS 38.413, in hexadecimal representation. Each
character in the string shall take a value of
'0' to '9', 'a' to 'f' or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most significant
bits of the Cell Id shall appear first in the string, and the
character representing the 4 least significant bit of the
Cell Id shall appear last in the string.

Pattern: '^[A-Fa-f0-9]{9}$'

Example:
An NR Cell Id 0x225BD6007 shall be encoded as '225BD6007'.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi/plmnId> a owl:ObjectProperty ;
    rdfs:label "Ncgi.plmnId" ;
    rdfs:comment "This attribute represents a PLMN Identity." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/PhysCellID> a rdfs:Datatype ;
    rdfs:label "PhysCellID" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange/end> a rdf:Property ;
    rdfs:label "SdRange.end" ;
    rdfs:comment """Last value identifying the end of an SD range.
This string shall be formatted as specified for the sd attribute of the
Snssai data type in clause 5.4.4.2 in TS 29.571""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange/start> a rdf:Property ;
    rdfs:label "SdRange.start" ;
    rdfs:comment """First value identifying the start of an SD range.
This string shall be formatted as specified for the sd attribute of the
Snssai data type in clause 5.4.4.2 of TS 29.571.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension/sdRanges> a owl:ObjectProperty ;
    rdfs:label "SnssaiExtension.sdRanges" ;
    rdfs:comment """It shall contain the range(s) of Slice Differentiator values
supported for the Slice/Service Type value indicated in the sst
attribute of the Snssai data type (see clause 5.4.4.2 in TS 29.571).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension/wildcardSd> a rdf:Property ;
    rdfs:label "SnssaiExtension.wildcardSd" ;
    rdfs:comment """It indicates that all SD values are supported for the
Slice/Service Type value indicated in the sst attribute of the Snssai
data type (see clause 5.4.4.2 in TS 29.571).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange/plmnId> a owl:ObjectProperty ;
    rdfs:label "TaiRange.plmnId" ;
    rdfs:comment "PLMN ID related to the TacRange." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange/tacRangeList> a owl:ObjectProperty ;
    rdfs:label "TaiRange.tacRangeList" ;
    rdfs:comment "The range of the TACs." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/tacRangeList> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/UTC24TimeOfDayT> a rdfs:Datatype ;
    rdfs:label "UTC24TimeOfDayT" ;
    rdfs:comment """Time of day in HH:MM or H:MM 24-hour format per UTC
time zone.""" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature/featureName> a rdf:Property ;
    rdfs:label "VendorSpecificFeature.featureName" ;
    rdfs:comment """It is a string representing a proprietary feature
specific to a given vendor.
It is recommended that the case convention for these strings is the
same as for enumerated data types (i.e. UPPER_WITH_UNDERSCORE;
see 3GPP TS 29.501, clause 5.1.1).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature/featureVersion> a rdf:Property ;
    rdfs:label "VendorSpecificFeature.featureVersion" ;
    rdfs:comment "It is a string representing the version of the feature." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature> ;
    rdfs:range xsd:string .

