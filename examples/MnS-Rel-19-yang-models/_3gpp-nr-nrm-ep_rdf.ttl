    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-ep/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ep/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

