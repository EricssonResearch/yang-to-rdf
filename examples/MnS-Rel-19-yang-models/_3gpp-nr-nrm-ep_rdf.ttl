@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ep3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-ep#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

ep3gpp:EP_E1 a rdfs:Class ;
    rdfs:label "EP_E1" ;
    rdfs:comment """Represents the local end point of the logical link,
supporting E1 interface between gNB-CU-CP and gNB-CU-UP.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:EP_F1C a rdfs:Class ;
    rdfs:label "_3gpp-nr-nrm-ep:EP_F1C" ;
    rdfs:comment """Represents the local end point of the control plane
interface (F1-C) between the gNB-DU and gNB-CU or gNB-CU-CP.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:EP_F1U a rdfs:Class ;
    rdfs:label "_3gpp-nr-nrm-ep:EP_F1U" ;
    rdfs:comment """Represents the local end point of the user plane
interface (F1-U) between the gNB-DU and gNB-CU or gNB-CU-UP.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:EP_NgC a rdfs:Class ;
    rdfs:label "EP_NgC" ;
    rdfs:comment """This IOC represents the local end point of the control
plane interface (NG-C) between the gNB and AMF or the gNB and AIOTF.
The transport network layer is built on IP transport. For the reliable
transport of signalling messages, SCTP is added on top of IP.
The application layer signalling protocol is referred to as NG-AP
(NG Application Protocol).

3GPP TS 38.470 noted that 'one gNB-CU and a set of gNB-DUs are
visible to other logical nodes as a gNB or an en-gNB where the gNB
terminates the Xn and the NG interfaces, and the en-gNB terminates
the X2 and the S1-U interfaces'.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:EP_NgU a rdfs:Class ;
    rdfs:label "EP_NgU" ;
    rdfs:comment """Represents the local end point of the NG user plane
(NG-U) interface between the gNB and UPF.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:EP_S1U a rdfs:Class ;
    rdfs:label "EP_S1U" ;
    rdfs:comment """Represents the local end point of the logical link,
supporting S1-U interface towards a S-GW node.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:EP_X2C a rdfs:Class ;
    rdfs:label "EP_X2C" ;
    rdfs:comment """Represents the local end point of the logical link,
supporting X2-C application protocols used in EN-DC, to a neighbour
eNB or en-gNB node.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:EP_X2U a rdfs:Class ;
    rdfs:label "EP_X2U" ;
    rdfs:comment """Represents the local end-point of a logical link supporting
the X2 user plane (X2-U) interface used in EN-DC.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:EP_XnC a rdfs:Class ;
    rdfs:label "EP_XnC" ;
    rdfs:comment """Represents the local gNB node end point of the logical
link, supporting Xn application protocols, to a neighbour NG-RAN node
(including gNB and ng-eNB). The Xn Application PDUs are carried over
SCTP/IP/Data link layer/Physical layer stack.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:EP_XnU a rdfs:Class ;
    rdfs:label "EP_XnU" ;
    rdfs:comment """Represents the one end-point of a logical link supporting
the Xn user plane (Xn-U) interface. The Xn-U interface provides
non-guaranteed delivery of user plane PDUs between two NG-RAN nodes.""" ;
    y2r:hasAttribute ep3gpp:SupportedPerfMetricGroups,
        ep3gpp:localAddress .

ep3gpp:SupportedPerfMetricGroups a rdfs:Class ;
    rdfs:label "_3gpp-nr-nrm-ep:SupportedPerfMetricGroups" ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" .

ep3gpp:localAddress a rdfs:Class ;
    rdfs:label "_3gpp-nr-nrm-ep:localAddress" ;
    rdfs:comment "Local IP address and VLAN ID." .

<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-ep> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-ep" ;
    dcterms:description """Defines the YANG mapping of the NR related endpoint
Information Object Classes (IOCs) that are part of the NR Network
Resource Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-ep" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-11-07 (CR-1640 CR-1643)" ;
    y2r:yangModuleName "_3gpp-nr-nrm-ep" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-nr-nrm-ep> .

ep3gpp:EP_E1.SupportedPerfMetricGroups a owl:ObjectProperty ;
    rdfs:label "EP_E1.SupportedPerfMetricGroups" ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain ep3gpp:EP_E1 ;
    rdfs:range ep3gpp:SupportedPerfMetricGroups .

ep3gpp:EP_E1.farEndEntity a owl:ObjectProperty ;
    rdfs:label "EP_E1.farEndEntity" ;
    rdfs:domain ep3gpp:EP_E1 ;
    y2r:isReference true .

ep3gpp:EP_E1.id a rdf:Property ;
    rdfs:label "EP_E1.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain ep3gpp:EP_E1 ;
    rdfs:range xsd:string .

ep3gpp:EP_E1.localAddress a owl:ObjectProperty ;
    rdfs:label "EP_E1.localAddress" ;
    rdfs:comment "Local IP address and VLAN ID." ;
    rdfs:domain ep3gpp:EP_E1 ;
    rdfs:range ep3gpp:localAddress .

ep3gpp:EP_E1.remoteAddress a rdf:Property ;
    rdfs:label "EP_E1.remoteAddress" ;
    rdfs:comment "Remote IP address." ;
    rdfs:domain ep3gpp:EP_E1 ;
    rdfs:range xsd:string .

ep3gpp:EP_E1.userLabel a rdf:Property ;
    rdfs:label "EP_E1.userLabel" ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain ep3gpp:EP_E1 ;
    rdfs:range xsd:string .

