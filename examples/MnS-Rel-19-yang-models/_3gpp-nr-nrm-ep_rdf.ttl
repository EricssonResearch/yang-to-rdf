    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-ep/EP_XnC> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-ep/EP_XnC/id> a rdf:Property ;
