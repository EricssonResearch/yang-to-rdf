@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix engyinfo3gpp: <https://semantics.ericsson.com/yang/_3gpp-engy-nrm-energyinformation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

engyinfo3gpp:EnergyInfoGroup a rdfs:Class ;
    rdfs:label "EnergyInfoGroup" ;
    rdfs:comment """This IOC represents a group of Network Elements, represented
by ManagedElement IOC and information related to the energy supply modes
that are used to power them. This information is configured by the
operator. Attribute memberDNList can be configured with the DNs of
ManagedElement or DNs of SubNetwork. This attribute provides the list
of Network Elements in the group, represented using ManagedElement MOIs
or represented using SubNetwork MOIs. In the case, memberDNList is
configured by DN of SubNetwork, then all the ManagedElement MOIs that
are name-contained by the SubNetwork MOI are part of the group. Attribute
energySupplyModeRefList is used to indicate the mode of energy supply
for powering the Network Elements of the group.""" .

engyinfo3gpp:EnergySupplyInfo a rdfs:Class ;
    rdfs:label "EnergySupplyInfo" ;
    rdfs:comment """This IOC defines the information related to energy supply
and the sources used to produce the energy. This information is configured
by the operator with the information obtained from sources external to
3GPP e.g an energy supplier. """ .

<https://semantics.ericsson.com/yang/_3gpp-engy-nrm-energyinformation> a owl:Ontology ;
    rdfs:label "_3gpp-engy-nrm-energyinformation" ;
    dcterms:description """This IOC represents the Energy Information NRM.
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI,
TSDSI, TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.310" ;
    dcterms:title "_3gpp-engy-nrm-energyinformation" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-05-07 (CR-0082)" ;
    y2r:yangModuleName "_3gpp-engy-nrm-energyinformation" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation> .

engyinfo3gpp:EnergyInfoGroup.energySupplyModeRefList a owl:ObjectProperty ;
    rdfs:label "EnergyInfoGroup.energySupplyModeRefList" ;
    rdfs:comment """The list of energy supply modes for the Network Elements
of the group. This information is configured by the operator with the
information obtained from external sources.""" ;
    rdfs:domain engyinfo3gpp:EnergyInfoGroup ;
    y2r:isReference true .

engyinfo3gpp:EnergyInfoGroup.id a rdf:Property ;
    rdfs:label "EnergyInfoGroup.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain engyinfo3gpp:EnergyInfoGroup ;
    rdfs:range xsd:string .

engyinfo3gpp:EnergyInfoGroup.memberDNList a owl:ObjectProperty ;
    rdfs:label "EnergyInfoGroup.memberDNList" ;
    rdfs:comment """This attribute contains the DNs of managed entities
that are members of the energy info group.""" ;
    rdfs:domain engyinfo3gpp:EnergyInfoGroup ;
    y2r:isReference true .

engyinfo3gpp:EnergySupplyInfo.energySupplyModeRefList a owl:ObjectProperty ;
    rdfs:label "EnergySupplyInfo.energySupplyModeRefList" ;
    rdfs:comment """The list of energy supply modes for the Network Elements
of the group. This information is configured by the operator with the
information obtained from external sources.""" ;
    rdfs:domain engyinfo3gpp:EnergySupplyInfo ;
    y2r:isReference true .

engyinfo3gpp:EnergySupplyInfo.id a rdf:Property ;
    rdfs:label "EnergySupplyInfo.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain engyinfo3gpp:EnergySupplyInfo ;
    rdfs:range xsd:string .

engyinfo3gpp:EnergySupplyInfo.memberDNList a owl:ObjectProperty ;
    rdfs:label "EnergySupplyInfo.memberDNList" ;
    rdfs:comment """This attribute contains the DNs of managed entities
that are members of the energy info group.""" ;
    rdfs:domain engyinfo3gpp:EnergySupplyInfo ;
    y2r:isReference true .

