            sh:path types3gpp:SAP.port ] ;
    sh:targetClass types3gpp:SAP .

types3gpp-shapes:Tai a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
