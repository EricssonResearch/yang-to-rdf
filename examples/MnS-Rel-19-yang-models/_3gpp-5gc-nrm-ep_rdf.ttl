<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups> a rdfs:Class ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/localAddress> a rdfs:Class ;
    rdfs:comment "Local IP address and VLAN ID." .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/remotePlmnId> a rdfs:Class ;
    rdfs:comment """PLMN Identifiers of the remote sepp.
The PLMN Identifier is composed of a Mobile Country Code
(MCC) and a Mobile Network Code (MNC).""" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep> a owl:Ontology .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_EP_N6/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_EP_N6> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_EP_N6/farEndEntity> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_EP_N6> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_EP_N6/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_EP_N6> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_EP_N6/localAddress> a owl:ObjectProperty ;
    rdfs:comment "Local IP address and VLAN ID." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_EP_N6> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/localAddress> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_EP_N6/remoteAddress> a rdf:Property ;
