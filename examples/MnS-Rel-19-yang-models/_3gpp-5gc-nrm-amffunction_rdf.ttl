    rdfs:comment """This attribute defines the information related to NR
Satellite RAT type and corresponding information of satellite coverage""" ;
    y2r:hasAttribute amf3gpp:NtnLocationInfo .

amf3gpp:SliceExpiryInfo a rdfs:Class ;
    rdfs:label "SliceExpiryInfo" ;
