    rdfs:comment "This attribute represents a PLMN Identity." .

amf3gpp:traceTarget a rdfs:Class ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:traceTarget" ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-amffunction> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-amffunction" ;
    dcterms:description """AMFFunction derived from basic ManagedFunction.
Copyright 2026, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-5gc-nrm-amffunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-05-25 (CR-1702)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-amffunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction> .

amf3gpp:AMFFunction.NTNTimeBasedConfig a owl:ObjectProperty ;
    rdfs:label "AMFFunction.NTNTimeBasedConfig" ;
    rdfs:comment "This is the NTN time-based configuration." ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:NTNTimeBasedConfig .

amf3gpp:AMFFunction.SupportedPerfMetricGroups a owl:ObjectProperty ;
    rdfs:label "AMFFunction.SupportedPerfMetricGroups" ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:SupportedPerfMetricGroups .

amf3gpp:AMFFunction.aMFIdentifier a owl:ObjectProperty ;
    rdfs:label "AMFFunction.aMFIdentifier" ;
    rdfs:comment """An AMF identifier, comprising an AMF Region ID, an
AMF Set ID and an AMF Pointer.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:aMFIdentifier .

amf3gpp:AMFFunction.aMFSetRef a owl:ObjectProperty ;
    rdfs:label "AMFFunction.aMFSetRef" ;
    rdfs:comment "This is the DN of AMFSet" ;
    rdfs:domain amf3gpp:AMFFunction ;
    y2r:isReference true .

amf3gpp:AMFFunction.amfInfo a owl:ObjectProperty ;
    rdfs:label "AMFFunction.amfInfo" ;
    rdfs:comment """This attribute represents information of an AMF
NF Instance.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:AmfInfo .

amf3gpp:AMFFunction.cNSIIdList a rdf:Property ;
    rdfs:label "AMFFunction.cNSIIdList" ;
    rdfs:comment """It is a set of NSI ID. NSI ID is an identifier for
identifying the Core Network part of a Network Slice instance when
multiple Network Slice instances of the same Network Slice are deployed,
and there is a need to differentiate between them in the 5GC.
See NSI ID definition in clause 3.1 of TS 23.501 and
subclause 6.1.6.2.7 of  TS 29.531""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range xsd:string .

amf3gpp:AMFFunction.commModelList a owl:ObjectProperty ;
    rdfs:label "AMFFunction.commModelList" ;
    rdfs:comment """Specifies a list of commModel. It can be used by NF and
NF services to interact with each other in 5G Core network """ ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:commModelList .

amf3gpp:AMFFunction.id a rdf:Property ;
    rdfs:label "AMFFunction.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range xsd:string .

amf3gpp:AMFFunction.managedNFProfile a owl:ObjectProperty ;
    rdfs:label "AMFFunction.managedNFProfile" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range mnfp3gpp:ManagedNFProfile .

amf3gpp:AMFFunction.mappedCellIdInfoList a owl:ObjectProperty ;
    rdfs:label "AMFFunction.mappedCellIdInfoList" ;
    rdfs:comment """It provides the list of mapping between GEO area and
Mapped Cell ID.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:MappedCellIdInfo .

amf3gpp:AMFFunction.mdtUserConsentReqList a rdf:Property ;
    rdfs:label "AMFFunction.mdtUserConsentReqList" ;
    rdfs:comment """represents a list of MDT measurement names that are
subject to user consent at MDT activation.
Any MDT measurement, whose name is not specified in this list, is not
subject to user consent at MDT activation.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range xsd:string .

amf3gpp:AMFFunction.nTNPLMNRestrictionsList a owl:ObjectProperty ;
    rdfs:label "AMFFunction.nTNPLMNRestrictionsList" ;
    rdfs:comment """This attribute defines the location restrictions per PLMN
that relates to non-terrestrial network access.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:NTNPLMNRestrictionsInfo .

amf3gpp:AMFFunction.pLMNInfoList a owl:ObjectProperty ;
    rdfs:label "AMFFunction.pLMNInfoList" ;
    rdfs:comment "It defines the PLMN(s) of a Network Function. " ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:pLMNInfoList .

amf3gpp:AMFFunction.peeParameterslist a owl:ObjectProperty ;
    rdfs:label "AMFFunction.peeParameterslist" ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range mf3gpp:PeeParameters .

amf3gpp:AMFFunction.priorityLabel a rdf:Property ;
    rdfs:label "AMFFunction.priorityLabel" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range xsd:unsignedInt .

amf3gpp:AMFFunction.sBIFQDN a rdf:Property ;
    rdfs:label "AMFFunction.sBIFQDN" ;
    rdfs:comment """The FQDN of the registered NF instance in the
service-based interface.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range xsd:string .

amf3gpp:AMFFunction.satelliteBackhaulInfoList a owl:ObjectProperty ;
    rdfs:label "AMFFunction.satelliteBackhaulInfoList" ;
    rdfs:comment """Specifies a list of satellite backhaul information. It can be
used by NF and NF services.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:SatelliteBackhaulInfo .

amf3gpp:AMFFunction.satelliteCoverageInfoList a owl:ObjectProperty ;
    rdfs:label "AMFFunction.satelliteCoverageInfoList" ;
    rdfs:comment """This attribute defines the information related to NR
Satellite RAT type and corresponding information of satellite coverage""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:SatelliteCoverageInfo .

amf3gpp:AMFFunction.sliceExpiryInfo a owl:ObjectProperty ;
    rdfs:label "AMFFunction.sliceExpiryInfo" ;
    rdfs:comment """This provides information related to a network slice
validity.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range amf3gpp:SliceExpiryInfo .

amf3gpp:AMFFunction.supportedTraceMetrics a rdf:Property ;
    rdfs:label "AMFFunction.supportedTraceMetrics" ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range xsd:string .

amf3gpp:AMFFunction.userLabel a rdf:Property ;
    rdfs:label "AMFFunction.userLabel" ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range xsd:string .

amf3gpp:AMFFunction.vnfParametersList a owl:ObjectProperty ;
    rdfs:label "AMFFunction.vnfParametersList" ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain amf3gpp:AMFFunction ;
    rdfs:range mf3gpp:VnfParameters .

amf3gpp:AmfInfo.aMFRegionId a rdf:Property ;
    rdfs:label "AmfInfo.aMFRegionId" ;
    rdfs:comment """It represents the AMF Region ID, which identifies the
region. AllowedValues: defined in subclause 2.10.1 of 3GPP TS 23.003 """ ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range xsd:long .

amf3gpp:AmfInfo.aMFSetId a rdf:Property ;
    rdfs:label "AmfInfo.aMFSetId" ;
    rdfs:comment """It represents the AMF Set ID, which is uniquely identifies
the AMF Set within the AMF Region.
allowedValues: defined in subclause 2.10.1 of 3GPP TS 23.003""" ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range xsd:long .

amf3gpp:AmfInfo.amfOnboardingCapability a rdf:Property ;
    rdfs:label "AmfInfo.amfOnboardingCapability" ;
    rdfs:comment """This attribute indicates the AMF supports SNPN Onboarding
capability. This is used for the case of Onboarding of UEs for SNPNs
(see TS 23.501, clause 5.30.2.10).
- FALSE: AMF does not support SNPN Onboarding;
- TRUE: AMF supports SNPN Onboarding.""" ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range xsd:boolean .

amf3gpp:AmfInfo.backupInfoAmfFailure a owl:ObjectProperty ;
    rdfs:label "AmfInfo.backupInfoAmfFailure" ;
    rdfs:comment """List of GUAMIs for which the AMF acts as a backup for AMF
failure.""" ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range amf3gpp:GUAMInfo .

amf3gpp:AmfInfo.backupInfoAmfRemoval a owl:ObjectProperty ;
    rdfs:label "AmfInfo.backupInfoAmfRemoval" ;
    rdfs:comment """List of GUAMIs for which the AMF acts as a backup for
planned AMF removal.""" ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range amf3gpp:GUAMInfo .

amf3gpp:AmfInfo.gUAMIdList a owl:ObjectProperty ;
    rdfs:label "AmfInfo.gUAMIdList" ;
    rdfs:comment "List of supported Globally Unique AMF Ids (GUAMIs)." ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range amf3gpp:GUAMInfo .

amf3gpp:AmfInfo.highLatencyCom a rdf:Property ;
    rdfs:label "AmfInfo.highLatencyCom" ;
    rdfs:comment """This attribute indicates whether the AMF supports High
Latency communication (e.g. for NR RedCap UE). This is used for CP NF
to discover AMF supporting High Latency communication (see TS 23.501,
clause 6.3.5).
- FALSE: AMF does not support High Latency communication e.g. for
NR RedCap UE;
- TRUE: AMF supports High Latency communication e.g. for NR RedCap UE;""" ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range xsd:boolean .

amf3gpp:AmfInfo.n2InterfaceAmfInfo a owl:ObjectProperty ;
    rdfs:label "AmfInfo.n2InterfaceAmfInfo" ;
    rdfs:comment """This attribute represents the N2 interface information of
the AMF. """ ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range amf3gpp:N2InterfaceAmfInfo .

amf3gpp:AmfInfo.taiList a owl:ObjectProperty ;
    rdfs:label "AmfInfo.taiList" ;
    rdfs:comment "The list of TAIs." ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range types3gpp:Tai .

amf3gpp:AmfInfo.taiRangeList a owl:ObjectProperty ;
    rdfs:label "AmfInfo.taiRangeList" ;
    rdfs:comment "The range of TAIs." ;
    rdfs:domain amf3gpp:AmfInfo ;
    rdfs:range types5g3gpp:TaiRange .

amf3gpp:BlockedLocationInfo.blockedDurWindow a owl:ObjectProperty ;
    rdfs:label "BlockedLocationInfo.blockedDurWindow" ;
    rdfs:comment """This provides the time durations for which the PLMN are
not allowed at a given location in case of NTN""" ;
    rdfs:domain amf3gpp:BlockedLocationInfo ;
    rdfs:range types3gpp:TimeWindow .

amf3gpp:BlockedLocationInfo.blockedLocation a owl:ObjectProperty ;
    rdfs:label "BlockedLocationInfo.blockedLocation" ;
    rdfs:comment """This provides the geographical location at which the PLMN
are not allowed in case of NTN.""" ;
    rdfs:domain amf3gpp:BlockedLocationInfo ;
    rdfs:range amf3gpp:blockedLocation .

amf3gpp:BlockedLocationInfo.blockedSlice a owl:ObjectProperty ;
    rdfs:label "BlockedLocationInfo.blockedSlice" ;
    rdfs:comment """This provides the slice for which the access is
not allowed at a given location in case of NTN. """ ;
    rdfs:domain amf3gpp:BlockedLocationInfo ;
    rdfs:range amf3gpp:blockedSlice .

amf3gpp:File.fileCompression a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.fileCompression" ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:File.fileContent a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.fileContent" ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:base64Binary ;
    y2r:isInvariant true .

amf3gpp:File.fileDataType a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.fileDataType" ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:File.fileExpirationTime a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.fileExpirationTime" ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:File.fileFormat a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.fileFormat" ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:File.fileLocation a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.fileLocation" ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:File.fileReadyTime a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.fileReadyTime" ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:File.fileSize a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.fileSize" ;
    rdfs:comment "Size of the file" ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:unsignedLong ;
    y2r:isInvariant true .

amf3gpp:File.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:string .

amf3gpp:File.jobId a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.jobId" ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain amf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:File.jobRef a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:File.jobRef" ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain amf3gpp:File ;
    y2r:isInvariant true ;
    y2r:isReference true .

amf3gpp:Files.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:Files.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain amf3gpp:Files ;
    rdfs:range xsd:string .

amf3gpp:Files.jobId a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:Files.jobId" ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain amf3gpp:Files ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:Files.jobRef a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:Files.jobRef" ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain amf3gpp:Files ;
    y2r:isInvariant true ;
    y2r:isReference true .

amf3gpp:Files.numberOfFiles a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:Files.numberOfFiles" ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain amf3gpp:Files ;
    rdfs:range xsd:unsignedLong .

amf3gpp:GUAMInfo.aMFIdentifier a rdf:Property ;
    rdfs:label "GUAMInfo.aMFIdentifier" ;
    rdfs:comment """The AMFI is constructed from an AMF Region ID, an
AMF Set ID and an AMF Pointer. The AMF Region ID identifies the region,
the AMF Set ID uniquely identifies the AMF Set within the AMF Region,
and the AMF Pointer uniquely identifies the AMF within the AMF Set.
(Ref. 3GPP TS 23.003)""" ;
    rdfs:domain amf3gpp:GUAMInfo ;
    rdfs:range xsd:long .

amf3gpp:GUAMInfo.pLMNId a owl:ObjectProperty ;
    rdfs:label "GUAMInfo.pLMNId" ;
    rdfs:comment "This attribute represents a PLMN Identity." ;
    rdfs:domain amf3gpp:GUAMInfo ;
    rdfs:range amf3gpp:pLMNId .

amf3gpp:ManagedNFService.administrativeState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ManagedNFService.administrativeState" ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain amf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

amf3gpp:ManagedNFService.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ManagedNFService.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain amf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

amf3gpp:ManagedNFService.nFServiceType a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ManagedNFService.nFServiceType" ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain amf3gpp:ManagedNFService ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:ManagedNFService.operationalState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ManagedNFService.operationalState" ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain amf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

amf3gpp:ManagedNFService.operations a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ManagedNFService.operations" ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain amf3gpp:ManagedNFService ;
    rdfs:range mf3gpp:Operation .

amf3gpp:ManagedNFService.registrationState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ManagedNFService.registrationState" ;
    rdfs:domain amf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

amf3gpp:ManagedNFService.sAP a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ManagedNFService.sAP" ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain amf3gpp:ManagedNFService ;
    rdfs:range types3gpp:SAP .

amf3gpp:ManagedNFService.usageState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ManagedNFService.usageState" ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain amf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

amf3gpp:ManagedNFService.userLabel a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ManagedNFService.userLabel" ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain amf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

amf3gpp:MappedCellIdInfo.mappedCellId a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:MappedCellIdInfo.mappedCellId" ;
    rdfs:comment """This attribute is in format of NCGI to indicate a fixed
geographical area (See subclause 16.14.5 in TS 38.300""" ;
    rdfs:domain amf3gpp:MappedCellIdInfo ;
    rdfs:range types5g3gpp:Ncgi .

amf3gpp:MappedCellIdInfo.ntnGeoArea a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:MappedCellIdInfo.ntnGeoArea" ;
    rdfs:comment """This attribute indicates a specific geographical location
mapped to Mapped Cell ID(s).""" ;
    rdfs:domain amf3gpp:MappedCellIdInfo ;
    rdfs:range types3gpp:GeoArea .

amf3gpp:N2InterfaceAmfInfo.amfName a rdf:Property ;
    rdfs:label "N2InterfaceAmfInfo.amfName" ;
    rdfs:comment """This attribute represents AMF Name FQDN as defined in
clause 28.3.2.5 of TS 23.003.""" ;
    rdfs:domain amf3gpp:N2InterfaceAmfInfo ;
    rdfs:range xsd:string .

amf3gpp:N2InterfaceAmfInfo.ipv4EndpointAddress a rdf:Property ;
    rdfs:label "N2InterfaceAmfInfo.ipv4EndpointAddress" ;
    rdfs:comment """This attribute represents available AMF endpoint
IPv4 address(es) for N2.""" ;
    rdfs:domain amf3gpp:N2InterfaceAmfInfo ;
    rdfs:range xsd:string .

amf3gpp:N2InterfaceAmfInfo.ipv6EndpointAddress a rdf:Property ;
    rdfs:label "N2InterfaceAmfInfo.ipv6EndpointAddress" ;
    rdfs:comment """This attribute represents available AMF endpoint
IPv6 address(es) for N2.""" ;
    rdfs:domain amf3gpp:N2InterfaceAmfInfo ;
    rdfs:range xsd:string .

amf3gpp:NTNGlobalRanNodeID.GlobalRanNodeIDValue a rdf:Property ;
    rdfs:label "NTNGlobalRanNodeID.GlobalRanNodeIDValue" ;
    rdfs:comment "this relies on the choice of GlobalRanNodeID" ;
    rdfs:domain amf3gpp:NTNGlobalRanNodeID ;
    rdfs:range xsd:string .

amf3gpp:NTNGlobalRanNodeID.GlobalgNBID a rdf:Property ;
    rdfs:label "NTNGlobalRanNodeID.GlobalgNBID" ;
    rdfs:comment "Unique identifier of a gNB." ;
    rdfs:domain amf3gpp:NTNGlobalRanNodeID ;
    rdfs:range xsd:long .

amf3gpp:NTNGlobalRanNodeID.Globalng-eNBID a rdf:Property ;
    rdfs:label "NTNGlobalRanNodeID.Globalng-eNBID" ;
    rdfs:comment """This represents the identifier of
the ng-eNB ID as specified in
clause 9.3.1.8 of 3GPP TS 38.413.""" ;
    rdfs:domain amf3gpp:NTNGlobalRanNodeID ;
    rdfs:range xsd:string .

amf3gpp:NTNGlobalRanNodeID.N3IWFID a rdf:Property ;
    rdfs:label "NTNGlobalRanNodeID.N3IWFID" ;
    rdfs:comment """This IE shall contain the N3IWF
identifier received over NGAP and
shall be encoded as a string of
hexadecimal characters.""" ;
    rdfs:domain amf3gpp:NTNGlobalRanNodeID ;
    rdfs:range xsd:string .

amf3gpp:NTNGlobalRanNodeID.TNGFID a rdf:Property ;
    rdfs:label "NTNGlobalRanNodeID.TNGFID" ;
    rdfs:comment """This represents the identifier of
the TNGF ID as specified in clause
9.3.1.161 of 3GPP TS 38.413 in hexadecimal
representation.""" ;
    rdfs:domain amf3gpp:NTNGlobalRanNodeID ;
    rdfs:range xsd:string .

amf3gpp:NTNGlobalRanNodeID.TWIFID a rdf:Property ;
    rdfs:label "NTNGlobalRanNodeID.TWIFID" ;
    rdfs:comment """This represents the TWIF identification
as specified in clause
9.3.1.163 of TS 38.413""" ;
    rdfs:domain amf3gpp:NTNGlobalRanNodeID ;
    rdfs:range xsd:string .

amf3gpp:NTNGlobalRanNodeID.W-AGFID a rdf:Property ;
    rdfs:label "NTNGlobalRanNodeID.W-AGFID" ;
    rdfs:comment """This represents the identifier of
the W-AGF ID as specified in
clause 9.3.1.162 of 3GPP TS 38.413
in hexadecimal representation.""" ;
    rdfs:domain amf3gpp:NTNGlobalRanNodeID ;
    rdfs:range xsd:string .

amf3gpp:NTNGlobalRanNodeID.pLMNId a owl:ObjectProperty ;
    rdfs:label "NTNGlobalRanNodeID.pLMNId" ;
    rdfs:comment """The PLMN Identifier is composed of
a Mobile Country Code (MCC) and
a Mobile Network Code (MNC).""" ;
    rdfs:domain amf3gpp:NTNGlobalRanNodeID ;
    rdfs:range amf3gpp:pLMNId .

amf3gpp:NTNPLMNRestrictionsInfo.blockedLocationInfoList a owl:ObjectProperty ;
    rdfs:label "NTNPLMNRestrictionsInfo.blockedLocationInfoList" ;
    rdfs:comment """This defines the information related with the location
for which the access restrictions are to be applied in case of NTN.""" ;
    rdfs:domain amf3gpp:NTNPLMNRestrictionsInfo ;
    rdfs:range amf3gpp:BlockedLocationInfo .

amf3gpp:NTNPLMNRestrictionsInfo.pLMNId a owl:ObjectProperty ;
    rdfs:label "NTNPLMNRestrictionsInfo.pLMNId" ;
    rdfs:comment "This attribute represents a PLMN Identity." ;
    rdfs:domain amf3gpp:NTNPLMNRestrictionsInfo ;
    rdfs:range amf3gpp:pLMNId .

amf3gpp:NTNTimeBasedConfig.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:NTNTimeBasedConfig.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain amf3gpp:NTNTimeBasedConfig ;
    rdfs:range xsd:string .

amf3gpp:NTNTimeBasedConfig.nTNEntityConfigList a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:NTNTimeBasedConfig.nTNEntityConfigList" ;
    rdfs:comment """It contains a list of configuration
updates to be applied to specified NTN entities.""" ;
    rdfs:domain amf3gpp:NTNTimeBasedConfig ;
    rdfs:range ntn3gpp:NTNEntityConfig .

amf3gpp:NTNTimeBasedConfig.timeWindow a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:NTNTimeBasedConfig.timeWindow" ;
    rdfs:comment "It defines the time window." ;
    rdfs:domain amf3gpp:NTNTimeBasedConfig ;
    rdfs:range types3gpp:TimeWindow .

amf3gpp:NtnLocationInfo.availabilityWindows a owl:ObjectProperty ;
    rdfs:label "NtnLocationInfo.availabilityWindows" ;
    rdfs:comment """This attribute defines the list of time windows at which
the satellite coverage will be available for this location.
Either availabilityWindows or nonAvailabilityWindows shall be present.""" ;
    rdfs:domain amf3gpp:NtnLocationInfo ;
    rdfs:range types3gpp:TimeWindow .

amf3gpp:NtnLocationInfo.location a owl:ObjectProperty ;
    rdfs:label "NtnLocationInfo.location" ;
    rdfs:comment """This defines the Location (geographical area) under
consideration to which the satellite coverage info belongs""" ;
    rdfs:domain amf3gpp:NtnLocationInfo ;
    rdfs:range types3gpp:GeoArea .

amf3gpp:NtnLocationInfo.nonAvailabilityWindows a owl:ObjectProperty ;
    rdfs:label "NtnLocationInfo.nonAvailabilityWindows" ;
    rdfs:comment """This attribute defines the list of time windows at which
the satellite coverage will not be available for this location.
Either availabilityWindows or nonAvailabilityWindows shall be present.""" ;
    rdfs:domain amf3gpp:NtnLocationInfo ;
    rdfs:range types3gpp:TimeWindow .

amf3gpp:PerfMetricJob._linkToFiles a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob._linkToFiles" ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:PerfMetricJob.administrativeState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.administrativeState" ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

amf3gpp:PerfMetricJob.conditionMonitorRef a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.conditionMonitorRef" ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    y2r:isReference true .

amf3gpp:PerfMetricJob.fileLocation a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.fileLocation" ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

amf3gpp:PerfMetricJob.fileReportingPeriod a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.fileReportingPeriod" ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:unsignedInt .

amf3gpp:PerfMetricJob.granularityPeriod a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.granularityPeriod" ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:unsignedInt .

amf3gpp:PerfMetricJob.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

amf3gpp:PerfMetricJob.jobId a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.jobId" ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:PerfMetricJob.notificationRecipientAddress a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.notificationRecipientAddress" ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

amf3gpp:PerfMetricJob.objectInstances a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.objectInstances" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    y2r:isReference true .

amf3gpp:PerfMetricJob.operationalState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.operationalState" ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

amf3gpp:PerfMetricJob.performanceMetrics a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.performanceMetrics" ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

amf3gpp:PerfMetricJob.rootObjectInstances a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.rootObjectInstances" ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    y2r:isReference true .

amf3gpp:PerfMetricJob.schedulerRef a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.schedulerRef" ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    y2r:isReference true .

amf3gpp:PerfMetricJob.streamTarget a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:PerfMetricJob.streamTarget" ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain amf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

amf3gpp:SatelliteBackhaulInfo.GlobalRanNodeIDValue a rdf:Property ;
    rdfs:label "SatelliteBackhaulInfo.GlobalRanNodeIDValue" ;
    rdfs:comment "this relies on the choice of GlobalRanNodeID" ;
    rdfs:domain amf3gpp:SatelliteBackhaulInfo ;
    rdfs:range xsd:string .

amf3gpp:SatelliteBackhaulInfo.geoSatelliteId a rdf:Property ;
    rdfs:label "SatelliteBackhaulInfo.geoSatelliteId" ;
    rdfs:comment "Unique identifier of a GEO satellite." ;
    rdfs:domain amf3gpp:SatelliteBackhaulInfo ;
    rdfs:range xsd:string .

amf3gpp:SatelliteBackhaulInfo.nTNGlobalRanNodeID a owl:ObjectProperty ;
    rdfs:label "SatelliteBackhaulInfo.nTNGlobalRanNodeID" ;
    rdfs:comment "Unique identifier of an NG-RAN node." ;
    rdfs:domain amf3gpp:SatelliteBackhaulInfo ;
    rdfs:range amf3gpp:NTNGlobalRanNodeID .

amf3gpp:SatelliteBackhaulInfo.satelliteBackhaulCategory a rdf:Property ;
    rdfs:label "SatelliteBackhaulInfo.satelliteBackhaulCategory" ;
    rdfs:comment """Satellite backhaul category refers to the type of the
satellite used in the backhaul. Only a single backhaul category
can be indicated.""" ;
    rdfs:domain amf3gpp:SatelliteBackhaulInfo ;
    rdfs:range xsd:string .

amf3gpp:SatelliteCoverageInfo.locationInfo a owl:ObjectProperty ;
    rdfs:label "SatelliteCoverageInfo.locationInfo" ;
    rdfs:comment """This attribute defines the information about location and
corresponding time windows for which the satellite coverage will be
available or unavailable.""" ;
    rdfs:domain amf3gpp:SatelliteCoverageInfo ;
    rdfs:range amf3gpp:NtnLocationInfo .

amf3gpp:SatelliteCoverageInfo.nRSatelliteRATtype a rdf:Property ;
    rdfs:label "SatelliteCoverageInfo.nRSatelliteRATtype" ;
    rdfs:comment """This attribute defines the RAT Type for NR satellite
access.""" ;
    rdfs:domain amf3gpp:SatelliteCoverageInfo ;
    rdfs:range xsd:string .

amf3gpp:SliceExpiryInfo.expiryTime a rdf:Property ;
    rdfs:label "SliceExpiryInfo.expiryTime" ;
    rdfs:comment """This attribute provides information about the time at
which the slice is scheduled to be expired as it is not required
anymore.
This attribute will be set based on the sliceAvailability coming as
part of ServiceProfile.""" ;
    rdfs:domain amf3gpp:SliceExpiryInfo ;
    rdfs:range xsd:string .

amf3gpp:SliceExpiryInfo.pLMNInfo a owl:ObjectProperty ;
    rdfs:label "SliceExpiryInfo.pLMNInfo" ;
    rdfs:comment "It defines the PLMN(s) of a Network Function. " ;
    rdfs:domain amf3gpp:SliceExpiryInfo ;
    rdfs:range amf3gpp:pLMNInfo .

amf3gpp:StmCtrl.administrativeState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:StmCtrl.administrativeState" ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain amf3gpp:StmCtrl ;
    rdfs:range xsd:string .

amf3gpp:StmCtrl.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:StmCtrl.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain amf3gpp:StmCtrl ;
    rdfs:range xsd:string .

amf3gpp:StmCtrl.operationalState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:StmCtrl.operationalState" ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain amf3gpp:StmCtrl ;
    rdfs:range xsd:string .

amf3gpp:StmCtrl.reportingNFList a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:StmCtrl.reportingNFList" ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain amf3gpp:StmCtrl ;
    y2r:isReference true .

amf3gpp:StmCtrl.stmTargetUri a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:StmCtrl.stmTargetUri" ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain amf3gpp:StmCtrl ;
    rdfs:range xsd:string .

amf3gpp:StmCtrl.targetInterfaceInfoList a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:StmCtrl.targetInterfaceInfoList" ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain amf3gpp:StmCtrl ;
    rdfs:range stm3gpp:NetworkInterface .

amf3gpp:SupportedPerfMetricGroups.granularityPeriods a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:SupportedPerfMetricGroups.granularityPeriods" ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain amf3gpp:SupportedPerfMetricGroups ;
    rdfs:range xsd:unsignedInt .

amf3gpp:SupportedPerfMetricGroups.performanceMetrics a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:SupportedPerfMetricGroups.performanceMetrics" ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain amf3gpp:SupportedPerfMetricGroups ;
    rdfs:range xsd:string .

amf3gpp:SupportedPerfMetricGroups.reportingMethods a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:SupportedPerfMetricGroups.reportingMethods" ;
    rdfs:domain amf3gpp:SupportedPerfMetricGroups ;
    rdfs:range xsd:string .

amf3gpp:SupportedPerfMetricGroups.reportingPeriods a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:SupportedPerfMetricGroups.reportingPeriods" ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain amf3gpp:SupportedPerfMetricGroups ;
    rdfs:range xsd:unsignedInt .

amf3gpp:ThresholdMonitor.administrativeState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ThresholdMonitor.administrativeState" ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain amf3gpp:ThresholdMonitor ;
    rdfs:range xsd:string .

amf3gpp:ThresholdMonitor.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ThresholdMonitor.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain amf3gpp:ThresholdMonitor ;
    rdfs:range xsd:string .

amf3gpp:ThresholdMonitor.monitorGranularityPeriod a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ThresholdMonitor.monitorGranularityPeriod" ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain amf3gpp:ThresholdMonitor ;
    rdfs:range xsd:unsignedInt .

amf3gpp:ThresholdMonitor.objectInstances a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ThresholdMonitor.objectInstances" ;
    rdfs:domain amf3gpp:ThresholdMonitor ;
    y2r:isReference true .

amf3gpp:ThresholdMonitor.operationalState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ThresholdMonitor.operationalState" ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain amf3gpp:ThresholdMonitor ;
    rdfs:range xsd:string .

amf3gpp:ThresholdMonitor.rootObjectInstances a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ThresholdMonitor.rootObjectInstances" ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain amf3gpp:ThresholdMonitor ;
    y2r:isReference true .

amf3gpp:ThresholdMonitor.thresholdInfoList a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:ThresholdMonitor.thresholdInfoList" ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain amf3gpp:ThresholdMonitor ;
    rdfs:range meas3gpp:ThresholdInfo .

amf3gpp:TraceJob.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range xsd:string .

amf3gpp:TraceJob.jobId a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.jobId" ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

amf3gpp:TraceJob.jobType a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.jobType" ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range xsd:string .

amf3gpp:TraceJob.listOfTraceMetrics a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.listOfTraceMetrics" ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range xsd:string .

amf3gpp:TraceJob.mdtConfig a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.mdtConfig" ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed. For NTN MDT, if the list of plmnList is included, it will
only log measurements for the cells belonging to the listed PLMNs.""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range trace3gpp:MdtConfig .

amf3gpp:TraceJob.nPNTarget a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.nPNTarget" ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range types3gpp:NpnId .

amf3gpp:TraceJob.pLMNTarget a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.pLMNTarget" ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range amf3gpp:pLMNTarget .

amf3gpp:TraceJob.rrcReportType a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.rrcReportType" ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range xsd:string .

amf3gpp:TraceJob.traceCollectionEntityIPAddress a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.traceCollectionEntityIPAddress" ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range xsd:string .

amf3gpp:TraceJob.traceConfig a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.traceConfig" ;
    rdfs:comment "Trace config" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range trace3gpp:TraceConfig .

amf3gpp:TraceJob.traceReference a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.traceReference" ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range trace3gpp:TraceReference .

amf3gpp:TraceJob.traceReportingConsumerUri a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.traceReportingConsumerUri" ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range xsd:string .

amf3gpp:TraceJob.traceReportingFormat a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.traceReportingFormat" ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range xsd:string .

amf3gpp:TraceJob.traceTarget a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-amffunction:TraceJob.traceTarget" ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain amf3gpp:TraceJob ;
    rdfs:range amf3gpp:traceTarget .

