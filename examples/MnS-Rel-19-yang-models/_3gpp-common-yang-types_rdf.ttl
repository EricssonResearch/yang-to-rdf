@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> a rdfs:Class ;
    rdfs:label "GeoArea" ;
    rdfs:comment "geographical areas for NTN MDT" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> a rdfs:Class ;
    rdfs:label "GeoCoordinate" ;
    rdfs:comment """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> a rdfs:Class ;
    rdfs:label "NpnId" ;
    rdfs:comment """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-common-yang-types/SAP> a rdfs:Class ;
    rdfs:label "SAP" ;
    rdfs:comment "The service access point of the managed NF service instance" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Tai> a rdfs:Class ;
    rdfs:label "Tai" ;
    rdfs:comment "Tracking Area Identity list" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> a rdfs:Class ;
    rdfs:label "TimeWindow" ;
    rdfs:comment """This specifies the time window for which the MWAB can act
as MWAB-gNB. If the allowed time window/ validity indicates 20th June,
10 am to 5 pm of the day, the MWAB acts as an MWAB g-NB only during 20th
June, 10 am to 5 pm of the day, and does not act as MWAB-gNB for any
other time. (See sub clause 5.49 [11]).""" .

<urn:3gpp:sa5:_3gpp-common-yang-types> a owl:Ontology ;
    rdfs:label "_3gpp-common-yang-types" ;
    dcterms:description """The model defines a YANG mapping of the top level
information classes used for management of 5G networks and
network slicing.
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.623" ;
    dcterms:title "_3gpp-common-yang-types" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-10-07 (CR-0573 CR-0582 CR-583)" .

<urn:3gpp:sa5:_3gpp-common-yang-types/AdministrativeState> a rdfs:Datatype ;
    rdfs:label "AdministrativeState" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Altitude> a rdfs:Datatype ;
    rdfs:label "Altitude" ;
    rdfs:comment "Height from a reference 0 value." .

<urn:3gpp:sa5:_3gpp-common-yang-types/AmfPointer> a rdfs:Datatype ;
    rdfs:label "AmfPointer" .

<urn:3gpp:sa5:_3gpp-common-yang-types/AmfRegionId> a rdfs:Datatype ;
    rdfs:label "AmfRegionId" .

<urn:3gpp:sa5:_3gpp-common-yang-types/AmfSetId> a rdfs:Datatype ;
    rdfs:label "AmfSetId" .

<urn:3gpp:sa5:_3gpp-common-yang-types/AvailabilityStatus> a rdfs:Datatype ;
    rdfs:label "AvailabilityStatus" .

<urn:3gpp:sa5:_3gpp-common-yang-types/BasicAdministrativeState> a rdfs:Datatype ;
    rdfs:label "BasicAdministrativeState" .

<urn:3gpp:sa5:_3gpp-common-yang-types/CagId> a rdfs:Datatype ;
    rdfs:label "CagId" ;
    rdfs:comment """This represents the identifier of a Closed Access
Group (CAG), which together with a PLMN ID is used to
identify a PNI-NPN.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/CellState> a rdfs:Datatype ;
    rdfs:label "CellState" .

<urn:3gpp:sa5:_3gpp-common-yang-types/DateMonth> a rdfs:Datatype ;
    rdfs:label "DateMonth" .

<urn:3gpp:sa5:_3gpp-common-yang-types/DateMonthDay> a rdfs:Datatype ;
    rdfs:label "DateMonthDay" .

<urn:3gpp:sa5:_3gpp-common-yang-types/DayOfWeek> a rdfs:Datatype ;
    rdfs:label "DayOfWeek" .

<urn:3gpp:sa5:_3gpp-common-yang-types/DistinguishedName> a rdfs:Datatype ;
    rdfs:label "DistinguishedName" ;
    rdfs:comment """Represents the 3GPP standard for DistinguishedName.

Limitations:
- RDNSeparator: don't allow SpaceChar or CarriageReturnChar
- NullDN: Disallow nullDN that is the same as not providing a DN
- NamesOfClassAndNamingAttribute format not allowed
(eg. ManagedElement.mykey=345436)""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/EnabledDisabled> a rdfs:Datatype ;
    rdfs:label "EnabledDisabled" .

<urn:3gpp:sa5:_3gpp-common-yang-types/EutraCellId> a rdfs:Datatype ;
    rdfs:label "EutraCellId" ;
    rdfs:comment """28-bit string identifying an E-UTRA Cell Id
as specified in clause 9.3.1.9 of 3GPP TS 38.413
in hexadecimal representation. Each character in the
string shall take a value of '0' to '9', 'a' to 'f'
or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most
significant bits of the Cell Id shall appear first in the
string, and the character representing the 4 least
significant bit of the Cell Id shall appear last in the
string.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/FullTime> a rdfs:Datatype ;
    rdfs:label "FullTime" .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea/geoPolygon> a owl:ObjectProperty ;
    rdfs:label "geoPolygon" ;
    rdfs:comment """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate/altitude> a rdf:Property ;
    rdfs:label "altitude" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate/latitude> a rdf:Property ;
    rdfs:label "latitude" ;
    rdfs:comment """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate/longitude> a rdf:Property ;
    rdfs:label "longitude" ;
    rdfs:comment """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-yang-types/Latitude> a rdfs:Datatype ;
    rdfs:label "Latitude" ;
    rdfs:comment "Latitude values" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Load> a rdfs:Datatype ;
    rdfs:label "Load" ;
    rdfs:comment "Latest known load information of the NF, percentage " .

<urn:3gpp:sa5:_3gpp-common-yang-types/Longitude> a rdfs:Datatype ;
    rdfs:label "Longitude" ;
    rdfs:comment "Longitude values" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Mcc> a rdfs:Datatype ;
    rdfs:label "Mcc" ;
    rdfs:comment """The mobile country code consists of three decimal digits,
The first digit of the mobile country code identifies the geographic
region (the digits 1 and 8 are not used):""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Mnc> a rdfs:Datatype ;
    rdfs:label "Mnc" ;
    rdfs:comment """The mobile network code consists of two or three
decimal digits (for example: MNC of 001 is not the same as MNC of 01)""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/N1MessageClass> a rdfs:Datatype ;
    rdfs:label "N1MessageClass" .

<urn:3gpp:sa5:_3gpp-common-yang-types/N2InformationClass> a rdfs:Datatype ;
    rdfs:label "N2InformationClass" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Nci> a rdfs:Datatype ;
    rdfs:label "Nci" ;
    rdfs:comment """NR Cell Identity. The NCI shall be of fixed length of 36 bits
and shall be coded using full hexadecimal representation.
The exact coding of the NCI is the responsibility of each PLMN operator""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/NfType> a rdfs:Datatype ;
    rdfs:label "NfType" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Nid> a rdfs:Datatype ;
    rdfs:label "Nid" ;
    rdfs:comment """This represents the Network Identifier, which
together with a PLMN ID is used to identify a SNPN.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/NotificationType> a rdfs:Datatype ;
    rdfs:label "NotificationType" .

<urn:3gpp:sa5:_3gpp-common-yang-types/NpnId/cAGIdList> a rdf:Property ;
    rdfs:label "cAGIdList" ;
    rdfs:comment """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-yang-types/NpnId/nIDList> a rdf:Property ;
    rdfs:label "nIDList" ;
    rdfs:comment """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-yang-types/NpnId/plmnId> a owl:ObjectProperty ;
    rdfs:label "plmnId" ;
    rdfs:comment "It specifies the PLMN Id of the NPN network." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-common-yang-types/NrCellId> a rdfs:Datatype ;
    rdfs:label "NrCellId" ;
    rdfs:comment """36-bit string identifying an NR Cell Id
as specified in clause 9.3.1.7 of 3GPP TS 38.413
in hexadecimal representation. Each character in the
string shall take a value of '0' to '9', 'a' to 'f'
or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most
significant bits of the Cell Id shall appear first in the
string, and the character representing the 4 least
significant bit of the Cell Id shall appear last in the
string.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Nrpci> a rdfs:Datatype ;
    rdfs:label "Nrpci" ;
    rdfs:comment "Physical Cell Identity (PCI) of the NR cell." .

<urn:3gpp:sa5:_3gpp-common-yang-types/NsiId> a rdfs:Datatype ;
    rdfs:label "NsiId" .

<urn:3gpp:sa5:_3gpp-common-yang-types/OnOff> a rdfs:Datatype ;
    rdfs:label "OnOff" .

<urn:3gpp:sa5:_3gpp-common-yang-types/OperationalState> a rdfs:Datatype ;
    rdfs:label "OperationalState" .

<urn:3gpp:sa5:_3gpp-common-yang-types/QOffsetRange> a rdfs:Datatype ;
    rdfs:label "QOffsetRange" .

<urn:3gpp:sa5:_3gpp-common-yang-types/ResourceSharingLevel> a rdfs:Datatype ;
    rdfs:label "ResourceSharingLevel" .

<urn:3gpp:sa5:_3gpp-common-yang-types/SAP/host> a rdf:Property ;
    rdfs:label "host" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-yang-types/SAP/port> a rdf:Property ;
    rdfs:label "port" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-common-yang-types/Tac> a rdfs:Datatype ;
    rdfs:label "Tac" ;
    rdfs:comment """Tracking Area Code
2 or 3-octet string identifying a tracking area code as specified in
clause 9.3.3.10 of 3GPP TS 38.413 [34], in hexadecimal representation.
Each character in the string shall take a value of
'0' to '9', 'a' to 'f' or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most significant
bits of the TAC shall appear first in the string, and the character
representing the 4 least significant bit of the TAC shall appear last
in the string.

pattern: '(^[A-Fa-f0-9]{4}$)|(^[A-Fa-f0-9]{6}$)'

Examples:
A legacy TAC 0x4305 shall be encoded as '4305'.
An extended TAC 0x63F84B shall be encoded as '63F84B'""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Tai/plmnId> a owl:ObjectProperty ;
    rdfs:label "plmnId" ;
    rdfs:comment "PLMN Identity." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-common-yang-types/Tai/tac> a rdf:Property ;
    rdfs:label "tac" ;
    rdfs:comment "Tracking Area Code" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-yang-types/TenthOfDegrees> a rdfs:Datatype ;
    rdfs:label "TenthOfDegrees" ;
    rdfs:comment """A single integral value corresponding to an angle in degrees
between 0 and 360 with a resolution of 0.1 degrees.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow/endTime> a rdf:Property ;
    rdfs:label "endTime" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow/startTime> a rdf:Property ;
    rdfs:label "startTime" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-yang-types/TxDirection> a rdfs:Datatype ;
    rdfs:label "TxDirection" .

<urn:3gpp:sa5:_3gpp-common-yang-types/UeMobilityLevel> a rdfs:Datatype ;
    rdfs:label "UeMobilityLevel" .

<urn:3gpp:sa5:_3gpp-common-yang-types/usageState> a rdfs:Datatype ;
    rdfs:label "usageState" ;
    rdfs:comment """It describes whether or not the resource is actively in
use at a specific instant, and if so, whether or not it has spare
capacity for additional users at that instant. The value is READ-ONLY.""" .

