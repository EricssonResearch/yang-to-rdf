            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/pLMNInfoList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/pLMNInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/pLMNTargetShape> a sh:NodeShape ;
