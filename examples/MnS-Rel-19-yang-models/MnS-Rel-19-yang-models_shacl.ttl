<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/selectionConditionsShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/conditionItem> ;
            sh:description """It represent a single condition item that shall be
evaluated Instance shall be selected.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/selectionConditions/conditionItem> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/selectionConditions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/supiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start ofa SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g., IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/supiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g. IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/supiRangeList/end> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the set of SUPI's belonging to
this range.A SUPI value is considered part of the range if and
only if the SUPI string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/supiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/supiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/supportedVendorSpecificFeaturesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "IANA-assigned SMI Network Management Private Enterprise Code" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/supportedVendorSpecificFeatures/enterpriseCode> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vendorSpecificFeature> ;
            sh:description """VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/supportedVendorSpecificFeatures/vendorSpecificFeature> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/supportedVendorSpecificFeatures> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/tacRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of a TAC range,
to be used when the range of TAC's can be represented
as a hexadecimal range (e.g., TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/tacRangeList/start> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6}$)" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a TAC range,
to be used when the range of TAC's can be represented as
a hexadecimal range (e.g. TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/tacRangeList/end> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6})$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262)
representing the set of TAC's belonging to this range.
A TAC value is considered part of the range if and only if the
TAC string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/tacRangeList/nRTACpattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/tacRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/taiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/taiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/plmnId> ;
            sh:description "PLMN ID related to the TacRange." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/taiRangeList/plmnId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/tacRangeList> ;
            sh:description "The range of the TACs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/taiRangeList/tacRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/taiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vendorSpecificFeatureShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It is a string representing a proprietary feature
specific to a given vendor.
It is recommended that the case convention for these strings is the
same as for enumerated data types (i.e. UPPER_WITH_UNDERSCORE;
see 3GPP TS 29.501, clause 5.1.1).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vendorSpecificFeature/featureName> ],
        [ sh:datatype xsd:string ;
            sh:description "It is a string representing the version of the feature." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vendorSpecificFeature/featureVersion> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vendorSpecificFeature> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/versionsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/versions/apiVersionInUri> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/versions/apiFullVersion> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/versions/expiry> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/versions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates the onboard satellite Id.
It shall be formatted as a fixed 5-digit string, padding with
leading digits '0' to complete a 5-digit length.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/onboardSatelliteId> ;
            sh:pattern "[0-9]{5}" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the operator configurable capability supported
by the UPF.  (see clause 5.8.2.21 in TS 23.501, clause 5.4.2
in TS 29.571)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/uPFCapabilities> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/SupportedPerfMetricGroups> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdList> ;
            sh:description """A list of PLMN identifiers (Mobile Country Code and Mobile
Network Code).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/pLMNIdList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile> ;
            sh:description "Profile definition of a Managed NF (See TS 23.501)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/managedNFProfile> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo> ;
            sh:description """This attribute represents information of an UPF NF Instance.
Multiple upfInfo may be allowed to define different TAI list for each
supported S-NSSAI""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/upfInfo> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """List of Tracking Area Codes (legacy TAC or extended TAC)
where the represented management function is serving.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/nRTACList> ],
        [ sh:datatype xsd:string ;
            sh:description """It is a set of NSI ID. NSI ID is an identifier for
identifying the Core Network part of a Network Slice instance when
multiple Network Slice instances of the same Network Slice are deployed,
and there is a need to differentiate between them in the 5GC.
See NSI ID definition in clause 3.1 of TS 23.501 and
subclause 6.1.6.2.7 of  TS 29.531. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/cNSIIdList> ],
        [ sh:description """This attribute allows management system to initiate energy
saving activation or deactivation for the edge UPF.""" ;
            sh:in ( "TO_BE_ENERGYSAVING" "TO_BE_NOT_ENERGYSAVING" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/energySavingControl> ],
        [ sh:description """This attribute specifies the status regarding the energy
saving in the edge UPF.

If the value of energySavingControl is TO_BE_ENERGYSAVING, then it
shall be tried to achieve the value IS_ENERGYSAVING for the
energySavingState.

If the value of energySavingControl is TO_BE_NOT_ENERGYSAVING, then
it shall be tried to achieve the value IS_NOT_ENERGYSAVING for the
energySavingState. """ ;
            sh:in ( "IS_NOT_ENERGYSAVING" "IS_ENERGYSAVING" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/energySavingState> ],
        [ sh:datatype xsd:string ;
            sh:description """List of supported BMOs (Bridge Managed Objects) required
for integration with TSN system.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/supportedBMOList> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether the function is
on board the satellite.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/isOnboardSatellite> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAIShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAI/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAI/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAI> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAIsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAIs/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAIs/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAIs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPLMNsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPLMNs/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPLMNs/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPLMNs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPlmnsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPlmns/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPlmns/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPlmns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSNPNsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This is the Mobile Country Code (MCC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSNPNs/mCC> ],
        [ sh:datatype xsd:string ;
            sh:description """This is the Mobile Network Code (MNC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSNPNs/mNC> ],
        [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid
identifies an SNPN""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSNPNs/nId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSNPNs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSnpnsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSnpns/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSnpns/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSnpns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/atsssCapabilityShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """Indicates the ATSSS-LL capability to support procedures
related to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/atsssCapability/atsssLL> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates the MPTCP capability to support procedures related
to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/atsssCapability/mptcp> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF supports RTT measurement without
PMF (see clauses 5.32.2, 6.3.3.3 of TS 23.501).
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/atsssCapability/rttWithoutPmf> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/atsssCapability> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/collocatedNfInstancesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/collocatedNfInstances/nfInstanceId> ],
        [ sh:description "Type of Network Function." ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/collocatedNfInstances/nfType> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/collocatedNfInstances> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItemShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/id> ],
        [ sh:description """It represents the NF types of the consumers for
which the conditions included in this ConditionItem apply.
If this attribute is absent, the conditions are applicable
to all NF consumer types.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/consumerNfTypes> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiRangeList> ;
            sh:description """It represents a set of TAIs where the
NF(Service) instance under CANARY_RELEASE status shall
be selected for a certain UE""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/taiRangeList> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It represents a feature number of that NF Service
Instance,under CANARY_RELEASE status. This attribute only
applies when the          selectionConditions, where this
ConditionItem is included, is included in a NF Service Instance
This condition is evaluated to <true> when the service requests
froma consumer of this NF Service Instance require the support
of the indicated feature on the NF Service Instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/serviceFeature> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It represents a Vendor-Specific feature
number of thatNF Service Instance, under CANARY_RELEASE
status. This attribute only applies when the
selectionConditions, where this ConditionItem is included,
is included in a NF Service Instance.This condition is
evaluated to true when the service requests from a
consumer of this NF Service Instance require the support
of the indicated Vendor-Specific feature on the NF
Service Instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/vsServiceFeature> ],
        [ sh:datatype xsd:string ;
            sh:description """It represents a set of PEIs of the UEs for
which the NF(Service) instance under CANARY_RELEASE status
shall be selected""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/peiList> ],
        [ sh:datatype xsd:string ;
            sh:description """ It represents a set of TAIs where the NF
(Service) instance under CANARY_RELEASE status shall be
selected for a certain UE""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/dnnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supiRangeList> ;
            sh:description """It represents a set of SUPIs for which
the NF (Service) instance under CANARY_RELEASE status shall
be selected.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/supiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/gpsiRangeList> ;
            sh:description """It represents a set of GPSIs for which the NF
(Service)
instance under CANARY_RELEASE status shall be selected""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/gpsiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impuRangeList> ;
            sh:description """It represents a set of IMS Public Identities
for which the NF (Service) instance under CANARY_RELEASE
status shall be selected""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/impuRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impiRangeList> ;
            sh:description """It represents a set of IMS Private Identities
for which theNF (Service) instance under
CANARY_RELEASE status shall be selected.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem/impiRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptionsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "N1_MESSAGES" "N2_INFORMATION" "LOCATION_NOTIFICATION" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/notificationType> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/callbackUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the optional path segment(s) used to construct
the prefix of the Callback URIs during the reselection of an NF service
consumer, as described in 3GPP TS 29.501""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/callbackUriPrefix> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the callback URI to be used by NF Service
Producers located in PLMNs that are different from the PLMN of
the NF consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/interPlmnCallbackUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:in ( "5GMM" "SM" "LPP" "SMS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/n1MessageClass> ],
        [ sh:in ( "SM" "NRPPA" "PWS" "PWS_BCAL" "PWS_RF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/n2InformationClass> ],
        [ sh:description """This attribute identifies the API versions
(e.g. v1) supported for the default notification type""" ;
            sh:in ( "SM" "NRPPA" "PWS" "PWS_BCAL" "PWS_RF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/versions> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute shall contain the value of the Binding
Indication for the default subscription notification """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/binding> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the content encodings that are accepted by a
NF Service Consumer when receiving a notification related to a default
notification subscription""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/acceptedEncoding> ],
        [ sh:datatype xsd:string ;
            sh:description """It is a string, which indicates the features of the service
corresponding to the subscribed default notification, which are supported
by the NF (Service) instance acting as NF service consumer. The string
shall contain a bitmask indicating supported features in hexadecimal
representation:Each character in the string shall take a value
of 0 to 9, a to f or A to F """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/supportedFeatures> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates a list of service specific information. It may
be present when the notification request of the notification type may be
generated by multiple services, i.e. notifications from different
services may be received by the subscription.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions/serviceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String representing a Data Network." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/dnn> ],
        [ sh:datatype xsd:string ;
            sh:description """List of Data network access identifiers supported
by the UPF for this DNN.
The absence of this attribute indicates that the UPF
can be selected for this DNN for any DNAI.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/dnaiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRanges> ;
            sh:description """This attribute represents a list of ranges of NATed IPv6
prefixes.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/natedIpv6PrefixRanges> ],
        [ sh:description """List of PDU session type(s) supported by
the UPF for a specific DNN.""" ;
            sh:in ( "IPV4" "IPV6" "IPV4V6" "UNSTRUCTURED" "ETHERNET" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/pduSessionTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a list of Ipv4 Index supported by
the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/ipv4IndexList> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a list of Ipv6 Index supported
by the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/ipv6IndexList> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents the N6 Network Instance
(See TS 29.244) associated with the S-NSSAI and DNN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/networkInstance> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a map of a network instance per
DNAI for the DNN, where the key of the map is the DNAI (Data network
access identifier), see TS 23.501.

When present, the value of each entry of the map shall contain a N6
network instance that is configured for the DNAI indicated by the key.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/dnaiNwInstanceList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRanges> ;
            sh:description """This attribute represents a list of ranges of IPv4 addresses
handled by UPF. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/ipv4AddressRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRanges> ;
            sh:description """This attribute represents a list of ranges of IPv6 prefixes
handled by the UPF. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/ipv6PrefixRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRanges> ;
            sh:description """This attribute represents a list of ranges of NATed IPv4
addresses.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList/natedIpv4AddressRanges> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/gpsiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/gpsiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/gpsiRangeList/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/gpsiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/gpsiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impiRangeList/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impuRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impuRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impuRangeList/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impuRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/impuRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/interfaceUpfInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """User Plane interface type.
See TS 29.510[23] clause 6.1.6.3.9""" ;
            sh:in ( "N3" "N6" "N9" "DATA_FORWARDING" "N6MB" "N19MB" "N3MB" "NMB9" "S1U" "S5U" "S8U" "S11U" "S12" "S2AU" "S2BU" "N3TRUSTEDN3GPP" "N3UNTRUSTEDN3GPP" "N9ROAMING" "SGI" "N19" "SXAU" "SXBU" "N4U" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/interfaceUpfInfoList/interfaceType> ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/interfaceUpfInfoList/ipv4EndpointAddresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/interfaceUpfInfoList/ipv6EndpointAddresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/interfaceUpfInfoList/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """Network Instance (See TS 29.244) associated to the User
Plane interface""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/interfaceUpfInfoList/networkInstance> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/interfaceUpfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipEndPointsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipEndPoints/ipv4Address> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipEndPoints/ipv6Address> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipEndPoints/ipv6Prefix> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ],
        [ sh:in ( "TCP" "STCP" "UDP" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipEndPoints/transport> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipEndPoints/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipEndPoints> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRanges/start> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRanges/end> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRanges/start> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRanges/end> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfInstanceId> ],
        [ sh:description "Type of Network Function." ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfType> ],
        [ sh:datatype xsd:string ;
            sh:description """Operator defined information about the location
of the NF instance (e.g. geographic location, data center).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/locality> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the operator defined information about the
location of the NF instance. The key of the map shall be a (unique)
valid JSON string per clause 7 of IETF RFC 8259 [92], with a maximum
of 32 characters, representing a type of locality as defined in
clause 6.1.6.3.18.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/extLocality> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Static capacity information in the range of 0-65535,
expressed as a weight relative to other NF instances of
the same type; if capacity is also present in the nfServiceList
parameters, those will have precedence over this value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/capacity> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Dynamic load information, ranged from 0 to 100,
indicates the current load percentage of the NF.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/load> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the point in time in which the latest load
information (sent by the NF in the load attribute of the NF Profile)
was generated at the NF Instance.If the NF did not provide a timestamp,
the NRF should set it to the instant when the NRF received the message
where the NF provided the latest load information.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/loadTimeStamp> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """Timestamp when the NF was (re)started. The NRF shall notify
NFs subscribed to receiving notifications of changes of the NF profile,
if the NF recoveryTime is changed""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/recoveryTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the different service
instances of a same NF Service in the NF instance, supporting a same
API version, are capable to persist their resource state in shared
storage and therefore these resources are available after a new NF
service instance supporting the same API version is selected by a NF
Service Consumer """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfServicePersistence> ],
        [ sh:datatype xsd:string ;
            sh:description """A NF Set Identifier is a globally unique identifier of
a set of equivalent and interchangeable CP NFs from a given network
that provide distribution, redundancy and scalability
(see clause 5.21.3 of 3GPP TS 23.501 [2]).An NF Set Identifier shall
be constructed from the MCC, MNC, NID (for SNPN), NF type and a Set ID.
A NF Set Identifier shall be formatted as the following string:
set<Set ID>.<nftype>set.5gc.mnc<MNC>.mcc<MCC> for a NF Set in a PLMN, or
set<Set ID>.<nftype>set.5gc.nid<NID>.mnc<MNC>.mcc<MCC> for a NF Set
in a SNPN.At most one NF Set ID shall be indicated per PLMN-ID or SNPN
of the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfSetIdList> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates if the NF Service Consumer supports
or does not support receiving NF Profile Changes. It may be present in
the NFRegister or NFUpdate (NF Profile Complete Replacement) request and
shall be absent in the response (see Annex B 3GPP TS 29.510 [23]).  """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfProfileChangesSupportInd> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It represents NF Profile Partial Update Changes Support
Indicator. TRUE: the NF Service Consumer supports receiving NF Profile
Changes in the response to an NF Profile Partial Update operation.
FALSE (default): the NF Service Consumer does not support receiving
NF Profile Changes in the response to an NF Profile Partial Update
operation""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfProfilePartialUpdateChangesSupportInd> ],
        [ sh:description "Status of the NF Instance." ;
            sh:in ( "REGISTERED" "SUSPENDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfStatus> ],
        [ sh:datatype xsd:boolean ;
            sh:description """NF Profile Changes Indicator. This IE shall be absent
in the request to the NRF and may be included by the NRF
in NFRegister or NFUpdate (NF Profile Complete Replacement) response.
true: the NF Profile contains NF Profile changes.
false (default): complete NF Profile.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfProfileChangesInd> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter indicates the served geographical areas
of a NF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/servingScope> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Load Control based on LCI Header.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/lcHSupportInd> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Overload Control based on OCI Header .""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/olcHSupportInd> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Set(s)
indicated by the NfSetId, where the NF instance belongs.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfSetRecoveryTimeList> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Service
Set(s) configured in the NF instance, which are indicated by the
NfServiceSetId""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/serviceSetRecoveryTimeList> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter shall carry the list of SCP domains the
SCP belongs to, or the SCP domain the NF (other than SCP) or the SEPP
belongs to..""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/scpDomains> ],
        [ sh:datatype xsd:string ;
            sh:description """Vendor ID of the NF instance, according to the
IANA-assigned SMI Network Management Private Enterprise Codes [77].
allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits 0 to complete
a 6-digit string value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/vendorId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/hniList> ],
        [ sh:datatype xsd:string ;
            sh:description """If the NF needs to be discoverable by other
NFs in a different PLMN, then an FQDN that is used
for inter-PLMN routing is specified.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/interPlmnFqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description "It represents human readable name of the NF Instance" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfInstanceName> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF instance whose
nfStatus is set to REGISTERED is in Canary Release condition,
i.e. it should only be selected by NF Service Consumers under the
conditions indicated by the selectionConditions attribute.
True: the NF is under Canary Release condition, even if the
nfStatus is set to REGISTERED
False: the NF instance indicates its Canary Release condition
via the nfStatus attribute""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/canaryRelease> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF Service
Consumer should only select an NF Service Producer in Canary
Release condition.
True: the consumer shall only select producers in Canary Release
condition
False: the consumer may select producers not in Canary Release
condition""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/exclusiveCanaryReleaseSelection> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates a string uniquely identifying
Shared Profile Data. The format of the sharedProfileDataId shall be
a Universally Unique Identifier (UUID) version 4, as described in
IETF RFC 4122 [44]. The hexadecimal letters should be formatted as
lower-case characters by the sender, and they shall be handled as
case-insensitive by the receiver.
Example: 4ace9d34-2c69-4f99-92d5-a73a3fe8e23b""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/sharedProfileDataId> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the timestamp when the NF Instance is
planned to be shut down. This attribute may be present if the
nfStatus is set to UNDISCOVERABLE due to scheduled shutdown""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/shutdownTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "It represents a list of Resource Content Filter IDs" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/supportedRcfs> ],
        [ sh:datatype xsd:boolean ;
            sh:description """ManagedNFProfile.canaryPrecedenceOverPreferred  This
attribute indicates whether the NRF shall prioritize the NF Service
Producer in Canary Release condition over the preferences
(preferred-xxx, ext-preferred-xxx) present in NF discovery requests.
allowedValues:
True NRF shall prioritize NF Service Producers in Canary Release
condition at NF discovery requests, i.e. NF Service Producers
determined according to preferred-xxx and/or ext-preferred-xxx
shall be prioritized after the NF Service Producers in Canary
Release condition. The associated NF (service) priorities for Service
Producers in Canary Release condition shall not be modified by NRF.
False NRF shall prioritize the NF Service Producers according to
preferred-xxx and/or ext-preferred-xxx (i.e. Canary Release condition
in NF Service Producers shall not be prioritized over NF Service
Consumer preferences at NF discovery requests)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/canaryPrecedenceOverPreferred> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/collocatedNfInstances> ;
            sh:description """It represents information related to collocated NF
type(s) and corresponding NF Instances when the NF is collocated
with NFs supporting other NF types.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/collocatedNfInstances> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnList> ;
            sh:description """PLMN(s) of the Network Function.
This IE shall be present if this information
is available for the NF. If not provided, PLMN ID(s)
of the PLMN of the NRF are assumed for the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssais> ;
            sh:description """S-NSSAIs of the Network Function. If not
provided, the NF can serve any S-NSSAI. When present
this IE represents the list of S-NSSAIs supported in
all the PLMNs listed in the plmnList IE.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/sNssais> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPlmns> ;
            sh:description """PLMNs allowed to access the NF instance.
If not provided, any PLMN is allowed to access the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/allowedPlmns> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Time in seconds expected between 2 consecutive
heart-beat messages from an NF Instance to the NRF.
It may be included in the registration request.
When present in the request it shall contain the
heartbeat time proposed by the NF service consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/heartBeatTimer> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNPNList> ;
            sh:description """SNPN(s) of the Network Function. This attributeIE shall be
present if the NF pertains to one or more SNPNs.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/sNPNList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/perPlmnSnssaiList> ;
            sh:description """It includes the S-NSSAIs supported by the Network Function
for each PLMN supported by the Network Function. When present, it shall
override sNssais IE.If the perPlmnSnssaiList attribute is provided in
at least one NF Service, the S-NSSAIs supported per PLMN in the
NF Profile shall be the set or a superset of the perPlmnSnssaiList
of the NFService(s).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/perPlmnSnssaiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSNPNs> ;
            sh:description """SNPNs allowed to access the NF instance.
The absence of this attribute in the NF profile indicates that no SNPN,
other than the SNPN(s) registered in the snpnList attribute of the
NF Profile, is allowed to access the service instance""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/allowedSNPNs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAIs> ;
            sh:description """S-NSSAI of the allowed slices to access the NF instance.
If not provided, any slice is allowed to access the NF.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/allowedNSSAIs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions> ;
            sh:description """Notification endpoints for different notification types.
This attribute may contain multiple default subscriptions for a same
notification type; in that case, those default subscriptions are used
as alternative notification endpoints.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/defaultNotificationSubscriptions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices> ;
            sh:description """List of NF Service Instances. It shall include
the services produced by the NF that can be
discovered by other NFs.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/nfServices> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supportedVendorSpecificFeatures> ;
            sh:description """It indicates a map of Vendor-Specific features, where the
key of the map is the IANA-assigned SMI Network Management Private
Enterprise Codes and the value of each entry of the map shall be
a list (array) of VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/supportedVendorSpecificFeatures> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/selectionConditions> ;
            sh:description """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/selectionConditions> ],
        [ sh:datatype xsd:string ;
            sh:description """FQDN of the Network Function. For AMF, the
FQDN registered with the NRF shall be that of the AMF Name.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description "Host address of a NF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/hostAddr> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines NF Specific Service authorization
information. It shall include the NF type (s) and NF realms/origins
allowed to consume NF Service(s) of NF Service Producer """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/authzInfo> ],
        [ sh:description """Type of the NFs allowed to access the NF instance.
If not provided, any NF type is allowed to access the NF.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/allowedNfTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262
dialect [75]) representing the NF domain names within the PLMN of
the NRF allowed to access the NF instance If not provided,
any NF domain is allowed to access the NF.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile/allowedNfDomains> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/managedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRanges/start> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRanges/end> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRanges/start> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRanges/end> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServicesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique ID of the service instance within a given NF Instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/serviceInstanceID> ],
        [ sh:description "Name of the service instance (e.g. 'nudm-sdm')." ;
            sh:in ( "NNRF_NFM" "NNRF_DISC" "NUDM_SDM" "NUDM_UECM" "NUDM_UEAU" "NUDM_EE" "NUDM_PP" "NAMF_COMM" "NAMF_EVTS" "NAMF_MT" "NAMF_LOC" "NSMF_PDUSESSION" "NSMF_EVENT-EXPOSURE" "NAUSF_AUTH" "NAUSF_SORPROTECTION" "NNEF_PFDMANAGEMENT" "NPCF_AM-POLICY-CONTROL" "NPCF_SMPOLICYCONTROL" "NPCF_POLICYAUTHORIZATION" "NPCF_BDTPOLICYCONTROL" "NPCF_EVENTEXPOSURE" "NPCF_UE_POLICY_CONTROL" "NSMSF_SMS" "NNSSF_NSSELECTION" "NNSSF_NSSAIAVAILABILITY" "NUDR_DR" "NLMF_LOC" "N5G_EIR_EIC" "NBSF_MANAGEMENT" "NCHF_SPENDINGLIMITCONTROL" "NCHF_CONVERGEDCHARGING" "NNWDAF_EVENTSSUBSCRIPTION" "NNWDAF_ANALYTICSINFO" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/serviceName> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the allowed operations on resources for
a given NF Instance; the key of the map is the NF Instance Id, and
the value is an array of scopes""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/allowedOperationsPerNfInstance> ],
        [ sh:datatype xsd:boolean ;
            sh:description """When it is present and set to true, indicates that
the scopes defined in attribute allowedOperationsPerNfInstance
for a given NF Instance ID take precedence over the scopes defined
in attribute allowedOperationsPerNfType for the corresponding
NF type of the NF Instance associated to such NF Instance ID..""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/allowedOperationsPerNfInstanceOverrides> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the NF Service Instance requires
Oauth2-based authorization""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/oauth2Required> ],
        [ sh:datatype xsd:string ;
            sh:description """String uniquely identifying SharedServiceData. The format
of the sharedServiceDataId shall be a Universally Unique Identifier
(UUID) version 4, as described in IETF RFC 4122 [44]. The hexadecimal
letters should be formatted as lower-case characters by the sender,
and they shall be handled as case-insensitive by the receiver.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/sharedServiceDataId> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Priority (relative to other services of the same type)
in the range of 0-65535, to be used for NF Service selection; lower
values indicate a higher priority.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/priority> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Static capacity information in the range of 0-65535,
expressed as a weight relative to other services of the same type.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/capacity> ],
        [ sh:datatype xsd:string ;
            sh:description "Timestamp when the NF was (re)started." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/recoveryTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Vendor ID of the NF instance" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/vendorId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/versions> ;
            sh:description """API versions supported by the NF Service and if available,
the corresponding retirement date of the NF Service.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/versions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipEndPoints> ;
            sh:description """IP address(es) and port information of the Network Function
(including IPv4 and/or IPv6 address)where the service is listening
for incoming service requests.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/ipEndPoints> ],
        [ sh:description "URI scheme (e.g. 'http', 'https')." ;
            sh:in ( "HTTP" "HTTPS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/scheme> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/defaultNotificationSubscriptions> ;
            sh:description "Notification endpoints for different notification types." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/defaultNotificationSubscriptions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedPLMNs> ;
            sh:description """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/allowedPLMNs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedSnpns> ;
            sh:description """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/allowedSnpns> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/allowedNSSAI> ;
            sh:description """S-NSSAI of the allowed slices to access the service
instance. The absence of this attribute indicates that any slice
is allowed to access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/allowedNSSAI> ],
        [ sh:description "Status of the NF Service Instance." ;
            sh:in ( "REGISTERED" "SUSPENDED" "UNDISCOVERABLE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/nfServiceStatus> ],
        [ sh:datatype xsd:string ;
            sh:description "FQDN of the NF Service Instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """If the NF service needs to be discoverable by other NFs in a
different PLMN, then an FQDN that is used for inter PLMN routing.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/interPlmnFqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """Optional path segment(s) used to construct the {apiRoot}
variable of the different API URIs.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/apiPrefix> ],
        [ sh:description "SNPNs allowed to access the NF instance" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/allowedNfTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the NF domain names allowed to
access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/allowedNfDomains> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the allowed operations on resources for
each type of NF; the key of the map is the NF Type, and the value
is an array of scopes""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices/allowedOperationsPerNfType> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/nfServices> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/operations> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/perPlmnSnssaiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid
identifies an SNPN """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/perPlmnSnssaiList/nid> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnId> ;
            sh:description """PLMN ID for which list of supported S-NSSAI(s)
is provided.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/perPlmnSnssaiList/plmnId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiList> ;
            sh:description """The specific list of S-NSSAIs supported
by the given PLMN.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/perPlmnSnssaiList/sNssaiList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/perPlmnSnssaiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNPNListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Mobile Country Code (MCC) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNPNList/mcc> ],
        [ sh:datatype xsd:string ;
            sh:description "Mobile Network Code (MNC) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNPNList/mnc> ],
        [ sh:datatype xsd:string ;
            sh:description "Network Identifier (NID) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNPNList/nId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNPNList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai> ;
            sh:description """It represents the S-NSSAI the NetworkSlice managed object
is supporting. The S-NSSAI is defined in TS 23.003 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssai/snssai> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssaiExtension> ;
            sh:description "It represents extensions to the Snssai." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssai/snssaiExtension> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiUpfInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether the UPF supports redundant
transport path on the transport layer in the corresponding network
slice.
true: supported
false: not supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiUpfInfoList/redundantTransport> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssai> ;
            sh:description "Supported S-NSSAI." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiUpfInfoList/sNssai> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/dnnUpfInfoList> ;
            sh:description """It represents list of parameters supported by the UPF
per DNN.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiUpfInfoList/dnnUpfInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiUpfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaisShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssais/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssais/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssais> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sdRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an SD range.
This string shall be formatted as specified for the sd attribute of the
Snssai data type in clause 5.4.4.2 of TS 29.571.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sdRanges/start> ;
            sh:pattern "[A-Fa-f0-9]{6}" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of an SD range.
This string shall be formatted as specified for the sd attribute of the
Snssai data type in clause 5.4.4.2 in TS 29.571""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sdRanges/end> ;
            sh:pattern "[A-Fa-f0-9]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sdRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/selectionConditionsShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/conditionItem> ;
            sh:description """It represent a single condition item that shall be
evaluated Instance shall be selected.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/selectionConditions/conditionItem> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/selectionConditions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssaiExtensionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """It indicates that all SD values are supported for the
Slice/Service Type value indicated in the sst attribute of the Snssai
data type (see clause 5.4.4.2 in TS 29.571).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssaiExtension/wildcardSd> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sdRanges> ;
            sh:description """It shall contain the range(s) of Slice Differentiator values
supported for the Slice/Service Type value indicated in the sst
attribute of the Snssai data type (see clause 5.4.4.2 in TS 29.571).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssaiExtension/sdRanges> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssaiExtension> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssaiShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start ofa SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g., IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g. IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supiRangeList/end> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the set of SUPI's belonging to
this range.A SUPI value is considered part of the range if and
only if the SUPI string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supportedVendorSpecificFeaturesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "IANA-assigned SMI Network Management Private Enterprise Code" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supportedVendorSpecificFeatures/enterpriseCode> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vendorSpecificFeature> ;
            sh:description """VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supportedVendorSpecificFeatures/vendorSpecificFeature> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/supportedVendorSpecificFeatures> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tacRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of a TAC range,
to be used when the range of TAC's can be represented
as a hexadecimal range (e.g., TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tacRangeList/start> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6}$)" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a TAC range,
to be used when the range of TAC's can be represented as
a hexadecimal range (e.g. TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tacRangeList/end> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6})$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262)
representing the set of TAC's belonging to this range.
A TAC value is considered part of the range if and only if the
TAC string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tacRangeList/nRTACpattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tacRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/plmnId> ;
            sh:description "PLMN ID related to the TacRange." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiRangeList/plmnId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tacRangeList> ;
            sh:description "The range of the TACs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiRangeList/tacRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tngfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tngfInfo/ipv4EndpointAddresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tngfInfo/ipv6EndpointAddresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tngfInfo/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tngfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/twifInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/twifInfo/ipv4EndpointAddresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/twifInfo/ipv6EndpointAddresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/twifInfo/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/twifInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The SMF service area(s) the UPF can serve. See TS 29.510.
If not provided, the UPF can serve any SMF service area.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/smfServingArea> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether interworking with EPS is supported by
the UPF.
True: Supported
False: Not Supported""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/iwkEpsInd> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/sNssaiUpfInfoList> ;
            sh:description """This attribute represents a list of parameters supported by
the UPF per S-NSSAI.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/sNssaiUpfInfoList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/interfaceUpfInfoList> ;
            sh:description """List of User Plane interfaces configured on the UPF. When
this parameter is provided in the NF Discovery response, the NF Service
Consumer (e.g., SMF) may use this information for UPF selection.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/interfaceUpfInfoList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/atsssCapability> ;
            sh:description "Indicate the ATSSS capability of the UPF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/atsssCapability> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiList> ;
            sh:description "The list of TAIs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/taiRangeList> ;
            sh:description "The range of TAIs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/taiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/wAgfInfo> ;
            sh:description """Indicate that the UPF is collocated with W-AGF. If not
present, the UPF is not collocated with Wireline Access Gateway
Function (W-AGF).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/wAgfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/tngfInfo> ;
            sh:description """Indicate that the UPF is collocated with TNGF. If not
present, the UPF is not collocated with Trusted Non-3GPP Gateway
Function (TNGF).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/tngfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/twifInfo> ;
            sh:description """Indicate that the UPF is collocated with TWIF. If not
present, the UPF is not collocated with Trusted WLAN Interworking
Function (TWIF).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/twifInfo> ],
        [ sh:description "Indicates the type(s) of a PDU session." ;
            sh:in ( "IPV4" "IPV6" "IPV4V6" "UNSTRUCTURED" "ETHERNET" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/pduSessionTypes> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF supports allocating UE IP
addresses/prefixes.
true: supported
false: not supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/ueIpAddrInd> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """This parameter defines Priority (relative to other NFs of
the same type) in the range of 0-65535, to be used for NF selection;
lower values indicate a higher priority. If priority is also present
in the nfServiceList parameters, those will have precedence over
this value (See TS 29.510).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/priority> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF supports redundant GTP-U path.
true: supported
false: not supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/redundantGtpu> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF is configured for Inter-PLMN User
Plane Security (IPUPS). Any UPF can support the IPUPS functionality.
In network deployments where specific UPFs are used to provide IPUPS,
UPFs configured for providing IPUPS services shall be selected.
true: The UPF is configured for IPUPS.
false: The UPF is not configured for IPUPS""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/ipups> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF is configured for data forwarding.
Based on operator policies, if dedicated UPFs are preferred to be used
for indirect data forwarding during handover scenarios, when setting
up the indirect data forwarding tunnel, the SMF should preferably
select a UPF configured for data forwarding and use the network
instance indicated in the Network Instance ID associated to the
DATA_FORWARDING interface type in the interfaceUpfInfoList attribute.
true: the UPF is configured for data forwarding
false: the UPF is not configured for data forwarding

If the UPF is configured for data forwarding, it shall support UP
network interface with type 'DATA_FORWARDING'.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/dataForwarding> ],
        [ sh:datatype xsd:string ;
            sh:description """Supported Packet Forwarding Control Protocol (PFCP) Features.
A string used to indicate the PFCP features supported by the UPF,
which encodes the 'UP Function Features' as specified in
Table 8.2.25-1 of TS 29.244 (starting from Octet 5), in hexadecimal
representation.

Each character in the string shall take a value of '0' to '9', 'a'
to 'f' or 'A' to 'F' and each two characters shall represent one octet
of 'UP Function Features' (starting from Octet 5, to higher octets).
For each two characters representing one octet, the first character
representing the 4 most significant bits of the octet and the second
character the 4 least significant bits of the octet.

The supported PFCP features shall be provisioned in addition and be
consistent with the existing UPF features (atsssCapability, ueIpAddrInd,
redundantGtpu and ipups), e.g., if the ueIpAddrInd is set to 'true',
then the UEIP flag shall also be set to '1' in the supported PFCP
features.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/supportedPfcpFeatures> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether the UPF is configured to
support Sxa interface.
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo/sxaInd> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/upfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vendorSpecificFeatureShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It is a string representing a proprietary feature
specific to a given vendor.
It is recommended that the case convention for these strings is the
same as for enumerated data types (i.e. UPPER_WITH_UNDERSCORE;
see 3GPP TS 29.501, clause 5.1.1).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vendorSpecificFeature/featureName> ],
        [ sh:datatype xsd:string ;
            sh:description "It is a string representing the version of the feature." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vendorSpecificFeature/featureVersion> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vendorSpecificFeature> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/versionsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/versions/apiVersionInUri> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/versions/apiFullVersion> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/versions/expiry> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/versions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/wAgfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/wAgfInfo/ipv4EndpointAddresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/wAgfInfo/ipv6EndpointAddresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/wAgfInfo/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/wAgfInfo> .

<urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataTypeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Type of external management data as defined by the
implementation.

Examples: 'Electronic Map', 'Camara Data', 'UE path', 'Camera Photo',
'Event Schedule”""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/externalDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the media which includes the transfer protocol.

Examples:
sftp://companyA.com/datastore/fileName.xml
https://companyA.com/ManagedElement=1/Files=1/File=1""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/mediaLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the schema to parse a type of external management data.
The detailed schema definition for the different types of external
management data is out of scope of this specification.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/externalDataTypeSchema> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-externaldata/externalDataScope> ;
            sh:description """It describes the concrete scope which the external management
data is applicable.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/externalDataScope> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType> .

<urn:3gpp:sa5:_3gpp-common-externaldata/externalDataScopeShape> a sh:NodeShape ;
    sh:property [ sh:description """List of managed object instances to which the described
data are related. Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/externalDataScope/objectInstancesIncluded> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """List of managed object instances which are not considered
in relation to the described data. Each object instance is identified
by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/externalDataScope/objectInstancesExcluded> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-externaldata/geoAreas> ;
            sh:description "It describes the concrete geographical area(s)" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/externalDataScope/geoAreas> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-externaldata/externalDataScope> .

<urn:3gpp:sa5:_3gpp-common-externaldata/geoAreasShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-externaldata/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/geoAreas/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-externaldata/geoAreas> .

<urn:3gpp:sa5:_3gpp-common-externaldata/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-externaldata/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-externaldata/geoPolygon> .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name for the case the file content cannot be retrieved
by reading the 'fileContent' attribute.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Address of the notification recipient." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Setting this attribute to TRUE cancels the file download job.
As specified in the definition of ProcessMonitor, cancellation is
possible in the NOT_STARTED and RUNNING state. Setting the attribute
to FALSE has no observable result.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/cancelJob> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
            sh:description "Provides monitoring for the file download job." ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/jobMonitor> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Id of the process. It is unique within a single
multivalue attribute of type ProcessMonitor.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/id> ],
        [ sh:description "Status must not be 'PARTIALLY_FAILED'." ;
            sh:in ( "NOT_STARTED" "RUNNING" "CANCELLING" "FINISHED" "FAILED" "PARTIALLY_FAILED" "CANCELLED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/status> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description "Progress of the associated process as percentage" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/progressPercentage> ],
        [ sh:datatype xsd:string ;
            sh:description """Additional textual qualification of the states
'NOT_STARTED', 'CANCELLING' and 'RUNNING'.

For specific processes, specific well-defined strings (e.g. string
patterns or enums) may be defined as a specialisation.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/progressStateInfo> ],
        [ sh:datatype xsd:string ;
            sh:description """If status is FAILED resultStateInfo will be one of
the following or empty.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/resultStateInfo> ],
        [ sh:datatype xsd:string ;
            sh:description """Start time of the associated process, i.e. the time when the
status changed from 'NOT_STARTED' to 'RUNNING'.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/startTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time when status changed to 'SUCCESS', 'CANCELLED',
'FAILED' or 'PARTIALLY_FAILED'.

If the time is in the future, it is the estimated time
the process will end.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/endTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Time until the associated process is automatically cancelled.
If set, the system decreases the timer with time. When it reaches zero
the cancellation of the associated process is initiated by the
MnS_Producer.
If not set, there is no time limit for the process.

Once the timer is set, the consumer can not change it anymore.
If the consumer has not set the timer the MnS Producer may set it.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/timer> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> .

<urn:3gpp:sa5:_3gpp-common-managed-element/AlarmListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/id> ],
        [ sh:description """When set to UNLOCKED, the alarm list is updated.
When the set to LOCKED, the existing alarm records are not
updated, and new alarm records are not added to the alarm list.""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/administrativeState> ],
        [ sh:description """The producer sets this attribute to ENABLED, indicating
that it has the resource and ability to record alarm in AlarmList
else, it sets the attribute to DISABLED.""" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "The number of alarm records in the AlarmList" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/numOfAlarmRecords> ],
        [ sh:datatype xsd:string ;
            sh:description "The last time when an alarm record was modified" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/lastModification> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Identifies, the part of the alarm scope that may not be
reliable.

If this parameter is equal to the instance carried in systemDN,
then all AlarmRecord instances in the AlarmList may not be reliable.

If this parameter is equal to some instance represented by
MonitoredEntity, then only AlarmRecord related to this instance and
its descendants may not be reliable.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/unreliableAlarmScope> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords> ;
            sh:description "List of alarmRecords" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/alarmRecords> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/Configurable5QISetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/Configurable5QISet/id> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/Configurable5QISet> .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/id> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of an EAS instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eASIpAddress> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/uPFConnectionInfo> ;
            sh:description """The attribute is defined as a datatype UPFConnInfo
(see clause 5.3.121). It is used to provide the UPF IP address and
UPF DN. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/uPFConnectionInfo> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of an EES instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373). """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eESIpAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of an ECS instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eCSIpAddress> ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier of the edge data network (See TS 23.558)." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/ednIdentifier> ],
        [ sh:description """It indicates the type of ECM connection (i.e., user plane
connection via UPF, control plane connection via PCF or NEF.""" ;
            sh:in ( "USERPLANE" "CONTROLPLANE" "BOTH" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/ecmConnectionType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/eASServiceArea> ;
            sh:description """This parameter defines the EAS service area
(see clause 7.3.3.6 in TS 23.558).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eASServiceArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/eESServiceArea> ;
            sh:description """This parameter defines the EES service area
(see clause 7.3.3.5 in TS 23.558).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eESServiceArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/eDNServiceArea> ;
            sh:description """This parameter defines the EDN service area
(see clause 7.3.3.4 in TS 23.558)""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eDNServiceArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/_5GCNfConnEcmInfoList> ;
            sh:description """The attribute specifies a list of 5GCNfConnInfo which is
defined as a datatype (see clause 5.3.120). It is used to
provide 5GC NFs, such as PCF, NEF, SCEF, that are connected EDN NFs,
such as EAS, EES, and ECS.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/_5GCNfConnEcmInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> .

<urn:3gpp:sa5:_3gpp-common-managed-element/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/File> .

<urn:3gpp:sa5:_3gpp-common-managed-element/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/Files> .

<urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristicsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/id> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Identifies the 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/fiveQIValue> ],
        [ sh:description """It indicates the Resource Type of a 5QI, as specified
in TS 23.501 """ ;
            sh:in ( "GBR" "NON_GBR" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/resourceType> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It indicates the Priority Level of a 5QI, as specified
in TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/priorityLevel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Indicates the Packet Delay Budget (in unit of 0.5ms)of a 5QI,
as specified in TS 23.501 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/packetDelayBudget> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/averagingWindow> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/maximumDataBurstVolume> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/packetErrorRate> ;
            sh:description """It indicates the Packet Error Rate of a 5QI,
as specified in TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/packetErrorRate> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics> .

<urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl/id> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the periodicity of heartbeat notification emission.
The value of zero has the special meaning of stopping the heartbeat
notification emission.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl/heartbeatNtfPeriod> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Setting this attribute to 'true' triggers an immediate
additional heartbeat notification emission. Setting the value to
'false' has no observable result.

The periodicity of notifyHeartbeat emission is not changed.

After triggering the heartbeat the system SHALL set the value
back to false.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl/triggerHeartbeatNtf> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl> .

<urn:3gpp:sa5:_3gpp-common-managed-element/MWABShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/id> ],
        [ sh:description """It indicates the operational state of the MWAB instance.
It describes whether the resource is installed and partially or fully
operable (Enabled) or the resource is not installed or not
operable (Disabled).""" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/operationalState> ],
        [ sh:description """It indicates the administrative state of the MWAB instance.
It describes the permission to use or prohibition against using the
MWAB functionalities, imposed through the OAM services.""" ;
            sh:in ( "LOCKED" "UNLOCKED" "SHUTTINGDOWN" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/administrativeState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/mnrOamIPConfig> ;
            sh:description """It is IP configutation for OAM connectivity used
by a mobile NR node (e.g., IAB-node, MWAB-node)
to establish connection with management system as specified
in TS 28.314[x] clause 6.1.2""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/mnrOamIPConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/allowedArea> ;
            sh:description """This specifies the area where the MWAB can act as MWAB-gNB.
If the OAM indicates that the MWAB can act as MWAB-gNB is allowed areas,
it acts as MWAB-gNB only on the allowed area only.
(See sub clause 5.49 TS 28.662).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/allowedArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/allowedTime> ;
            sh:description """This specifies the time window for which the MWAB can act
as MWAB-gNB. If the allowed time window/ validity indicates 20th June,
10 am to 5 pm of the day, the MWAB acts as an MWAB g-NB only during 20th
June, 10 am to 5 pm of the day, and does not act as MWAB-gNB for any
other time. (See sub clause 5.49 [11]).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/allowedTime> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/currentLocation> ;
            sh:description """This parameter specifies the current location
of mobile NR node (e.g., IAB-node, MWAB-node).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/currentLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB> .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElementShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/id> ],
        [ sh:description """Provides naming context that allows the Managed
Elements to be partitioned into logical domains.
A Distingushed Name(DN) is defined by 3GPP TS 32.300,
which splits the DN into a DN Prefix and Local DN""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/dnPrefix> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/supportedTraceMetrics> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/SupportedPerfMetricGroups> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The physical location (e.g. an address) of an entity
represented by a (derivative of) ManagedElement_. It may contain no
information to support the case where the derivative of
ManagedElement_ needs to represent a distributed multi-location NE.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/locationName> ],
        [ sh:description """Relates to the role played by ManagementSystem_ in the
between ManagedSystem_ and ManagedElement_. This attribute contains
a list of the DN(s) of the related subclasses of
ManagementSystem_ instance(s).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/managedBy> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The type of functionality provided by the ManagedElement.
It may represent one ME functionality or a combination of
more than one functionality.
1) The allowed values of this attribute are the names of the IOC(s)
that are (a) derived/subclassed from ManagedFunction and (b) directly
name-contained by ManagedElement IOC (on the first level below
ManagedElement), but with the string 'Function' excluded.
2) If a ManagedElement contains multiple instances of a ManagedFunction
this attribute will not contain repeated values.
3) The capitalisation (usage of upper/lower case) of characters in this
attribute is insignificant.  Thus, the NodeB should be case insensitive
when reading these values.
4) Two examples of allowed values are:
-  NodeB;
-  HLR, VLR.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/managedElementTypeList> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/vendorName> ],
        [ sh:datatype xsd:string ;
            sh:description "An operator defined state for operator specific usage" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/userDefinedState> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/swVersion> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/priorityLabel> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> .

<urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRuleShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule/id> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """The minimum value of to be applied
for mapping from this attribute to the energy cost.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule/eCMRInputMinValue> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """The maximum value of to be applied
for mapping from this attribute to the energy cost.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule/eCMRInputMaxValue> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Time interval (in seconds) that
should be applied for collecting values of mapping
rule attribute to be used for computing the energy cost.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule/eCTimeInterval> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule> .

<urn:3gpp:sa5:_3gpp-common-managed-element/NotificationListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/id> ],
        [ sh:datatype xsd:string ;
            sh:description """eventTime of first notification available.
The attribute may be missing if and only if there are no notifications
in the NotificationList.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/firstEventTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """eventTime of latest notification available.
The attribute may be missing if and only if there are no notifications
in the NotificationList.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/lastEventTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "List of notification types." ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/notificationTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Filter to be applied to candidate notifications identified
by the notificationTypes attribute. Only notifications that pass the
filter criteria are included. All other notifications are discarded.
The filter can be applied to any field of a notification.

The format of the string shall confrm to a
JSON expressions (Jex) 'JexConditionsExpr'""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/notificationFilter> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/notificationEntries> ;
            sh:description """Representation of the individual notifications.
The entries shall be ordered based on eventTime of the notification,
newest first.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/notificationEntries> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/id> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Defines the types of notifications that are candidates
for being forwarded to the notification recipient.
If the notificationTypes attribute is not supported or not present
all candidate notifications types are forwarded to the notification;
discriminated by notificationFilter attribute.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/notificationTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Defines a filter to be applied to candidate notifications
identified by the notificationTypes attribute.
If notificationFilter is present, only notifications that pass the
filter criteria are forwarded to the notification recipient; all other
notifications are discarded.
The filter can be applied to any field of a notification.

The format of the string shall confrm to a
JSON expressions (Jex) 'JexConditionsExpr'""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/notificationFilter> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description """The sequence number of the last notification that was sent
by a 'NtfSubscriptionControl' instance.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/lastSequenceNo> ],
        [ sh:description """Operational state of manged object instance.
The operational state describes if an object instance is operable
('ENABLED') or inoperable ('DISABLED').
This state is set by the object instance or the MnS producer and
is hence READ-ONLY.""" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/operationalState> ],
        [ sh:description """The availability status provides additional information
about the operational state""" ;
            sh:in ( "IN_TEST" "FAILED" "POWER_OFF" "OFF_LINE" "OFF_DUTY" "DEPENDENCY" "DEGRADED" "NOT_INSTALLED" "LOG_FULL" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/availabilityStatus> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/scope> ;
            sh:description "Scopes (selects) data nodes in an object tree." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/scope> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl> .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl> .

<urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotificationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications/id> ],
        [ sh:datatype xsd:string ;
            sh:description "List of notification types supported by the MnS producer" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications/notificationTypes> ],
        [ sh:description "List of protocols supported for notifications." ;
            sh:in ( "HTTP" "HTTP_VES_ENCAPS" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications/notificationProtocols> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications> .

<urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> .

<urn:3gpp:sa5:_3gpp-common-managed-element/_5GCNfConnEcmInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description "It indicates the type of a NF instance." ;
            sh:in ( "PCF" "NEF" "SCEF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/_5GCNfConnEcmInfoList/_5GCNFType> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of a NF instance,
It can be IP address (either IPv4 address (See RFC 791) or
IPv6 address (See RFC 2373) or FQDN (See TS 23.003). """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/_5GCNfConnEcmInfoList/_5GCNFIpAddress> ],
        [ sh:description "This attribute holds the DN of a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/_5GCNfConnEcmInfoList/_5GCNFRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/_5GCNfConnEcmInfoList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformation/name> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformation/value> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformation> .

<urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecordsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identifies the alarmRecord" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/alarmId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/objectInstance> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates if an object (the MonitoredEntity) has a back
up. See definition in ITU-T Recommendation X.733 clause 8.1.2.4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/backedUpStatus> ],
        [ sh:description """Backup object of the alarmed object as defined in
ITU-T Rec. X. 733""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/backUpObject> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Indicates if some observed condition is getting better,
worse, or not changing. """ ;
            sh:in ( "MORE_SEVERE" "NO_CHANGE" "LESS_SEVERE" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/trendIndication> ],
        [ sh:datatype xsd:string ;
            sh:description """Indicates proposed repair actions. See definition in
ITU-T Recommendation X.733 clause 8.1.2.12.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/proposedRepairActions> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/additionalText> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates that this AlarmInformation is the root cause
of the events captured by the notifications whose identifiers are in
the related CorrelatedNotification instances.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/rootCauseIndicator> ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the time when the alarm has been
acknowledged or unacknowledged the last time, i.e. it registers the
time when ackState changes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/ackTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the last user who has changed the
Acknowledgement State.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/ackUserId> ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the system (Management System) that last
changed the ackState of an alarm, i.e. acknowledged or unacknowledged
the alarm.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/ackSystemId> ],
        [ sh:in ( "ACKNOWLEDGED" "UNACKNOWLEDGED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/ackState> ],
        [ sh:datatype xsd:int ;
            sh:description "The Id of the last notification updating the AlarmRecord." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/notificationId> ],
        [ sh:datatype xsd:string ;
            sh:description """Carries the identity of the user who invokes the
clearAlarms operation.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/clearUserId> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/clearSystemId> ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the service-user whose request for service
provided by the serviceProvider led to the generation of the
security alarm.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/serviceUser> ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the service-provider whose service is
requested by the serviceUser and the service request provokes the
generation of the security alarm.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/serviceProvider> ],
        [ sh:datatype xsd:string ;
            sh:description """It carries the identity of the detector of the security
alarm.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/securityAlarmDetector> ],
        [ sh:description """Indicates whether the alarm needs
to be cleared manually by the MnS consumer (ADMC)
or the producer will clear it automatically (ADAC).""" ;
            sh:in ( "AUTOMATIC" "MANUAL" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/clearingType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfo> ;
            sh:description "Indicates the crossed threshold" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/thresholdInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition> ;
            sh:description """Indicates MO attribute value changes associated with the
alarm for state attributes of the monitored entity (state transitions).
The change is reported with the name of the state attribute, the new
value and an optional old value.
See definition in ITU-T Recommendation X.733 [4] clause 8.1.2.10.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/stateChangeDefinition> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributes> ;
            sh:description """Attributes of the monitored entity and their
values at the time the alarm occurred that are of interest for the
alarm report.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/monitoredAttributes> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformation> ;
            sh:description "Vendor specific alarm information in the alarm." ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/additionalInformation> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/alarmRaisedTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/comments> ;
            sh:description "List of comments and data about the comments." ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/comments> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotifications> ;
            sh:description "List of correlated notifications" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/correlatedNotifications> ],
        [ sh:datatype xsd:string ;
            sh:description "not applicable if related alarm has not changed" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/alarmChangedTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "not applicable if related alarm was not cleared" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/alarmClearedTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description "General category for the alarm." ;
            sh:in ( "OTHER" "COMMUNICATIONS_ALARM" "QUALITY_OF_SERVICE_ALARM" "PROCESSING_ERROR_ALARM" "EQUIPMENT_ALARM" "ENVIRONMENTAL_ALARM" "INTEGRITY_VIOLATION" "OPERATIONAL_VIOLATION" "PHYSICAL_VIOLATION" "SECURITY_SERVICE_OR_MECHANISM_VIOLATION" "TIME_DOMAIN_VIOLATION" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/alarmType> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/probableCause> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/specificProblem> ],
        [ sh:description """This is Writable only if producer supports consumer
to set perceivedSeverity to CLEARED""" ;
            sh:in ( "CRITICAL" "MAJOR" "MINOR" "WARNING" "INDETERMINATE" "CLEARED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords/perceivedSeverity> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/alarmRecords> .

<urn:3gpp:sa5:_3gpp-common-managed-element/allowedAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/allowedArea/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/allowedArea> .

<urn:3gpp:sa5:_3gpp-common-managed-element/allowedTimeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/allowedTime/startTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/allowedTime/endTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/allowedTime> .

<urn:3gpp:sa5:_3gpp-common-managed-element/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-common-managed-element/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope> .

<urn:3gpp:sa5:_3gpp-common-managed-element/caraConfigurationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """IP address or FQDN of the CMP (Certificate Management
Protocol)
server""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/caraConfiguration/caraAddress> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """This parameter specifies the port number used by
CMP (Certificate Management Protocol) server. The port for HTTP/HTTPSs
transfer of CMP messages is not explicitly given in RFC 9811, therefore
this parameter is required. The port number is usually
represented as 2 octets.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/caraConfiguration/portNumber> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter specifies the path (in ASCII string) to
the CMP server directory. A CMP server may be located in an
arbitrary path other than root.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/caraConfiguration/path> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter specifies the subject name (in ASCII
string) of the CA/RA. The use is described in 3GPP TS 33.310
clause 9.5.3.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/caraConfiguration/subjectName> ],
        [ sh:description """This parameter specifies the protocol (HTTP or HTTPS)
to be used for certificate enrolment. The use is described in
3GPP TS 33.310 clause 9.6.""" ;
            sh:in ( "HTTP" "HTTPS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/caraConfiguration/protocol> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/caraConfiguration> .

<urn:3gpp:sa5:_3gpp-common-managed-element/commentsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Date and Time the comment was created." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/comments/commentTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """It carries the identification of the user who made the
comment.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/comments/commentUserId> ],
        [ sh:datatype xsd:string ;
            sh:description """It carries the identification of the system (
Management System) from which the comment is made. That system
supports the user that made the comment.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/comments/commentSystemId> ],
        [ sh:datatype xsd:string ;
            sh:description "It carries the textual comment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/comments/commentText> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/comments> .

<urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotificationsShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotifications/sourceObjectInstance> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:int ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotifications/notificationIds> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotifications> .

<urn:3gpp:sa5:_3gpp-common-managed-element/currentLocationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/currentLocation/id> ],
        [ sh:datatype xsd:long ;
            sh:description """It is either the gNB ID of the IAB-donor-CU that target IAB-DU
connects to or the gNB Id of the IAB-nonor-CU that serves IAB-MT, or
the gNBId of the gNB that serves MWAB-UE.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/currentLocation/gNBId> ],
        [ sh:datatype xsd:int ;
            sh:description """Identifies an NR cell where IAB-MT or MWAB-UE
is connected to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/currentLocation/cellLocalId> ],
        [ sh:datatype xsd:string ;
            sh:description """It is TAC pertaining to the cells where IAB-MT or MWAB-UE is
connected.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/currentLocation/nRTAC> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId> ;
            sh:description "The PLMN ID where IAB-MT or MWAB-UE is connected to" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/currentLocation/pLMNId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/tAI> ;
            sh:description """It is the TAI (see subclause 9.3.3.11 in TS 38.413) pertaining
to the cells where IAB-MT or MWAB-UE is connected""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/currentLocation/tAI> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/geoArea> ;
            sh:description """It specifies geographical area of mobile NR node
(e.g., IAB-node or MWAB-node).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/currentLocation/geoArea> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/currentLocation> .

<urn:3gpp:sa5:_3gpp-common-managed-element/downShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Higher value of a threshold with hysteresis, the integer
type is used for counter thresholds and the float type for gauge
thresholds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/down/high> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Lower value of a threshold with hysteresis, applicable
only to gauge thresholds.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/down/low> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/down> .

<urn:3gpp:sa5:_3gpp-common-managed-element/eASServiceAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalLocation> ;
            sh:description """This refers to the Geographical Service Area,
(see clause 7.3.3.3 in TS 23.558 that is defined as a datatype
(see clause 6.3.4).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/eASServiceArea/geographicalLocation> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/topologicalLocation> ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.7). """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/eASServiceArea/topologicalLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/eASServiceArea> .

<urn:3gpp:sa5:_3gpp-common-managed-element/eDNServiceAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalLocation> ;
            sh:description """This refers to the Geographical Service Area,
(see clause 7.3.3.3 in TS 23.558 that is defined as a datatype
(see clause 6.3.4).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/eDNServiceArea/geographicalLocation> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/topologicalLocation> ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.7). """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/eDNServiceArea/topologicalLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/eDNServiceArea> .

<urn:3gpp:sa5:_3gpp-common-managed-element/eESServiceAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalLocation> ;
            sh:description """This refers to the Geographical Service Area,
(see clause 7.3.3.3 in TS 23.558 that is defined as a datatype
(see clause 6.3.4).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/eESServiceArea/geographicalLocation> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/topologicalLocation> ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.7). """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/eESServiceArea/topologicalLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/eESServiceArea> .

<urn:3gpp:sa5:_3gpp-common-managed-element/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-common-managed-element/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/freqInfo> .

<urn:3gpp:sa5:_3gpp-common-managed-element/geoAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/geoArea/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/geoArea> .

<urn:3gpp:sa5:_3gpp-common-managed-element/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/geoPolygon> .

<urn:3gpp:sa5:_3gpp-common-managed-element/geographicalCoordinatesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalCoordinates/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalCoordinates/longitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalCoordinates> .

<urn:3gpp:sa5:_3gpp-common-managed-element/geographicalLocationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalLocation/civicLocations> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalCoordinates> ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.8).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalLocation/geographicalCoordinates> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalLocation> .

<urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/mdtConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/mnrOamIPConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mnrOamIPConfig/id> ],
        [ sh:datatype xsd:string ;
            sh:description """this parameter specifies IP address or
FQDN of security gateway (SeGW) used for an
an NR mobile node (e.g., IAB-node or MWAB)
to establish secure connection as specified in TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mnrOamIPConfig/seGwConfiguration> ],
        [ sh:datatype xsd:string ;
            sh:description """this parameter specifies IP address or FQDN of
configuration server (SCS) used for
an NR mobile node (e.g., IAB-node or MWAB)
to establish connection as specified in TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mnrOamIPConfig/scsConfiguration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/caraConfiguration> ;
            sh:description """configuration used for  an NR mobile node (e.g., IAB-node or MWAB),
to perform certificate enrolment procedure as specified in
TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/mnrOamIPConfig/caraConfiguration> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/mnrOamIPConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributes/attributeName> ],
        [ sh:description """The value of the attribute. The content of this data
node shall be in accordance with the data model for the attribute.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributes/value> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributes> .

<urn:3gpp:sa5:_3gpp-common-managed-element/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/nPNTarget> .

<urn:3gpp:sa5:_3gpp-common-managed-element/notificationEntriesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Identifier of an individual notificationEntry; unique within
a NotificationList MOI.

allowedValues:
- If the NotificationList is contained under an NtfSubscriptionControl
the value is the same as the notification's sequenceNo.
- If the NotificationList is contained under SubNetwork or
ManagedElement the value is the DN of the NtfSubscriptionControl that
created the notification followed by a single '*' asterisk character
and the sequenceNo.
e.g. 'ManagedElement=me1,NtfSubscriptionControl=Fault1*12345'""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/notificationEntries/notificationEntryId> ],
        [ sh:datatype xsd:string ;
            sh:description "eventTime from the header of the notification" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/notificationEntries/eventTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """The string representation of a notification as encoded in
the HTTP body (excluding the HTTP headers and the optional VES header).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/notificationEntries/notificationContent> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/notificationEntries> .

<urn:3gpp:sa5:_3gpp-common-managed-element/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/pLMNIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId> .

<urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-common-managed-element/packetErrorRateShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """The Packet Error Rate of a 5QI expressed as Scalar x 10-k
where k is the Exponent.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/packetErrorRate/scalar> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """The Packet Error Rate of a 5QI expressed as Scalar x 10-k,
where k is the Exponent.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/packetErrorRate/exponent> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/packetErrorRate> .

<urn:3gpp:sa5:_3gpp-common-managed-element/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/plmnId> .

<urn:3gpp:sa5:_3gpp-common-managed-element/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/plmnList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/scopeShape> a sh:NodeShape ;
    sh:property [ sh:description """If the optional scopeLevel parameter is not supported
or absent, allowed values of scopeType are BASE_ONLY and BASE_ALL.

The value BASE_ONLY indicates only the base object is selected.
The value BASE_ALL indicates the base object and all of its
subordinate objects (incl. the leaf objects) are selected.

If the scopeLevel parameter is supported and present, allowed
values of scopeType are BASE_ALL, BASE_ONLY, BASE_NTH_LEVEL
and BASE_SUBTREE.

The value BASE_NTH_LEVEL indicates all objects on the level,
which is specified by the scopeLevel parameter, below the base
object are selected. The base object is at scopeLevel zero.
The value BASE_SUBTREE indicates the base object and all of its
subordinate objects down to and including the objects on the level,
which is specified by the scopeLevel parameter, are selected.
The base object is at scopeLevel zero.""" ;
            sh:in ( "BASE_ONLY" "BASE_ALL" "BASE_NTH_LEVEL" "BASE_SUBTREE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/scope/scopeType> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description "See description of scopeType." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/scope/scopeLevel> ],
        [ sh:description "Subtree filter" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/scope/datastore-subtree-filter> ],
        [ sh:datatype xsd:string ;
            sh:description "XPath-filter" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/scope/datastore-xpath-filter> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/scope> .

<urn:3gpp:sa5:_3gpp-common-managed-element/servingPLMNShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/servingPLMN/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/servingPLMN/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/servingPLMN> .

<urn:3gpp:sa5:_3gpp-common-managed-element/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/sliceIdList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinitionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition/attributeName> ],
        [ sh:description """The new value of the attribute. The content of this data
node shall be in accordance with the data model for the attribute.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition/newValue> ],
        [ sh:description """The old value of the attribute. The content of this data
node shall be in accordance with the data model for the attribute.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition/oldValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition> .

<urn:3gpp:sa5:_3gpp-common-managed-element/tAIShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/tAI/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/tAI/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/tAI> .

<urn:3gpp:sa5:_3gpp-common-managed-element/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/taiList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The name of the monitored measurement that crossed the
threshold and that caused the notification (Rec. ITU-T X. 733 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfo/observedMeasurement> ],
        [ sh:datatype xsd:string ;
            sh:description """The value of the gauge or counter which crossed the
threshold. This may be different from the threshold value if, for
example, the gauge may only take on discrete values.
Integer values are used for counters and float values for gauges
(Rec. ITU-T X. 733). Note that a 'number' type property can contain
both integers and floating point numbers.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfo/observedValue> ],
        [ sh:datatype xsd:string ;
            sh:description """For a gauge threshold, the time at which the threshold
was last re-armed, namely the time after the previous threshold
crossing at which the hysteresis value of the threshold was
exceeded thus again permitting generation of notifications when the
threshold is crossed. For a counter threshold, the later of the time
at which the threshold offset was last applied, or the time at
which the counter was last initialized (for resettable counters)
(Rec. ITU-T X. 733)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfo/armTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdLevel> ;
            sh:description """In the case of a gauge the threshold level specifies
a pair of threshold values, the first being the value of the crossed
threshold and the second, its corresponding hysteresis; in the case
of a counter the threshold level specifies only the threshold value
(Rec. ITU-T X. 733).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfo/thresholdLevel> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdInfo> .

<urn:3gpp:sa5:_3gpp-common-managed-element/thresholdLevelShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/up> ;
            sh:description """Indicates for counter and gauge thresholds that the
threshold crossing occurred when going up.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdLevel/up> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/down> ;
            sh:description """Indicates for gauge thresholds that the threshold crossing
occurred when going down, applicable only to gauge thresholds.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdLevel/down> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/thresholdLevel> .

<urn:3gpp:sa5:_3gpp-common-managed-element/topologicalLocationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:int ;
            sh:description """It represents the list of NR cells.

The cell ID, together with the gNB Identifier (using gNBId of the
parent GNBCUCPFunction or GNBDUFunction or ExternalCUCPFunction),
identifies a NR cell within a PLMN. This is the NR Cell Identity(NCI).
See subclause 8.2 of TS 38.300""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/topologicalLocation/cellIDList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/trackingAreaIdList> ;
            sh:description "It represents the list of tracking areas within a PLMN." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/topologicalLocation/trackingAreaIdList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/servingPLMN> ;
            sh:description "It specifies the PLMN to be served." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/topologicalLocation/servingPLMN> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/topologicalLocation> .

<urn:3gpp:sa5:_3gpp-common-managed-element/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/traceConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/traceReference> .

<urn:3gpp:sa5:_3gpp-common-managed-element/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/traceTarget> .

<urn:3gpp:sa5:_3gpp-common-managed-element/trackingAreaIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/trackingAreaIdList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/trackingAreaIdList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/trackingAreaIdList> .

<urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-common-managed-element/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-common-managed-element/uPFConnectionInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of an UPF instance,
It can be IP address (either IPv4 address (See RFC 791) or
IPv6 address (See RFC 2373) or FQDN (See TS 23.003). """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/uPFConnectionInfo/uPFIpAddress> ],
        [ sh:description "This attribute holds the DN of an UPF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/uPFConnectionInfo/uPFRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/uPFConnectionInfo> .

<urn:3gpp:sa5:_3gpp-common-managed-element/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/upShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Higher value of a threshold with hysteresis, the integer
type is used for counter thresholds and the float type for gauge
thresholds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/up/high> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Lower value of a threshold with hysteresis, applicable
only to gauge thresholds.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managed-element/up/low> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managed-element/up> .

<urn:3gpp:sa5:_3gpp-common-management-node/ManagementNodeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/userLabel> ],
        [ sh:description """Contains a list of the DN(s) of the related subclasses of
ManagedElement_ instance(s).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/managedElements> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/vendorName> ],
        [ sh:datatype xsd:string ;
            sh:description "An operator defined state for operator specific usage" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/userDefinedState> ],
        [ sh:datatype xsd:string ;
            sh:description "The physical location of this entity (e.g. an address)." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/locationName> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/swVersion> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollectionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/id> ],
        [ sh:description """This attributes defines the type of management data that
are requested.

Allowed values for data category are COVERAGE, CAPACITY,
ENERGY_EFFICIENCY, MOBILITY, ACCESSIBILITY. The data categories
will map to certain measurement families defined in TS 28.552, see
below. In addition to the below mappings, MnS producer may map the
provided categories to any additional proprietary management data,
as appropriate.

- The COVERAGE category will map to measurement families of MR
(measurements related to Measurement Report) and L1M (measurements
related to Layer 1 Measurement).

- The CAPACITY category will map to measurement family RRU
(measurements related to Radio Resource Utilization).

- The ENERGY_EFFICIENCY category will map to measurement family PEE
(measurements related to Power, Energy and Environment).

- The MOBILITY category will map to measurement family MM
(measurements related to Mobility Management).

- The ACCESSIBILITY category will map to measurement family CE
(measurements related to Connection Establishment).""" ;
            sh:in ( "COVERAGE" "CAPACITY" "ENERGY_EFFICIENCY" "MOBILITY" "ACCESSIBILITY" ) ;
            sh:maxCount 5 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/category> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/processMonitor> ;
            sh:description "Indicates the process of the ManagementDataCollection MOI." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/processMonitor> ],
        [ sh:datatype xsd:string ;
            sh:description """List of management data identified by name.

The list may include metrics or set of metrics defined
in TS 28.552, TS 28.554 and TS 32.422.

The metrics are identified with their names/identifiers.
For performance measurements defined in TS 28.552 the name is
constructed as the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined according to the
KPI definitions template as the component designated with a).

For trace metrics (including trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RRC, RLF and RCEF
reports) defined in TS 32.422, the name (metric identifier) is
defined in clause 10 of TS 32.422.

For non-3GPP specified managment data the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/name> ],
        [ sh:description """It specifies whether the required data is reported per
S-NSSAI or per 5QI.""" ;
            sh:in ( "SNSSAI" "5QI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/dataScope> ],
        [ sh:datatype xsd:string ;
            sh:description """Logical expression of one or several condition(s).

The actual syntax and capabilities of condition is SS specific. However,
each SS should support condition consisting of one or several assertions
that may be grouped using the logical operators AND, OR and NOT. Only if
the whole expression of condition evaluates TRUE, the attribute
conditionStatus will be TRUE.

Each assertion is a pointer to a Boolean parameter or a logical
expression of attribute existence or attribute value comparison
('equal to X, less than Y' etc.).

An empty string is not allowed.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/condition> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the management data collection output will
be consolidated into a single file per reporting period.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/consolidateOutput> ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob, a TraceJob or a QMCJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/jobId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/targetNodeFilter> ;
            sh:description """Set of information to target the Object Instance to collect
the measurements from.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/targetNodeFilter> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/collectionTimeWindow> ;
            sh:description """Collection time window for which the management data
should be reported.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/collectionTimeWindow> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl> ;
            sh:description """Selecting the reporting method and defining associated
control parameters.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/reportingCtrl> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/areaOfInterestShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/areaOfInterest/nrCellIdList> ],
        [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/areaOfInterest/eutraCellIdList> ],
        [ sh:datatype xsd:string ;
            sh:description "List of UTRAN cells identified by UTRAN CGI" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/areaOfInterest/utraCellIdList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoAreaToCellMapping> ;
            sh:description """Contains a geographical area and an association threshold.
The geo-area is defined as a convex polygon using the attribute
'geoArea'.

The MnS producer shall map the geographical area to cells. There are
two evaluation criteria whether a cell belongs to a geographical area
or not. If attribute 'associationThreshold' is absent, the location
of the base station antenna determines the belonging. If attribute
'associationThreshold' is configured, the coverage area is considered.
The attribute 'associationThreshold' determines the lower boundary of
the coverage ratio. For example, if the 'associationThreshold' is
configured to 60%, a cell shall be considered as included in the
geographical area if at least 60% of the coverage area of that
cell overlaps with the specified geographical area.

The mapping of the geographical area to cells is performed at
instantiation of the IOC.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/areaOfInterest/geoAreaToCellMapping> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/areaOfInterest/taiList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/areaOfInterest> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/collectionTimeWindowShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/collectionTimeWindow/startTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/collectionTimeWindow/endTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/collectionTimeWindow> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoArea/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoArea> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoAreaToCellMappingShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description """It specifies the threshold of coverage area in
percentage whether a cell belongs to the geographical area or not.

If this attribute is absent, the location of the base station
antenna determines whether a cell belongs to the geographical
area or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoAreaToCellMapping/associationThreshold> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoArea> ;
            sh:description """It specifies the geographical area using the cordinates of
the corners of a convex polygon.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoAreaToCellMapping/geoArea> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoAreaToCellMapping> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/geoPolygon> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/plmnId> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/processMonitorShape> a sh:NodeShape ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/processMonitor> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl/fileLocation> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl/streamTarget> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/taiList> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/targetNodeFilterShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the network domain of the target node. This
will also result in collecting appropriate management data from the
nodes belonging to the specified domain.""" ;
            sh:in ( "CN" "RAN" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/targetNodeFilter/networkDomain> ],
        [ sh:description """It specifies the traffic type of the target node. This will
also result in collecting appropriate management data from the nodes
handling the specified traffic (e.g AMF for CP and UPF for UP).""" ;
            sh:in ( "CP" "UP" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/targetNodeFilter/cpUpType> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """It specifies the slice service type (SST) of which the slice
subnet should be targeted. Please refer to 3GPP TS 23.501: 'System
Architecture for the 5G System'""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/targetNodeFilter/sst> ],
        [ sh:description """List of managed object instances. Each object instance is
identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/targetNodeFilter/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managementdatacollection/areaOfInterest> ;
            sh:description """It specifies a location(s) from where the management data
shall be collected. It is defined in terms of TAI(s).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-managementdatacollection/targetNodeFilter/areaOfInterest> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-managementdatacollection/targetNodeFilter> .

<urn:3gpp:sa5:_3gpp-common-mecontext/MeContextShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mecontext/MeContext/id> ],
        [ sh:description """It carries the DN Prefix information or no information.
The instance of MeContext is the local root instance of the MIB.
Otherwise the attribute shall be absent or carry no information.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mecontext/MeContext/dnPrefix> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mecontext/MeContext> .

<urn:3gpp:sa5:_3gpp-common-mnsagent/MnsAgentShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsagent/MnsAgent/id> ],
        [ sh:description "Distinguished Name (DN) of a IRPAgent or a MnSAgent." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsagent/MnsAgent/systemDN> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mnsagent/MnsAgent> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/id> ],
        [ sh:description """This attributes defines the type of management data that
are requested.

Allowed values for data category are COVERAGE, CAPACITY,
ENERGY_EFFICIENCY, MOBILITY, ACCESSIBILITY. The data categories
will map to certain measurement families defined in TS 28.552, see
below. In addition to the below mappings, MnS producer may map the
provided categories to any additional proprietary management data,
as appropriate.

- The COVERAGE category will map to measurement families of MR
(measurements related to Measurement Report) and L1M (measurements
related to Layer 1 Measurement).

- The CAPACITY category will map to measurement family RRU
(measurements related to Radio Resource Utilization).

- The ENERGY_EFFICIENCY category will map to measurement family PEE
(measurements related to Power, Energy and Environment).

- The MOBILITY category will map to measurement family MM
(measurements related to Mobility Management).

- The ACCESSIBILITY category will map to measurement family CE
(measurements related to Connection Establishment).""" ;
            sh:in ( "COVERAGE" "CAPACITY" "ENERGY_EFFICIENCY" "MOBILITY" "ACCESSIBILITY" ) ;
            sh:maxCount 5 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/category> ],
        [ sh:datatype xsd:string ;
            sh:description """List of management data identified by name.

The list may include metrics or set of metrics defined
in TS 28.552, TS 28.554 and TS 32.422.

The metrics are identified with their names/identifiers.
For performance measurements defined in TS 28.552 the name is
constructed as the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined according to the
KPI definitions template as the component designated with a).

For trace metrics (including trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RRC, RLF and RCEF
reports) defined in TS 32.422, the name (metric identifier) is
defined in clause 10 of TS 32.422.

For non-3GPP specified managment data the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/name> ],
        [ sh:datatype xsd:int ;
            sh:description """Granularity periods supported for the production of
associated management data. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedGranularityPeriods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated management
data. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedReportingPeriods> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description """This attribute describes the maximum period of the requested
historical data. The period is defined in seconds.
When the value of this attribute is NULL, which means the capability of
querying historical data is not supported.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/historicalDataPeriod> ],
        [ sh:description """List of supported reporting methods for the associated
management data.""" ;
            sh:in ( "FILE" "STREAM" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedReportingMethod> ],
        [ sh:description """List of supported sub counter capabilities for the associated
management data""" ;
            sh:in ( "SNSSAI" "5QI" "PLMN" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedDataScope> ],
        [ sh:description """List of DN of MnSInfo for the MnS instance(s) which can be
used to request the associated management data""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedDataRequestMnSRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """List of DN of MnSInfo for the MnS instance(s) which can be
used to report the associated management data""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedDataReportingMnSRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/id> ],
        [ sh:datatype xsd:string ;
            sh:description "Human-readable name of management service." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsLabel> ],
        [ sh:description "Type of management service." ;
            sh:in ( "ProvMnS" "FaultSupervisionMnS" "StreamingDataReportingMnS" "FileDataReportingMnS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsType> ],
        [ sh:datatype xsd:string ;
            sh:description "Version of management service." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsVersion> ],
        [ sh:datatype xsd:string ;
            sh:description "Addressing information for Management Service operations." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """It describes the types of management capabilities of the
MnS instance provided by the MnS producer. The detailed description for
above enum values see Annex F in TS 28.533.
Note: vendor extension values are allowed for the attribute
'mnsCapability'""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsCapability> ],
        [ sh:description """List of DN of MgmtDataInfo instance(s) which are associated
the MnSInfo which represent a management service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mgmtDataInfoRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-mnsregistry/mnsScope> ;
            sh:description """This attribute defines the information about the
management scope of the Management Service. The management scope is
used to represent  the set of managed object instances that can be
accessed using the Management Service.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsScope> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsRegistryShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsRegistry/id> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsRegistry> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/geoAreasListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-mnsregistry/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/geoAreasList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mnsregistry/geoAreasList> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mnsregistry/geoPolygon> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/mnsScopeShape> a sh:NodeShape ;
    sh:property [ sh:description """This attribute describes list of DNs for the managed
object instances that can be accessed using the Management Service.
If a complete SubNetwork can be accessed using the Management Service,
this attribute may contain the DN of the SubNetwork instead of the
DNs of the individual managed entities within the SubNetwork.

If a complete ManagedElement can be accessed using the Management
Service, this attribute may contain the DN of the ManagedElement
instead of the DNs of the individual managed entities within the
ManagedElement.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/mnsScope/objectInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-mnsregistry/geoAreasList> ;
            sh:description """This attribute describes geographical areas for the
managed object instances that can be accessed using the Management
Service.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/mnsScope/geoAreasList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-mnsregistry/taiList> ;
            sh:description """This attribute describes the list of Tracking Area
Identities (TAI) for the managed object instances that can be accessed
using the Management Service.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/mnsScope/taiList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mnsregistry/mnsScope> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mnsregistry/plmnId> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-mnsregistry/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-mnsregistry/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-mnsregistry/taiList> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/id> ],
        [ sh:description "Specifies an end user service type for QoE measurements." ;
            sh:in ( "DASH" "MTSI" "VR" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/serviceType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTarget> ;
            sh:description """Defines the PLMN for which sessions shall be selected in
the network request session in case of area based QMC when several
PLMNs are supported in the RAN (this means that shared cells and not
shared cells are allowed for the specified PLMN. Furthermore, several
PLMNs can be used for not shared RAN cases as well as for shared RAN
cases.). Only the sessions may be selected where the PLMN that the
UE reports as selected PLMN is the same as the PLMN Target.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScope> ;
            sh:description """Contains a list of S-NSSAIs (Single Network Slice Selection
Assistance Information).  A Network Slice end to end is identified by
S-NSSAI.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/sliceScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/mDTAlignmentInformation> ;
            sh:description """This parameter indicates the MDT measurements with which
alignment of QoE measurement is required. This parameter is optional
and is valid for NR only.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/mDTAlignmentInformation> ],
        [ sh:datatype xsd:string ;
            sh:description """Specifies the address to which the QMC records shall be
transferred.  Ipv4 or Ipv6 address(es) may be used.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/qoECollectionEntityAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Specifies the target object of the QMC in case of
signalling based QMC.  The qoETarget attribute shall be able
to carry IMSI or SUPI.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/qoETarget> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifies the QoE measurement collection job in the
Managed Elements and in the measurement collection entity.  The QoE
reference shall be globally unique therefore it is composed as follows:
MCC+MNC+QMC ID, where the MCC and MNC are coming with the QMC
activation request from the management system to identify one PLMN
containing the management system, and QMC ID is a 3 byte Octet String.
The QMC ID is generated by the management system or the operator.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/qoEReference> ],
        [ sh:datatype xsd:string ;
            sh:description """The jobId attribute presents the job identifier of a
QMCJob instance. The jobId can be used to associate  multiple QMCJob
instances. For example, it is possible to configure the same jobId
for multiple QMCJob instances required to produce the data
(e.g. Streaming services and MTSI reports) for a specific network
analysis.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Provides a reference to a file including the parameters for
configuration of application layer measurements, known as Container
for Application Layer Measurement Configuration.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/qMCConfigFile> ],
        [ sh:description """This parameter indicates available RAN visible QoE metrics
to the gNB. This parameter is optional and is valid for NR only.""" ;
            sh:in ( "APP_LAYER_BUFFER_LEVEL_LIST" "PLAYOUT_DELAY_FOR_MEDIA_STARTUP" ) ;
            sh:maxCount 2 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/availableRANqoEMetrics> ],
        [ sh:description """This attribute indicates which type of MBS communication
service the QoE measurement configuration pertains to.""" ;
            sh:in ( "BROADCAST" "MULTICAST" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/mBSCommunicationServiceType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope> ;
            sh:description """It defines the area scope of QoE, which is specified
in clause 5.4 of TS 28.405.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/areaScope> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/areaScope> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/geoPolygon> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/mDTAlignmentInformationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/mDTAlignmentInformation/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/mDTAlignmentInformation/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/mDTAlignmentInformation/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/mDTAlignmentInformation> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/plmnId> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceIdList> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScope/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScope/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScope> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-qmcjob/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-qmcjob/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-qmcjob/taiList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/id> ],
        [ sh:description """When set to UNLOCKED, the alarm list is updated.
When the set to LOCKED, the existing alarm records are not
updated, and new alarm records are not added to the alarm list.""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/administrativeState> ],
        [ sh:description """The producer sets this attribute to ENABLED, indicating
that it has the resource and ability to record alarm in AlarmList
else, it sets the attribute to DISABLED.""" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "The number of alarm records in the AlarmList" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/numOfAlarmRecords> ],
        [ sh:datatype xsd:string ;
            sh:description "The last time when an alarm record was modified" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/lastModification> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Identifies, the part of the alarm scope that may not be
reliable.

If this parameter is equal to the instance carried in systemDN,
then all AlarmRecord instances in the AlarmList may not be reliable.

If this parameter is equal to some instance represented by
MonitoredEntity, then only AlarmRecord related to this instance and
its descendants may not be reliable.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/unreliableAlarmScope> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords> ;
            sh:description "List of alarmRecords" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/alarmRecords> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/Configurable5QISetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/Configurable5QISet/id> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/Configurable5QISet> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/id> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of an EAS instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eASIpAddress> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/uPFConnectionInfo> ;
            sh:description """The attribute is defined as a datatype UPFConnInfo
(see clause 5.3.121). It is used to provide the UPF IP address and
UPF DN. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/uPFConnectionInfo> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of an EES instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373). """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eESIpAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of an ECS instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eCSIpAddress> ],
        [ sh:datatype xsd:string ;
            sh:description "The identifier of the edge data network (See TS 23.558)." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/ednIdentifier> ],
        [ sh:description """It indicates the type of ECM connection (i.e., user plane
connection via UPF, control plane connection via PCF or NEF.""" ;
            sh:in ( "USERPLANE" "CONTROLPLANE" "BOTH" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/ecmConnectionType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/eASServiceArea> ;
            sh:description """This parameter defines the EAS service area
(see clause 7.3.3.6 in TS 23.558).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eASServiceArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/eESServiceArea> ;
            sh:description """This parameter defines the EES service area
(see clause 7.3.3.5 in TS 23.558).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eESServiceArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/eDNServiceArea> ;
            sh:description """This parameter defines the EDN service area
(see clause 7.3.3.4 in TS 23.558)""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eDNServiceArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/_5GCNfConnEcmInfoList> ;
            sh:description """The attribute specifies a list of 5GCNfConnInfo which is
defined as a datatype (see clause 5.3.120). It is used to
provide 5GC NFs, such as PCF, NEF, SCEF, that are connected EDN NFs,
such as EAS, EES, and ECS.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/_5GCNfConnEcmInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/File> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/Files> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristicsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/id> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Identifies the 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/fiveQIValue> ],
        [ sh:description """It indicates the Resource Type of a 5QI, as specified
in TS 23.501 """ ;
            sh:in ( "GBR" "NON_GBR" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/resourceType> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It indicates the Priority Level of a 5QI, as specified
in TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/priorityLevel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Indicates the Packet Delay Budget (in unit of 0.5ms)of a 5QI,
as specified in TS 23.501 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/packetDelayBudget> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/averagingWindow> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/maximumDataBurstVolume> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/packetErrorRate> ;
            sh:description """It indicates the Packet Error Rate of a 5QI,
as specified in TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/packetErrorRate> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl/id> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the periodicity of heartbeat notification emission.
The value of zero has the special meaning of stopping the heartbeat
notification emission.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl/heartbeatNtfPeriod> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Setting this attribute to 'true' triggers an immediate
additional heartbeat notification emission. Setting the value to
'false' has no observable result.

The periodicity of notifyHeartbeat emission is not changed.

After triggering the heartbeat the system SHALL set the value
back to false.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl/triggerHeartbeatNtf> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/MWABShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/id> ],
        [ sh:description """It indicates the operational state of the MWAB instance.
It describes whether the resource is installed and partially or fully
operable (Enabled) or the resource is not installed or not
operable (Disabled).""" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/operationalState> ],
        [ sh:description """It indicates the administrative state of the MWAB instance.
It describes the permission to use or prohibition against using the
MWAB functionalities, imposed through the OAM services.""" ;
            sh:in ( "LOCKED" "UNLOCKED" "SHUTTINGDOWN" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/administrativeState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/mnrOamIPConfig> ;
            sh:description """It is IP configutation for OAM connectivity used
by a mobile NR node (e.g., IAB-node, MWAB-node)
to establish connection with management system as specified
in TS 28.314[x] clause 6.1.2""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/mnrOamIPConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/allowedArea> ;
            sh:description """This specifies the area where the MWAB can act as MWAB-gNB.
If the OAM indicates that the MWAB can act as MWAB-gNB is allowed areas,
it acts as MWAB-gNB only on the allowed area only.
(See sub clause 5.49 TS 28.662).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/allowedArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/allowedTime> ;
            sh:description """This specifies the time window for which the MWAB can act
as MWAB-gNB. If the allowed time window/ validity indicates 20th June,
10 am to 5 pm of the day, the MWAB acts as an MWAB g-NB only during 20th
June, 10 am to 5 pm of the day, and does not act as MWAB-gNB for any
other time. (See sub clause 5.49 [11]).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/allowedTime> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocation> ;
            sh:description """This parameter specifies the current location
of mobile NR node (e.g., IAB-node, MWAB-node).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/currentLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRuleShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule/id> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """The minimum value of to be applied
for mapping from this attribute to the energy cost.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule/eCMRInputMinValue> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """The maximum value of to be applied
for mapping from this attribute to the energy cost.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule/eCMRInputMaxValue> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Time interval (in seconds) that
should be applied for collecting values of mapping
rule attribute to be used for computing the energy cost.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule/eCTimeInterval> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/id> ],
        [ sh:datatype xsd:string ;
            sh:description """eventTime of first notification available.
The attribute may be missing if and only if there are no notifications
in the NotificationList.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/firstEventTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """eventTime of latest notification available.
The attribute may be missing if and only if there are no notifications
in the NotificationList.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/lastEventTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "List of notification types." ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/notificationTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Filter to be applied to candidate notifications identified
by the notificationTypes attribute. Only notifications that pass the
filter criteria are included. All other notifications are discarded.
The filter can be applied to any field of a notification.

The format of the string shall confrm to a
JSON expressions (Jex) 'JexConditionsExpr'""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/notificationFilter> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/notificationEntries> ;
            sh:description """Representation of the individual notifications.
The entries shall be ordered based on eventTime of the notification,
newest first.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/notificationEntries> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/id> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Defines the types of notifications that are candidates
for being forwarded to the notification recipient.
If the notificationTypes attribute is not supported or not present
all candidate notifications types are forwarded to the notification;
discriminated by notificationFilter attribute.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/notificationTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Defines a filter to be applied to candidate notifications
identified by the notificationTypes attribute.
If notificationFilter is present, only notifications that pass the
filter criteria are forwarded to the notification recipient; all other
notifications are discarded.
The filter can be applied to any field of a notification.

The format of the string shall confrm to a
JSON expressions (Jex) 'JexConditionsExpr'""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/notificationFilter> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description """The sequence number of the last notification that was sent
by a 'NtfSubscriptionControl' instance.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/lastSequenceNo> ],
        [ sh:description """Operational state of manged object instance.
The operational state describes if an object instance is operable
('ENABLED') or inoperable ('DISABLED').
This state is set by the object instance or the MnS producer and
is hence READ-ONLY.""" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/operationalState> ],
        [ sh:description """The availability status provides additional information
about the operational state""" ;
            sh:in ( "IN_TEST" "FAILED" "POWER_OFF" "OFF_LINE" "OFF_DUTY" "DEPENDENCY" "DEGRADED" "NOT_INSTALLED" "LOG_FULL" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/availabilityStatus> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/scope> ;
            sh:description "Scopes (selects) data nodes in an object tree." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/scope> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetworkShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/id> ],
        [ sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/dnPrefix> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description "Textual information indicating network type, e.g. 'UTRAN'." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/userDefinedNetworkType> ],
        [ sh:datatype xsd:string ;
            sh:description """Set of Mobile Country Code (MCC).
The MCC uniquely identifies the country of domicile
of the mobile subscriber. MCC is part of the IMSI (3GPP TS 23.003)

This list contains all the MCC values in subordinate object
instances to this SubNetwork instance.

See clause 2.3 of 3GPP TS 23.003 for MCC allocation principles.

It shall be supported if there is more than one value in setOfMcc
of the SubNetwork. Otherwise the support is optional.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/setOfMcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/supportedTraceMetrics> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/SupportedPerfMetricGroups> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotificationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications/id> ],
        [ sh:datatype xsd:string ;
            sh:description "List of notification types supported by the MnS producer" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications/notificationTypes> ],
        [ sh:description "List of protocols supported for notifications." ;
            sh:in ( "HTTP" "HTTP_VES_ENCAPS" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications/notificationProtocols> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/_5GCNfConnEcmInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description "It indicates the type of a NF instance." ;
            sh:in ( "PCF" "NEF" "SCEF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/_5GCNfConnEcmInfoList/_5GCNFType> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of a NF instance,
It can be IP address (either IPv4 address (See RFC 791) or
IPv6 address (See RFC 2373) or FQDN (See TS 23.003). """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/_5GCNfConnEcmInfoList/_5GCNFIpAddress> ],
        [ sh:description "This attribute holds the DN of a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/_5GCNfConnEcmInfoList/_5GCNFRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/_5GCNfConnEcmInfoList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/additionalInformationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/additionalInformation/name> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/additionalInformation/value> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/additionalInformation> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecordsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Identifies the alarmRecord" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/alarmId> ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/objectInstance> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates if an object (the MonitoredEntity) has a back
up. See definition in ITU-T Recommendation X.733 clause 8.1.2.4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/backedUpStatus> ],
        [ sh:description """Backup object of the alarmed object as defined in
ITU-T Rec. X. 733""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/backUpObject> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Indicates if some observed condition is getting better,
worse, or not changing. """ ;
            sh:in ( "MORE_SEVERE" "NO_CHANGE" "LESS_SEVERE" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/trendIndication> ],
        [ sh:datatype xsd:string ;
            sh:description """Indicates proposed repair actions. See definition in
ITU-T Recommendation X.733 clause 8.1.2.12.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/proposedRepairActions> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/additionalText> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates that this AlarmInformation is the root cause
of the events captured by the notifications whose identifiers are in
the related CorrelatedNotification instances.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/rootCauseIndicator> ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the time when the alarm has been
acknowledged or unacknowledged the last time, i.e. it registers the
time when ackState changes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/ackTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the last user who has changed the
Acknowledgement State.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/ackUserId> ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the system (Management System) that last
changed the ackState of an alarm, i.e. acknowledged or unacknowledged
the alarm.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/ackSystemId> ],
        [ sh:in ( "ACKNOWLEDGED" "UNACKNOWLEDGED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/ackState> ],
        [ sh:datatype xsd:int ;
            sh:description "The Id of the last notification updating the AlarmRecord." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/notificationId> ],
        [ sh:datatype xsd:string ;
            sh:description """Carries the identity of the user who invokes the
clearAlarms operation.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/clearUserId> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/clearSystemId> ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the service-user whose request for service
provided by the serviceProvider led to the generation of the
security alarm.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/serviceUser> ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies the service-provider whose service is
requested by the serviceUser and the service request provokes the
generation of the security alarm.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/serviceProvider> ],
        [ sh:datatype xsd:string ;
            sh:description """It carries the identity of the detector of the security
alarm.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/securityAlarmDetector> ],
        [ sh:description """Indicates whether the alarm needs
to be cleared manually by the MnS consumer (ADMC)
or the producer will clear it automatically (ADAC).""" ;
            sh:in ( "AUTOMATIC" "MANUAL" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/clearingType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfo> ;
            sh:description "Indicates the crossed threshold" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/thresholdInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/stateChangeDefinition> ;
            sh:description """Indicates MO attribute value changes associated with the
alarm for state attributes of the monitored entity (state transitions).
The change is reported with the name of the state attribute, the new
value and an optional old value.
See definition in ITU-T Recommendation X.733 [4] clause 8.1.2.10.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/stateChangeDefinition> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/monitoredAttributes> ;
            sh:description """Attributes of the monitored entity and their
values at the time the alarm occurred that are of interest for the
alarm report.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/monitoredAttributes> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/additionalInformation> ;
            sh:description "Vendor specific alarm information in the alarm." ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/additionalInformation> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/alarmRaisedTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/comments> ;
            sh:description "List of comments and data about the comments." ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/comments> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/correlatedNotifications> ;
            sh:description "List of correlated notifications" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/correlatedNotifications> ],
        [ sh:datatype xsd:string ;
            sh:description "not applicable if related alarm has not changed" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/alarmChangedTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "not applicable if related alarm was not cleared" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/alarmClearedTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description "General category for the alarm." ;
            sh:in ( "OTHER" "COMMUNICATIONS_ALARM" "QUALITY_OF_SERVICE_ALARM" "PROCESSING_ERROR_ALARM" "EQUIPMENT_ALARM" "ENVIRONMENTAL_ALARM" "INTEGRITY_VIOLATION" "OPERATIONAL_VIOLATION" "PHYSICAL_VIOLATION" "SECURITY_SERVICE_OR_MECHANISM_VIOLATION" "TIME_DOMAIN_VIOLATION" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/alarmType> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/probableCause> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/specificProblem> ],
        [ sh:description """This is Writable only if producer supports consumer
to set perceivedSeverity to CLEARED""" ;
            sh:in ( "CRITICAL" "MAJOR" "MINOR" "WARNING" "INDETERMINATE" "CLEARED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords/perceivedSeverity> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/alarmRecords> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/allowedAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/allowedArea/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/allowedArea> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/allowedTimeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/allowedTime/startTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/allowedTime/endTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/allowedTime> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/caraConfigurationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """IP address or FQDN of the CMP (Certificate Management
Protocol)
server""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/caraConfiguration/caraAddress> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """This parameter specifies the port number used by
CMP (Certificate Management Protocol) server. The port for HTTP/HTTPSs
transfer of CMP messages is not explicitly given in RFC 9811, therefore
this parameter is required. The port number is usually
represented as 2 octets.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/caraConfiguration/portNumber> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter specifies the path (in ASCII string) to
the CMP server directory. A CMP server may be located in an
arbitrary path other than root.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/caraConfiguration/path> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter specifies the subject name (in ASCII
string) of the CA/RA. The use is described in 3GPP TS 33.310
clause 9.5.3.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/caraConfiguration/subjectName> ],
        [ sh:description """This parameter specifies the protocol (HTTP or HTTPS)
to be used for certificate enrolment. The use is described in
3GPP TS 33.310 clause 9.6.""" ;
            sh:in ( "HTTP" "HTTPS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/caraConfiguration/protocol> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/caraConfiguration> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/commentsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Date and Time the comment was created." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/comments/commentTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """It carries the identification of the user who made the
comment.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/comments/commentUserId> ],
        [ sh:datatype xsd:string ;
            sh:description """It carries the identification of the system (
Management System) from which the comment is made. That system
supports the user that made the comment.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/comments/commentSystemId> ],
        [ sh:datatype xsd:string ;
            sh:description "It carries the textual comment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/comments/commentText> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/comments> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/correlatedNotificationsShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/correlatedNotifications/sourceObjectInstance> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:int ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/correlatedNotifications/notificationIds> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/correlatedNotifications> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocation/id> ],
        [ sh:datatype xsd:long ;
            sh:description """It is either the gNB ID of the IAB-donor-CU that target IAB-DU
connects to or the gNB Id of the IAB-nonor-CU that serves IAB-MT, or
the gNBId of the gNB that serves MWAB-UE.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocation/gNBId> ],
        [ sh:datatype xsd:int ;
            sh:description """Identifies an NR cell where IAB-MT or MWAB-UE
is connected to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocation/cellLocalId> ],
        [ sh:datatype xsd:string ;
            sh:description """It is TAC pertaining to the cells where IAB-MT or MWAB-UE is
connected.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocation/nRTAC> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNId> ;
            sh:description "The PLMN ID where IAB-MT or MWAB-UE is connected to" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocation/pLMNId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/tAI> ;
            sh:description """It is the TAI (see subclause 9.3.3.11 in TS 38.413) pertaining
to the cells where IAB-MT or MWAB-UE is connected""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocation/tAI> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/geoArea> ;
            sh:description """It specifies geographical area of mobile NR node
(e.g., IAB-node or MWAB-node).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocation/geoArea> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/currentLocation> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/downShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Higher value of a threshold with hysteresis, the integer
type is used for counter thresholds and the float type for gauge
thresholds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/down/high> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Lower value of a threshold with hysteresis, applicable
only to gauge thresholds.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/down/low> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/down> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/eASServiceAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalLocation> ;
            sh:description """This refers to the Geographical Service Area,
(see clause 7.3.3.3 in TS 23.558 that is defined as a datatype
(see clause 6.3.4).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/eASServiceArea/geographicalLocation> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/topologicalLocation> ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.7). """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/eASServiceArea/topologicalLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/eASServiceArea> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/eDNServiceAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalLocation> ;
            sh:description """This refers to the Geographical Service Area,
(see clause 7.3.3.3 in TS 23.558 that is defined as a datatype
(see clause 6.3.4).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/eDNServiceArea/geographicalLocation> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/topologicalLocation> ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.7). """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/eDNServiceArea/topologicalLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/eDNServiceArea> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/eESServiceAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalLocation> ;
            sh:description """This refers to the Geographical Service Area,
(see clause 7.3.3.3 in TS 23.558 that is defined as a datatype
(see clause 6.3.4).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/eESServiceArea/geographicalLocation> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/topologicalLocation> ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.7). """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/eESServiceArea/topologicalLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/eESServiceArea> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/freqInfo> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/geoAreaShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/geoArea/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/geoArea> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/geoPolygon> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalCoordinatesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalCoordinates/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalCoordinates/longitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalCoordinates> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalLocationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalLocation/civicLocations> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalCoordinates> ;
            sh:description """This refers to the Topological Service Area,
(see clause 7.3.3.2 in TS 23.558) that is defined as a datatype
(see clause 6.3.8).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalLocation/geographicalCoordinates> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/geographicalLocation> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/mdtConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/mnrOamIPConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mnrOamIPConfig/id> ],
        [ sh:datatype xsd:string ;
            sh:description """this parameter specifies IP address or
FQDN of security gateway (SeGW) used for an
an NR mobile node (e.g., IAB-node or MWAB)
to establish secure connection as specified in TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mnrOamIPConfig/seGwConfiguration> ],
        [ sh:datatype xsd:string ;
            sh:description """this parameter specifies IP address or FQDN of
configuration server (SCS) used for
an NR mobile node (e.g., IAB-node or MWAB)
to establish connection as specified in TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mnrOamIPConfig/scsConfiguration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/caraConfiguration> ;
            sh:description """configuration used for  an NR mobile node (e.g., IAB-node or MWAB),
to perform certificate enrolment procedure as specified in
TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/mnrOamIPConfig/caraConfiguration> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/mnrOamIPConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/monitoredAttributesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/monitoredAttributes/attributeName> ],
        [ sh:description """The value of the attribute. The content of this data
node shall be in accordance with the data model for the attribute.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/monitoredAttributes/value> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/monitoredAttributes> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/nPNTarget> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/notificationEntriesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Identifier of an individual notificationEntry; unique within
a NotificationList MOI.

allowedValues:
- If the NotificationList is contained under an NtfSubscriptionControl
the value is the same as the notification's sequenceNo.
- If the NotificationList is contained under SubNetwork or
ManagedElement the value is the DN of the NtfSubscriptionControl that
created the notification followed by a single '*' asterisk character
and the sequenceNo.
e.g. 'ManagedElement=me1,NtfSubscriptionControl=Fault1*12345'""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/notificationEntries/notificationEntryId> ],
        [ sh:datatype xsd:string ;
            sh:description "eventTime from the header of the notification" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/notificationEntries/eventTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """The string representation of a notification as encoded in
the HTTP body (excluding the HTTP headers and the optional VES header).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/notificationEntries/notificationContent> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/notificationEntries> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNId> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/packetErrorRateShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """The Packet Error Rate of a 5QI expressed as Scalar x 10-k
where k is the Exponent.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/packetErrorRate/scalar> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """The Packet Error Rate of a 5QI expressed as Scalar x 10-k,
where k is the Exponent.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/packetErrorRate/exponent> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/packetErrorRate> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnId> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/scopeShape> a sh:NodeShape ;
    sh:property [ sh:description """If the optional scopeLevel parameter is not supported
or absent, allowed values of scopeType are BASE_ONLY and BASE_ALL.

The value BASE_ONLY indicates only the base object is selected.
The value BASE_ALL indicates the base object and all of its
subordinate objects (incl. the leaf objects) are selected.

If the scopeLevel parameter is supported and present, allowed
values of scopeType are BASE_ALL, BASE_ONLY, BASE_NTH_LEVEL
and BASE_SUBTREE.

The value BASE_NTH_LEVEL indicates all objects on the level,
which is specified by the scopeLevel parameter, below the base
object are selected. The base object is at scopeLevel zero.
The value BASE_SUBTREE indicates the base object and all of its
subordinate objects down to and including the objects on the level,
which is specified by the scopeLevel parameter, are selected.
The base object is at scopeLevel zero.""" ;
            sh:in ( "BASE_ONLY" "BASE_ALL" "BASE_NTH_LEVEL" "BASE_SUBTREE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/scope/scopeType> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description "See description of scopeType." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/scope/scopeLevel> ],
        [ sh:description "Subtree filter" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/scope/datastore-subtree-filter> ],
        [ sh:datatype xsd:string ;
            sh:description "XPath-filter" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/scope/datastore-xpath-filter> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/scope> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/servingPLMNShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/servingPLMN/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/servingPLMN/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/servingPLMN> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/sliceIdList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/stateChangeDefinitionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/stateChangeDefinition/attributeName> ],
        [ sh:description """The new value of the attribute. The content of this data
node shall be in accordance with the data model for the attribute.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/stateChangeDefinition/newValue> ],
        [ sh:description """The old value of the attribute. The content of this data
node shall be in accordance with the data model for the attribute.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/stateChangeDefinition/oldValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/stateChangeDefinition> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/tAIShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/tAI/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/tAI/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/tAI> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/taiList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The name of the monitored measurement that crossed the
threshold and that caused the notification (Rec. ITU-T X. 733 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfo/observedMeasurement> ],
        [ sh:datatype xsd:string ;
            sh:description """The value of the gauge or counter which crossed the
threshold. This may be different from the threshold value if, for
example, the gauge may only take on discrete values.
Integer values are used for counters and float values for gauges
(Rec. ITU-T X. 733). Note that a 'number' type property can contain
both integers and floating point numbers.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfo/observedValue> ],
        [ sh:datatype xsd:string ;
            sh:description """For a gauge threshold, the time at which the threshold
was last re-armed, namely the time after the previous threshold
crossing at which the hysteresis value of the threshold was
exceeded thus again permitting generation of notifications when the
threshold is crossed. For a counter threshold, the later of the time
at which the threshold offset was last applied, or the time at
which the counter was last initialized (for resettable counters)
(Rec. ITU-T X. 733)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfo/armTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdLevel> ;
            sh:description """In the case of a gauge the threshold level specifies
a pair of threshold values, the first being the value of the crossed
threshold and the second, its corresponding hysteresis; in the case
of a counter the threshold level specifies only the threshold value
(Rec. ITU-T X. 733).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfo/thresholdLevel> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdInfo> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdLevelShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/up> ;
            sh:description """Indicates for counter and gauge thresholds that the
threshold crossing occurred when going up.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdLevel/up> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/down> ;
            sh:description """Indicates for gauge thresholds that the threshold crossing
occurred when going down, applicable only to gauge thresholds.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdLevel/down> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/thresholdLevel> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/topologicalLocationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:int ;
            sh:description """It represents the list of NR cells.

The cell ID, together with the gNB Identifier (using gNBId of the
parent GNBCUCPFunction or GNBDUFunction or ExternalCUCPFunction),
identifies a NR cell within a PLMN. This is the NR Cell Identity(NCI).
See subclause 8.2 of TS 38.300""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/topologicalLocation/cellIDList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/trackingAreaIdList> ;
            sh:description "It represents the list of tracking areas within a PLMN." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/topologicalLocation/trackingAreaIdList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/servingPLMN> ;
            sh:description "It specifies the PLMN to be served." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/topologicalLocation/servingPLMN> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/topologicalLocation> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/traceConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/traceReference> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/traceTarget> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/trackingAreaIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/trackingAreaIdList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-subnetwork/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/trackingAreaIdList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/trackingAreaIdList> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/uPFConnectionInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This parameter defines address of an UPF instance,
It can be IP address (either IPv4 address (See RFC 791) or
IPv6 address (See RFC 2373) or FQDN (See TS 23.003). """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/uPFConnectionInfo/uPFIpAddress> ],
        [ sh:description "This attribute holds the DN of an UPF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/uPFConnectionInfo/uPFRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/uPFConnectionInfo> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/upShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Higher value of a threshold with hysteresis, the integer
type is used for counter thresholds and the float type for gauge
thresholds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/up/high> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Lower value of a threshold with hysteresis, applicable
only to gauge thresholds.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-subnetwork/up/low> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-subnetwork/up> .

<urn:3gpp:sa5:_3gpp-common-util/ConditionMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor/id> ],
        [ sh:datatype xsd:string ;
            sh:description """A logical condition containing an XPath expression.
The leaf contains an XPath 1.0 string with the following restrictions
- The accessible tree is the full Network Resource Model
- The root node is the list representing the top level MOI
(E.g. ManagedElement)
- In the accessible tree, all leafs and leaf-lists with default values
in use exist
- The data tree has no concept of document order except when 'ordered-by
user' is declared.
- The set of variable bindings is empty.
- The function library is the core function library defined in XPATH
- Namespaces should be ignored when evaluating the expression

An empty string is not allowed.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor/condition> ],
        [ sh:datatype xsd:boolean ;
            sh:description """The boolean result of the condition.
Switches between TRUE and FALSE depending upon whether the
configured constraints are fulfilled or not.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor/conditionStatus> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor> .

<urn:3gpp:sa5:_3gpp-common-util/SchedulerShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/Scheduler/id> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Switches between TRUE and FALSE depending upon whether the
configured time constraints are fulfilled or not.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/Scheduler/schedulerStatus> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-util/schedulingTimes> ;
            sh:description "It defines the active scheduling times." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/Scheduler/schedulingTimes> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-util/Scheduler> .

<urn:3gpp:sa5:_3gpp-common-util/schedulingTimesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/schedulingTimes/startTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/schedulingTimes/endTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Shall be present in case of Weekly periodicity,
otherwise not""" ;
            sh:in ( "MONDAY" "TUESDAY" "WEDNESDAY" "THURSDAY" "FRIDAY" "SATURDAY" "SUNDAY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/schedulingTimes/daysOfWeek> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Shall be present in case of Monthly periodicity,
otherwise not""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/schedulingTimes/daysOfMonth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-util/timeIntervals> ;
            sh:description """List of intervals within one day for which the service
shall be active.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/schedulingTimes/timeIntervals> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-util/schedulingTimes> .

<urn:3gpp:sa5:_3gpp-common-util/timeIntervalsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It indicates the time (in 'full-time' format) when the
service shall be started.
Data type 'FullTime' defines the time as specified by 'full-time'
in RFC3339.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/timeIntervals/intervalStart> ;
            sh:pattern "(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the time (in 'full-time' format) when the
service shall be stopped.
'FullTime' defines the time as specified by 'full-time' in RFC3339.
intervalEnd should use the same timezone as intervalStart and shall
be later then intervalStart""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-common-util/timeIntervals/intervalEnd> ;
            sh:pattern "(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-common-util/timeIntervals> .

<urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroupShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup/id> ],
        [ sh:description """The list of energy supply modes for the Network Elements
of the group. This information is configured by the operator with the
information obtained from external sources.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup/energySupplyModeRefList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """This attribute contains the DNs of managed entities
that are members of the energy info group.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup/memberDNList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup> .

<urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo/id> ],
        [ sh:description """The list of energy supply modes for the Network Elements
of the group. This information is configured by the operator with the
information obtained from external sources.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo/energySupplyModeRefList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """This attribute contains the DNs of managed entities
that are members of the energy info group.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo/memberDNList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/userLabel> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The maximum amount of change of azimuth the RET
system can support. This is the change in degrees clockwise
from bearing.
Note: The value of this attribute has no operational impact
on the network, e.g. the NE behaviour is not affected by the
value setting of this attribute.
Note as well that this attribute is not supported over the
Iuant interface according to Ref. 3GPP TS 37.466.
A single decimal value corresponding to an angle in degrees
between 0 and 360 with a resolution of 0.1 degrees.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/maxAzimuthValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The minimum amount of change of azimuth the RET
system can support. This is the change in degrees clockwise
from bearing.
Note: The value of this attribute has no operational impact
on the network, e.g. the NE behaviour is not affected by the
value setting of this attribute.
Note as well that this attribute is not supported over the
Iuant interface according to Ref. 3GPP TS 37.466.
A single decimal value corresponding to an angle in degrees
between 0 and 360 with a resolution of 0.1 degrees.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/minAzimuthValue> ],
        [ sh:description """This attribute contains the DNs of one or more objects
that refer to this object.

In the case of  AntennaFunction,  these referring objects may
include DNs of SectorEquipmentFunction instances if associations
between them and the AntennaFunction exist.

Note: referencedBy is a DN datatype and so can reference an MOI
under a different ME""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/referenceFrom> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The group name is a textual, alpha-numeric string to
define a logical grouping of antennas which may be in different cells.

This attribute permits the definition of a logical grouping
of the antennas. This may be defined either at
installation time, or by management activity""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/retGroupName> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """The electrical tilt setting of the antenna, "Tilt value" in
3GPP TS 37.466.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/retTiltValue> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """The 3 dB power beamwidth of the antenna pattern in
the vertical plane.
The value of this attribute has no operational impact on
the network, e.g. the NE behaviour is not affected by the
value setting of this attribute.
This attribute is not supported over the Iuant interface
according to Ref. 3GPP TS 37.466.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/vertBeamWidth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/SupportedPerfMetricGroups> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """The beam tilt of the wanted antenna beam
in the vertical plane. A positive value on the
beamtilt indicates an antenna beam direction below the
vertical plane.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/beamTilt> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """The bearing in degrees that the antenna is pointing in.
AllowedValues: See "Antenna bearing" in 3GPP TS 25.463.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/bearing> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The elevation the antenna function should have,
based on World Geodetic System (1984 version) global
reference frame (WGS 84). Positive values correspond to
meters above sea level, negative values correspond to meters
below sea level. If empty, value is not defined.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/elevation> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """The 3 dB power beamwidth of the antenna pattern
in the horizontal plane.
A value of 360 indicates an omnidirectional antenna.
Note: The value of this attribute has no operational impact
on the network, e.g. the NE behaviour is not affected by the
value setting of this attribute.
Note as well that this attribute is not supported over the
Iuant interface according to 3GPP TS37.466.
A single integral value corresponding to an angle in degrees
between 0 and 360.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/horizBeamWidth> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Latitude of transmitter antenna position.
Positive value means north, negative value means south.

Specification: WGS 84
Allowed Values: { -90.000000..90.000000 }""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude of transmitter antenna position.
Positive value means east, negative value means west.
Specification: WGS 84
Allowed Values: { -180.000000..180.000000 }""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/longititude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/operations> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnId> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnList> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sAP> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/taiList> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceReference> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-antennafunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-antennafunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/userLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/SupportedPerfMetricGroups> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It defines the allowed total power to use for all
cells together in this sector.
It may be set by the operator and/or limited by HW limitation
or licensed power, e.g.: 20, 40, 60, 80,120 watts""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/confOutputPower> ],
        [ sh:datatype xsd:string ;
            sh:description """The list of frequency bands/ranges supported by the
hardware associated with the SectorEquipmentFunction. The
earfcnDl and earfcnUl or earfcn of cells associated with the
SectorEquipmentFunction must be assigned one of the specified
frequency range values within the supported range.

Valid frequency bands/ranges may be found in 3GPP TS 25.104 (UTRA),
36.104 (E-UTRA) and 38.104 (NR).

AllowedValues:
Operating band id or supported frequency tuple
<UL,DL,mode> expressed as a string.

Examples for NR:
Bands:  {'n1', 'n12'}
Frequencies: {'1920–1980, 2110–2170, FDD', '699–716, 729–746, FDD'}""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/fqBandList> ],
        [ sh:description """This attribute contains the DNs of one or more objects
that refer to this object.

In the case of SectorEquipmentFunction , these referring objects
may include e.g. Cells, NRSectorCarriers if associations from them
and the SectorEquipmentFunction exist.

Note: referencedBy is a DN datatype and so can reference an MOI
under a different ME""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/referenceFrom> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """This attribute contains the DNs of one or more objects
referred to by this object.

In the case of SectorEquipmentFunction , these referred to objects
may include e.g. TMAFunction if associations to them
and the SectorEquipmentFunction exist.

Note: referencedBy is a DN datatype and so can reference an MOI
under a different ME""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/referenceTo> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/peeParameterslist> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/operations> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnId> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnList> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sAP> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/taiList> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceReference> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReaderShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/id> ],
        [ sh:datatype xsd:int ;
            sh:description """It defines the reader identifier to uniquely identify a
reader within a gNB.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/readerId> ],
        [ sh:description """It indicates the administrative state of the AIOTReader.
It describes the permission to use or prohibition against using the
AIOT reader, imposed through the OAM services.""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/administrativeState> ],
        [ sh:description """It indicates the supported AIOT service type for an
AIOT reader.""" ;
            sh:in ( "INVENTORY" "COMMAND" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/supportedAIOTServices> ],
        [ sh:datatype xsd:string ;
            sh:description """This specifies the geographical location of a A-IoT reader.
Reader Location may represent any of latitude/longitude, or any
geographical location/coordinate/area polygon.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/readerLocation> ],
        [ sh:description """This attribute contains the DN of the referenced
NRSectorCarrier.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/nRSectorCarrierRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId> ;
            sh:description "Defines which PLMN that can be served by the AIOT reader." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/pLMNId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/servedAIOTAreas> ;
            sh:description """This attribute is used to specify the A-IoT areas supported
by the A-IoT reader. It contains one or multiple A-IoT Area ID, which
is used to uniquely identify an A-IoT Area.

A-IoT Area ID = PLMN ID +NID (optional) + A-IoT Area Code
(OCTET STRING (SIZE(3))), which is defined in TS 38.413.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/servedAIOTAreas> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader> .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/servedAIOTAreasShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid identifies
an SNPN (see clauses 5.30.2.3, 5.30.2.9, 6.3.4, and 6.3.8 in 3GPP
TS 23.501""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/servedAIOTAreas/nID> ;
            sh:pattern "[A-Fa-f0-9]{11}" ],
        [ sh:datatype xsd:string ;
            sh:description """This specifies the identity of the A-IoT Area Code which is
one of the components of A-IoT Area ID. It's a 3-octet string defined
in TS 38.413.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/servedAIOTAreas/aIotAreaCode> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId> ;
            sh:description "It defines which PLMN that can be served by the AIOT reader." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/servedAIOTAreas/pLMNId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/servedAIOTAreas> .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/BeamShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/id> ],
        [ sh:datatype xsd:int ;
            sh:description "Index of the beam. " ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamIndex> ],
        [ sh:description "The type of the beam. " ;
            sh:in ( "SSB-BEAM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamType> ],
        [ sh:datatype xsd:int ;
            sh:description """The azimuth of a beam transmission, which means the
horizontal beamforming pointing angle (beam peak direction) in the
Phi-axis in 1/10th degree resolution. The pointing angle is the
direction equal to the geometric centre of the half-power contour
of the beam relative to the reference plane. Zero degree implies
explicit antenna bearing (boresight). Positive angle implies clockwise
from the antenna bearing.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamAzimuth> ],
        [ sh:datatype xsd:int ;
            sh:description """The tilt of a beam transmission, which means the vertical
beamforming pointing angle (beam peak direction) in the Theta-axis in
1/10th degree resolution.
The pointing angle is the direction equal to the geometric centre of
the half-power contour of the beam relative to the reference plane.
Positive value implies downtilt.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamTilt> ],
        [ sh:datatype xsd:int ;
            sh:description """ The Horizontal beamWidth of a beam transmission, which
means the horizontal beamforming half-power (3dB down) beamwidth in the
Phi-axis in 1/10th degree resolution.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamHorizWidth> ],
        [ sh:datatype xsd:int ;
            sh:description """ The Vertical beamWidth of a beam transmission, which means
the vertical beamforming half-power (3dB down) beamwidth in the
Theta-axis in 1/10th degree resolution.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamVertWidth> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/userLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/SupportedPerfMetricGroups> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/supportedTraceMetrics> ],
        [ sh:description """Identifies whether the object is used for downlink, uplink
or supplementary uplink.""" ;
            sh:in ( "DL" "UL" "SUL" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/bwpContext> ],
        [ sh:description """Identifies whether the object is used for initial or other
BWP.""" ;
            sh:in ( "INITIAL" "OTHER" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/isInitialBwp> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Subcarrier spacing configuration for a BWP." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/subCarrierSpacing> ],
        [ sh:description "Cyclic prefix, which may be normal or extended." ;
            sh:in ( "NORMAL" "EXTENDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/cyclicPrefix> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Offset in common resource blocks to common resource block 0
for the applicable subcarrier spacing for a BWP.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/startRB> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Number of physical resource blocks for a BWP." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/numberOfRBs> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/freqInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/geoPolygon> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/mdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/nPNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/operations> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/sliceIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/taiList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/userLabel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/supportedTraceMetrics> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/SupportedPerfMetricGroups> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/freqInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/geoPolygon> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/mdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/nPNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/operations> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/sliceIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/taiList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
