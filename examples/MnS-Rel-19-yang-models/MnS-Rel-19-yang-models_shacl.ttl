            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNPNList/mcc> ],
        [ sh:datatype xsd:string ;
            sh:description "Mobile Network Code (MNC) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNPNList/mnc> ],
        [ sh:datatype xsd:string ;
            sh:description "Network Identifier (NID) of the SNPN." ;
