    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
