<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/supiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start ofa SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g., IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/supiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g. IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/supiRangeList/end> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the set of SUPI's belonging to
this range.A SUPI value is considered part of the range if and
only if the SUPI string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/supiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/supiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/supportedVendorSpecificFeaturesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "IANA-assigned SMI Network Management Private Enterprise Code" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/supportedVendorSpecificFeatures/enterpriseCode> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vendorSpecificFeature> ;
            sh:description """VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/supportedVendorSpecificFeatures/vendorSpecificFeature> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/supportedVendorSpecificFeatures> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/tacRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of a TAC range,
to be used when the range of TAC's can be represented
as a hexadecimal range (e.g., TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/tacRangeList/start> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6}$)" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a TAC range,
to be used when the range of TAC's can be represented as
a hexadecimal range (e.g. TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/tacRangeList/end> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6})$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262)
representing the set of TAC's belonging to this range.
A TAC value is considered part of the range if and only if the
TAC string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/tacRangeList/nRTACpattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/tacRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/taiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/taiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/plmnId> ;
            sh:description "PLMN ID related to the TacRange." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/taiRangeList/plmnId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/tacRangeList> ;
            sh:description "The range of the TACs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/taiRangeList/tacRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/taiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vendorSpecificFeatureShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It is a string representing a proprietary feature
specific to a given vendor.
It is recommended that the case convention for these strings is the
same as for enumerated data types (i.e. UPPER_WITH_UNDERSCORE;
see 3GPP TS 29.501, clause 5.1.1).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vendorSpecificFeature/featureName> ],
        [ sh:datatype xsd:string ;
            sh:description "It is a string representing the version of the feature." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vendorSpecificFeature/featureVersion> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vendorSpecificFeature> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/versionsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/versions/apiVersionInUri> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/versions/apiFullVersion> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/versions/expiry> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/versions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/userLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList> ;
            sh:description """It is a set of NFProfile(s) to be registered in the NRF
instance. NFProfile is defined in 3GPP TS 29.510 """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/nFProfileList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo> ;
            sh:description "Represents information of an NRF NF Instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/nrfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile> ;
            sh:description "This parameter defines profile for managed NF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/managedNFProfile> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/aIoTNRFMapping> ;
            sh:description """Represents mapping information between (Internal) target
area (provided by NEF) and AIOTF DN.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/aIoTNRFMapping> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It is used to indicate the FQDN of the registered NF instance
in service-based interface, for example, NF instance FQDN structure is:
nftype<nfnum>.slicetype<sliceid>.mnc<MNC>.mcc<MCC>.3gppnetwork.org""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/sBIFQDN> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """NSI ID. NSI ID is an identifier for identifying the Core
Network part of a Network Slice instance when multiple Network Slice
instances of the same Network Slice are deployed, and there is a need
to differentiate between them in the 5GC, see clause 3.1 of TS 23.501
and subclause 6.1.6.2.7 of 3GPP TS 29.531""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/cNSIIdList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/SupportedPerfMetricGroups> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList> ;
            sh:description "It defines the PLMN(s) of a Network Function." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/pLMNInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/aIoTNRFMappingShape> a sh:NodeShape ;
    sh:property [ sh:description """Represents the distinguished name (DN) identifier of the
AIOTF that serves the (internal) target area provided by NEF to NRF""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/aIoTNRFMapping/aIOTFdN> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalTargetArea> ;
            sh:description """It is the (internal) target area used by NRF (as provided
by NEF) to accurately locate the AIOTF instance. It is mapped to aIOTFdN.
It could refer to a list of AIoT Areas.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/aIoTNRFMapping/internalTargetArea> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/aIoTNRFMapping> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddressesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the IMSI range." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses/id> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates the Diameter
name of the network node diameter address.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses/name> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates the Diameter realm of the
network node diameter addres. See TS 29.571 [61]. String contains
a Diameter Identity (FQDN).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses/realm> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAIShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAI/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAI/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAI> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAIsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAIs/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAIs/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAIs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPLMNsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPLMNs/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPLMNs/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPLMNs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPlmnsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPlmns/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPlmns/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPlmns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSNPNsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This is the Mobile Country Code (MCC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSNPNs/mCC> ],
        [ sh:datatype xsd:string ;
            sh:description """This is the Mobile Network Code (MNC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSNPNs/mNC> ],
        [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid
identifies an SNPN""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSNPNs/nId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSNPNs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSnpnsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSnpns/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSnpns/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSnpns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/atsssCapabilityShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """Indicates the ATSSS-LL capability to support procedures
related to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/atsssCapability/atsssLL> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates the MPTCP capability to support procedures related
to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/atsssCapability/mptcp> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF supports RTT measurement without
PMF (see clauses 5.32.2, 6.3.3.3 of TS 23.501).
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/atsssCapability/rttWithoutPmf> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/atsssCapability> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfFailureShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """The AMFI is constructed from an AMF Region ID, an
AMF Set ID and an AMF Pointer. The AMF Region ID identifies the region,
the AMF Set ID uniquely identifies the AMF Set within the AMF Region,
and the AMF Pointer uniquely identifies the AMF within the AMF Set.
(Ref. 3GPP TS 23.003)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfFailure/aMFIdentifier> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNId> ;
            sh:description "This attribute represents a PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfFailure/pLMNId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfFailure> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfRemovalShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """The AMFI is constructed from an AMF Region ID, an
AMF Set ID and an AMF Pointer. The AMF Region ID identifies the region,
the AMF Set ID uniquely identifies the AMF Set within the AMF Region,
and the AMF Pointer uniquely identifies the AMF within the AMF Set.
(Ref. 3GPP TS 23.003)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfRemoval/aMFIdentifier> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNId> ;
            sh:description "This attribute represents a PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfRemoval/pLMNId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfRemoval> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/collocatedNfInstancesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/collocatedNfInstances/nfInstanceId> ],
        [ sh:description "Type of Network Function." ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/collocatedNfInstances/nfType> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/collocatedNfInstances> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItemShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/id> ],
        [ sh:description """It represents the NF types of the consumers for
which the conditions included in this ConditionItem apply.
If this attribute is absent, the conditions are applicable
to all NF consumer types.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/consumerNfTypes> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeList> ;
            sh:description """It represents a set of TAIs where the
NF(Service) instance under CANARY_RELEASE status shall
be selected for a certain UE""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/taiRangeList> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It represents a feature number of that NF Service
Instance,under CANARY_RELEASE status. This attribute only
applies when the          selectionConditions, where this
ConditionItem is included, is included in a NF Service Instance
This condition is evaluated to <true> when the service requests
froma consumer of this NF Service Instance require the support
of the indicated feature on the NF Service Instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/serviceFeature> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It represents a Vendor-Specific feature
number of thatNF Service Instance, under CANARY_RELEASE
status. This attribute only applies when the
selectionConditions, where this ConditionItem is included,
is included in a NF Service Instance.This condition is
evaluated to true when the service requests from a
consumer of this NF Service Instance require the support
of the indicated Vendor-Specific feature on the NF
Service Instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/vsServiceFeature> ],
        [ sh:datatype xsd:string ;
            sh:description """It represents a set of PEIs of the UEs for
which the NF(Service) instance under CANARY_RELEASE status
shall be selected""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/peiList> ],
        [ sh:datatype xsd:string ;
            sh:description """ It represents a set of TAIs where the NF
(Service) instance under CANARY_RELEASE status shall be
selected for a certain UE""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/dnnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRangeList> ;
            sh:description """It represents a set of SUPIs for which
the NF (Service) instance under CANARY_RELEASE status shall
be selected.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/supiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeList> ;
            sh:description """It represents a set of GPSIs for which the NF
(Service)
instance under CANARY_RELEASE status shall be selected""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/gpsiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impuRangeList> ;
            sh:description """It represents a set of IMS Public Identities
for which the NF (Service) instance under CANARY_RELEASE
status shall be selected""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/impuRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impiRangeList> ;
            sh:description """It represents a set of IMS Private Identities
for which theNF (Service) instance under
CANARY_RELEASE status shall be selected.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem/impiRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/conditionItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptionsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "N1_MESSAGES" "N2_INFORMATION" "LOCATION_NOTIFICATION" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/notificationType> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/callbackUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the optional path segment(s) used to construct
the prefix of the Callback URIs during the reselection of an NF service
consumer, as described in 3GPP TS 29.501""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/callbackUriPrefix> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the callback URI to be used by NF Service
Producers located in PLMNs that are different from the PLMN of
the NF consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/interPlmnCallbackUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:in ( "5GMM" "SM" "LPP" "SMS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/n1MessageClass> ],
        [ sh:in ( "SM" "NRPPA" "PWS" "PWS_BCAL" "PWS_RF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/n2InformationClass> ],
        [ sh:description """This attribute identifies the API versions
(e.g. v1) supported for the default notification type""" ;
            sh:in ( "SM" "NRPPA" "PWS" "PWS_BCAL" "PWS_RF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/versions> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute shall contain the value of the Binding
Indication for the default subscription notification """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/binding> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the content encodings that are accepted by a
NF Service Consumer when receiving a notification related to a default
notification subscription""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/acceptedEncoding> ],
        [ sh:datatype xsd:string ;
            sh:description """It is a string, which indicates the features of the service
corresponding to the subscribed default notification, which are supported
by the NF (Service) instance acting as NF service consumer. The string
shall contain a bitmask indicating supported features in hexadecimal
representation:Each character in the string shall take a value
of 0 to 9, a to f or A to F """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/supportedFeatures> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates a list of service specific information. It may
be present when the notification request of the notification type may be
generated by multiple services, i.e. notifications from different
services may be received by the subscription.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions/serviceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnSmfInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Supported DNN." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnSmfInfoList/dnn> ],
        [ sh:datatype xsd:string ;
            sh:description """List of Data network access identifiers supported by
the SMF for this DNN. The absence of this attribute indicates that
the SMF can be selected for this DNN for any DNAI.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnSmfInfoList/dnaiList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnSmfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String representing a Data Network." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/dnn> ],
        [ sh:datatype xsd:string ;
            sh:description """List of Data network access identifiers supported
by the UPF for this DNN.
The absence of this attribute indicates that the UPF
can be selected for this DNN for any DNAI.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/dnaiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv6PrefixRanges> ;
            sh:description """This attribute represents a list of ranges of NATed IPv6
prefixes.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/natedIpv6PrefixRanges> ],
        [ sh:description """List of PDU session type(s) supported by
the UPF for a specific DNN.""" ;
            sh:in ( "IPV4" "IPV6" "IPV4V6" "UNSTRUCTURED" "ETHERNET" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/pduSessionTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a list of Ipv4 Index supported by
the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/ipv4IndexList> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a list of Ipv6 Index supported
by the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/ipv6IndexList> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents the N6 Network Instance
(See TS 29.244) associated with the S-NSSAI and DNN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/networkInstance> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a map of a network instance per
DNAI for the DNN, where the key of the map is the DNAI (Data network
access identifier), see TS 23.501.

When present, the value of each entry of the map shall contain a N6
network instance that is configured for the DNAI indicated by the key.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/dnaiNwInstanceList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv4AddressRanges> ;
            sh:description """This attribute represents a list of ranges of IPv4 addresses
handled by UPF. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/ipv4AddressRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges> ;
            sh:description """This attribute represents a list of ranges of IPv6 prefixes
handled by the UPF. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/ipv6PrefixRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv4AddressRanges> ;
            sh:description """This attribute represents a list of ranges of NATed IPv4
addresses.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList/natedIpv4AddressRanges> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/flTimeIntervalShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/flTimeInterval/startTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/flTimeInterval/endTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/flTimeInterval> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gUAMIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """The AMFI is constructed from an AMF Region ID, an
AMF Set ID and an AMF Pointer. The AMF Region ID identifies the region,
the AMF Set ID uniquely identifies the AMF Set within the AMF Region,
and the AMF Pointer uniquely identifies the AMF within the AMF Set.
(Ref. 3GPP TS 23.003)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gUAMIdList/aMFIdentifier> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNId> ;
            sh:description "This attribute represents a PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gUAMIdList/pLMNId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gUAMIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeList/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRanges/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRanges/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRanges/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddressShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the IMSI range." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress/id> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates the Diameter
name of the network node diameter address.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress/name> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates the Diameter realm of the
network node diameter addres. See TS 29.571 [61]. String contains
a Diameter Identity (FQDN).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress/realm> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impiRangeList/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impuRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impuRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impuRangeList/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impuRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/impuRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPrivateIdentityRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the IMSI range." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPrivateIdentityRanges/id> ],
        [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPrivateIdentityRanges/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPrivateIdentityRanges/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPrivateIdentityRanges/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPrivateIdentityRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPublicIdentityRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the IMSI range." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPublicIdentityRanges/id> ],
        [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPublicIdentityRanges/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPublicIdentityRanges/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPublicIdentityRanges/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPublicIdentityRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the IMSI range." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges/id> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates the first value identifying
the start of a IMSI range. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates the last value identifying
the end of a IMSI range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges/end> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates pattern (regular expression
according to the ECMA-262 dialect [75]) representing the set of
IMSIs belonging to this range. An IMSI value is considered part
of the range if and only if the IMSI string fully matches the
regular expression.Either the start and end attributes, or the
pattern attribute, shall be present.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/interfaceUpfInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """User Plane interface type.
See TS 29.510[23] clause 6.1.6.3.9""" ;
            sh:in ( "N3" "N6" "N9" "DATA_FORWARDING" "N6MB" "N19MB" "N3MB" "NMB9" "S1U" "S5U" "S8U" "S11U" "S12" "S2AU" "S2BU" "N3TRUSTEDN3GPP" "N3UNTRUSTEDN3GPP" "N9ROAMING" "SGI" "N19" "SXAU" "SXBU" "N4U" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/interfaceUpfInfoList/interfaceType> ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/interfaceUpfInfoList/ipv4EndpointAddresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/interfaceUpfInfoList/ipv6EndpointAddresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/interfaceUpfInfoList/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """Network Instance (See TS 29.244) associated to the User
Plane interface""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/interfaceUpfInfoList/networkInstance> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/interfaceUpfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalGroupIdentifiersRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It indicates first value identifying the start of an
identity range, to be used when the range of identities can be
represented as a consecutive numeric range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalGroupIdentifiersRanges/start> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates last value identifying the end of an
identity range, to be used when the range of identities can be
represented as a consecutive numeric range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalGroupIdentifiersRanges/end> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates pattern (regular expression according
to the ECMA-262 dialect [75]) representing the set of identities
belonging to this range. An identity value is considered part of
the range if and only if the identity string fully matches the
regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalGroupIdentifiersRanges/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalGroupIdentifiersRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalTargetAreaShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid identifies
an SNPN (see clauses 5.30.2.3, 5.30.2.9, 6.3.4, and 6.3.8 in 3GPP
TS 23.501""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalTargetArea/nID> ;
            sh:pattern "[A-Fa-f0-9]{11}" ],
        [ sh:datatype xsd:string ;
            sh:description """This specifies the identity of the A-IoT Area Code which is
one of the components of A-IoT Area ID. It's a 3-octet string defined
in TS 38.413.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalTargetArea/aIotAreaCode> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNId> ;
            sh:description "It defines which PLMN that can be served by the AIOT reader." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalTargetArea/pLMNId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalTargetArea> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipEndPointsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipEndPoints/ipv4Address> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipEndPoints/ipv6Address> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipEndPoints/ipv6Prefix> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ],
        [ sh:in ( "TCP" "STCP" "UDP" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipEndPoints/transport> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipEndPoints/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipEndPoints> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv4AddressRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv4AddressRanges/start> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv4AddressRanges/end> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges/start> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges/end> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfInstanceId> ],
        [ sh:description "Type of Network Function." ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfType> ],
        [ sh:datatype xsd:string ;
            sh:description """Operator defined information about the location
of the NF instance (e.g. geographic location, data center).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/locality> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the operator defined information about the
location of the NF instance. The key of the map shall be a (unique)
valid JSON string per clause 7 of IETF RFC 8259 [92], with a maximum
of 32 characters, representing a type of locality as defined in
clause 6.1.6.3.18.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/extLocality> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Static capacity information in the range of 0-65535,
expressed as a weight relative to other NF instances of
the same type; if capacity is also present in the nfServiceList
parameters, those will have precedence over this value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/capacity> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Dynamic load information, ranged from 0 to 100,
indicates the current load percentage of the NF.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/load> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the point in time in which the latest load
information (sent by the NF in the load attribute of the NF Profile)
was generated at the NF Instance.If the NF did not provide a timestamp,
the NRF should set it to the instant when the NRF received the message
where the NF provided the latest load information.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/loadTimeStamp> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """Timestamp when the NF was (re)started. The NRF shall notify
NFs subscribed to receiving notifications of changes of the NF profile,
if the NF recoveryTime is changed""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/recoveryTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the different service
instances of a same NF Service in the NF instance, supporting a same
API version, are capable to persist their resource state in shared
storage and therefore these resources are available after a new NF
service instance supporting the same API version is selected by a NF
Service Consumer """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfServicePersistence> ],
        [ sh:datatype xsd:string ;
            sh:description """A NF Set Identifier is a globally unique identifier of
a set of equivalent and interchangeable CP NFs from a given network
that provide distribution, redundancy and scalability
(see clause 5.21.3 of 3GPP TS 23.501 [2]).An NF Set Identifier shall
be constructed from the MCC, MNC, NID (for SNPN), NF type and a Set ID.
A NF Set Identifier shall be formatted as the following string:
set<Set ID>.<nftype>set.5gc.mnc<MNC>.mcc<MCC> for a NF Set in a PLMN, or
set<Set ID>.<nftype>set.5gc.nid<NID>.mnc<MNC>.mcc<MCC> for a NF Set
in a SNPN.At most one NF Set ID shall be indicated per PLMN-ID or SNPN
of the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfSetIdList> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates if the NF Service Consumer supports
or does not support receiving NF Profile Changes. It may be present in
the NFRegister or NFUpdate (NF Profile Complete Replacement) request and
shall be absent in the response (see Annex B 3GPP TS 29.510 [23]).  """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfProfileChangesSupportInd> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It represents NF Profile Partial Update Changes Support
Indicator. TRUE: the NF Service Consumer supports receiving NF Profile
Changes in the response to an NF Profile Partial Update operation.
FALSE (default): the NF Service Consumer does not support receiving
NF Profile Changes in the response to an NF Profile Partial Update
operation""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfProfilePartialUpdateChangesSupportInd> ],
        [ sh:description "Status of the NF Instance." ;
            sh:in ( "REGISTERED" "SUSPENDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfStatus> ],
        [ sh:datatype xsd:boolean ;
            sh:description """NF Profile Changes Indicator. This IE shall be absent
in the request to the NRF and may be included by the NRF
in NFRegister or NFUpdate (NF Profile Complete Replacement) response.
true: the NF Profile contains NF Profile changes.
false (default): complete NF Profile.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfProfileChangesInd> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter indicates the served geographical areas
of a NF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/servingScope> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Load Control based on LCI Header.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/lcHSupportInd> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Overload Control based on OCI Header .""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/olcHSupportInd> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Set(s)
indicated by the NfSetId, where the NF instance belongs.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfSetRecoveryTimeList> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Service
Set(s) configured in the NF instance, which are indicated by the
NfServiceSetId""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/serviceSetRecoveryTimeList> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter shall carry the list of SCP domains the
SCP belongs to, or the SCP domain the NF (other than SCP) or the SEPP
belongs to..""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/scpDomains> ],
        [ sh:datatype xsd:string ;
            sh:description """Vendor ID of the NF instance, according to the
IANA-assigned SMI Network Management Private Enterprise Codes [77].
allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits 0 to complete
a 6-digit string value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/vendorId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/hniList> ],
        [ sh:datatype xsd:string ;
            sh:description """If the NF needs to be discoverable by other
NFs in a different PLMN, then an FQDN that is used
for inter-PLMN routing is specified.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/interPlmnFqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description "It represents human readable name of the NF Instance" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfInstanceName> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF instance whose
nfStatus is set to REGISTERED is in Canary Release condition,
i.e. it should only be selected by NF Service Consumers under the
conditions indicated by the selectionConditions attribute.
True: the NF is under Canary Release condition, even if the
nfStatus is set to REGISTERED
False: the NF instance indicates its Canary Release condition
via the nfStatus attribute""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/canaryRelease> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF Service
Consumer should only select an NF Service Producer in Canary
Release condition.
True: the consumer shall only select producers in Canary Release
condition
False: the consumer may select producers not in Canary Release
condition""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/exclusiveCanaryReleaseSelection> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates a string uniquely identifying
Shared Profile Data. The format of the sharedProfileDataId shall be
a Universally Unique Identifier (UUID) version 4, as described in
IETF RFC 4122 [44]. The hexadecimal letters should be formatted as
lower-case characters by the sender, and they shall be handled as
case-insensitive by the receiver.
Example: 4ace9d34-2c69-4f99-92d5-a73a3fe8e23b""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/sharedProfileDataId> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the timestamp when the NF Instance is
planned to be shut down. This attribute may be present if the
nfStatus is set to UNDISCOVERABLE due to scheduled shutdown""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/shutdownTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "It represents a list of Resource Content Filter IDs" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/supportedRcfs> ],
        [ sh:datatype xsd:boolean ;
            sh:description """ManagedNFProfile.canaryPrecedenceOverPreferred  This
attribute indicates whether the NRF shall prioritize the NF Service
Producer in Canary Release condition over the preferences
(preferred-xxx, ext-preferred-xxx) present in NF discovery requests.
allowedValues:
True NRF shall prioritize NF Service Producers in Canary Release
condition at NF discovery requests, i.e. NF Service Producers
determined according to preferred-xxx and/or ext-preferred-xxx
shall be prioritized after the NF Service Producers in Canary
Release condition. The associated NF (service) priorities for Service
Producers in Canary Release condition shall not be modified by NRF.
False NRF shall prioritize the NF Service Producers according to
preferred-xxx and/or ext-preferred-xxx (i.e. Canary Release condition
in NF Service Producers shall not be prioritized over NF Service
Consumer preferences at NF discovery requests)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/canaryPrecedenceOverPreferred> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/collocatedNfInstances> ;
            sh:description """It represents information related to collocated NF
type(s) and corresponding NF Instances when the NF is collocated
with NFs supporting other NF types.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/collocatedNfInstances> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnList> ;
            sh:description """PLMN(s) of the Network Function.
This IE shall be present if this information
is available for the NF. If not provided, PLMN ID(s)
of the PLMN of the NRF are assumed for the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssais> ;
            sh:description """S-NSSAIs of the Network Function. If not
provided, the NF can serve any S-NSSAI. When present
this IE represents the list of S-NSSAIs supported in
all the PLMNs listed in the plmnList IE.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/sNssais> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPlmns> ;
            sh:description """PLMNs allowed to access the NF instance.
If not provided, any PLMN is allowed to access the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/allowedPlmns> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Time in seconds expected between 2 consecutive
heart-beat messages from an NF Instance to the NRF.
It may be included in the registration request.
When present in the request it shall contain the
heartbeat time proposed by the NF service consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/heartBeatTimer> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNPNList> ;
            sh:description """SNPN(s) of the Network Function. This attributeIE shall be
present if the NF pertains to one or more SNPNs.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/sNPNList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/perPlmnSnssaiList> ;
            sh:description """It includes the S-NSSAIs supported by the Network Function
for each PLMN supported by the Network Function. When present, it shall
override sNssais IE.If the perPlmnSnssaiList attribute is provided in
at least one NF Service, the S-NSSAIs supported per PLMN in the
NF Profile shall be the set or a superset of the perPlmnSnssaiList
of the NFService(s).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/perPlmnSnssaiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSNPNs> ;
            sh:description """SNPNs allowed to access the NF instance.
The absence of this attribute in the NF profile indicates that no SNPN,
other than the SNPN(s) registered in the snpnList attribute of the
NF Profile, is allowed to access the service instance""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/allowedSNPNs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAIs> ;
            sh:description """S-NSSAI of the allowed slices to access the NF instance.
If not provided, any slice is allowed to access the NF.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/allowedNSSAIs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions> ;
            sh:description """Notification endpoints for different notification types.
This attribute may contain multiple default subscriptions for a same
notification type; in that case, those default subscriptions are used
as alternative notification endpoints.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/defaultNotificationSubscriptions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices> ;
            sh:description """List of NF Service Instances. It shall include
the services produced by the NF that can be
discovered by other NFs.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/nfServices> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supportedVendorSpecificFeatures> ;
            sh:description """It indicates a map of Vendor-Specific features, where the
key of the map is the IANA-assigned SMI Network Management Private
Enterprise Codes and the value of each entry of the map shall be
a list (array) of VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/supportedVendorSpecificFeatures> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/selectionConditions> ;
            sh:description """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/selectionConditions> ],
        [ sh:datatype xsd:string ;
            sh:description """FQDN of the Network Function. For AMF, the
FQDN registered with the NRF shall be that of the AMF Name.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description "Host address of a NF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/hostAddr> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines NF Specific Service authorization
information. It shall include the NF type (s) and NF realms/origins
allowed to consume NF Service(s) of NF Service Producer """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/authzInfo> ],
        [ sh:description """Type of the NFs allowed to access the NF instance.
If not provided, any NF type is allowed to access the NF.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/allowedNfTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262
dialect [75]) representing the NF domain names within the PLMN of
the NRF allowed to access the NF instance If not provided,
any NF domain is allowed to access the NF.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile/allowedNfDomains> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/managedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mlAnalyticsListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This attribute represents the Analytic functionalities
(identified by nwdafEvent defined in TS 29.520 [85]) of the NWDAF
instance. MnS consumer can configure this attribute to specify
which Analytic functionalities (identified by nwdafEvent) can be
performed the NWDAF instance. If the value of this attribute is not
present, the NWDAF instance can perform any NWDAFEvents

Analytics Id(s) supported by the Nnwdaf_MLModelProvision service,
if none are provided the NWDAF can serve any mlAnalyticsId.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mlAnalyticsList/mlAnalyticsIds> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute defines the list of NWDAF vendors that are
allowed to retrieve ML models from the NWDAF containing MTLF. The
absence of this attribute indicates that none of the NWDAF vendors
can retrieve the ML models.

allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits '0' to complete a
6-digit string value.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mlAnalyticsList/mlModelInterInfo> ;
            sh:pattern "[0-9]{6}" ],
        [ sh:description """This attribute defines the federated learning capability
type supported by NWDAF containing MTLF.""" ;
            sh:in ( "FL_SERVER" "FL_CLIENT" "FL_SERVER_AND_CLIENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mlAnalyticsList/flCapabilityType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNSSAIList> ;
            sh:description """List of S-NSSAIs the managed object is capable of
supporting.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mlAnalyticsList/sNSSAIList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trackingAreaList> ;
            sh:description """This attribute represents area of Interest of the ML model,
if none are provided the ML model for the analytics can apply to any
TAIs.

If present, it represents the list of TAIs, it may contain one or
more non-3GPP access TAIs.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mlAnalyticsList/trackingAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/flTimeInterval> ;
            sh:description """This attribute defines the time window at which the
indicated flCapabilityType supported by NWDAF MTLF is available.
This attribute shall be present only if flCapabilityType attribute
is present.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mlAnalyticsList/flTimeInterval> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mlAnalyticsList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique identifier for the IMSI range." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges/id> ],
        [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/n2InterfaceAmfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This attribute represents available AMF endpoint
IPv4 address(es) for N2.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/n2InterfaceAmfInfo/ipv4EndpointAddress> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents available AMF endpoint
IPv6 address(es) for N2.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/n2InterfaceAmfInfo/ipv6EndpointAddress> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents AMF Name FQDN as defined in
clause 28.3.2.5 of TS 23.003.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/n2InterfaceAmfInfo/amfName> ;
            sh:pattern "[a-zA-Z0-9\\-\\.]+" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/n2InterfaceAmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfInstanceId> ],
        [ sh:description "Type of Network Function." ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfType> ],
        [ sh:datatype xsd:string ;
            sh:description """Operator defined information about the location
of the NF instance (e.g. geographic location, data center).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/locality> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the operator defined information about the
location of the NF instance. The key of the map shall be a (unique)
valid JSON string per clause 7 of IETF RFC 8259 [92], with a maximum
of 32 characters, representing a type of locality as defined in
clause 6.1.6.3.18.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/extLocality> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Static capacity information in the range of 0-65535,
expressed as a weight relative to other NF instances of
the same type; if capacity is also present in the nfServiceList
parameters, those will have precedence over this value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/capacity> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Dynamic load information, ranged from 0 to 100,
indicates the current load percentage of the NF.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/load> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the point in time in which the latest load
information (sent by the NF in the load attribute of the NF Profile)
was generated at the NF Instance.If the NF did not provide a timestamp,
the NRF should set it to the instant when the NRF received the message
where the NF provided the latest load information.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/loadTimeStamp> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """Timestamp when the NF was (re)started. The NRF shall notify
NFs subscribed to receiving notifications of changes of the NF profile,
if the NF recoveryTime is changed""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/recoveryTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the different service
instances of a same NF Service in the NF instance, supporting a same
API version, are capable to persist their resource state in shared
storage and therefore these resources are available after a new NF
service instance supporting the same API version is selected by a NF
Service Consumer """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfServicePersistence> ],
        [ sh:datatype xsd:string ;
            sh:description """A NF Set Identifier is a globally unique identifier of
a set of equivalent and interchangeable CP NFs from a given network
that provide distribution, redundancy and scalability
(see clause 5.21.3 of 3GPP TS 23.501 [2]).An NF Set Identifier shall
be constructed from the MCC, MNC, NID (for SNPN), NF type and a Set ID.
A NF Set Identifier shall be formatted as the following string:
set<Set ID>.<nftype>set.5gc.mnc<MNC>.mcc<MCC> for a NF Set in a PLMN, or
set<Set ID>.<nftype>set.5gc.nid<NID>.mnc<MNC>.mcc<MCC> for a NF Set
in a SNPN.At most one NF Set ID shall be indicated per PLMN-ID or SNPN
of the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfSetIdList> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates if the NF Service Consumer supports
or does not support receiving NF Profile Changes. It may be present in
the NFRegister or NFUpdate (NF Profile Complete Replacement) request and
shall be absent in the response (see Annex B 3GPP TS 29.510 [23]).  """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfProfileChangesSupportInd> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It represents NF Profile Partial Update Changes Support
Indicator. TRUE: the NF Service Consumer supports receiving NF Profile
Changes in the response to an NF Profile Partial Update operation.
FALSE (default): the NF Service Consumer does not support receiving
NF Profile Changes in the response to an NF Profile Partial Update
operation""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfProfilePartialUpdateChangesSupportInd> ],
        [ sh:description "Status of the NF Instance." ;
            sh:in ( "REGISTERED" "SUSPENDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfStatus> ],
        [ sh:datatype xsd:boolean ;
            sh:description """NF Profile Changes Indicator. This IE shall be absent
in the request to the NRF and may be included by the NRF
in NFRegister or NFUpdate (NF Profile Complete Replacement) response.
true: the NF Profile contains NF Profile changes.
false (default): complete NF Profile.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfProfileChangesInd> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter indicates the served geographical areas
of a NF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/servingScope> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Load Control based on LCI Header.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/lcHSupportInd> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Overload Control based on OCI Header .""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/olcHSupportInd> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Set(s)
indicated by the NfSetId, where the NF instance belongs.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfSetRecoveryTimeList> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Service
Set(s) configured in the NF instance, which are indicated by the
NfServiceSetId""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/serviceSetRecoveryTimeList> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter shall carry the list of SCP domains the
SCP belongs to, or the SCP domain the NF (other than SCP) or the SEPP
belongs to..""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/scpDomains> ],
        [ sh:datatype xsd:string ;
            sh:description """Vendor ID of the NF instance, according to the
IANA-assigned SMI Network Management Private Enterprise Codes [77].
allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits 0 to complete
a 6-digit string value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/vendorId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/hniList> ],
        [ sh:datatype xsd:string ;
            sh:description """If the NF needs to be discoverable by other
NFs in a different PLMN, then an FQDN that is used
for inter-PLMN routing is specified.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/interPlmnFqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description "It represents human readable name of the NF Instance" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfInstanceName> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF instance whose
nfStatus is set to REGISTERED is in Canary Release condition,
i.e. it should only be selected by NF Service Consumers under the
conditions indicated by the selectionConditions attribute.
True: the NF is under Canary Release condition, even if the
nfStatus is set to REGISTERED
False: the NF instance indicates its Canary Release condition
via the nfStatus attribute""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/canaryRelease> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF Service
Consumer should only select an NF Service Producer in Canary
Release condition.
True: the consumer shall only select producers in Canary Release
condition
False: the consumer may select producers not in Canary Release
condition""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/exclusiveCanaryReleaseSelection> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates a string uniquely identifying
Shared Profile Data. The format of the sharedProfileDataId shall be
a Universally Unique Identifier (UUID) version 4, as described in
IETF RFC 4122 [44]. The hexadecimal letters should be formatted as
lower-case characters by the sender, and they shall be handled as
case-insensitive by the receiver.
Example: 4ace9d34-2c69-4f99-92d5-a73a3fe8e23b""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/sharedProfileDataId> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the timestamp when the NF Instance is
planned to be shut down. This attribute may be present if the
nfStatus is set to UNDISCOVERABLE due to scheduled shutdown""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/shutdownTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "It represents a list of Resource Content Filter IDs" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/supportedRcfs> ],
        [ sh:datatype xsd:boolean ;
            sh:description """ManagedNFProfile.canaryPrecedenceOverPreferred  This
attribute indicates whether the NRF shall prioritize the NF Service
Producer in Canary Release condition over the preferences
(preferred-xxx, ext-preferred-xxx) present in NF discovery requests.
allowedValues:
True NRF shall prioritize NF Service Producers in Canary Release
condition at NF discovery requests, i.e. NF Service Producers
determined according to preferred-xxx and/or ext-preferred-xxx
shall be prioritized after the NF Service Producers in Canary
Release condition. The associated NF (service) priorities for Service
Producers in Canary Release condition shall not be modified by NRF.
False NRF shall prioritize the NF Service Producers according to
preferred-xxx and/or ext-preferred-xxx (i.e. Canary Release condition
in NF Service Producers shall not be prioritized over NF Service
Consumer preferences at NF discovery requests)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/canaryPrecedenceOverPreferred> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/collocatedNfInstances> ;
            sh:description """It represents information related to collocated NF
type(s) and corresponding NF Instances when the NF is collocated
with NFs supporting other NF types.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/collocatedNfInstances> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnList> ;
            sh:description """PLMN(s) of the Network Function.
This IE shall be present if this information
is available for the NF. If not provided, PLMN ID(s)
of the PLMN of the NRF are assumed for the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssais> ;
            sh:description """S-NSSAIs of the Network Function. If not
provided, the NF can serve any S-NSSAI. When present
this IE represents the list of S-NSSAIs supported in
all the PLMNs listed in the plmnList IE.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/sNssais> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPlmns> ;
            sh:description """PLMNs allowed to access the NF instance.
If not provided, any PLMN is allowed to access the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/allowedPlmns> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Time in seconds expected between 2 consecutive
heart-beat messages from an NF Instance to the NRF.
It may be included in the registration request.
When present in the request it shall contain the
heartbeat time proposed by the NF service consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/heartBeatTimer> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNPNList> ;
            sh:description """SNPN(s) of the Network Function. This attributeIE shall be
present if the NF pertains to one or more SNPNs.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/sNPNList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/perPlmnSnssaiList> ;
            sh:description """It includes the S-NSSAIs supported by the Network Function
for each PLMN supported by the Network Function. When present, it shall
override sNssais IE.If the perPlmnSnssaiList attribute is provided in
at least one NF Service, the S-NSSAIs supported per PLMN in the
NF Profile shall be the set or a superset of the perPlmnSnssaiList
of the NFService(s).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/perPlmnSnssaiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSNPNs> ;
            sh:description """SNPNs allowed to access the NF instance.
The absence of this attribute in the NF profile indicates that no SNPN,
other than the SNPN(s) registered in the snpnList attribute of the
NF Profile, is allowed to access the service instance""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/allowedSNPNs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAIs> ;
            sh:description """S-NSSAI of the allowed slices to access the NF instance.
If not provided, any slice is allowed to access the NF.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/allowedNSSAIs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions> ;
            sh:description """Notification endpoints for different notification types.
This attribute may contain multiple default subscriptions for a same
notification type; in that case, those default subscriptions are used
as alternative notification endpoints.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/defaultNotificationSubscriptions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices> ;
            sh:description """List of NF Service Instances. It shall include
the services produced by the NF that can be
discovered by other NFs.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/nfServices> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supportedVendorSpecificFeatures> ;
            sh:description """It indicates a map of Vendor-Specific features, where the
key of the map is the IANA-assigned SMI Network Management Private
Enterprise Codes and the value of each entry of the map shall be
a list (array) of VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/supportedVendorSpecificFeatures> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/selectionConditions> ;
            sh:description """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/selectionConditions> ],
        [ sh:datatype xsd:string ;
            sh:description """FQDN of the Network Function. For AMF, the
FQDN registered with the NRF shall be that of the AMF Name.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description "Host address of a NF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/hostAddr> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines NF Specific Service authorization
information. It shall include the NF type (s) and NF realms/origins
allowed to consume NF Service(s) of NF Service Producer """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/authzInfo> ],
        [ sh:description """Type of the NFs allowed to access the NF instance.
If not provided, any NF type is allowed to access the NF.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/allowedNfTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262
dialect [75]) representing the NF domain names within the PLMN of
the NRF allowed to access the NF instance If not provided,
any NF domain is allowed to access the NF.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList/allowedNfDomains> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nFProfileList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv4AddressRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv4AddressRanges/start> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv4AddressRanges/end> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv6PrefixRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv6PrefixRanges/start> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv6PrefixRanges/end> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/natedIpv6PrefixRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServicesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique ID of the service instance within a given NF Instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/serviceInstanceID> ],
        [ sh:description "Name of the service instance (e.g. 'nudm-sdm')." ;
            sh:in ( "NNRF_NFM" "NNRF_DISC" "NUDM_SDM" "NUDM_UECM" "NUDM_UEAU" "NUDM_EE" "NUDM_PP" "NAMF_COMM" "NAMF_EVTS" "NAMF_MT" "NAMF_LOC" "NSMF_PDUSESSION" "NSMF_EVENT-EXPOSURE" "NAUSF_AUTH" "NAUSF_SORPROTECTION" "NNEF_PFDMANAGEMENT" "NPCF_AM-POLICY-CONTROL" "NPCF_SMPOLICYCONTROL" "NPCF_POLICYAUTHORIZATION" "NPCF_BDTPOLICYCONTROL" "NPCF_EVENTEXPOSURE" "NPCF_UE_POLICY_CONTROL" "NSMSF_SMS" "NNSSF_NSSELECTION" "NNSSF_NSSAIAVAILABILITY" "NUDR_DR" "NLMF_LOC" "N5G_EIR_EIC" "NBSF_MANAGEMENT" "NCHF_SPENDINGLIMITCONTROL" "NCHF_CONVERGEDCHARGING" "NNWDAF_EVENTSSUBSCRIPTION" "NNWDAF_ANALYTICSINFO" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/serviceName> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the allowed operations on resources for
a given NF Instance; the key of the map is the NF Instance Id, and
the value is an array of scopes""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/allowedOperationsPerNfInstance> ],
        [ sh:datatype xsd:boolean ;
            sh:description """When it is present and set to true, indicates that
the scopes defined in attribute allowedOperationsPerNfInstance
for a given NF Instance ID take precedence over the scopes defined
in attribute allowedOperationsPerNfType for the corresponding
NF type of the NF Instance associated to such NF Instance ID..""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/allowedOperationsPerNfInstanceOverrides> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the NF Service Instance requires
Oauth2-based authorization""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/oauth2Required> ],
        [ sh:datatype xsd:string ;
            sh:description """String uniquely identifying SharedServiceData. The format
of the sharedServiceDataId shall be a Universally Unique Identifier
(UUID) version 4, as described in IETF RFC 4122 [44]. The hexadecimal
letters should be formatted as lower-case characters by the sender,
and they shall be handled as case-insensitive by the receiver.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/sharedServiceDataId> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Priority (relative to other services of the same type)
in the range of 0-65535, to be used for NF Service selection; lower
values indicate a higher priority.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/priority> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Static capacity information in the range of 0-65535,
expressed as a weight relative to other services of the same type.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/capacity> ],
        [ sh:datatype xsd:string ;
            sh:description "Timestamp when the NF was (re)started." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/recoveryTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Vendor ID of the NF instance" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/vendorId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/versions> ;
            sh:description """API versions supported by the NF Service and if available,
the corresponding retirement date of the NF Service.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/versions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipEndPoints> ;
            sh:description """IP address(es) and port information of the Network Function
(including IPv4 and/or IPv6 address)where the service is listening
for incoming service requests.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/ipEndPoints> ],
        [ sh:description "URI scheme (e.g. 'http', 'https')." ;
            sh:in ( "HTTP" "HTTPS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/scheme> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/defaultNotificationSubscriptions> ;
            sh:description "Notification endpoints for different notification types." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/defaultNotificationSubscriptions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedPLMNs> ;
            sh:description """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/allowedPLMNs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedSnpns> ;
            sh:description """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/allowedSnpns> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/allowedNSSAI> ;
            sh:description """S-NSSAI of the allowed slices to access the service
instance. The absence of this attribute indicates that any slice
is allowed to access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/allowedNSSAI> ],
        [ sh:description "Status of the NF Service Instance." ;
            sh:in ( "REGISTERED" "SUSPENDED" "UNDISCOVERABLE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/nfServiceStatus> ],
        [ sh:datatype xsd:string ;
            sh:description "FQDN of the NF Service Instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """If the NF service needs to be discoverable by other NFs in a
different PLMN, then an FQDN that is used for inter PLMN routing.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/interPlmnFqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """Optional path segment(s) used to construct the {apiRoot}
variable of the different API URIs.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/apiPrefix> ],
        [ sh:description "SNPNs allowed to access the NF instance" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/allowedNfTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the NF domain names allowed to
access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/allowedNfDomains> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the allowed operations on resources for
each type of NF; the key of the map is the NF Type, and the value
is an array of scopes""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices/allowedOperationsPerNfType> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfServices> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfoShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdrInfo> ;
            sh:description """This attribute contains all the udrInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedUdrInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo> ;
            sh:description """This attribute contains all the udmInfo
attributes
locally configured in the NRF or the NRF
received during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedUdmInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
            sh:description """This attribute contains all the pcscfInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId to which
the map entry belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedPcscfInfoList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedGmlcInfo> ;
            sh:description """This attribute contains all the gmlcInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId of which
the nefInfo belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedGmlcInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo> ;
            sh:description """This attribute contains all the lmfInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId of which
the lmfInfo belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedLmfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNfInfo> ;
            sh:description """This attribute contains information of other NFs
without corresponding NF type specific Info extensions locally
configured in the NRF or the NRF received during NF registration.
The key of the map is the nfInstanceId of the NF. The map entry
is the NfInfo as defined in clause 5.3.229 representing the
information of a generic NF instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedNfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList> ;
            sh:description """This attribute contains list of HssInfo attribute
locally configured in the NRF or that the NRF received during NF
registration. The key of the map is the nfInstanceId to which the
map entry belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedHssInfoList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/served5gDdnmfInfo> ;
            sh:description """This attribute contains all the 5gDdnmfInfo
attribute locally configured in the NRF or that the NRF
received during NF registration. The key of the map is
the nfInstanceId to which the map entry belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/served5gDdnmfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAusfInfo> ;
            sh:description """This attribute contains all the
ausfInfo attributes
locally configured in the NRF or the NRF
received during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedAusfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo> ;
            sh:description """This attribute contains all the amfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedAmfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo> ;
            sh:description """This attribute contains all the smfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedSmfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo> ;
            sh:description """This attribute contains all the upfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedUpfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcfInfo> ;
            sh:description """This attribute contains all the pcfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedPcfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
            sh:description """This attribute contains all the bsfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedBsfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
            sh:description """This attribute contains all the bsfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedChfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo> ;
            sh:description """This attribute contains all the nwdafInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId of which
the nwdafInfo belongs to.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo/servedNwdafInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nrfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nwdafCapabilityShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the NWDAF supports analytics
aggregation""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nwdafCapability/analyticsAggregation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicate whether the NWDAF supports analytics metadata
provisioning:""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nwdafCapability/analyticsMetadataProvisioning> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the NWDAF
supports roaming exchange capability""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nwdafCapability/roamingExchange> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nwdafCapability> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/operations> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/perPlmnSnssaiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid
identifies an SNPN """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/perPlmnSnssaiList/nid> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnId> ;
            sh:description """PLMN ID for which list of supported S-NSSAI(s)
is provided.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/perPlmnSnssaiList/plmnId> ],
