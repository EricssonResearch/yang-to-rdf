        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssai> ;
            sh:description "Supported S-NSSAI." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssaiUpfInfoList/sNssai> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnUpfInfoList> ;
            sh:description """It represents list of parameters supported by the UPF
per DNN.""" ;
