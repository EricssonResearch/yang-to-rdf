            sh:description """The specific list of S-NSSAIs supported
by the given PLMN.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/perPlmnSnssaiList/sNssaiList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/perPlmnSnssaiList> .

