            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/dynamic5QIs/maximumDataBurstVolume> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/packetErrorRate> ;
