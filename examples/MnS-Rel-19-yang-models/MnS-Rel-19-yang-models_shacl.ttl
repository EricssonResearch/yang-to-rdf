<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vendorSpecificFeatureShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It is a string representing a proprietary feature
specific to a given vendor.
It is recommended that the case convention for these strings is the
same as for enumerated data types (i.e. UPPER_WITH_UNDERSCORE;
see 3GPP TS 29.501, clause 5.1.1).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vendorSpecificFeature/featureName> ],
        [ sh:datatype xsd:string ;
            sh:description "It is a string representing the version of the feature." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vendorSpecificFeature/featureVersion> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vendorSpecificFeature> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/versionsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/versions/apiVersionInUri> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/versions/apiFullVersion> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/versions/expiry> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/versions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/DNFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/DNFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/DNFunction/userLabel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/DNFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/DNFunction/supportedTraceMetrics> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/DNFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/DNFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/DNFunction/SupportedPerfMetricGroups> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/DNFunction> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/File> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/Files> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/operations> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/taiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dnfunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/Dynamic5QISetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/Dynamic5QISet/id> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/dynamic5QIs> ;
            sh:description """This IOC specifies the dynamically assigned 5QIs
including their QoS characteristics, see 3GPP TS 23.501.
The instance of this IOC shall not be created or modified by the
MnS consumer except for the instance associated to
PCFFunction MOI or SMFFunction MOI when the PCF is not deployed.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/Dynamic5QISet/dynamic5QIs> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/Dynamic5QISet> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristicsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristics/id> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Identifies the 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristics/fiveQIValue> ],
        [ sh:description """It indicates the Resource Type of a 5QI, as specified
in TS 23.501 """ ;
            sh:in ( "GBR" "NON_GBR" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristics/resourceType> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It indicates the Priority Level of a 5QI, as specified
in TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristics/priorityLevel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Indicates the Packet Delay Budget (in unit of 0.5ms)of a 5QI,
as specified in TS 23.501 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristics/packetDelayBudget> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristics/averagingWindow> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristics/maximumDataBurstVolume> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/packetErrorRate> ;
            sh:description """It indicates the Packet Error Rate of a 5QI,
as specified in TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristics/packetErrorRate> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/FiveQICharacteristics> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-dynamic5qiset/dynamic5QIsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
