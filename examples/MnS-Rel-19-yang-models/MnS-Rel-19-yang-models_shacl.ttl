    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/plmnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
