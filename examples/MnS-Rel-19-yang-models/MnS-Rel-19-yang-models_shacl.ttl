            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/peeParameterslist> .

