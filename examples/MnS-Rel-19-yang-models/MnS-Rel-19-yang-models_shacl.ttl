    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/plmnList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/qceIdMappingInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the address to which the QMC reports shall be
transferred.  Ipv4 or Ipv6 address may be used.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/qceIdMappingInfoList/qoECollectionEntityAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Specifies the unique identity to which the QMC reports
shall be transferred.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/qceIdMappingInfoList/qoECollectionEntityIdentity> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/pLMNTarget> ;
            sh:description """The PLMN identifier where QoE collection entity
resides. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/qceIdMappingInfoList/pLMNTarget> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/qceIdMappingInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
