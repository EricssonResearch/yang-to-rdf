    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNPNListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Mobile Country Code (MCC) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNPNList/mcc> ],
        [ sh:datatype xsd:string ;
            sh:description "Mobile Network Code (MNC) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNPNList/mnc> ],
        [ sh:datatype xsd:string ;
            sh:description "Network Identifier (NID) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNPNList/nId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNPNList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAI/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
