        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
