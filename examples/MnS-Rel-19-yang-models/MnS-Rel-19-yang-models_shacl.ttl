    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnList/mcc> ;
