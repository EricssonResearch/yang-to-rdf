<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/selectionConditionsShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem> ;
