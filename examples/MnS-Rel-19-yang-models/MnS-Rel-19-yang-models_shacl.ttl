<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/served5gDdnmfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/served5gDdnmfInfo/nfInstanceId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnId> ;
