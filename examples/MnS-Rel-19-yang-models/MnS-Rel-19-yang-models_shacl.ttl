    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/packetErrorRateShape> a sh:NodeShape ;
