    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/plmnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sAPShape> a sh:NodeShape ;
