            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/plmnList/mcc> ;
