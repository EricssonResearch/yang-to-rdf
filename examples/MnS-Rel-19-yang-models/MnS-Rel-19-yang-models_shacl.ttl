<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/nfInstanceId> ],
        [ sh:datatype xsd:long ;
            sh:description """It represents the AMF Region ID, which identifies the
region. AllowedValues: defined in subclause 2.10.1 of 3GPP TS 23.003 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/amfRegionId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/n2InterfaceAmfInfo> ;
            sh:description """This attribute represents the N2 interface information of
the AMF. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/n2InterfaceAmfInfo> ],
        [ sh:datatype xsd:long ;
            sh:description """It represents the AMF Set ID, which is uniquely identifies
the AMF Set within the AMF Region.
allowedValues: defined in subclause 2.10.1 of 3GPP TS 23.003""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/amfSetId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates the AMF supports SNPN Onboarding
capability. This is used for the case of Onboarding of UEs for SNPNs
(see TS 23.501, clause 5.30.2.10).
- FALSE: AMF does not support SNPN Onboarding;
- TRUE: AMF supports SNPN Onboarding.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/amfOnboardingCapability> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether the AMF supports High
Latency communication (e.g. for NR RedCap UE). This is used for CP NF
to discover AMF supporting High Latency communication (see TS 23.501,
clause 6.3.5).
- FALSE: AMF does not support High Latency communication e.g. for
NR RedCap UE;
- TRUE: AMF supports High Latency communication e.g. for NR RedCap UE;""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/highLatencyCom> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiList> ;
            sh:description "The list of TAIs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeList> ;
            sh:description "The range of TAIs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/taiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gUAMIdList> ;
            sh:description "List of supported Globally Unique AMF Ids (GUAMIs)." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/gUAMIdList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfFailure> ;
            sh:description """List of GUAMIs for which the AMF acts as a backup for AMF
failure.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/backupInfoAmfFailure> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/backupInfoAmfRemoval> ;
            sh:description """List of GUAMIs for which the AMF acts as a backup for
planned AMF removal.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo/backupInfoAmfRemoval> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAusfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAusfInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines identity of the group that is
served by the NF instance (See TS 29.510).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAusfInfo/nFSrvGroupId> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a list of Routing Indicator
information that allows to route network signalling with SUCI
(see TS 23.003 [13]) to the AUSF instance.
If not provided, the AUSF can serve any Routing Indicator.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAusfInfo/routingIndicators> ;
            sh:pattern "[0-9]{1,4}" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRanges> ;
            sh:description """It represents list of ranges of SUPIs that can be served
by the PCF instance.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAusfInfo/supiRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/suciInfos> ;
            sh:description """This attribute represents a list of SuciInfo. A SUCI
that matches this information can be served by the AUSF.
A SUCI that matches all attributes of at least one entry in this
array shall be considered as a match of this information.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAusfInfo/suciInfos> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedAusfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """List of DNNs handled by the BSF
If not provided, the BSF can serve any DNN.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/dnnList> ],
        [ sh:datatype xsd:string ;
            sh:description """List of IPv4 address domains, as described in
subclause 6.2 of 3GPP TS 29.513, handled by the BSF.
If not provided, the BSF can serve any IP domain.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/ipDomainList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv4AddressRanges> ;
            sh:description """List of ranges of IPv4 addresses handled by BSF.
If not provided, the BSF can serve any IPv4 address.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/ipv4AddressRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges> ;
            sh:description """List of ranges of IPv6 prefixes handled by the BSF.
If not provided, the BSF can serve any IPv6 prefix.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/ipv6PrefixRanges> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents the NF Instance Id of the
primary CHF instance. This attribute shall be absent if the
secondaryChfInstance is present.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/primaryChfInstance> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents the NF Instance Id of the
secondary CHF instance.This attribute shall be absent if the
primaryChfInstance is present.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/secondaryChfInstance> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRangeList> ;
            sh:description """List of ranges of SUPIs that can be served by
the CHF instance. If not provided, the CHF can serve any SUPI.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/supiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeList> ;
            sh:description """List of ranges of GPSI that can be served
by the CHF instance. If not provided, the CHF can serve any GPSI.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/gpsiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnRangeList> ;
            sh:description """List of ranges of PLMNs (including the PLMN
IDs of the CHF instance) that can be served by the CHF instance.
If not provided, the CHF can serve any PLMN.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/plmnRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedGmlcInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedGmlcInfo/nfInstanceId> ],
        [ sh:description """Identity of the GMLC group that is served by
the GMLC instance.""" ;
            sh:in ( "EMERGENCY_SERVICES" "VALUE_ADDED_SERVICES" "PLMN_OPERATOR_SERVICES" "LAWFUL_INTERCEPT_SERVICES" "EXTERNAL_CLIENT_FOR_LAWFUL_INTERCEPT_SERVICES" "PLMN_OPERATOR_OM" "PLMN_OPERATOR_ANONYMOUS_STATISTICS" "PLMN_OPERATOR_TARGET_MS_SERVICE_SUPPORT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedGmlcInfo/servingClientTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents each item of the array
shall carry an OctetString indicating the ISDN number of the GMLC in
international number format as described in ITU-T Rec. E.164 [94] and
shall be encoded as a TBCD-string.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedGmlcInfo/gmlcNumbers> ;
            sh:pattern "^[0-9]{5,15}$" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedGmlcInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute defines the identity of the HSS group
that is served by the HSS instance.If not provided, the HSS instance
does not pertain to any HSS group.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList/groupID> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges> ;
            sh:description """This attribute defines the list of ranges of IMSIs whose
profile data is available in the HSS instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList/imsiRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPrivateIdentityRanges> ;
            sh:description """This attribute defines the list of ranges of IMS Private
Identities whose profile data is available in the HSS instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList/imsPrivateIdentityRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPublicIdentityRanges> ;
            sh:description """This attribute defines the list of ranges of MSISDNs whose
profile data is available in the HSS instance. """ ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList/imsPublicIdentityRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges> ;
            sh:description """This attribute defines the list of ranges of IMS Public
Identities whose profile data is available in the HSS instance """ ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList/msisdnRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges> ;
            sh:description """This attribute defines the list of ranges of external
group IDs that can be served by this HSS instance.If not provided,
the HSS instance does not serve any external groups. """ ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList/externalGroupIdentifiersRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress> ;
            sh:description "This attribute defines the Diameter Address of the HSS " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList/hssDiameterAddress> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses> ;
            sh:description """This attribute defines the Additional Diameter Addresses
of the HSS;may be present if hssDiameterAddress is present """ ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList/additionalDiamAddresses> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedHssInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo/nfInstanceId> ],
        [ sh:description """This attribute represents a list of external client type(s),
e.g. emergency client. The NRF should only include this LMF instance
to NF discovery with 'client-type' query parameter indicating one of
the external client types in the list.

Absence of this attribute means the LMF is not dedicated to serve
specific client types.""" ;
            sh:in ( "EMERGENCY_SERVICES" "VALUE_ADDED_SERVICES" "PLMN_OPERATOR_SERVICES" "LAWFUL_INTERCEPT_SERVICES" "PLMN_OPERATOR_BROADCAST_SERVICES" "PLMN_OPERATOR_OM" "PLMN_OPERATOR_ANONYMOUS_STATISTICS" "PLMN_OPERATOR_TARGET_MS_SERVICE_SUPPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo/servingClientTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents the LMF identification.
See clause 6.1.6.3.6 TS 29.572""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo/lmfId> ],
        [ sh:description """This attribute contains the access type (3GPP_ACCESS and/or
NON_3GPP_ACCESS) supported by the SMF.
If not included, it shall be assumed the both access types are
supported.""" ;
            sh:in ( "3GPP_ACCESS" "NON_3GPP_ACCESS" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo/servingAccessTypes> ],
        [ sh:description """This attribute contains the AN node type (i.e. gNB or NG-eNB)
supported by the LMF.
If not included, it shall be assumed that all AN node types are
supported.""" ;
            sh:in ( "GNB" "NG" "ENB" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo/servingAnNodeTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute contains the RAT type (e.g. 5G NR, eLTE or
any of the RAT Types specified for NR satellite access) supported by
the LMF.
If not included, it shall be assumed that all RAT types are supported
allowedValues: see clause 5.4.3.2 of TS 29.571""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo/servingRatTypes> ],
        [ sh:description """This attribute contains the GAD shapes supported by the LMF.
If not included, it doesn't indicate that the LMF doesn't support any
GAD shapes.
The allowedValues are: see clause 6.1.6.3.4 of TS 29.572 """ ;
            sh:in ( "POINT" "POINT_UNCERTAINTY_CIRCLE" "POINT_UNCERTAINTY_ELLIPSE" "POLYGON" "POINT_ALTITUDE" "POINT_ALTITUDE_UNCERTAINTY" "ELLIPSOID_ARC" "LOCAL_2D_POINT_UNCERTAINTY_ELLIPSE" "LOCAL_3D_POINT_UNCERTAINTY_ELLIPSOID" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo/supportedGADShapes> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiList> ;
            sh:description """This attribute contains TAI list that the LMF can serve.
It may contain one or more non-3GPP access TAIs.
The absence of both this attribute and the taiRangeList attribute
indicates that the LMF can be selected for any TAI in the serving
network.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeList> ;
            sh:description """This attribute contains TAI range list that the LMF can
serve. It may contain one or more non-3GPP access TAI ranges.
The absence of both this attribute and the taiList attribute indicates
that the LMF can be selected for any TAI in the serving network.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo/taiRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedLmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNfInfo/nfInstanceId> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description "This parameter defines type of Network Function" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNfInfo/nfType> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents the Analytic functionalities
(identified by nwdafEvent defined in TS 29.520) of the NWDAF instance.
MnS consumer can configure this attribute to specify which Analytic
functionalities (identified by nwdafEvent) can be performed the NWDAF
instance. If the value of this attribute is not present, the NWDAF
instance can perform any NWDAFEvents.
The detailed ENUM value for NwdafEvent see the Table 5.1.6.3.4-1
in TS 29.520""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/nwdafEvents> ],
        [ sh:datatype xsd:string ;
            sh:description """It represents the EventId(s) supported by the
Nnwdaf_AnalyticsInfo service, if none are provided the NWDAF can serve
any eventId. (see clause TS 29.520)""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/eventIds> ],
        [ sh:datatype xsd:int ;
            sh:description """It represents the supported Analytics Delay related to the
eventIds and nwdafEvents.
It is an unsigned integer identifying a period of time in units of
seconds.(see clause 5.2.2 TS 29.571).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/analyticsDelay> ],
        [ sh:description """It contains the list of NF type(s) from which the NWDAF NF
can collect data. The absence of this attribute indicates that the
NWDAF can collect data from any NF type.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/servingNfTypeList> ],
        [ sh:datatype xsd:string ;
            sh:description """It contains the list of NF type(s) from which the NWDAF NF
can collect data. The absence of this attribute indicates that the
NWDAF can collect data from any NF type. (see clause 5.4.2 NfSetId
in TS 29.571)""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/servingNfSetIdList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiList> ;
            sh:description "The list of TAIs. " ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeList> ;
            sh:description "The range of TAIs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/taiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nwdafCapability> ;
            sh:description """This attribute indicates the capability of the NWDAF.
If not present, the NWDAF shall be regarded with no capability.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/nwdafCapability> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/mlAnalyticsList> ;
            sh:description """It represents ML Analytics Filter information supported by
the Nnwdaf_MLModelProvision service.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo/mlAnalyticsList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedNwdafInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcfInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """DNNs supported by the PCF.
If not provided, the PCF can serve any DNN.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcfInfo/dnnList> ],
        [ sh:datatype xsd:string ;
            sh:description """This IE shall be present if the PCF supports Rx interface.
When present, this IE shall indicate the Diameter host
of the Rx interface for the PCF.
Pattern: '^([A-Za-z0-9]+(-[A-Za-z0-9]+).)+[a-z]{2,}$'.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcfInfo/rxDiamHost> ],
        [ sh:datatype xsd:string ;
            sh:description """This IE shall be present if the PCF supports Rx interface.
When present, this IE shall indicate the Diameter realm
of the Rx interface for the PCF.
Pattern: '^([A-Za-z0-9]+(-[A-Za-z0-9]+).)+[a-z]{2,}$'.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcfInfo/rxDiamRealm> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRanges> ;
            sh:description """List of ranges of SUPIs that can be served by
the PCF instance. If not provided, the PCF can serve any SUPI.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcfInfo/supiRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/proseCapability> ;
            sh:description "It indicates the supported ProSe Capability by the PCF." ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcfInfo/proseCapability> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/nfInstanceId> ],
        [ sh:description """It provides the condition of access type of the UE when
the session AMBR shall be enforced, see TS 29.512 [60].If this
attribute is included in SmfInfo, it shall contain the access type
(3GPP_ACCESS and/or NON_3GPP_ACCESS) supported by the SMF.If not
included, it shall be assumed the both access types are supported.""" ;
            sh:in ( "3GPP_ACCESS" "NON_3GPP_ACCESS" ) ;
            sh:maxCount 2 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/accessType> ],
        [ sh:datatype xsd:string ;
            sh:description """It represents the DNNs supported by the PCF. The DNN,
as defined in clause 9A of TS 23.003 [13], shall contain the Network
Identifier and it may additionally contain an Operator Identifier,
as specified in TS 23.003 [13] clause 9.1.1 and 9.1.2. If the Operator
Identifier is not included, the DNN is supported for all the PLMNs in
the plmnList of the NF Profile.If not provided, the PCF can serve any
DNN.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/dnnList> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents FQDN of the P-CSCF for the Gm
interface.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/gmFqdn> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents list of IPv4 addresses of of
the P-CSCF for the Gm interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/gmIpv4Addresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents list of IPv6 addresses of of the
P-CSCF for the Gm interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/gmIpv6Addresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents FQDN of the P-CSCF for the Mw
interface.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/mwFqdn> ],
        [ sh:datatype xsd:string ;
            sh:description """List of ranges of PLMNs (including the PLMN
IDs of the CHF instance) that can be served by the CHF instance.
If not provided, the CHF can serve any PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/mwIpv4Addresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents list of IPv4 addresses of
the P-CSCF for the Mw interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/mwIpv6Addresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges> ;
            sh:description """List of ranges of PLMNs (including the PLMN
IDs of the CHF instance) that can be served by the CHF instance.
If not provided, the CHF can serve any PLMN.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/servedIpv4AddressRanges> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description "The FQDN of the PGW if the SMF is a combined SMF/PGW-C." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/pgwFqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiList> ;
            sh:description """The list of TAIs the SMF can serve.
It may contain the non-3GPP access TAI.
The absence of this attribute and the taiRangeList
attribute indicate that
the SMF can be selected for any TAI
in the serving network.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeList> ;
            sh:description """The range of TAIs the SMF can serve.
The absence of this attribute and the taiList
attribute indicate that the SMF can be selected
for any TAI in the serving network.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/taiRangeList> ],
        [ sh:description """If included, this IE shall contain the access type
(3GPP_ACCESS and/or NON_3GPP_ACCESS) supported by the SMF.
If not included, it shall be assumed the both
 access types are supported.""" ;
            sh:in ( "3GPP_ACCESS" "NON_3GPP_ACCESS" ) ;
            sh:maxCount 2 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/accessType> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """This parameter defines Priority (relative to other
NFs of the same type) in the range of 0-65535, to be used for
NF selection; lower values indicate a higher priority. If
priority is also present in the nfServiceList parameters,
those will have precedence over this value """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/priority> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Used by an SMF to explicitly indicate the support of
V-SMF capability and its preference to be selected as V-SMF.
When present it indicate whether the V-SMF capability is supported
by the SMF:
- true: V-SMF capability supported by the SMF
- false: V-SMF capability not supported by the SMF.
When absent the V-SMF capability support of the SMF is not specified.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/vsmfSupportInd> ],
        [ sh:datatype xsd:string ;
            sh:description """When present, this attribute provides additional FQDNs
to the FQDN indicated in the pgwFqdn attribute.
The pgwFqdnList attribute may be present if the pgwFqdn attribute
is present.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/pgwFqdnList> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute may be used by an SMF to explicitly
indicate the support of I-SMF capability and its preference to be
selected as I-SMF. When present, this attribute shall indicate
whether the I-SMF capability are supported by the SMF:
- TRUE: I-SMF capability supported by the SMF
- FALSE: I-SMF capability not supported by the SMF. Absence of this
attribute indicates the I-SMF capability support of the SMF is not
specified.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/ismfSupportInd> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates the SMF supports SNPN
Onboarding capability and User Plane Remote Provisioning. This
is used for the case of Onboarding of UEs for SNPNs
(see TS 23.501 [2], clauses 5.30.2.10 and 6.2.6.2).
-  FALSE: SMF does not support SNPN Onboarding;
-  TRUE: SMF supports SNPN Onboarding.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/smfOnboardingCapability> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute IE indicates the SMF supports User
Plane Remote Provisioning (UPRP) capability. This is used for
the case of Onboarding of UEs for SNPNs ,
clauses 5.30.2.10 and 6.2.6.2).
-  FALSE: SMF does not support UPRP;
-   TRUE: SMF supports UPRP.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/smfUPRPCapability> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssaiSmfInfoList> ;
            sh:description "List of parameters supported by the SMF per S-NSSAI." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo/sNssaiSmfInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedSmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identity of the UDM group that is served by the
UDM instance. If not provided, the UDM instance does
not pertain to any UDM group.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo/groupId> ],
        [ sh:datatype xsd:string ;
            sh:description """List of Routing Indicator information that allows
to route network signalling with SUCI
to the UDM instance. If not provided,
the UDM can serve any Routing Indicator.
Pattern: '^[0-9]{1,4}$'.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo/routingIndicators> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRanges> ;
            sh:description """List of ranges of SUPI's whose profile data is
available in the UDM instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo/supiRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRanges> ;
            sh:description """List of ranges of GPSIs whose profile data is
available in the UDM instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo/gpsiRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges> ;
            sh:description """List of ranges of external groups whose profile
data is available in the UDM instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo/externalGroupIdentifiersRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/internalGroupIdentifiersRanges> ;
            sh:description """It represents list of ranges of Internal Group
Identifiers whose profile data is available in the UDM instance.
If not provided, it does not imply that the UDM supports all
internal groups.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo/internalGroupIdentifiersRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/suciInfos> ;
            sh:description """It represents list of SuciInfo. A SUCI that matches
this information can be served by the UDM .A SUCI that matches
all attributes of at least one entry in this array shall be
considered as a match of this information""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo/suciInfos> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdmInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdrInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdrInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identity of the UDR group that is served
by the UDR instance.
If not provided, the UDR instance does not pertain
to any UDR group.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdrInfo/groupId> ],
        [ sh:description """List of supported data sets in the UDR instance.
If not provided, the UDR supports all data sets.""" ;
            sh:in ( "SUBSCRIPTION" "POLICY" "EXPOSURE" "APPLICATION" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdrInfo/supportedDataSets> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRanges> ;
            sh:description """List of ranges of SUPI's whose profile data
is available in the UDR instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdrInfo/supiRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRanges> ;
            sh:description """List of ranges of GPSIs whose profile data is
available in the UDR instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdrInfo/gpsiRanges> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges> ;
            sh:description """List of ranges of external groups whose profile
data is available in the UDR instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdrInfo/externalGroupIdentifiersRanges> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUdrInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/nfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """The SMF service area(s) the UPF can serve. See TS 29.510.
If not provided, the UPF can serve any SMF service area.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/smfServingArea> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether the UPF is configured to
support Sxa interface.
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/sxaInd> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssaiUpfInfoList> ;
            sh:description """This attribute represents a list of parameters supported by
the UPF per S-NSSAI.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/sNssaiUpfInfoList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/interfaceUpfInfoList> ;
            sh:description """List of User Plane interfaces configured on the UPF. When
this parameter is provided in the NF Discovery response, the NF Service
Consumer (e.g., SMF) may use this information for UPF selection.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/interfaceUpfInfoList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/atsssCapability> ;
            sh:description "Indicate the ATSSS capability of the UPF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/atsssCapability> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiList> ;
            sh:description "The list of TAIs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeList> ;
            sh:description "The range of TAIs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/taiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/wAgfInfo> ;
            sh:description """Indicate that the UPF is collocated with W-AGF. If not
present, the UPF is not collocated with Wireline Access Gateway
Function (W-AGF).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/wAgfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tngfInfo> ;
            sh:description """Indicate that the UPF is collocated with TNGF. If not
present, the UPF is not collocated with Trusted Non-3GPP Gateway
Function (TNGF).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/tngfInfo> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/twifInfo> ;
            sh:description """Indicate that the UPF is collocated with TWIF. If not
present, the UPF is not collocated with Trusted WLAN Interworking
Function (TWIF).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/twifInfo> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether interworking with EPS is supported by
the UPF.
True: Supported
False: Not Supported""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/iwkEpsInd> ],
        [ sh:description "Indicates the type(s) of a PDU session." ;
            sh:in ( "IPV4" "IPV6" "IPV4V6" "UNSTRUCTURED" "ETHERNET" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/pduSessionTypes> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF supports allocating UE IP
addresses/prefixes.
true: supported
false: not supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/ueIpAddrInd> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """This parameter defines Priority (relative to other NFs of
the same type) in the range of 0-65535, to be used for NF selection;
lower values indicate a higher priority. If priority is also present
in the nfServiceList parameters, those will have precedence over
this value (See TS 29.510).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/priority> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF supports redundant GTP-U path.
true: supported
false: not supported""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/redundantGtpu> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF is configured for Inter-PLMN User
Plane Security (IPUPS). Any UPF can support the IPUPS functionality.
In network deployments where specific UPFs are used to provide IPUPS,
UPFs configured for providing IPUPS services shall be selected.
true: The UPF is configured for IPUPS.
false: The UPF is not configured for IPUPS""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/ipups> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF is configured for data forwarding.
Based on operator policies, if dedicated UPFs are preferred to be used
for indirect data forwarding during handover scenarios, when setting
up the indirect data forwarding tunnel, the SMF should preferably
select a UPF configured for data forwarding and use the network
instance indicated in the Network Instance ID associated to the
DATA_FORWARDING interface type in the interfaceUpfInfoList attribute.
true: the UPF is configured for data forwarding
false: the UPF is not configured for data forwarding

If the UPF is configured for data forwarding, it shall support UP
network interface with type 'DATA_FORWARDING'.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/dataForwarding> ],
        [ sh:datatype xsd:string ;
            sh:description """Supported Packet Forwarding Control Protocol (PFCP) Features.
A string used to indicate the PFCP features supported by the UPF,
which encodes the 'UP Function Features' as specified in
Table 8.2.25-1 of TS 29.244 (starting from Octet 5), in hexadecimal
representation.

Each character in the string shall take a value of '0' to '9', 'a'
to 'f' or 'A' to 'F' and each two characters shall represent one octet
of 'UP Function Features' (starting from Octet 5, to higher octets).
For each two characters representing one octet, the first character
representing the 4 most significant bits of the octet and the second
character the 4 least significant bits of the octet.

The supported PFCP features shall be provisioned in addition and be
consistent with the existing UPF features (atsssCapability, ueIpAddrInd,
redundantGtpu and ipups), e.g., if the ueIpAddrInd is set to 'true',
then the UEIP flag shall also be set to '1' in the supported PFCP
features.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo/supportedPfcpFeatures> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedUpfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/suciInfosShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It indicates served Routing Indicator (see TS 23.003,
clause 2.2B). If not provided, the AUSF/UDM
can serve any Routing Indicator.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/suciInfos/routingInds> ],
        [ sh:datatype xsd:long ;
            sh:description """It indicating served Home Network Public Key
(see TS 23.003, clause 2.2B). If not provided, the AUSF/UDM
can serve any public key.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/suciInfos/hNwPubKeyIds> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/suciInfos> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start ofa SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g., IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g. IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRangeList/end> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the set of SUPI's belonging to
this range.A SUPI value is considered part of the range if and
only if the SUPI string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRangesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start ofa SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g., IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRanges/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g. IMSI ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRanges/end> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the set of SUPI's belonging to
this range.A SUPI value is considered part of the range if and
only if the SUPI string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRanges/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supiRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supportedVendorSpecificFeaturesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "IANA-assigned SMI Network Management Private Enterprise Code" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supportedVendorSpecificFeatures/enterpriseCode> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vendorSpecificFeature> ;
            sh:description """VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supportedVendorSpecificFeatures/vendorSpecificFeature> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/supportedVendorSpecificFeatures> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tacRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of a TAC range,
to be used when the range of TAC's can be represented
as a hexadecimal range (e.g., TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tacRangeList/start> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6}$)" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a TAC range,
to be used when the range of TAC's can be represented as
a hexadecimal range (e.g. TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tacRangeList/end> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6})$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262)
representing the set of TAC's belonging to this range.
A TAC value is considered part of the range if and only if the
TAC string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tacRangeList/nRTACpattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tacRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnId> ;
            sh:description "PLMN ID related to the TacRange." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeList/plmnId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tacRangeList> ;
            sh:description "The range of the TACs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeList/tacRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/taiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tngfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tngfInfo/ipv4EndpointAddresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tngfInfo/ipv6EndpointAddresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tngfInfo/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/tngfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trackingAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trackingAreaList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trackingAreaList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trackingAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/twifInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/twifInfo/ipv4EndpointAddresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/twifInfo/ipv6EndpointAddresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/twifInfo/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/twifInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vendorSpecificFeatureShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It is a string representing a proprietary feature
specific to a given vendor.
It is recommended that the case convention for these strings is the
same as for enumerated data types (i.e. UPPER_WITH_UNDERSCORE;
see 3GPP TS 29.501, clause 5.1.1).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vendorSpecificFeature/featureName> ],
        [ sh:datatype xsd:string ;
            sh:description "It is a string representing the version of the feature." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vendorSpecificFeature/featureVersion> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vendorSpecificFeature> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/versionsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/versions/apiVersionInUri> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/versions/apiFullVersion> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/versions/expiry> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/versions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/wAgfInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/wAgfInfo/ipv4EndpointAddresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/wAgfInfo/ipv6EndpointAddresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/wAgfInfo/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/wAgfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/userLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sNSSAIList> ;
            sh:description """List of S-NSSAIs the managed object is capable of supporting.
(Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/sNSSAIList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile> ;
            sh:description "Profile definition of a Managed NF (See TS 23.501)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/managedNFProfile> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """The FQDN of the registered NF instance in the service-based
interface.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/sBIFQDN> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """NSI ID. NSI ID is an identifier for identifying the Core
Network part of a Network Slice instance when multiple Network Slice
instances of the same Network Slice are deployed, and there is a need
to differentiate between them in the 5GC, see clause 3.1 of TS 23.501
and subclause 6.1.6.2.7 of 3GPP TS 29.531""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/cNSIIdList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/SupportedPerfMetricGroups> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdList> ;
            sh:description """List of at most six entries of PLMN Identifiers, but at least
one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a
Mobile Network Code (MNC).""" ;
            sh:maxCount 6 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/pLMNIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAIShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAI/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAI/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAI> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAIsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAIs/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAIs/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAIs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPLMNsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPLMNs/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPLMNs/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPLMNs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPlmnsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPlmns/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPlmns/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPlmns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSNPNsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This is the Mobile Country Code (MCC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSNPNs/mCC> ],
        [ sh:datatype xsd:string ;
            sh:description """This is the Mobile Network Code (MNC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSNPNs/mNC> ],
        [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid
identifies an SNPN""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSNPNs/nId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSNPNs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSnpnsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSnpns/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSnpns/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSnpns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/collocatedNfInstancesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/collocatedNfInstances/nfInstanceId> ],
        [ sh:description "Type of Network Function." ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/collocatedNfInstances/nfType> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/collocatedNfInstances> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItemShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/id> ],
        [ sh:description """It represents the NF types of the consumers for
which the conditions included in this ConditionItem apply.
If this attribute is absent, the conditions are applicable
to all NF consumer types.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/consumerNfTypes> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/taiRangeList> ;
            sh:description """It represents a set of TAIs where the
NF(Service) instance under CANARY_RELEASE status shall
be selected for a certain UE""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/taiRangeList> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It represents a feature number of that NF Service
Instance,under CANARY_RELEASE status. This attribute only
applies when the          selectionConditions, where this
ConditionItem is included, is included in a NF Service Instance
This condition is evaluated to <true> when the service requests
froma consumer of this NF Service Instance require the support
of the indicated feature on the NF Service Instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/serviceFeature> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It represents a Vendor-Specific feature
number of thatNF Service Instance, under CANARY_RELEASE
status. This attribute only applies when the
selectionConditions, where this ConditionItem is included,
is included in a NF Service Instance.This condition is
evaluated to true when the service requests from a
consumer of this NF Service Instance require the support
of the indicated Vendor-Specific feature on the NF
Service Instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/vsServiceFeature> ],
        [ sh:datatype xsd:string ;
            sh:description """It represents a set of PEIs of the UEs for
which the NF(Service) instance under CANARY_RELEASE status
shall be selected""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/peiList> ],
        [ sh:datatype xsd:string ;
            sh:description """ It represents a set of TAIs where the NF
(Service) instance under CANARY_RELEASE status shall be
selected for a certain UE""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/dnnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/supiRangeList> ;
            sh:description """It represents a set of SUPIs for which
the NF (Service) instance under CANARY_RELEASE status shall
be selected.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/supiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/gpsiRangeList> ;
            sh:description """It represents a set of GPSIs for which the NF
(Service)
instance under CANARY_RELEASE status shall be selected""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/gpsiRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impuRangeList> ;
            sh:description """It represents a set of IMS Public Identities
for which the NF (Service) instance under CANARY_RELEASE
status shall be selected""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/impuRangeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impiRangeList> ;
            sh:description """It represents a set of IMS Private Identities
for which theNF (Service) instance under
CANARY_RELEASE status shall be selected.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem/impiRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/conditionItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptionsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "N1_MESSAGES" "N2_INFORMATION" "LOCATION_NOTIFICATION" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/notificationType> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/callbackUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the optional path segment(s) used to construct
the prefix of the Callback URIs during the reselection of an NF service
consumer, as described in 3GPP TS 29.501""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/callbackUriPrefix> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the callback URI to be used by NF Service
Producers located in PLMNs that are different from the PLMN of
the NF consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/interPlmnCallbackUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:in ( "5GMM" "SM" "LPP" "SMS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/n1MessageClass> ],
        [ sh:in ( "SM" "NRPPA" "PWS" "PWS_BCAL" "PWS_RF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/n2InformationClass> ],
        [ sh:description """This attribute identifies the API versions
(e.g. v1) supported for the default notification type""" ;
            sh:in ( "SM" "NRPPA" "PWS" "PWS_BCAL" "PWS_RF" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/versions> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute shall contain the value of the Binding
Indication for the default subscription notification """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/binding> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the content encodings that are accepted by a
NF Service Consumer when receiving a notification related to a default
notification subscription""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/acceptedEncoding> ],
        [ sh:datatype xsd:string ;
            sh:description """It is a string, which indicates the features of the service
corresponding to the subscribed default notification, which are supported
by the NF (Service) instance acting as NF service consumer. The string
shall contain a bitmask indicating supported features in hexadecimal
representation:Each character in the string shall take a value
of 0 to 9, a to f or A to F """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/supportedFeatures> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates a list of service specific information. It may
be present when the notification request of the notification type may be
generated by multiple services, i.e. notifications from different
services may be received by the subscription.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions/serviceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/gpsiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/gpsiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/gpsiRangeList/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/gpsiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/gpsiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impiRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impiRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impiRangeList/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impiRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impuRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impuRangeList/start> ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impuRangeList/end> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impuRangeList/pattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/impuRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ipEndPointsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ipEndPoints/ipv4Address> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ipEndPoints/ipv6Address> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ipEndPoints/ipv6Prefix> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ],
        [ sh:in ( "TCP" "STCP" "UDP" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ipEndPoints/transport> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ipEndPoints/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ipEndPoints> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfInstanceId> ],
        [ sh:description "Type of Network Function." ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfType> ],
        [ sh:datatype xsd:string ;
            sh:description """Operator defined information about the location
of the NF instance (e.g. geographic location, data center).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/locality> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the operator defined information about the
location of the NF instance. The key of the map shall be a (unique)
valid JSON string per clause 7 of IETF RFC 8259 [92], with a maximum
of 32 characters, representing a type of locality as defined in
clause 6.1.6.3.18.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/extLocality> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Static capacity information in the range of 0-65535,
expressed as a weight relative to other NF instances of
the same type; if capacity is also present in the nfServiceList
parameters, those will have precedence over this value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/capacity> ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Dynamic load information, ranged from 0 to 100,
indicates the current load percentage of the NF.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/load> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the point in time in which the latest load
information (sent by the NF in the load attribute of the NF Profile)
was generated at the NF Instance.If the NF did not provide a timestamp,
the NRF should set it to the instant when the NRF received the message
where the NF provided the latest load information.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/loadTimeStamp> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """Timestamp when the NF was (re)started. The NRF shall notify
NFs subscribed to receiving notifications of changes of the NF profile,
if the NF recoveryTime is changed""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/recoveryTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the different service
instances of a same NF Service in the NF instance, supporting a same
API version, are capable to persist their resource state in shared
storage and therefore these resources are available after a new NF
service instance supporting the same API version is selected by a NF
Service Consumer """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfServicePersistence> ],
        [ sh:datatype xsd:string ;
            sh:description """A NF Set Identifier is a globally unique identifier of
a set of equivalent and interchangeable CP NFs from a given network
that provide distribution, redundancy and scalability
(see clause 5.21.3 of 3GPP TS 23.501 [2]).An NF Set Identifier shall
be constructed from the MCC, MNC, NID (for SNPN), NF type and a Set ID.
A NF Set Identifier shall be formatted as the following string:
set<Set ID>.<nftype>set.5gc.mnc<MNC>.mcc<MCC> for a NF Set in a PLMN, or
set<Set ID>.<nftype>set.5gc.nid<NID>.mnc<MNC>.mcc<MCC> for a NF Set
in a SNPN.At most one NF Set ID shall be indicated per PLMN-ID or SNPN
of the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfSetIdList> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates if the NF Service Consumer supports
or does not support receiving NF Profile Changes. It may be present in
the NFRegister or NFUpdate (NF Profile Complete Replacement) request and
shall be absent in the response (see Annex B 3GPP TS 29.510 [23]).  """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfProfileChangesSupportInd> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It represents NF Profile Partial Update Changes Support
Indicator. TRUE: the NF Service Consumer supports receiving NF Profile
Changes in the response to an NF Profile Partial Update operation.
FALSE (default): the NF Service Consumer does not support receiving
NF Profile Changes in the response to an NF Profile Partial Update
operation""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfProfilePartialUpdateChangesSupportInd> ],
        [ sh:description "Status of the NF Instance." ;
            sh:in ( "REGISTERED" "SUSPENDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfStatus> ],
        [ sh:datatype xsd:boolean ;
            sh:description """NF Profile Changes Indicator. This IE shall be absent
in the request to the NRF and may be included by the NRF
in NFRegister or NFUpdate (NF Profile Complete Replacement) response.
true: the NF Profile contains NF Profile changes.
false (default): complete NF Profile.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfProfileChangesInd> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter indicates the served geographical areas
of a NF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/servingScope> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Load Control based on LCI Header.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/lcHSupportInd> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Overload Control based on OCI Header .""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/olcHSupportInd> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Set(s)
indicated by the NfSetId, where the NF instance belongs.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfSetRecoveryTimeList> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Service
Set(s) configured in the NF instance, which are indicated by the
NfServiceSetId""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/serviceSetRecoveryTimeList> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter shall carry the list of SCP domains the
SCP belongs to, or the SCP domain the NF (other than SCP) or the SEPP
belongs to..""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/scpDomains> ],
        [ sh:datatype xsd:string ;
            sh:description """Vendor ID of the NF instance, according to the
IANA-assigned SMI Network Management Private Enterprise Codes [77].
allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits 0 to complete
a 6-digit string value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/vendorId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/hniList> ],
        [ sh:datatype xsd:string ;
            sh:description """If the NF needs to be discoverable by other
NFs in a different PLMN, then an FQDN that is used
for inter-PLMN routing is specified.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/interPlmnFqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description "It represents human readable name of the NF Instance" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfInstanceName> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF instance whose
nfStatus is set to REGISTERED is in Canary Release condition,
i.e. it should only be selected by NF Service Consumers under the
conditions indicated by the selectionConditions attribute.
True: the NF is under Canary Release condition, even if the
nfStatus is set to REGISTERED
False: the NF instance indicates its Canary Release condition
via the nfStatus attribute""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/canaryRelease> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF Service
Consumer should only select an NF Service Producer in Canary
Release condition.
True: the consumer shall only select producers in Canary Release
condition
False: the consumer may select producers not in Canary Release
condition""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/exclusiveCanaryReleaseSelection> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates a string uniquely identifying
Shared Profile Data. The format of the sharedProfileDataId shall be
a Universally Unique Identifier (UUID) version 4, as described in
IETF RFC 4122 [44]. The hexadecimal letters should be formatted as
lower-case characters by the sender, and they shall be handled as
case-insensitive by the receiver.
Example: 4ace9d34-2c69-4f99-92d5-a73a3fe8e23b""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/sharedProfileDataId> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the timestamp when the NF Instance is
planned to be shut down. This attribute may be present if the
nfStatus is set to UNDISCOVERABLE due to scheduled shutdown""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/shutdownTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "It represents a list of Resource Content Filter IDs" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/supportedRcfs> ],
        [ sh:datatype xsd:boolean ;
            sh:description """ManagedNFProfile.canaryPrecedenceOverPreferred  This
attribute indicates whether the NRF shall prioritize the NF Service
Producer in Canary Release condition over the preferences
(preferred-xxx, ext-preferred-xxx) present in NF discovery requests.
allowedValues:
True NRF shall prioritize NF Service Producers in Canary Release
condition at NF discovery requests, i.e. NF Service Producers
determined according to preferred-xxx and/or ext-preferred-xxx
shall be prioritized after the NF Service Producers in Canary
Release condition. The associated NF (service) priorities for Service
Producers in Canary Release condition shall not be modified by NRF.
False NRF shall prioritize the NF Service Producers according to
preferred-xxx and/or ext-preferred-xxx (i.e. Canary Release condition
in NF Service Producers shall not be prioritized over NF Service
Consumer preferences at NF discovery requests)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/canaryPrecedenceOverPreferred> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/collocatedNfInstances> ;
            sh:description """It represents information related to collocated NF
type(s) and corresponding NF Instances when the NF is collocated
with NFs supporting other NF types.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/collocatedNfInstances> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnList> ;
            sh:description """PLMN(s) of the Network Function.
This IE shall be present if this information
is available for the NF. If not provided, PLMN ID(s)
of the PLMN of the NRF are assumed for the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sNssais> ;
            sh:description """S-NSSAIs of the Network Function. If not
provided, the NF can serve any S-NSSAI. When present
this IE represents the list of S-NSSAIs supported in
all the PLMNs listed in the plmnList IE.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/sNssais> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPlmns> ;
            sh:description """PLMNs allowed to access the NF instance.
If not provided, any PLMN is allowed to access the NF.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/allowedPlmns> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Time in seconds expected between 2 consecutive
heart-beat messages from an NF Instance to the NRF.
It may be included in the registration request.
When present in the request it shall contain the
heartbeat time proposed by the NF service consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/heartBeatTimer> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sNPNList> ;
            sh:description """SNPN(s) of the Network Function. This attributeIE shall be
present if the NF pertains to one or more SNPNs.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/sNPNList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/perPlmnSnssaiList> ;
            sh:description """It includes the S-NSSAIs supported by the Network Function
for each PLMN supported by the Network Function. When present, it shall
override sNssais IE.If the perPlmnSnssaiList attribute is provided in
at least one NF Service, the S-NSSAIs supported per PLMN in the
NF Profile shall be the set or a superset of the perPlmnSnssaiList
of the NFService(s).""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/perPlmnSnssaiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSNPNs> ;
            sh:description """SNPNs allowed to access the NF instance.
The absence of this attribute in the NF profile indicates that no SNPN,
other than the SNPN(s) registered in the snpnList attribute of the
NF Profile, is allowed to access the service instance""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/allowedSNPNs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAIs> ;
            sh:description """S-NSSAI of the allowed slices to access the NF instance.
If not provided, any slice is allowed to access the NF.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/allowedNSSAIs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions> ;
            sh:description """Notification endpoints for different notification types.
This attribute may contain multiple default subscriptions for a same
notification type; in that case, those default subscriptions are used
as alternative notification endpoints.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/defaultNotificationSubscriptions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices> ;
            sh:description """List of NF Service Instances. It shall include
the services produced by the NF that can be
discovered by other NFs.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/nfServices> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/supportedVendorSpecificFeatures> ;
            sh:description """It indicates a map of Vendor-Specific features, where the
key of the map is the IANA-assigned SMI Network Management Private
Enterprise Codes and the value of each entry of the map shall be
a list (array) of VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/supportedVendorSpecificFeatures> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/selectionConditions> ;
            sh:description """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/selectionConditions> ],
        [ sh:datatype xsd:string ;
            sh:description """FQDN of the Network Function. For AMF, the
FQDN registered with the NRF shall be that of the AMF Name.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description "Host address of a NF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/hostAddr> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines NF Specific Service authorization
information. It shall include the NF type (s) and NF realms/origins
allowed to consume NF Service(s) of NF Service Producer """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/authzInfo> ],
        [ sh:description """Type of the NFs allowed to access the NF instance.
If not provided, any NF type is allowed to access the NF.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/allowedNfTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262
dialect [75]) representing the NF domain names within the PLMN of
the NRF allowed to access the NF instance If not provided,
any NF domain is allowed to access the NF.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile/allowedNfDomains> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/managedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServicesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Unique ID of the service instance within a given NF Instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/serviceInstanceID> ],
        [ sh:description "Name of the service instance (e.g. 'nudm-sdm')." ;
            sh:in ( "NNRF_NFM" "NNRF_DISC" "NUDM_SDM" "NUDM_UECM" "NUDM_UEAU" "NUDM_EE" "NUDM_PP" "NAMF_COMM" "NAMF_EVTS" "NAMF_MT" "NAMF_LOC" "NSMF_PDUSESSION" "NSMF_EVENT-EXPOSURE" "NAUSF_AUTH" "NAUSF_SORPROTECTION" "NNEF_PFDMANAGEMENT" "NPCF_AM-POLICY-CONTROL" "NPCF_SMPOLICYCONTROL" "NPCF_POLICYAUTHORIZATION" "NPCF_BDTPOLICYCONTROL" "NPCF_EVENTEXPOSURE" "NPCF_UE_POLICY_CONTROL" "NSMSF_SMS" "NNSSF_NSSELECTION" "NNSSF_NSSAIAVAILABILITY" "NUDR_DR" "NLMF_LOC" "N5G_EIR_EIC" "NBSF_MANAGEMENT" "NCHF_SPENDINGLIMITCONTROL" "NCHF_CONVERGEDCHARGING" "NNWDAF_EVENTSSUBSCRIPTION" "NNWDAF_ANALYTICSINFO" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/serviceName> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the allowed operations on resources for
a given NF Instance; the key of the map is the NF Instance Id, and
the value is an array of scopes""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/allowedOperationsPerNfInstance> ],
        [ sh:datatype xsd:boolean ;
            sh:description """When it is present and set to true, indicates that
the scopes defined in attribute allowedOperationsPerNfInstance
for a given NF Instance ID take precedence over the scopes defined
in attribute allowedOperationsPerNfType for the corresponding
NF type of the NF Instance associated to such NF Instance ID..""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/allowedOperationsPerNfInstanceOverrides> ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the NF Service Instance requires
Oauth2-based authorization""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/oauth2Required> ],
        [ sh:datatype xsd:string ;
            sh:description """String uniquely identifying SharedServiceData. The format
of the sharedServiceDataId shall be a Universally Unique Identifier
(UUID) version 4, as described in IETF RFC 4122 [44]. The hexadecimal
letters should be formatted as lower-case characters by the sender,
and they shall be handled as case-insensitive by the receiver.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/sharedServiceDataId> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Priority (relative to other services of the same type)
in the range of 0-65535, to be used for NF Service selection; lower
values indicate a higher priority.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/priority> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Static capacity information in the range of 0-65535,
expressed as a weight relative to other services of the same type.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/capacity> ],
        [ sh:datatype xsd:string ;
            sh:description "Timestamp when the NF was (re)started." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/recoveryTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Vendor ID of the NF instance" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/vendorId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/versions> ;
            sh:description """API versions supported by the NF Service and if available,
the corresponding retirement date of the NF Service.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/versions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ipEndPoints> ;
            sh:description """IP address(es) and port information of the Network Function
(including IPv4 and/or IPv6 address)where the service is listening
for incoming service requests.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/ipEndPoints> ],
        [ sh:description "URI scheme (e.g. 'http', 'https')." ;
            sh:in ( "HTTP" "HTTPS" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/scheme> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/defaultNotificationSubscriptions> ;
            sh:description "Notification endpoints for different notification types." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/defaultNotificationSubscriptions> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedPLMNs> ;
            sh:description """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/allowedPLMNs> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedSnpns> ;
            sh:description """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/allowedSnpns> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/allowedNSSAI> ;
            sh:description """S-NSSAI of the allowed slices to access the service
instance. The absence of this attribute indicates that any slice
is allowed to access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/allowedNSSAI> ],
        [ sh:description "Status of the NF Service Instance." ;
            sh:in ( "REGISTERED" "SUSPENDED" "UNDISCOVERABLE" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/nfServiceStatus> ],
        [ sh:datatype xsd:string ;
            sh:description "FQDN of the NF Service Instance." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """If the NF service needs to be discoverable by other NFs in a
different PLMN, then an FQDN that is used for inter PLMN routing.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/interPlmnFqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """Optional path segment(s) used to construct the {apiRoot}
variable of the different API URIs.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/apiPrefix> ],
        [ sh:description "SNPNs allowed to access the NF instance" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/allowedNfTypes> ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the NF domain names allowed to
access the service instance.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/allowedNfDomains> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the allowed operations on resources for
each type of NF; the key of the map is the NF Type, and the value
is an array of scopes""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices/allowedOperationsPerNfType> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/nfServices> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/operations> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/perPlmnSnssaiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid
identifies an SNPN """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/perPlmnSnssaiList/nid> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnId> ;
            sh:description """PLMN ID for which list of supported S-NSSAI(s)
is provided.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/perPlmnSnssaiList/plmnId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sNssaiList> ;
            sh:description """The specific list of S-NSSAIs supported
by the given PLMN.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/perPlmnSnssaiList/sNssaiList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/perPlmnSnssaiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/plmnId/mcc> ;
