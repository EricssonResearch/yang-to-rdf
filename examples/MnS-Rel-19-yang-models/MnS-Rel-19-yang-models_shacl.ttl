            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/TraceJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/freqInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/geoPolygon> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/mdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/nPNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/operations> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/sliceIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/taiList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfreqrelation/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequencyShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency/id> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Specifies the channel number for the central DL frequency." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency/earfcnDL> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description "List of additional frequency bands the frequency belongs to." ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency/multiBandInfoListEutra> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/userLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNIdList> ;
            sh:description """List of at most six entries of PLMN Identifiers, but at least
one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a
Mobile Network Code (MNC).""" ;
            sh:maxCount 6 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/pLMNIdList> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/amfRegionId> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/amfSetId> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/amfPointer> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction/SupportedPerfMetricGroups> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ExternalAMFFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/File> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/Files> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/operations> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/taiList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalamffunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction/userLabel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:int ;
            sh:description "Unambiguously identifies an eNodeB within a PLMN." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction/eNBId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction/SupportedPerfMetricGroups> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDDShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/userLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/SupportedPerfMetricGroups> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnIdList> ;
            sh:description """List of unique identities for PLMNs. A cell can broadcast
up to 6 PLMN IDs. This is to support the case that one cell can be
used by up to 6 operator's core networks. The PLMN(s) included in this
list will use the same single tracking area code (TAC) and the same
Cell Identity (cellLocalId) for sharing the radio access network
resources. One member of plmnIdList is the primary PLMN ID. A PLMN ID
included in this list cannot be included in the cellAccessInfoList.
The PLMN ID is composed of a Mobile Country Code (MCC) and a Mobile
Network Code (MNC).""" ;
            sh:maxCount 6 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/plmnIdList> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/supportedTraceMetrics> ],
        [ sh:datatype xsd:int ;
            sh:description """The Physical Cell Identity (PCI) of the cell (for
NM-Centralized, EM-Centralized and Distributed PCI assignment cases).
In the case of NM-Centralized PCI assignment, see 3GPP TS 36.300.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/pci> ],
        [ sh:datatype xsd:int ;
            sh:description "Unambiguously identifies a cell within an eNodeB." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/cellLocalId> ],
        [ sh:datatype xsd:int ;
            sh:description "Unambiguously identifies an eNodeB within a PLMN." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/eNBId> ],
        [ sh:datatype xsd:int ;
            sh:description "The channel number for the central DL frequency." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/earfcnDL> ],
        [ sh:datatype xsd:int ;
            sh:description """The channel number for the central UL frequency. Value 0
means that the UL channel number is N/A for the DL-only bands.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/earfcnUL> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD/vnfParametersList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellFDD> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDDShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/userLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/SupportedPerfMetricGroups> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnIdList> ;
            sh:description """List of unique identities for PLMNs. A cell can broadcast
up to 6 PLMN IDs. This is to support the case that one cell can be
used by up to 6 operator's core networks. The PLMN(s) included in this
list will use the same single tracking area code (TAC) and the same
Cell Identity (cellLocalId) for sharing the radio access network
resources. One member of plmnIdList is the primary PLMN ID. A PLMN ID
included in this list cannot be included in the cellAccessInfoList.
The PLMN ID is composed of a Mobile Country Code (MCC) and a Mobile
Network Code (MNC).""" ;
            sh:maxCount 6 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/plmnIdList> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/supportedTraceMetrics> ],
        [ sh:datatype xsd:int ;
            sh:description """The Physical Cell Identity (PCI) of the cell (for
NM-Centralized, EM-Centralized and Distributed PCI assignment cases).
In the case of NM-Centralized PCI assignment, see 3GPP TS 36.300.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/pci> ],
        [ sh:datatype xsd:int ;
            sh:description "Unambiguously identifies a cell within an eNodeB." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/cellLocalId> ],
        [ sh:datatype xsd:int ;
            sh:description "Unambiguously identifies an eNodeB within a PLMN." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/eNBId> ],
        [ sh:datatype xsd:int ;
            sh:description "The frequency number for the central frequency." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/earfcn> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD/peeParameterslist> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalEUtranCellTDD> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/File> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/Files> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/operations> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/taiList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/userLabel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Identifies a gNB within a PLMN.
The gNB ID is part of the NR Cell Identifier (NCI) of the gNB cells.

See 'gNB Identifier (gNB ID)' of subclause 8.2 of TS 38.300.
See 'Global gNB ID' in subclause 9.3.1.6 of TS 38.413""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/gNBId> ],
        [ sh:datatype xsd:int ;
            sh:description "Indicates the number of bits for encoding the gNB ID." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/gNBIdLength> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/SupportedPerfMetricGroups> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNId> ;
            sh:description """Specifies the PLMN identifier to be used as part of the
global RAN node identity.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction/pLMNId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalGNBCUCPFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCUShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/userLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNIdList> ;
            sh:description """Defines which PLMNs that are assumed to be served by the
NR cell in another gNB CU-CP. This list is either updated by the
managed element itself (e.g. due to ANR, signalling over Xn, etc.) or
by consumer over the standard interface.""" ;
            sh:maxCount 12 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/pLMNIdList> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/supportedTraceMetrics> ],
        [ sh:datatype xsd:int ;
            sh:description """It identifies a NR cell of a gNB.

It, together with the gNB Identifier (using gNBId of the parent
GNBCUCPFunction or GNBDUFunction or OperatorDU (for MOCN network
sharing scenario) or ExternalCUCPFunction), identifies a NR cell within
a PLMN. This is the NR Cell Identity(NCI). See subclause 8.2 of TS38.300.

The NCI can be constructed by encoding the gNB Identifier using gNBId
(of the parent GNBCUCPFunction or GNBDUFunction or OperatorDU
(for MOCN network sharing scenario) or ExternalCUCPFunction) and
cellLocalId where the gNB Identifier field is of length specified by
gNBIdLength (of the parent GNBCUCPFunction or GNBDUFunction or
ExternalCUCPFunction). See 'Global gNB ID' in subclause 9.3.1.6 of
TS 38.413.

The NR Cell Global identifier (NCGI) is constructed from the
PLMN identity the cell belongs to and the NR Cell Identifier (NCI) of
the cell.

See relation between NCI and NCGI subclause 8.2 of TS 38.300 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/cellLocalId> ],
        [ sh:datatype xsd:long ;
            sh:description """This holds the Physical Cell Identity (PCI) of the NR cell.

allowedValues:
See 3GPP TS 36.211 subclause 6.11 for legal values of pci.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/nRPCI> ],
        [ sh:description "Reference to corresponding NRFrequency instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/nRFrequencyRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU/SupportedPerfMetricGroups> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ExternalNRCellCU> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/File> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/Files> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/operations> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/taiList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction/userLabel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Identifies a gNB within a PLMN.
The gNB ID is part of the NR Cell Identifier (NCI) of the gNB cells.

See 'gNB Identifier (gNB ID)' of subclause 8.2 of TS 38.300.
See 'Global gNB ID' in subclause 9.3.1.6 of TS 38.413""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction/gNBId> ],
        [ sh:datatype xsd:int ;
            sh:description "Indicates the number of bits for encoding the gNB ID." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction/gNBIdLength> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction/SupportedPerfMetricGroups> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ExternalGNBCUUPFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/File> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/Files> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/operations> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/taiList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcuupfunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction/userLabel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction/priorityLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction/supportedTraceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Identifies a gNB within a PLMN.
The gNB ID is part of the NR Cell Identifier (NCI) of the gNB cells.

See 'gNB Identifier (gNB ID)' of subclause 8.2 of TS 38.300.
See 'Global gNB ID' in subclause 9.3.1.6 of TS 38.413""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction/gNBId> ],
        [ sh:datatype xsd:int ;
            sh:description "Indicates the number of bits for encoding the gNB ID." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction/gNBIdLength> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction/SupportedPerfMetricGroups> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ExternalGNBDUFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/File> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/Files> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ntnGeoAreaListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/geoPolygon> ;
            sh:description """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
            sh:minCount 3 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ntnGeoAreaList/geoPolygon> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/operations/name> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/operations/allowedNFTypes> ],
        [ sh:description "Semantics type of the operation." ;
            sh:in ( "REQUEST_RESPONSE" "SUBSCRIBE_NOTIFY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/operations> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/pLMNTarget/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/pLMNTarget/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslistShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The identification of the site where the
ManagedFunction resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist/siteIdentification> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist/siteLatitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist/siteLongitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist/siteAltitude> ],
        [ sh:datatype xsd:string ;
            sh:description """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist/siteDescription> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of equipment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist/equipmentType> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of environment where the managedFunction
instance resides.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist/environmentType> ],
        [ sh:datatype xsd:string ;
            sh:description "The type of power." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist/powerInterface> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/peeParameterslist> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnId/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sAP/host> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sAP/port> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sliceIdListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sliceIdList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sliceIdList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sliceIdList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sliceIdList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/sliceIdList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/taiList/tac> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/plmnId> ;
            sh:description "PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/taiList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/taiList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/targetInterfaceInfoListShape> a sh:NodeShape ;
    sh:property [ sh:description """List of network interface type to be monitored. The
applicable network interface type names are specified based on
subclause 4.2.3 of 3GPP TS 23.501 and clause 4.2.1 of 3GPP
TS 23.273.
The value ALL is specified for the case if all the applicable
interface type of the network function shall be monitored.""" ;
            sh:in ( "ALL" "N2" "N4" "N5" "N7" "N8" "N10" "N11" "N12" "N13" "N14" "N15" "N16" "N17" "N18" "N20" "N21" "N22" "N23" "N26" "N28" "N29" "N30" "N33" "N34" "N35" "N36" "N37" "N40" "N41" "N42" "N51" "N52" "N58" "N59" "N60" "N61" "N62" "N63" "N80" "N81" "N82" "N83" "N84" "N85" "N86" "N87" "N88" "N89" "N96" "NL1" "NL2" "NL5" "NL6" "NL8" "NL9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/targetInterfaceInfoList/networkInterfaceType> ],
        [ sh:description """The list of applicable network interface instances, for
which the monitoring is to be performed, of the network interface
type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/targetInterfaceInfoList/networkInterfaceInstanceList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """The list of applicable service operations exchanged
over the network interface instances specified by
networkInterfaceInstanceList, that needs to be monitored. Or,
If networkInterfaceInstanceList is not present, the list of
applicable service operations exchanged over the network
interface type specified by networkInterfaceType.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/targetInterfaceInfoList/serviceOperationList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/targetInterfaceInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/thresholdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/thresholdInfoList/performanceMetrics> ],
        [ sh:description """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
            sh:in ( "UP" "DOWN" "UP_AND_DOWN" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/thresholdInfoList/thresholdDirection> ],
        [ sh:datatype xsd:string ;
            sh:description """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/thresholdInfoList/thresholdValue> ],
        [ sh:datatype xsd:string ;
            sh:description """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/thresholdInfoList/hysteresis> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/thresholdInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceConfig/listOfInterfaces> ],
        [ sh:description """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
            sh:in ( "MSC_SERVER" "SGSN" "MGW" "GGSN" "RNC" "BM_SC" "MME" "SGW" "PGW" "ENB" "EN_GNB" "GNB_CU_CP" "GNB_CU_UP" "GNB_DU" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceConfig/listOfNeTypes> ],
        [ sh:description """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
            sh:in ( "MINIMUM" "MEDIUM" "MAXIMUM" "VENDORMINIMUM" "VENDORMEDIUM" "VENDORMAXIMUM" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceConfig/traceDepth> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents> ;
            sh:description """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceConfig/triggeringEvents> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceReferenceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceReference/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceReference/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceReference/traceId> ;
            sh:pattern "[0-9a-fA-F]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceTargetShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceTarget/traceTargetType> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceTarget/traceTargetValueList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEventsShape> a sh:NodeShape ;
    sh:property [ sh:in ( "MO_MT_CALLS" "MO_MT_SMS" "LU_IMSIattach_IMSIdetach" "SS" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/MSC_SERVER> ],
        [ sh:in ( "PDPcontext" "MO_MT_SMS" "RAU_GPRSattach_GPRSdetach" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/SGSN> ],
        [ sh:in ( "PDUsessionEstablishment" "PDUsessionModification" "PDUsessionRelease" "PDUsessionUPactivationDeactivation" "MobilityBtw3gppAndN3gppTo5GC" "MobilityFromEpc" "MobilityBtwISMForVSMF" "CovergedChargingService" "OfflineOnlyCharging" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/SMF> ],
        [ sh:in ( "AMpolicy" "SMpolicy" "Authorization" "BDTpolicy" "SpendingLimitControl" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/PCF> ],
        [ sh:in ( "N4Session" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/UPF> ],
        [ sh:in ( "UEauthentication" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/AUSF> ],
        [ sh:in ( "EventExposure" "PFDmanagement" "ParameterProvisiong" "Trigger" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/NEF> ],
        [ sh:in ( "NFmanagement" "NFdiscovery" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/NRF> ],
        [ sh:in ( "NSSelection" "NSSAI" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/NSSF> ],
        [ sh:in ( "SMService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/SMSF> ],
        [ sh:in ( "UEcontext" "SubscriberData" "UEauthentication" "EventExposure" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/UDM> ],
        [ sh:in ( "CONTEXT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/MGW> ],
        [ sh:in ( "PDPcontext" "MBMScontext" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/GGSN> ],
        [ sh:in ( "SIPsession_StandaloenTransaction" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/IMS> ],
        [ sh:in ( "MBMSactivation" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/BM_SC> ],
        [ sh:in ( "UEinitiatedPDNconnectivityRequest" "ServiceRequest" "InitialAttach_TAU_Detach" "UEInitiatedPDNdisconnection" "BearerActivationModificationDeletion" "Handover" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/MME> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/SGW> ],
        [ sh:in ( "PDNconnectionCreation" "PDNconnectionTermination" "BearerActivationModificationDeletion" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/PGW> ],
        [ sh:in ( "Registration" "ServiceRequest" "Handover" "UEderegistration" "NetworkDeregistration" "UEMobilityFromEPC" "UEMobilityToEPC" "CovergedChargingService" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents/AMF> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/trsrPrefixCfgShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "A 2 byte Octet String. This is the base TRSR prefix" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/trsrPrefixCfg/trsrPrefix> ],
        [ sh:datatype xsd:int ;
            sh:description """An integer to indicate how many bits are used for the
TRSR prefix""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/trsrPrefixCfg/trsrPrefixLength> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/trsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ueCoreMeasConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ueCoreMeasConfig/ueCoreMeasurements> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ueCoreMeasConfig/ueCoreMeasGranularityPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ueCoreMeasConfig/nfTypeToMeasure> ],
        [ sh:datatype xsd:string ;
            sh:description """List of object instances.
Each object instance is identified by its DN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ueCoreMeasConfig/objectInstances> ],
        [ sh:datatype xsd:string ;
            sh:description """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ueCoreMeasConfig/rootObjectInstances> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/ueCoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/vnfParametersListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "VNF instance identifier" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/vnfParametersList/vnfInstanceId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/vnfParametersList/vnfdId> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/vnfParametersList/flavourId> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/vnfParametersList/autoScalable> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbdufunction/vnfParametersList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/Configurable5QISetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/Configurable5QISet/id> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/Configurable5QISet> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FileShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/id> ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/fileLocation> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/jobId> ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/fileContent> ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/fileCompression> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/fileSize> ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/fileDataType> ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/fileFormat> ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/fileReadyTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/fileExpirationTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/File> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FilesShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/Files/id> ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/Files/numberOfFiles> ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/Files/jobRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/Files/jobId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/Files> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristicsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristics/id> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Identifies the 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristics/fiveQIValue> ],
        [ sh:description """It indicates the Resource Type of a 5QI, as specified
in TS 23.501 """ ;
            sh:in ( "GBR" "NON_GBR" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristics/resourceType> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It indicates the Priority Level of a 5QI, as specified
in TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristics/priorityLevel> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Indicates the Packet Delay Budget (in unit of 0.5ms)of a 5QI,
as specified in TS 23.501 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristics/packetDelayBudget> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristics/averagingWindow> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristics/maximumDataBurstVolume> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/packetErrorRate> ;
            sh:description """It indicates the Packet Error Rate of a 5QI,
as specified in TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristics/packetErrorRate> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/FiveQICharacteristics> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/userLabel> ],
        [ sh:description """DN of the Configurable5QISet that the GNBCUCPFunction
supports (is associated to).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/configurable5QISetRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether the function is
on board the satellite.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/isOnboardSatellite> ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates the onboard satellite Id.
It shall be formatted as a fixed 5-digit string, padding with
leading digits '0' to complete a 5-digit length.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/onboardSatelliteId> ],
        [ sh:description """DN of the Dynamic5QISet that the GNBCUCPFunction supports
(is associated to).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/dynamic5QISetRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "This is the DN of EphemerisInfoSet." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/ephemerisInfoSetRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """DN of a NRECMappingRule.  An empty value indicates the
NRECMappingRule contained by parent, e.g. ManagedElement or
SubNetwork, applies.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/nRECMappingRuleRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """This attribute represents the MWAB functionality
(See sub clause 5.49 [11]). This attribute contains the DN of the
referenced MWAB.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/mWABRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/vnfParametersList> ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/vnfParametersList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/peeParameterslist> ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/peeParameterslist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/SupportedPerfMetricGroups> ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/SupportedPerfMetricGroups> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/priorityLabel> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/pLMNId> ;
            sh:description """The PLMN identifier to be used as part of the global RAN
node identity.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/pLMNId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/x2BlockList> ;
            sh:description "List of nodes to which X2 connections are prohibited." ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/x2BlockList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/x2AllowList> ;
            sh:description "List of nodes to which X2 connections are enforced." ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/x2AllowList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/xnBlockList> ;
            sh:description "List of nodes to which Xn connections are prohibited." ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/xnBlockList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/xnAllowList> ;
            sh:description "List of nodes to which X2 connections are enforced." ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/xnAllowList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/x2HOBlockList> ;
            sh:description "List of nodes to which handovers over X2 are prohibited." ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/x2HOBlockList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/xnHOBlockList> ;
            sh:description "List of nodes to which handovers over  Xn are prohibited." ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/xnHOBlockList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappingSetIDBackhaulAddressList> ;
            sh:description """The attribute specifies a list of mappingSetIDBackhaulAddress
which is defined as a datatype. Which is used to
retrieve the backhaul address of the victim set.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/mappingSetIDBackhaulAddressList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/tceIDMappingInfoList> ;
            sh:description """This attribute includes a list of TCE ID, PLMN where TCE
resides and the corresponding TCE IP address. It is used in Logged MDT
case to provide the information to the gNodeB or GNBCUCPFunction to
get the corresponding TCE IP address when there is an MDT log
received from the UE.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/tceIDMappingInfoList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/qceIdMappingInfoList> ;
            sh:description """List of the mapping relationship between QoE collection entity
identity, PLMN where QoE collection entity resides, and the IP address of
the QoE collection entity.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/qceIdMappingInfoList> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/supportedTraceMetrics> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellIdInfoList> ;
            sh:description """This attribute provides the list of mapping between
geographical location and Mapped Cell ID.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/mappedCellIdInfoList> ],
        [ sh:datatype xsd:long ;
            sh:description """Identifies a gNB within a PLMN. The gNB Identifier (gNB ID)
is part of the NR Cell Identifier (NCI) of the gNB cells.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/gNBId> ],
        [ sh:datatype xsd:int ;
            sh:description "Indicates the number of bits for encoding the gNB ID." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/gNBIdLength> ],
        [ sh:datatype xsd:string ;
            sh:description "Identifies the Central Unit of an gNB." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/gNBCUName> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute determines whether the DAPS handover function
is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/dDAPSHOControl> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute determines whether the CHO function is
enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/dCHOControl> ],
        [ sh:description """represents a list of MDT measurement names that are
subject to user consent at MDT activation.
Any MDT measurement, whose name is not specified in this list, is not
subject to user consent at MDT activation.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6" "M7" "M8" "M9" "MDT_UE_LOCATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction/mdtUserConsentReqList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/GNBCUCPFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFServiceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService/id> ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService/userLabel> ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService/nFServiceType> ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService/administrativeState> ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService/operationalState> ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService/usageState> ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService/registrationState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/sAP> ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService/sAP> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/operations> ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService/operations> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ManagedNFService> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/id> ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/administrativeState> ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/notificationRecipientAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/streamTarget> ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/_linkToFiles> ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/schedulerRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/conditionMonitorRef> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/operationalState> ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/jobId> ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/granularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/fileReportingPeriod> ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob/fileLocation> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/PerfMetricJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/StmCtrlShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/StmCtrl/id> ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/StmCtrl/reportingNFList> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/StmCtrl/stmTargetUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/StmCtrl/administrativeState> ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/StmCtrl/operationalState> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/targetInterfaceInfoList> ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/StmCtrl/targetInterfaceInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/StmCtrl> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/SupportedPerfMetricGroupsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/SupportedPerfMetricGroups/performanceMetrics> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/SupportedPerfMetricGroups/granularityPeriods> ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/SupportedPerfMetricGroups/reportingMethods> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/SupportedPerfMetricGroups/reportingPeriods> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ThresholdMonitorShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ThresholdMonitor/id> ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ThresholdMonitor/administrativeState> ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ThresholdMonitor/operationalState> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ThresholdMonitor/monitorGranularityPeriod> ],
        [ sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ThresholdMonitor/objectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ThresholdMonitor/rootObjectInstances> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/thresholdInfoList> ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ThresholdMonitor/thresholdInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ThresholdMonitor> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJobShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/id> ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/jobType> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/traceTarget> ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/traceTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/traceConfig> ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/traceConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig> ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/mdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ueCoreMeasConfig> ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/ueCoreMeasConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNTarget> ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/nPNTarget> ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/rrcReportType> ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/listOfTraceMetrics> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/traceCollectionEntityIPAddress> ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/traceReportingConsumerUri> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/jobId> ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/traceReportingFormat> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/pLMNTarget> ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/pLMNTarget> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/traceReference> ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob/traceReference> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/TraceJob> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaConfigurationForNeighCellShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "List of neighbour cells subject for MDT scope." ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaConfigurationForNeighCell/pciList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/freqInfo> ;
            sh:description """It specifies the carrier frequency and bands used in
a cell.""" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaConfigurationForNeighCell/freqInfo> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaConfigurationForNeighCell> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ntnGeoAreaList> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNIdentityList> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/taiList> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/backhaulAddressShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """It identifies a gNB within a PLMN. The gNB ID is part of
the NR Cell Identifier (NCI) of the gNB cells.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/backhaulAddress/gNBId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/tAI> ;
            sh:description "Tracking Area Identity" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/backhaulAddress/tAI> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/backhaulAddress> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/excessPacketDelayThresholdsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedByte ;
            sh:description "It indicates 5QI value." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/excessPacketDelayThresholds/fiveQIValue> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/excessPacketDelayThresholds/excessPacketDelayThresholdValue> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/excessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/freqInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/freqInfo/arfcn> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/freqInfo/freqBands> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/freqInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/geoPolygonShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:description """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/geoPolygon/latitude> ],
        [ sh:datatype xsd:decimal ;
            sh:description """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/geoPolygon/longitude> ],
        [ sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/geoPolygon/altitude> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/geoPolygon> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
            sh:in ( "M1" "M2" "M3" "M4" "M5" "M6_DL" "M6_UL" "M7_DL" "M7_UL" "M1_EVENT_TRIGGERED" "M6" "M7" "M8" "M9" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/listOfMeasurements> ],
        [ sh:description """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
            sh:in ( "PERIODICAL" "A2_FOR_LTE" "1F_FOR_UMTS" "1I_FOR_UMTS_MCPS_TDD" "A2_TRIGGERED_PERIODIC_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_LTE" "ALL_CONFIGURED_RRM_FOR_UMTS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportingTrigger> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/collectionPeriodM6LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/collectionPeriodM7LTE> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/eventThresholdUphUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/collectionPeriodRRMUMTS> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/measurementPeriodUMTS> ],
        [ sh:description """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
            sh:in ( "CPICH_ECNO" "CPICH_RSCP" "PATHLOSS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/measurementQuantity> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/beamLevelMeasurement> ],
        [ sh:description """It specifies what positioning method should be used in the
MDT job.""" ;
            sh:in ( "GNSS" "E_CELL_ID" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/positioningMethod> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM1LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM4LTE> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportInterval> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM5LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM6LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM7LTE> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM1NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM4NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM5NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM6NR> ],
        [ sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
            sh:in ( "1" "2" "4" "8" "16" "32" "64" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmountM7NR> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/excessPacketDelayThresholds> ;
            sh:description "Excess packet delay thresholds info for M6 UL measurement." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/excessPacketDelayThresholds> ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/reportAmount> ],
        [ sh:datatype xsd:long ;
            sh:description """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/eventThreshold> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/collectionPeriodRRMNR> ],
        [ sh:description """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
            sh:in ( "120ms" "240ms" "480ms" "640ms" "1024ms" "2048ms" "5120ms" "10240ms" "20480ms" "40960ms" "1min" "6min" "12min" "30min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/collectionPeriodM6NR> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/collectionPeriodM7NR> ],
        [ sh:description """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
            sh:in ( "100ms" "1000ms" "1024ms" "1280ms" "2048ms" "2560ms" "5120ms" "10000ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/collectionPeriodRRMLTE> ],
        [ sh:description """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
            sh:in ( "1024ms" "2048ms" "5120ms" "10240ms" "1min" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig/measurementPeriodLTE> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:long ;
            sh:description """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/traceCollectionEntityId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/loggingDuration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNIdentityList> ;
            sh:description """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/nPNIdentityList> ],
        [ sh:description """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
            sh:in ( "320ms" "640ms" "1280ms" "2560ms" "5120ms" "10240ms" "20480ms" "30720ms" "40960ms" "61440ms" "INFINITY" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/loggingInterval> ],
        [ sh:description "It specifies report type for logged NR MDT" ;
            sh:in ( "PERIODICAL" "EVENT_TRIGGERED" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/reportType> ],
        [ sh:description """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
            sh:in ( "OUT_OF_COVERAGE" "A2_EVENT" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/eventListForEventTriggeredMeasurement> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/eventThresholdL1> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/hysteresisL1> ],
        [ sh:datatype xsd:int ;
            sh:description """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/timeToTriggerL1> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaConfigurationForNeighCell> ;
            sh:description """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/areaConfigurationForNeighCell> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mbsfnAreaList> ;
            sh:description """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig/mbsfnAreaList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellIdInfoListShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ntnGeoArea> ;
            sh:description """This attribute indicates a specific geographical location
mapped to Mapped Cell ID(s).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellIdInfoList/ntnGeoArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellId> ;
            sh:description """This attribute is in format of NCGI to indicate a fixed
geographical area (See subclause 16.14.5 in TS 38.300)""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellIdInfoList/mappedCellId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellIdInfoList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This attribute represents NR Cell Identity.
It's a 36-bit string identifying an NR Cell Id as specified in
clause 9.3.1.7 of TS 38.413, in hexadecimal representation. Each
character in the string shall take a value of
'0' to '9', 'a' to 'f' or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most significant
bits of the Cell Id shall appear first in the string, and the
character representing the 4 least significant bit of the
Cell Id shall appear last in the string.

Pattern: '^[A-Fa-f0-9]{9}$'

Example:
An NR Cell Id 0x225BD6007 shall be encoded as '225BD6007'.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellId/nrCellId> ],
        [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid identifies
an SNPN (see clauses 5.30.2.3, 5.30.2.9, 6.3.4, and 6.3.8 in
3GPP TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellId/nId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/plmnId> ;
            sh:description "This attribute represents a PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellId/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappedCellId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappingSetIDBackhaulAddressListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """This specifies the set ID of a victim Set (RIM-RS1 Set) or
aggressor Set (RIM-RS2 set). (See subclause 7.4.1.6 in TS 38.211).

allowedValues:
The bit length of the set ID is maximum 22bit.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappingSetIDBackhaulAddressList/setId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/backhaulAddress> ;
            sh:description """The attribute specifies backhaulAddress which is defined as
a datatype.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappingSetIDBackhaulAddressList/backhaulAddress> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mappingSetIDBackhaulAddressList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mbsfnAreaListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description "MBSFN Area Identifier" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mbsfnAreaList/mbsfnAreaId> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Carrier Frequency" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mbsfnAreaList/earfcn> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mbsfnAreaList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
            sh:in ( "NO_IDENTITY" "TAC_OF_IMEI" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig/anonymizationOfMdtData> ],
        [ sh:description """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
            sh:in ( "BAROMETRIC_PRESSURE" "UE_SPEED" "UE_ORIENTATION" ) ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig/sensorInformation> ],
        [ sh:datatype xsd:boolean ;
            sh:description """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig/mNOnly> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/areaScope> ;
            sh:description "It specifies the area where data shall be collected. " ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig/areaScope> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/immediateMdtConfig> ;
            sh:description """The set of parameters specific for Immediate MDT
configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig/immediateMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/loggedMdtConfig> ;
            sh:description """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig/loggedMdtConfig> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/plmnList> ;
            sh:description """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig/plmnList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/trsrPrefixCfg> ;
            sh:description """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig/trsrPrefixCfg> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/mdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNIdentityListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNIdentityList/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNIdentityList/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNIdentityList/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNIdentityList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNTarget/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
            sh:maxCount 16 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNTarget/nIDList> ;
            sh:pattern "^[A-Fa-f0-9]{11}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/plmnId> ;
            sh:description "It specifies the PLMN Id of the NPN network." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNTarget/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/nPNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/ntnGeoAreaListShape> a sh:NodeShape ;
