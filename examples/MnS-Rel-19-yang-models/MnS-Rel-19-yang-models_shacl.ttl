    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNssaiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNssaisShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
