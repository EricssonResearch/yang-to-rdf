            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/perPlmnSnssaiList/plmnId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNssaiList> ;
            sh:description """The specific list of S-NSSAIs supported
by the given PLMN.""" ;
            sh:maxCount 1 ;
