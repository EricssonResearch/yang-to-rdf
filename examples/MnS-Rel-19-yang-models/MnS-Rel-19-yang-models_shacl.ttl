            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/operations/operationSemantics> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/operations> .

<urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/pLMNIdShape> a sh:NodeShape ;
