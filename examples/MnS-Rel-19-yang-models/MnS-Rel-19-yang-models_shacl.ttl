    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ntnGeoAreaList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/operationsShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
