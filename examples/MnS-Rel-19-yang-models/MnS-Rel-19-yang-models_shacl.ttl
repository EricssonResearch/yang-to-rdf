            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/plmnId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/plmnListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/plmnList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/plmnList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/plmnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/positionVelocityShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """X, Y, Z coordinate of satellite position state vector
in ECEF. Unit is meter.
Step of 1.3 m. Actual value = field value * 1.3.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/positionVelocity/positionX> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """X, Y, Z coordinate of satellite position state vector
in ECEF. Unit is meter.
Step of 1.3 m. Actual value = field value * 1.3.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/positionVelocity/positionY> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """X, Y, Z coordinate of satellite position state vector
in ECEF. Unit is meter.
Step of 1.3 m. Actual value = field value * 1.3.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/positionVelocity/positionZ> ],
        [ sh:datatype xsd:int ;
            sh:description """X, Y, Z coordinate of satellite velocity state vector
in ECEF.
Step of 0.06 m/s. Actual value = field value * 0.06.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/positionVelocity/velocityVX> ],
        [ sh:datatype xsd:int ;
            sh:description """X, Y, Z coordinate of satellite velocity state vector
in ECEF.
Step of 0.06 m/s. Actual value = field value * 0.06.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/positionVelocity/velocityVY> ],
        [ sh:datatype xsd:int ;
            sh:description """X, Y, Z coordinate of satellite velocity state vector
in ECEF.
Step of 0.06 m/s. Actual value = field value * 0.06.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/positionVelocity/velocityVZ> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/positionVelocity> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/sAPShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/sAP/host> ],
