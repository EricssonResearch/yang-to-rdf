            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/supportedVendorSpecificFeatures/enterpriseCode> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/vendorSpecificFeature> ;
            sh:description """VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/supportedVendorSpecificFeatures/vendorSpecificFeature> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/supportedVendorSpecificFeatures> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/tacRangeListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of a TAC range,
to be used when the range of TAC's can be represented
as a hexadecimal range (e.g., TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/tacRangeList/start> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6}$)" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of a TAC range,
to be used when the range of TAC's can be represented as
a hexadecimal range (e.g. TAC ranges).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/tacRangeList/end> ;
            sh:pattern "^([A-Fa-f0-9]{4}|[A-Fa-f0-9]{6})$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262)
representing the set of TAC's belonging to this range.
A TAC value is considered part of the range if and only if the
TAC string fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/tacRangeList/nRTACpattern> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/tacRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/taiListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code" ;
            sh:maxCount 1 ;
