<urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOWeakCoverageParametersShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOWeakCoverageParameters/id> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It indicates the coverage shape of specific sites which
can be selected to optimize radio coverage.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOWeakCoverageParameters/coverageShapeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/downlinkTransmitPowerRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of downlinkTransmitPower to optimize radio coverage.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOWeakCoverageParameters/downlinkTransmitPowerRange> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/antennaTiltRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of antennaTilt to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOWeakCoverageParameters/antennaTiltRange> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/antennaAzimuthRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of antennaAzimuth to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOWeakCoverageParameters/antennaAzimuthRange> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/digitalTiltRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of digitalTilt to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOWeakCoverageParameters/digitalTiltRange> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/digitalAzimuthRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of digitalAzimuth to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOWeakCoverageParameters/digitalAzimuthRange> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOWeakCoverageParameters> .

