            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/perPlmnSnssaiList/nid> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/plmnId> ;
            sh:description """PLMN ID for which list of supported S-NSSAI(s)
is provided.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/perPlmnSnssaiList/plmnId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sNssaiList> ;
            sh:description """The specific list of S-NSSAIs supported
by the given PLMN.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/perPlmnSnssaiList/sNssaiList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/perPlmnSnssaiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/plmnIdShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/plmnId/mcc> ;
