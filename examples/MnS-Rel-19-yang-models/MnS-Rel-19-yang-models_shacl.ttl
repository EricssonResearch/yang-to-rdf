            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/xnAllowList/gnbId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-gnbcucpfunction/xnAllowList> .

