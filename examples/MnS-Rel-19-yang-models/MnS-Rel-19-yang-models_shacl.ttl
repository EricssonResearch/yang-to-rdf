    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/operations> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNIdListShape> a sh:NodeShape ;
