@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency> a owl:Ontology ;
    owl:versionInfo "revision 2025-04-25 (CR-1526 CR-1527)" .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequencyShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency/id> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Specifies the channel number for the central DL frequency." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency/earfcnDL> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description "List of additional frequency bands the frequency belongs to." ;
            sh:minCount 0 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency/multiBandInfoListEutra> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency> .

