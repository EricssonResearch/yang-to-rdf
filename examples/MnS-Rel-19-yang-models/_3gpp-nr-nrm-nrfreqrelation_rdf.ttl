    rdfs:label "NRFreqRelation.rsrqOffsetCsiRs" ;
    rdfs:comment "Offset value of rsrqOffsetCSI-RS." ;
    rdfs:domain nrfreqrel3gpp:NRFreqRelation ;
    rdfs:range xsd:byte .

nrfreqrel3gpp:NRFreqRelation.rsrqOffsetSsb a rdf:Property ;
