nrfreqrel3gpp:NRFreqRelation.tReselectionNRSfHigh a rdf:Property ;
    rdfs:label "NRFreqRelation.tReselectionNRSfHigh" ;
    rdfs:comment """The attribute tReselectionNr (parameter TreselectionNR in
3GPP TS 38.304) is multiplied with this scaling factor if the UE is
in high mobility state.""" ;
    rdfs:domain nrfreqrel3gpp:NRFreqRelation ;
    rdfs:range xsd:unsignedByte .

nrfreqrel3gpp:NRFreqRelation.tReselectionNRSfMedium a rdf:Property ;
    rdfs:label "NRFreqRelation.tReselectionNRSfMedium" ;
