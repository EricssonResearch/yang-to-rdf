nrfreqrel3gpp:NRFreqRelation.tReselectionNr a rdf:Property ;
    rdfs:label "NRFreqRelation.tReselectionNr" ;
    rdfs:comment "Cell reselection timer for NR." ;
    rdfs:domain nrfreqrel3gpp:NRFreqRelation ;
