@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> a rdfs:Class ;
    rdfs:comment """Together with the target NRFrequency, it represents the
frequency properties applicable to the referencing NRFreqRelation.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-nr-nrm-redcapaccess/CellReselectionRedcap> .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation> a owl:Ontology ;
    owl:versionInfo "revision 2025-11-07 (CR-1640)" .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/blockListEntry> a rdf:Property ;
    rdfs:comment """A list of Physical Cell Identities (PCIs) that are
blocklisted in NR measurements.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/blockListEntryIdleMode> a rdf:Property ;
    rdfs:comment """A list of Physical Cell Identities (PCIs) that are
blocklisted in SIB4 and SIB5.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/cellReselectionPriority> a rdf:Property ;
    rdfs:comment """The absolute priority of the carrier frequency used by the
cell reselection procedure. Value 0 means lowest priority. The value
must not already used by other RAT, i.e. equal priorities between RATs
are not supported. The UE behaviour when no value is entered is
specified in subclause 5.2.4.1 of 3GPP TS 38.304.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/cellReselectionRedcap> a owl:ObjectProperty ;
    rdfs:comment """This attribute indicates the configuration parameters
to allow relaxation of RRM measurement requirements for redcap UE
cell reselection""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-redcapaccess/CellReselectionRedcap> .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/cellReselectionSubPriority> a rdf:Property ;
    rdfs:comment """Indicates a fractional value to be added to the value of
cellReselectionPriority to obtain the absolute priority of the
concerned carrier frequency for E-UTRA and NR.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/nRFrequencyRef> a owl:ObjectProperty ;
    rdfs:comment "Reference to a corresponding NRFrequency instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/pMax> a rdf:Property ;
    rdfs:comment """Used for calculation of the parameter Pcompensation
(defined in 3GPP TS 38.304), at cell reselection to a cell.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/qOffsetFreq> a rdf:Property ;
    rdfs:comment """The frequency specific offset applied when evaluating
candidates for cell reselection.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:byte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/qQualMin> a rdf:Property ;
    rdfs:comment """Indicates the minimum required quality level in the cell.
Value 0 means that it is not sent and UE applies in such case the
(default) value of negative infinity for Qqualmin. Sent in SIB3 or
SIB5.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/qRxLevMin> a rdf:Property ;
    rdfs:comment """Indicates the required minimum received Reference Symbol
Received Power (RSRP) level in the NR frequency for cell reselection.
Broadcast in SIB3 or SIB5, depending on whether the related frequency
is intra- or inter-frequency. Resolution is 2.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/rsrpOffsetCsiRs> a rdf:Property ;
    rdfs:comment "Offset value of rsrpOffsetCSI-RS." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:byte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/rsrpOffsetSsb> a rdf:Property ;
    rdfs:comment "Offset value of rsrpOffsetSSB." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:byte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/rsrqOffsetCsiRs> a rdf:Property ;
    rdfs:comment "Offset value of rsrqOffsetCSI-RS." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:byte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/rsrqOffsetSsb> a rdf:Property ;
    rdfs:comment "Offset value of rsrqOffsetSSB." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:byte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/sinrOffsetCsiRs> a rdf:Property ;
    rdfs:comment "Offset value of sinrOffsetCSI-RS." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:byte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/sinrOffsetSsb> a rdf:Property ;
    rdfs:comment "Offset value of sinrOffsetSSB." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:byte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/tReselectionNR> a rdf:Property ;
    rdfs:comment "Cell reselection timer for NR." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/tReselectionNRSfHigh> a rdf:Property ;
    rdfs:comment """The attribute tReselectionNr (parameter TreselectionNR in
3GPP TS 38.304) is multiplied with this scaling factor if the UE is
in high mobility state.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/tReselectionNRSfMedium> a rdf:Property ;
    rdfs:comment """The attribute tReselectionNr (parameter TreselectionNR in
3GPP TS 38.304) multiplied with this scaling factor if the UE is in
medium mobility state.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/threshXHighP> a rdf:Property ;
    rdfs:comment """Specifies the Srxlev threshold used by the UE when
reselecting towards a higher priority RAT/frequency than the current
serving frequency. Each frequency of NR and E-UTRAN might have a
specific threshold. Resolution is 2.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/threshXHighQ> a rdf:Property ;
    rdfs:comment """Specifies the Squal threshold used by the UE when
reselecting towards a higher priority RAT/frequency than the current
serving frequency. Each frequency of NR and E-UTRAN might have a
specific threshold.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/threshXLowP> a rdf:Property ;
    rdfs:comment """Specifies the Srxlev threshold used by the UE when
reselecting towards a lower priority RAT/frequency than the current
serving frequency. Each frequency of NR and E-UTRAN might have a
specific threshold. Resolution is 2.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation/threshXLowQ> a rdf:Property ;
    rdfs:comment """Specifies the Squal threshold used by the UE when
reselecting towards a lower priority RAT/frequency than the current
serving frequency. Each frequency of NR and E-UTRAN might have a
specific threshold.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
    rdfs:range xsd:int .

