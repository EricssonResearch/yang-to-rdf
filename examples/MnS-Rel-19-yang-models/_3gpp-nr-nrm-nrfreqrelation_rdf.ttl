nrfreqrel3gpp:NRFreqRelation a rdfs:Class ;
    rdfs:label "NRFreqRelation" ;
    rdfs:comment """Together with the target NRFrequency, it represents the
frequency properties applicable to the referencing NRFreqRelation.""" ;
    y2r:hasAttribute redcap3gpp:CellReselectionRedcap .

<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nrfreqrelation> a owl:Ontology ;
