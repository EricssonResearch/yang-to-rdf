nfs3gpp-shapes:CallbackUriPrefixItem a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It indicates the optional path segment(s) used to
construct the prefix of the Callback URIs during the reselection
of an NF service consumer.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nfs3gpp:CallbackUriPrefixItem.callbackUriPrefix ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """List of notification type values using the callback
URI prefix of the callbackUriPrefix.""" ;
            sh:path nfs3gpp:CallbackUriPrefixItem.notificationTypes ] ;
    sh:targetClass nfs3gpp:CallbackUriPrefixItem .

