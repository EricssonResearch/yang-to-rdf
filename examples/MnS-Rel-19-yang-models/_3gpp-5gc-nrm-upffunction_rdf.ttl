upf3gpp:AtsssCapability.atsssLL a rdf:Property ;
    rdfs:label "AtsssCapability.atsssLL" ;
    rdfs:comment """Indicates the ATSSS-LL capability to support procedures
related to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
    rdfs:domain upf3gpp:AtsssCapability ;
    rdfs:range xsd:boolean .

upf3gpp:AtsssCapability.mptcp a rdf:Property ;
    rdfs:label "AtsssCapability.mptcp" ;
    rdfs:comment """Indicates the MPTCP capability to support procedures related
to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
    rdfs:domain upf3gpp:AtsssCapability ;
    rdfs:range xsd:boolean .

upf3gpp:AtsssCapability.rttWithoutPmf a rdf:Property ;
    rdfs:label "AtsssCapability.rttWithoutPmf" ;
    rdfs:comment """Indicates whether the UPF supports RTT measurement without
PMF (see clauses 5.32.2, 6.3.3.3 of TS 23.501).
true: Supported
false: Not Supported""" ;
    rdfs:domain upf3gpp:AtsssCapability ;
    rdfs:range xsd:boolean .

upf3gpp:DnnUpfInfoItem.dnaiList a rdf:Property ;
    rdfs:label "DnnUpfInfoItem.dnaiList" ;
    rdfs:comment """List of Data network access identifiers supported
by the UPF for this DNN.
The absence of this attribute indicates that the UPF
can be selected for this DNN for any DNAI.""" ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:DnnUpfInfoItem.dnaiNwInstanceList a rdf:Property ;
    rdfs:label "DnnUpfInfoItem.dnaiNwInstanceList" ;
    rdfs:comment """This attribute represents a map of a network instance per
DNAI for the DNN, where the key of the map is the DNAI (Data network
access identifier), see TS 23.501.

When present, the value of each entry of the map shall contain a N6
network instance that is configured for the DNAI indicated by the key.""" ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:DnnUpfInfoItem.dnn a rdf:Property ;
    rdfs:label "DnnUpfInfoItem.dnn" ;
    rdfs:comment "String representing a Data Network." ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:DnnUpfInfoItem.ipv4AddressRanges a owl:ObjectProperty ;
    rdfs:label "DnnUpfInfoItem.ipv4AddressRanges" ;
    rdfs:comment """This attribute represents a list of ranges of IPv4 addresses
handled by UPF. """ ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range upf3gpp:ipv4AddressRanges .

upf3gpp:DnnUpfInfoItem.ipv4IndexList a rdf:Property ;
    rdfs:label "DnnUpfInfoItem.ipv4IndexList" ;
    rdfs:comment """This attribute represents a list of Ipv4 Index supported by
the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:DnnUpfInfoItem.ipv6IndexList a rdf:Property ;
    rdfs:label "DnnUpfInfoItem.ipv6IndexList" ;
    rdfs:comment """This attribute represents a list of Ipv6 Index supported
by the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:DnnUpfInfoItem.ipv6PrefixRanges a owl:ObjectProperty ;
    rdfs:label "DnnUpfInfoItem.ipv6PrefixRanges" ;
    rdfs:comment """This attribute represents a list of ranges of IPv6 prefixes
handled by the UPF. """ ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range upf3gpp:ipv6PrefixRanges .

upf3gpp:DnnUpfInfoItem.natedIpv4AddressRanges a owl:ObjectProperty ;
    rdfs:label "DnnUpfInfoItem.natedIpv4AddressRanges" ;
    rdfs:comment """This attribute represents a list of ranges of NATed IPv4
addresses.""" ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range upf3gpp:natedIpv4AddressRanges .

upf3gpp:DnnUpfInfoItem.natedIpv6PrefixRanges a owl:ObjectProperty ;
    rdfs:label "DnnUpfInfoItem.natedIpv6PrefixRanges" ;
    rdfs:comment """This attribute represents a list of ranges of NATed IPv6
prefixes.""" ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range upf3gpp:natedIpv6PrefixRanges .

upf3gpp:DnnUpfInfoItem.networkInstance a rdf:Property ;
    rdfs:label "DnnUpfInfoItem.networkInstance" ;
    rdfs:comment """This attribute represents the N6 Network Instance
(See TS 29.244) associated with the S-NSSAI and DNN.""" ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:DnnUpfInfoItem.pduSessionTypes a rdf:Property ;
    rdfs:label "DnnUpfInfoItem.pduSessionTypes" ;
    rdfs:comment """List of PDU session type(s) supported by
the UPF for a specific DNN.""" ;
    rdfs:domain upf3gpp:DnnUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:File.fileCompression a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.fileCompression" ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:File.fileContent a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.fileContent" ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:base64Binary ;
    y2r:isInvariant true .

upf3gpp:File.fileDataType a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.fileDataType" ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:File.fileExpirationTime a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.fileExpirationTime" ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:File.fileFormat a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.fileFormat" ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:File.fileLocation a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.fileLocation" ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:File.fileReadyTime a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.fileReadyTime" ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:File.fileSize a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.fileSize" ;
    rdfs:comment "Size of the file" ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:unsignedLong ;
    y2r:isInvariant true .

upf3gpp:File.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:string .

upf3gpp:File.jobId a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.jobId" ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain upf3gpp:File ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:File.jobRef a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:File.jobRef" ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain upf3gpp:File ;
    y2r:isInvariant true ;
    y2r:isReference true .

upf3gpp:Files.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:Files.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain upf3gpp:Files ;
    rdfs:range xsd:string .

upf3gpp:Files.jobId a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:Files.jobId" ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain upf3gpp:Files ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:Files.jobRef a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:Files.jobRef" ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain upf3gpp:Files ;
    y2r:isInvariant true ;
    y2r:isReference true .

upf3gpp:Files.numberOfFiles a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:Files.numberOfFiles" ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain upf3gpp:Files ;
    rdfs:range xsd:unsignedLong .

upf3gpp:InterfaceUpfInfoItem.fqdn a rdf:Property ;
    rdfs:label "InterfaceUpfInfoItem.fqdn" ;
    rdfs:comment """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
    rdfs:domain upf3gpp:InterfaceUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:InterfaceUpfInfoItem.interfaceType a rdf:Property ;
    rdfs:label "InterfaceUpfInfoItem.interfaceType" ;
    rdfs:comment """User Plane interface type.
See TS 29.510[23] clause 6.1.6.3.9""" ;
    rdfs:domain upf3gpp:InterfaceUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:InterfaceUpfInfoItem.ipv4EndpointAddresses a rdf:Property ;
    rdfs:label "InterfaceUpfInfoItem.ipv4EndpointAddresses" ;
    rdfs:comment """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
    rdfs:domain upf3gpp:InterfaceUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:InterfaceUpfInfoItem.ipv6EndpointAddresses a rdf:Property ;
    rdfs:label "InterfaceUpfInfoItem.ipv6EndpointAddresses" ;
    rdfs:comment """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
    rdfs:domain upf3gpp:InterfaceUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:InterfaceUpfInfoItem.networkInstance a rdf:Property ;
    rdfs:label "InterfaceUpfInfoItem.networkInstance" ;
    rdfs:comment """Network Instance (See TS 29.244) associated to the User
Plane interface""" ;
    rdfs:domain upf3gpp:InterfaceUpfInfoItem ;
    rdfs:range xsd:string .

upf3gpp:ManagedNFService.administrativeState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ManagedNFService.administrativeState" ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain upf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

upf3gpp:ManagedNFService.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ManagedNFService.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain upf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

upf3gpp:ManagedNFService.nFServiceType a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ManagedNFService.nFServiceType" ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain upf3gpp:ManagedNFService ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:ManagedNFService.operationalState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ManagedNFService.operationalState" ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain upf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

upf3gpp:ManagedNFService.operations a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ManagedNFService.operations" ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain upf3gpp:ManagedNFService ;
    rdfs:range mf3gpp:Operation .

upf3gpp:ManagedNFService.registrationState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ManagedNFService.registrationState" ;
    rdfs:domain upf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

upf3gpp:ManagedNFService.sAP a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ManagedNFService.sAP" ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain upf3gpp:ManagedNFService ;
    rdfs:range types3gpp:SAP .

upf3gpp:ManagedNFService.usageState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ManagedNFService.usageState" ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain upf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

upf3gpp:ManagedNFService.userLabel a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ManagedNFService.userLabel" ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain upf3gpp:ManagedNFService ;
    rdfs:range xsd:string .

upf3gpp:PduSessionType a rdfs:Datatype ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PduSessionType" .

upf3gpp:PerfMetricJob._linkToFiles a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob._linkToFiles" ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:PerfMetricJob.administrativeState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.administrativeState" ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

upf3gpp:PerfMetricJob.conditionMonitorRef a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.conditionMonitorRef" ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    y2r:isReference true .

upf3gpp:PerfMetricJob.fileLocation a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.fileLocation" ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

upf3gpp:PerfMetricJob.fileReportingPeriod a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.fileReportingPeriod" ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:unsignedInt .

upf3gpp:PerfMetricJob.granularityPeriod a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.granularityPeriod" ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:unsignedInt .

upf3gpp:PerfMetricJob.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

upf3gpp:PerfMetricJob.jobId a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.jobId" ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:PerfMetricJob.notificationRecipientAddress a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.notificationRecipientAddress" ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

upf3gpp:PerfMetricJob.objectInstances a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.objectInstances" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    y2r:isReference true .

upf3gpp:PerfMetricJob.operationalState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.operationalState" ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

upf3gpp:PerfMetricJob.performanceMetrics a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.performanceMetrics" ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

upf3gpp:PerfMetricJob.rootObjectInstances a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.rootObjectInstances" ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    y2r:isReference true .

upf3gpp:PerfMetricJob.schedulerRef a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.schedulerRef" ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    y2r:isReference true .

upf3gpp:PerfMetricJob.streamTarget a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:PerfMetricJob.streamTarget" ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain upf3gpp:PerfMetricJob ;
    rdfs:range xsd:string .

upf3gpp:SnssaiUpfInfoItem.dnnUpfInfoList a owl:ObjectProperty ;
    rdfs:label "SnssaiUpfInfoItem.dnnUpfInfoList" ;
    rdfs:comment """It represents list of parameters supported by the UPF
per DNN.""" ;
    rdfs:domain upf3gpp:SnssaiUpfInfoItem ;
    rdfs:range upf3gpp:DnnUpfInfoItem .

upf3gpp:SnssaiUpfInfoItem.dnnUpfInfoListId a rdf:Property ;
    rdfs:label "SnssaiUpfInfoItem.dnnUpfInfoListId" ;
    rdfs:comment "Identifier of the DNN UPF Info List." ;
    rdfs:domain upf3gpp:SnssaiUpfInfoItem ;
    rdfs:range xsd:unsignedInt .

upf3gpp:SnssaiUpfInfoItem.redundantTransport a rdf:Property ;
    rdfs:label "SnssaiUpfInfoItem.redundantTransport" ;
    rdfs:comment """This attribute indicates whether the UPF supports redundant
transport path on the transport layer in the corresponding network
slice.
true: supported
false: not supported""" ;
    rdfs:domain upf3gpp:SnssaiUpfInfoItem ;
    rdfs:range xsd:boolean .

upf3gpp:SnssaiUpfInfoItem.sNssai a owl:ObjectProperty ;
    rdfs:label "SnssaiUpfInfoItem.sNssai" ;
    rdfs:comment "Supported S-NSSAI." ;
    rdfs:domain upf3gpp:SnssaiUpfInfoItem ;
    rdfs:range types5g3gpp:ExtSnssai .

upf3gpp:StmCtrl.administrativeState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:StmCtrl.administrativeState" ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain upf3gpp:StmCtrl ;
    rdfs:range xsd:string .

upf3gpp:StmCtrl.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:StmCtrl.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain upf3gpp:StmCtrl ;
    rdfs:range xsd:string .

upf3gpp:StmCtrl.operationalState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:StmCtrl.operationalState" ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain upf3gpp:StmCtrl ;
    rdfs:range xsd:string .

upf3gpp:StmCtrl.reportingNFList a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:StmCtrl.reportingNFList" ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain upf3gpp:StmCtrl ;
    y2r:isReference true .

upf3gpp:StmCtrl.stmTargetUri a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:StmCtrl.stmTargetUri" ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain upf3gpp:StmCtrl ;
    rdfs:range xsd:string .

upf3gpp:StmCtrl.targetInterfaceInfoList a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:StmCtrl.targetInterfaceInfoList" ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain upf3gpp:StmCtrl ;
    rdfs:range stm3gpp:NetworkInterface .

upf3gpp:SupportedPerfMetricGroups.granularityPeriods a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:SupportedPerfMetricGroups.granularityPeriods" ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain upf3gpp:SupportedPerfMetricGroups ;
    rdfs:range xsd:unsignedInt .

upf3gpp:SupportedPerfMetricGroups.performanceMetrics a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:SupportedPerfMetricGroups.performanceMetrics" ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain upf3gpp:SupportedPerfMetricGroups ;
    rdfs:range xsd:string .

upf3gpp:SupportedPerfMetricGroups.reportingMethods a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:SupportedPerfMetricGroups.reportingMethods" ;
    rdfs:domain upf3gpp:SupportedPerfMetricGroups ;
    rdfs:range xsd:string .

upf3gpp:SupportedPerfMetricGroups.reportingPeriods a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:SupportedPerfMetricGroups.reportingPeriods" ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain upf3gpp:SupportedPerfMetricGroups ;
    rdfs:range xsd:unsignedInt .

upf3gpp:ThresholdMonitor.administrativeState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ThresholdMonitor.administrativeState" ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain upf3gpp:ThresholdMonitor ;
    rdfs:range xsd:string .

upf3gpp:ThresholdMonitor.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ThresholdMonitor.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain upf3gpp:ThresholdMonitor ;
    rdfs:range xsd:string .

upf3gpp:ThresholdMonitor.monitorGranularityPeriod a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ThresholdMonitor.monitorGranularityPeriod" ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain upf3gpp:ThresholdMonitor ;
    rdfs:range xsd:unsignedInt .

upf3gpp:ThresholdMonitor.objectInstances a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ThresholdMonitor.objectInstances" ;
    rdfs:domain upf3gpp:ThresholdMonitor ;
    y2r:isReference true .

upf3gpp:ThresholdMonitor.operationalState a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ThresholdMonitor.operationalState" ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain upf3gpp:ThresholdMonitor ;
    rdfs:range xsd:string .

upf3gpp:ThresholdMonitor.rootObjectInstances a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ThresholdMonitor.rootObjectInstances" ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain upf3gpp:ThresholdMonitor ;
    y2r:isReference true .

upf3gpp:ThresholdMonitor.thresholdInfoList a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ThresholdMonitor.thresholdInfoList" ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain upf3gpp:ThresholdMonitor ;
    rdfs:range meas3gpp:ThresholdInfo .

upf3gpp:TraceJob.id a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range xsd:string .

upf3gpp:TraceJob.jobId a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.jobId" ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:TraceJob.jobType a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.jobType" ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range xsd:string .

upf3gpp:TraceJob.listOfTraceMetrics a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.listOfTraceMetrics" ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range xsd:string .

upf3gpp:TraceJob.mdtConfig a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.mdtConfig" ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed. For NTN MDT, if the list of plmnList is included, it will
only log measurements for the cells belonging to the listed PLMNs.""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range trace3gpp:MdtConfig .

upf3gpp:TraceJob.nPNTarget a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.nPNTarget" ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range types3gpp:NpnId .

upf3gpp:TraceJob.pLMNTarget a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.pLMNTarget" ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range upf3gpp:pLMNTarget .

upf3gpp:TraceJob.rrcReportType a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.rrcReportType" ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range xsd:string .

upf3gpp:TraceJob.traceCollectionEntityIPAddress a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.traceCollectionEntityIPAddress" ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range xsd:string .

upf3gpp:TraceJob.traceConfig a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.traceConfig" ;
    rdfs:comment "Trace config" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range trace3gpp:TraceConfig .

upf3gpp:TraceJob.traceReference a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.traceReference" ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range trace3gpp:TraceReference .

upf3gpp:TraceJob.traceReportingConsumerUri a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.traceReportingConsumerUri" ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range xsd:string .

upf3gpp:TraceJob.traceReportingFormat a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.traceReportingFormat" ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range xsd:string .

upf3gpp:TraceJob.traceTarget a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.traceTarget" ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range upf3gpp:traceTarget .

upf3gpp:TraceJob.ueCoreMeasConfig a owl:ObjectProperty ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:TraceJob.ueCoreMeasConfig" ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain upf3gpp:TraceJob ;
    rdfs:range trace3gpp:UECoreMeasConfig .

upf3gpp:UPFFunction.SupportedPerfMetricGroups a owl:ObjectProperty ;
    rdfs:label "UPFFunction.SupportedPerfMetricGroups" ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range upf3gpp:SupportedPerfMetricGroups .

upf3gpp:UPFFunction.cNSIIdList a rdf:Property ;
    rdfs:label "UPFFunction.cNSIIdList" ;
    rdfs:comment """It is a set of NSI ID. NSI ID is an identifier for
identifying the Core Network part of a Network Slice instance when
multiple Network Slice instances of the same Network Slice are deployed,
and there is a need to differentiate between them in the 5GC.
See NSI ID definition in clause 3.1 of TS 23.501 and
subclause 6.1.6.2.7 of  TS 29.531. """ ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string .

upf3gpp:UPFFunction.energySavingControl a rdf:Property ;
    rdfs:label "UPFFunction.energySavingControl" ;
    rdfs:comment """This attribute allows management system to initiate energy
saving activation or deactivation for the edge UPF.""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string .

upf3gpp:UPFFunction.energySavingState a rdf:Property ;
    rdfs:label "UPFFunction.energySavingState" ;
    rdfs:comment """This attribute specifies the status regarding the energy
saving in the edge UPF.

If the value of energySavingControl is TO_BE_ENERGYSAVING, then it
shall be tried to achieve the value IS_ENERGYSAVING for the
energySavingState.

If the value of energySavingControl is TO_BE_NOT_ENERGYSAVING, then
it shall be tried to achieve the value IS_NOT_ENERGYSAVING for the
energySavingState. """ ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string .

upf3gpp:UPFFunction.id a rdf:Property ;
    rdfs:label "UPFFunction.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string .

upf3gpp:UPFFunction.isOnboardSatellite a rdf:Property ;
    rdfs:label "UPFFunction.isOnboardSatellite" ;
    rdfs:comment """This attribute indicates whether the function is
on board the satellite.""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:boolean ;
    y2r:isInvariant true .

upf3gpp:UPFFunction.managedNFProfile a owl:ObjectProperty ;
    rdfs:label "UPFFunction.managedNFProfile" ;
    rdfs:comment "Profile definition of a Managed NF (See TS 23.501)" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range mnfp3gpp:ManagedNFProfile .

upf3gpp:UPFFunction.nRTACList a rdf:Property ;
    rdfs:label "UPFFunction.nRTACList" ;
    rdfs:comment """List of Tracking Area Codes (legacy TAC or extended TAC)
where the represented management function is serving.""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string .

upf3gpp:UPFFunction.onboardSatelliteId a rdf:Property ;
    rdfs:label "UPFFunction.onboardSatelliteId" ;
    rdfs:comment """This attribute indicates the onboard satellite Id.
It shall be formatted as a fixed 5-digit string, padding with
leading digits '0' to complete a 5-digit length.""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:UPFFunction.pLMNIdList a owl:ObjectProperty ;
    rdfs:label "UPFFunction.pLMNIdList" ;
    rdfs:comment """A list of PLMN identifiers (Mobile Country Code and Mobile
Network Code).""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range upf3gpp:pLMNIdList .

upf3gpp:UPFFunction.peeParameterslist a owl:ObjectProperty ;
    rdfs:label "UPFFunction.peeParameterslist" ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range mf3gpp:PeeParameters .

upf3gpp:UPFFunction.priorityLabel a rdf:Property ;
    rdfs:label "UPFFunction.priorityLabel" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:unsignedInt .

upf3gpp:UPFFunction.supportedBMOList a rdf:Property ;
    rdfs:label "UPFFunction.supportedBMOList" ;
    rdfs:comment """List of supported BMOs (Bridge Managed Objects) required
for integration with TSN system.""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string .

upf3gpp:UPFFunction.supportedTraceMetrics a rdf:Property ;
    rdfs:label "UPFFunction.supportedTraceMetrics" ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string .

upf3gpp:UPFFunction.uPFCapabilities a rdf:Property ;
    rdfs:label "UPFFunction.uPFCapabilities" ;
    rdfs:comment """It indicates the operator configurable capability supported
by the UPF.  (see clause 5.8.2.21 in TS 23.501, clause 5.4.2
in TS 29.571)""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

upf3gpp:UPFFunction.upfInfo a owl:ObjectProperty ;
    rdfs:label "UPFFunction.upfInfo" ;
    rdfs:comment """This attribute represents information of an UPF NF Instance.
Multiple upfInfo may be allowed to define different TAI list for each
supported S-NSSAI""" ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range upf3gpp:UpfInfo .

upf3gpp:UPFFunction.userLabel a rdf:Property ;
    rdfs:label "UPFFunction.userLabel" ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range xsd:string .

upf3gpp:UPFFunction.vnfParametersList a owl:ObjectProperty ;
    rdfs:label "UPFFunction.vnfParametersList" ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain upf3gpp:UPFFunction ;
    rdfs:range mf3gpp:VnfParameters .

upf3gpp:UPInterfaceType a rdfs:Datatype ;
    rdfs:label "UPInterfaceType" .

upf3gpp:UpfInfo.atsssCapability a owl:ObjectProperty ;
    rdfs:label "UpfInfo.atsssCapability" ;
    rdfs:comment "Indicate the ATSSS capability of the UPF" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range upf3gpp:AtsssCapability .

upf3gpp:UpfInfo.dataForwarding a rdf:Property ;
    rdfs:label "UpfInfo.dataForwarding" ;
    rdfs:comment """Indicates whether the UPF is configured for data forwarding.
Based on operator policies, if dedicated UPFs are preferred to be used
for indirect data forwarding during handover scenarios, when setting
up the indirect data forwarding tunnel, the SMF should preferably
select a UPF configured for data forwarding and use the network
instance indicated in the Network Instance ID associated to the
DATA_FORWARDING interface type in the interfaceUpfInfoList attribute.
true: the UPF is configured for data forwarding
false: the UPF is not configured for data forwarding

If the UPF is configured for data forwarding, it shall support UP
network interface with type 'DATA_FORWARDING'.""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:boolean .

upf3gpp:UpfInfo.interfaceUpfInfoList a owl:ObjectProperty ;
    rdfs:label "UpfInfo.interfaceUpfInfoList" ;
    rdfs:comment """List of User Plane interfaces configured on the UPF. When
this parameter is provided in the NF Discovery response, the NF Service
Consumer (e.g., SMF) may use this information for UPF selection.""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range upf3gpp:InterfaceUpfInfoItem .

upf3gpp:UpfInfo.ipups a rdf:Property ;
    rdfs:label "UpfInfo.ipups" ;
    rdfs:comment """Indicates whether the UPF is configured for Inter-PLMN User
Plane Security (IPUPS). Any UPF can support the IPUPS functionality.
In network deployments where specific UPFs are used to provide IPUPS,
UPFs configured for providing IPUPS services shall be selected.
true: The UPF is configured for IPUPS.
false: The UPF is not configured for IPUPS""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:boolean .

upf3gpp:UpfInfo.iwkEpsInd a rdf:Property ;
    rdfs:label "UpfInfo.iwkEpsInd" ;
    rdfs:comment """Indicates whether interworking with EPS is supported by
the UPF.
True: Supported
False: Not Supported""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:boolean .

upf3gpp:UpfInfo.pduSessionTypes a rdf:Property ;
    rdfs:label "UpfInfo.pduSessionTypes" ;
    rdfs:comment "Indicates the type(s) of a PDU session." ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:string .

upf3gpp:UpfInfo.priority a rdf:Property ;
    rdfs:label "UpfInfo.priority" ;
    rdfs:comment """This parameter defines Priority (relative to other NFs of
the same type) in the range of 0-65535, to be used for NF selection;
lower values indicate a higher priority. If priority is also present
in the nfServiceList parameters, those will have precedence over
this value (See TS 29.510).""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:unsignedShort .

upf3gpp:UpfInfo.redundantGtpu a rdf:Property ;
    rdfs:label "UpfInfo.redundantGtpu" ;
    rdfs:comment """Indicates whether the UPF supports redundant GTP-U path.
true: supported
false: not supported""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:boolean .

upf3gpp:UpfInfo.sNssaiUpfInfoList a owl:ObjectProperty ;
    rdfs:label "UpfInfo.sNssaiUpfInfoList" ;
    rdfs:comment """This attribute represents a list of parameters supported by
the UPF per S-NSSAI.""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range upf3gpp:SnssaiUpfInfoItem .

upf3gpp:UpfInfo.smfServingArea a rdf:Property ;
    rdfs:label "UpfInfo.smfServingArea" ;
    rdfs:comment """The SMF service area(s) the UPF can serve. See TS 29.510.
If not provided, the UPF can serve any SMF service area.""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:string .

upf3gpp:UpfInfo.supportedPfcpFeatures a rdf:Property ;
    rdfs:label "UpfInfo.supportedPfcpFeatures" ;
    rdfs:comment """Supported Packet Forwarding Control Protocol (PFCP) Features.
A string used to indicate the PFCP features supported by the UPF,
which encodes the 'UP Function Features' as specified in
Table 8.2.25-1 of TS 29.244 (starting from Octet 5), in hexadecimal
representation.

Each character in the string shall take a value of '0' to '9', 'a'
to 'f' or 'A' to 'F' and each two characters shall represent one octet
of 'UP Function Features' (starting from Octet 5, to higher octets).
For each two characters representing one octet, the first character
representing the 4 most significant bits of the octet and the second
character the 4 least significant bits of the octet.

The supported PFCP features shall be provisioned in addition and be
consistent with the existing UPF features (atsssCapability, ueIpAddrInd,
redundantGtpu and ipups), e.g., if the ueIpAddrInd is set to 'true',
then the UEIP flag shall also be set to '1' in the supported PFCP
features.""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:string .

upf3gpp:UpfInfo.sxaInd a rdf:Property ;
    rdfs:label "UpfInfo.sxaInd" ;
    rdfs:comment """This attribute indicates whether the UPF is configured to
support Sxa interface.
true: Supported
false: Not Supported""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:boolean .

upf3gpp:UpfInfo.taiList a owl:ObjectProperty ;
    rdfs:label "UpfInfo.taiList" ;
    rdfs:comment "The list of TAIs." ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range types3gpp:Tai .

upf3gpp:UpfInfo.taiRangeList a owl:ObjectProperty ;
    rdfs:label "UpfInfo.taiRangeList" ;
    rdfs:comment "The range of TAIs." ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range types5g3gpp:TaiRange .

upf3gpp:UpfInfo.tngfInfo a owl:ObjectProperty ;
    rdfs:label "UpfInfo.tngfInfo" ;
    rdfs:comment """Indicate that the UPF is collocated with TNGF. If not
present, the UPF is not collocated with Trusted Non-3GPP Gateway
Function (TNGF).""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range types5g3gpp:IpInterface .

upf3gpp:UpfInfo.twifInfo a owl:ObjectProperty ;
    rdfs:label "UpfInfo.twifInfo" ;
    rdfs:comment """Indicate that the UPF is collocated with TWIF. If not
present, the UPF is not collocated with Trusted WLAN Interworking
Function (TWIF).""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range types5g3gpp:IpInterface .

upf3gpp:UpfInfo.ueIpAddrInd a rdf:Property ;
    rdfs:label "UpfInfo.ueIpAddrInd" ;
    rdfs:comment """Indicates whether the UPF supports allocating UE IP
addresses/prefixes.
true: supported
false: not supported""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range xsd:boolean .

upf3gpp:UpfInfo.wAgfInfo a owl:ObjectProperty ;
    rdfs:label "UpfInfo.wAgfInfo" ;
    rdfs:comment """Indicate that the UPF is collocated with W-AGF. If not
present, the UPF is not collocated with Wireline Access Gateway
Function (W-AGF).""" ;
    rdfs:domain upf3gpp:UpfInfo ;
    rdfs:range types5g3gpp:IpInterface .

upf3gpp:ipv4AddressRanges.end a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ipv4AddressRanges.end" ;
    rdfs:domain upf3gpp:ipv4AddressRanges ;
    rdfs:range xsd:string .

upf3gpp:ipv4AddressRanges.start a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ipv4AddressRanges.start" ;
    rdfs:domain upf3gpp:ipv4AddressRanges ;
    rdfs:range xsd:string .

upf3gpp:ipv6PrefixRanges.end a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ipv6PrefixRanges.end" ;
    rdfs:domain upf3gpp:ipv6PrefixRanges ;
    rdfs:range xsd:string .

upf3gpp:ipv6PrefixRanges.start a rdf:Property ;
    rdfs:label "_3gpp-5gc-nrm-upffunction:ipv6PrefixRanges.start" ;
    rdfs:domain upf3gpp:ipv6PrefixRanges ;
    rdfs:range xsd:string .

upf3gpp:natedIpv4AddressRanges.end a rdf:Property ;
    rdfs:label "natedIpv4AddressRanges.end" ;
    rdfs:domain upf3gpp:natedIpv4AddressRanges ;
    rdfs:range xsd:string .

upf3gpp:natedIpv4AddressRanges.start a rdf:Property ;
    rdfs:label "natedIpv4AddressRanges.start" ;
    rdfs:domain upf3gpp:natedIpv4AddressRanges ;
    rdfs:range xsd:string .

upf3gpp:natedIpv6PrefixRanges.end a rdf:Property ;
    rdfs:label "natedIpv6PrefixRanges.end" ;
    rdfs:domain upf3gpp:natedIpv6PrefixRanges ;
    rdfs:range xsd:string .

upf3gpp:natedIpv6PrefixRanges.start a rdf:Property ;
