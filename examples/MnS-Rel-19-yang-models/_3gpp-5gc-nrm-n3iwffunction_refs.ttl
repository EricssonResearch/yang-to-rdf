<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-n3iwffunction> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-n3iwffunction" ;
    dcterms:description """This IOC represents the N3IWF function which is used to enable
non-3GPP access networks connected to the 5GC. For more information about the
N3IWF, see 3GPP TS 23.501. Copyright 2023, 3GPP Organizational Partners
(ARIB, ATIS, CCSA, ETSI, TSDSI, TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-n3iwffunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-07-25 (CR-1558)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-n3iwffunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction> .

