    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ADMFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ADMFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """It is used to indicate the FQDN of the registered NF instance
in service-based interface, for example, NF instance FQDN structure is:
nftype<nfnum>.slicetype<sliceid>.mnc<MNC>.mcc<MCC>.3gppnetwork.org""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ADMFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ADMFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ADMFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ADMFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ADMFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ADMFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ADMFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/aIOTgNBInfo> a owl:ObjectProperty ;
    rdfs:comment """It represents the information that a AIOTF needs for
selecting the NG-RAN i.e.of gNB supporting Ambient-IoT service,
which includes gNB ID, served NG-RAN A-IoT area and the information
of served Readers of the gNB.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIoTgNBInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "This parameter defines profile for managed NF" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/pLMNId> a owl:ObjectProperty ;
    rdfs:comment "Represents a PLMN Identity." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """It is used to indicate the FQDN of the registered NF instance
in service-based interface, for example, NF instance FQDN structure is:
nftype<nfnum>.slicetype<sliceid>.mnc<MNC>.mcc<MCC>.3gppnetwork.org""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIOTFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIoTgNBInfo/gNBId> a rdf:Property ;
    rdfs:comment "It identifies a gNB within a PLMN" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIoTgNBInfo> ;
    rdfs:range xsd:long .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIoTgNBInfo/servedReaderInfoList> a owl:ObjectProperty ;
    rdfs:comment """Represents the information of served Readers of a gNB,
which includes the reader ID (indexes), served A-IoT areas of the RAN
and Reader and optionally the Reader location.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/AIoTgNBInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedReaderInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID/aIotAreaCode> a rdf:Property ;
    rdfs:comment """This specifies the identity of the A-IoT Area Code which is
one of the components of A-IoT Area ID. It's a 3-octet string defined
in TS 38.413.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID/nID> a rdf:Property ;
    rdfs:comment """Network Identity; Shall be present if PlmnIdNid identifies
an SNPN (see clauses 5.30.2.3, 5.30.2.9, 6.3.4, and 6.3.8 in 3GPP
TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID/pLMNId> a owl:ObjectProperty ;
    rdfs:comment "It defines which PLMN that can be served by the AIOT reader." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedReaderInfo/readerId> a rdf:Property ;
    rdfs:comment """It defines the reader identifier to uniquely identify a
reader within a gNB.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedReaderInfo> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedReaderInfo/readerLocation> a rdf:Property ;
    rdfs:comment """This specifies the geographical location of a A-IoT reader.
Reader Location may represent any of latitude/longitude, or any
geographical location/coordinate/area polygon.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedReaderInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedReaderInfo/servedAIOTAreas> a owl:ObjectProperty ;
    rdfs:comment """This attribute is used to specify the A-IoT areas supported
by the A-IoT reader. It contains one or multiple A-IoT Area ID, which
is used to uniquely identify an A-IoT Area.

A-IoT Area ID = PLMN ID +NID (optional) + A-IoT Area Code
(OCTET STRING (SIZE(3))), which is defined in TS 38.413.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedReaderInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNId/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNId/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/NTNTimeBasedConfig> a owl:ObjectProperty ;
    rdfs:comment "This is the NTN time-based configuration." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNTimeBasedConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/aMFIdentifier> a owl:ObjectProperty ;
    rdfs:comment """An AMF identifier, comprising an AMF Region ID, an
AMF Set ID and an AMF Pointer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/aMFIdentifier> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/aMFSetRef> a owl:ObjectProperty ;
    rdfs:comment "This is the DN of AMFSet" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/amfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents information of an AMF
NF Instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/cNSIIdList> a rdf:Property ;
    rdfs:comment """It is a set of NSI ID. NSI ID is an identifier for
identifying the Core Network part of a Network Slice instance when
multiple Network Slice instances of the same Network Slice are deployed,
and there is a need to differentiate between them in the 5GC.
See NSI ID definition in clause 3.1 of TS 23.501 and
subclause 6.1.6.2.7 of  TS 29.531""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """Specifies a list of commModel. It can be used by NF and
NF services to interact with each other in 5G Core network """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/mappedCellIdInfoList> a owl:ObjectProperty ;
    rdfs:comment """It provides the list of mapping between GEO area and
Mapped Cell ID.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/MappedCellIdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/mdtUserConsentReqList> a rdf:Property ;
    rdfs:comment """represents a list of MDT measurement names that are
subject to user consent at MDT activation.
Any MDT measurement, whose name is not specified in this list, is not
subject to user consent at MDT activation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/nTNPLMNRestrictionsList> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the location restrictions per PLMN
that relates to non-terrestrial network access.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNPLMNRestrictionsInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/pLMNInfoList> a owl:ObjectProperty ;
    rdfs:comment "It defines the PLMN(s) of a Network Function. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """The FQDN of the registered NF instance in the
service-based interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/satelliteBackhaulInfoList> a owl:ObjectProperty ;
    rdfs:comment """Specifies a list of satellite backhaul information. It can be
used by NF and NF services.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteBackhaulInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/satelliteCoverageInfoList> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the information related to NR
Satellite RAT type and corresponding information of satellite coverage""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteCoverageInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/sliceExpiryInfo> a owl:ObjectProperty ;
    rdfs:comment """This provides information related to a network slice
validity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SliceExpiryInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/amfOnboardingCapability> a rdf:Property ;
    rdfs:comment """This attribute indicates the AMF supports SNPN Onboarding
capability. This is used for the case of Onboarding of UEs for SNPNs
(see TS 23.501, clause 5.30.2.10).
- FALSE: AMF does not support SNPN Onboarding;
- TRUE: AMF supports SNPN Onboarding.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/amfRegionId> a rdf:Property ;
    rdfs:comment """It represents the AMF Region ID, which identifies the
region. AllowedValues: defined in subclause 2.10.1 of 3GPP TS 23.003 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range xsd:long .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/amfSetId> a rdf:Property ;
    rdfs:comment """It represents the AMF Set ID, which is uniquely identifies
the AMF Set within the AMF Region.
allowedValues: defined in subclause 2.10.1 of 3GPP TS 23.003""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range xsd:long .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/backupInfoAmfFailure> a owl:ObjectProperty ;
    rdfs:comment """List of GUAMIs for which the AMF acts as a backup for AMF
failure.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/GUAMInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/backupInfoAmfRemoval> a owl:ObjectProperty ;
    rdfs:comment """List of GUAMIs for which the AMF acts as a backup for
planned AMF removal.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/GUAMInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/gUAMIdList> a owl:ObjectProperty ;
    rdfs:comment "List of supported Globally Unique AMF Ids (GUAMIs)." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/GUAMInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/highLatencyCom> a rdf:Property ;
    rdfs:comment """This attribute indicates whether the AMF supports High
Latency communication (e.g. for NR RedCap UE). This is used for CP NF
to discover AMF supporting High Latency communication (see TS 23.501,
clause 6.3.5).
- FALSE: AMF does not support High Latency communication e.g. for
NR RedCap UE;
- TRUE: AMF supports High Latency communication e.g. for NR RedCap UE;""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/n2InterfaceAmfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents the N2 interface information of
the AMF. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/N2InterfaceAmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/taiList> a owl:ObjectProperty ;
    rdfs:comment "The list of TAIs." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo/taiRangeList> a owl:ObjectProperty ;
    rdfs:comment "The range of TAIs." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/BlockedLocationInfo/blockedDurWindow> a owl:ObjectProperty ;
    rdfs:comment """This provides the time durations for which the PLMN are
not allowed at a given location in case of NTN""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/BlockedLocationInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/BlockedLocationInfo/blockedLocation> a owl:ObjectProperty ;
    rdfs:comment """This provides the geographical location at which the PLMN
are not allowed in case of NTN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/BlockedLocationInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/blockedLocation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/BlockedLocationInfo/blockedSlice> a owl:ObjectProperty ;
    rdfs:comment """This provides the slice for which the access is
not allowed at a given location in case of NTN. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/BlockedLocationInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/blockedSlice> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/GUAMInfo/aMFIdentifier> a rdf:Property ;
    rdfs:comment """The AMFI is constructed from an AMF Region ID, an
AMF Set ID and an AMF Pointer. The AMF Region ID identifies the region,
the AMF Set ID uniquely identifies the AMF Set within the AMF Region,
and the AMF Pointer uniquely identifies the AMF within the AMF Set.
(Ref. 3GPP TS 23.003)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/GUAMInfo> ;
    rdfs:range xsd:long .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/GUAMInfo/pLMNId> a owl:ObjectProperty ;
    rdfs:comment "This attribute represents a PLMN Identity." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/GUAMInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/MappedCellIdInfo/mappedCellId> a owl:ObjectProperty ;
    rdfs:comment """This attribute is in format of NCGI to indicate a fixed
geographical area (See subclause 16.14.5 in TS 38.300""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/MappedCellIdInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/MappedCellIdInfo/ntnGeoArea> a owl:ObjectProperty ;
    rdfs:comment """This attribute indicates a specific geographical location
mapped to Mapped Cell ID(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/MappedCellIdInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/N2InterfaceAmfInfo/amfName> a rdf:Property ;
    rdfs:comment """This attribute represents AMF Name FQDN as defined in
clause 28.3.2.5 of TS 23.003.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/N2InterfaceAmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/N2InterfaceAmfInfo/ipv4EndpointAddress> a rdf:Property ;
    rdfs:comment """This attribute represents available AMF endpoint
IPv4 address(es) for N2.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/N2InterfaceAmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/N2InterfaceAmfInfo/ipv6EndpointAddress> a rdf:Property ;
    rdfs:comment """This attribute represents available AMF endpoint
IPv6 address(es) for N2.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/N2InterfaceAmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID/GlobalRanNodeIDValue> a rdf:Property ;
    rdfs:comment "this relies on the choice of GlobalRanNodeID" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID/GlobalgNBID> a rdf:Property ;
    rdfs:comment "Unique identifier of a gNB." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID> ;
    rdfs:range xsd:long .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID/Globalng-eNBID> a rdf:Property ;
    rdfs:comment """This represents the identifier of
the ng-eNB ID as specified in
clause 9.3.1.8 of 3GPP TS 38.413.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID/N3IWFID> a rdf:Property ;
    rdfs:comment """This IE shall contain the N3IWF
identifier received over NGAP and
shall be encoded as a string of
hexadecimal characters.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID/TNGFID> a rdf:Property ;
    rdfs:comment """This represents the identifier of
the TNGF ID as specified in clause
9.3.1.161 of 3GPP TS 38.413 in hexadecimal
representation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID/TWIFID> a rdf:Property ;
    rdfs:comment """This represents the TWIF identification
as specified in clause
9.3.1.163 of TS 38.413""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID/W-AGFID> a rdf:Property ;
    rdfs:comment """This represents the identifier of
the W-AGF ID as specified in
clause 9.3.1.162 of 3GPP TS 38.413
in hexadecimal representation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID/pLMNId> a owl:ObjectProperty ;
    rdfs:comment """The PLMN Identifier is composed of
a Mobile Country Code (MCC) and
a Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNPLMNRestrictionsInfo/blockedLocationInfoList> a owl:ObjectProperty ;
    rdfs:comment """This defines the information related with the location
for which the access restrictions are to be applied in case of NTN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNPLMNRestrictionsInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/BlockedLocationInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNPLMNRestrictionsInfo/pLMNId> a owl:ObjectProperty ;
    rdfs:comment "This attribute represents a PLMN Identity." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNPLMNRestrictionsInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNTimeBasedConfig/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNTimeBasedConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNTimeBasedConfig/nTNEntityConfigList> a owl:ObjectProperty ;
    rdfs:comment """It contains a list of configuration
updates to be applied to specified NTN entities.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNTimeBasedConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNTimeBasedConfig/timeWindow> a owl:ObjectProperty ;
    rdfs:comment "It defines the time window." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNTimeBasedConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NtnLocationInfo/availabilityWindows> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the list of time windows at which
the satellite coverage will be available for this location.
Either availabilityWindows or nonAvailabilityWindows shall be present.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NtnLocationInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NtnLocationInfo/location> a owl:ObjectProperty ;
    rdfs:comment """This defines the Location (geographical area) under
consideration to which the satellite coverage info belongs""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NtnLocationInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NtnLocationInfo/nonAvailabilityWindows> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the list of time windows at which
the satellite coverage will not be available for this location.
Either availabilityWindows or nonAvailabilityWindows shall be present.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NtnLocationInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteBackhaulInfo/GlobalRanNodeIDValue> a rdf:Property ;
    rdfs:comment "this relies on the choice of GlobalRanNodeID" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteBackhaulInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteBackhaulInfo/geoSatelliteId> a rdf:Property ;
    rdfs:comment "Unique identifier of a GEO satellite." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteBackhaulInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteBackhaulInfo/nTNGlobalRanNodeID> a owl:ObjectProperty ;
    rdfs:comment "Unique identifier of an NG-RAN node." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteBackhaulInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NTNGlobalRanNodeID> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteBackhaulInfo/satelliteBackhaulCategory> a rdf:Property ;
    rdfs:comment """Satellite backhaul category refers to the type of the
satellite used in the backhaul. Only a single backhaul category
can be indicated.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteBackhaulInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteCoverageInfo/locationInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the information about location and
corresponding time windows for which the satellite coverage will be
available or unavailable.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteCoverageInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/NtnLocationInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteCoverageInfo/nRSatelliteRATtype> a rdf:Property ;
    rdfs:comment """This attribute defines the RAT Type for NR satellite
access.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SatelliteCoverageInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SliceExpiryInfo/expiryTime> a rdf:Property ;
    rdfs:comment """This attribute provides information about the time at
which the slice is scheduled to be expired as it is not required
anymore.
This attribute will be set based on the sliceAvailability coming as
part of ServiceProfile.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SliceExpiryInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SliceExpiryInfo/pLMNInfo> a owl:ObjectProperty ;
    rdfs:comment "It defines the PLMN(s) of a Network Function. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SliceExpiryInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/traceTarget> .

