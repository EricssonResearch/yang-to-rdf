    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/aMFIdentifier/amfPointer> a rdf:Property ;
