    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/tacRangeList> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/UTC24TimeOfDayT> a rdfs:Datatype ;
    rdfs:comment """Time of day in HH:MM or H:MM 24-hour format per UTC
time zone.""" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature/featureName> a rdf:Property ;
    rdfs:comment """It is a string representing a proprietary feature
specific to a given vendor.
It is recommended that the case convention for these strings is the
same as for enumerated data types (i.e. UPPER_WITH_UNDERSCORE;
see 3GPP TS 29.501, clause 5.1.1).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature/featureVersion> a rdf:Property ;
    rdfs:comment "It is a string representing the version of the feature." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet/FiveQiDscpMappingSet/fiveQiDscpMappingList> a owl:ObjectProperty ;
    rdfs:comment "It provides the list of mapping between 5QIs and DSCP." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet/FiveQiDscpMappingSet> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet/fiveQiDscpMappingList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet/FiveQiDscpMappingSet/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet/FiveQiDscpMappingSet> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet/fiveQiDscpMappingList/dscp> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet/fiveQiDscpMappingList> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet/fiveQiDscpMappingList/fiveQIValues> a rdf:Property ;
    rdfs:comment " Identifies the 5QI values that are mapped to a same DSCP" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-FiveQiDscpMappingSet/fiveQiDscpMappingList> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds> a owl:ObjectProperty ;
    rdfs:comment """It specifies the thresholds for reporting the packet delay
for the GTO-U path QoS monitoring.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/gtpUPathMeasurementPeriod> a rdf:Property ;
    rdfs:comment """It specifies the period (in seconds) for reporting the packet
delay for GTP-U path QoS monitoring.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/gtpUPathMinimumWaitTime> a rdf:Property ;
    rdfs:comment """It specifies the minimum waiting time (in seconds) between
two consecutive reports for event triggered GTP-U path QoS monitoring
reporting.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/gtpUPathMonitoredSNSSAIs> a owl:ObjectProperty ;
    rdfs:comment """The S-NSSAIs for which the the GTP-U path QoS monitoring is
to be performed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathMonitoredSNSSAIs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/gtpUPathQoSMonitoringState> a rdf:Property ;
    rdfs:comment "The state of GTP-U path QoS monitoring." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/isEventTriggeredGtpUPathMonitoringSupported> a rdf:Property ;
    rdfs:comment """It indicates whether the event triggered GTP-U path QoS
monitoring reporting based on thresholds is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/isImmediateGtpUMonitoringSupported> a rdf:Property ;
    rdfs:comment """It indicates whether the immediate GTP-U path QoS monitoring
reporting is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/isPeriodicGtpUMonitoringSupported> a rdf:Property ;
    rdfs:comment """It indicates whether the periodic GTP-U path QoS monitoring
reporting is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl/monitoredDSCPs> a rdf:Property ;
    rdfs:comment """The DSCPs for which the GTP-U path QoS monitoring is to be
performed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/GtpUPathQoSMonitoringControl> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds/n3AveragePacketDelayThreshold> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds/n3MaxPacketDelayThreshold> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds/n3MinPacketDelayThreshold> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds/n9AveragePacketDelayThreshold> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds/n9MaxPacketDelayThreshold> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds/n9MinPacketDelayThreshold> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathDelayThresholds> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathMonitoredSNSSAIs/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathMonitoredSNSSAIs> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathMonitoredSNSSAIs/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-GtpUPathQoSMonitoringControl/gtpUPathMonitoredSNSSAIs> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFPacketDelayThresholdsType/thresholdDl> a rdf:Property ;
    rdfs:comment "Downlink threshold" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFPacketDelayThresholdsType> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFPacketDelayThresholdsType/thresholdRtt> a rdf:Property ;
    rdfs:comment "Round trip threshold" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFPacketDelayThresholdsType> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFPacketDelayThresholdsType/thresholdUl> a rdf:Property ;
    rdfs:comment "Uplink threshold" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFPacketDelayThresholdsType> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/isEventTriggeredQFMonitoringSupported> a rdf:Property ;
    rdfs:comment """It indicates whether the event based QoS monitoring
reporting per QoS flow per UE is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/isPeriodicQFMonitoringSupported> a rdf:Property ;
    rdfs:comment """It indicates whether the periodic QoS monitoring reporting
per QoS flow per UE is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/isSessionReleasedQFMonitoringSupported> a rdf:Property ;
    rdfs:comment """It indicates whether the session release based QoS monitoring
reporting  per QoS flow per UE is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/qFMeasurementPeriod> a rdf:Property ;
    rdfs:comment """It specifies the period (in seconds) for reporting the
packet delay for QoS monitoring per QoS flow per UE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/qFMinimumWaitTime> a rdf:Property ;
    rdfs:comment """It specifies the minimum waiting time (in seconds) between
two consecutive reports for event triggered QoS monitoring reporting
per QoS flow per UE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/qFMonitored5QIs> a rdf:Property ;
    rdfs:comment """The 5QIs for which the QoS monitoring per QoS flow
per UE is to be performed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/qFMonitoredSNSSAIs> a owl:ObjectProperty ;
    rdfs:comment """The S-NSSAIs for which the QoS monitoring per QoS flow
per UE is to be performed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/qFMonitoredSNSSAIs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/qFPacketDelayThresholds> a owl:ObjectProperty ;
    rdfs:comment """It specifies the thresholds for reporting the packet delay
between PSA and UE for QoS monitoring per QoS flow per UE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFPacketDelayThresholdsType> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl/qFQoSMonitoringState> a rdf:Property ;
    rdfs:comment "The state of QoS monitoring per QoS flow per UE." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/QFQoSMonitoringControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/qFMonitoredSNSSAIs/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/qFMonitoredSNSSAIs> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/qFMonitoredSNSSAIs/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-QFQoSMonitoringControl/qFMonitoredSNSSAIs> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/AFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-affunction/traceTarget> ;
    rdfs:range xsd:string .

