Remote UE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL2UetoNetworkRelay> a rdf:Property ;
    rdfs:comment """Indicates support for ProSe Layer-2
UE-to-Network Relay..""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL2UetoUeRelay> a rdf:Property ;
    rdfs:comment """Indicates support for ProSe Layer-2
UE-to-UE Relay.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL3EndUe> a rdf:Property ;
    rdfs:comment "Indicates support for ProSe Layer-3 End UE." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL3EndUeMultihop> a rdf:Property ;
    rdfs:comment "Indicates support for ProSe Layer-3 End UE Multihop." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL3IntermRelay> a rdf:Property ;
    rdfs:comment """Indicates support for ProSe Layer-3
Intermediate Relay.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL3MultihopRemote> a rdf:Property ;
    rdfs:comment "Indicates support for ProSe Layer-3 Multihop Remote." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL3NetMultihopRelay> a rdf:Property ;
    rdfs:comment """Indicates support for ProSe Layer-3 Network Multihop
Relay.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL3RemoteUe> a rdf:Property ;
    rdfs:comment """Indicates support for ProSe Layer-3
Remote UE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL3UeMultihopRelay> a rdf:Property ;
    rdfs:comment "Indicates support for ProSe Layer-3 UE Multihop Relay." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL3UetoNetworkRelay> a rdf:Property ;
    rdfs:comment """Indicates support for ProSe Layer-3
UE-to-Network Relay.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL3UetoUeRelay> a rdf:Property ;
    rdfs:comment """Indicates support for ProSe Layer-3
UE-to-UE Relay.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/commModelList/commModelConfiguration> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/commModelList/commModelType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/commModelList/groupId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/commModelList> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/commModelList/targetNFServiceList> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/commModelList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo/dnnList> a rdf:Property ;
    rdfs:comment """DNNs supported by the PCF.
If not provided, the PCF can serve any DNN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo/proseCapability> a owl:ObjectProperty ;
    rdfs:comment "It indicates the supported ProSe Capability by the PCF." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo/rxDiamHost> a rdf:Property ;
    rdfs:comment """This IE shall be present if the PCF supports Rx interface.
When present, this IE shall indicate the Diameter host
of the Rx interface for the PCF.
Pattern: '^([A-Za-z0-9]+(-[A-Za-z0-9]+).)+[a-z]{2,}$'.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo/rxDiamRealm> a rdf:Property ;
    rdfs:comment """This IE shall be present if the PCF supports Rx interface.
When present, this IE shall indicate the Diameter realm
of the Rx interface for the PCF.
Pattern: '^([A-Za-z0-9]+(-[A-Za-z0-9]+).)+[a-z]{2,}$'.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo/supiRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of SUPIs that can be served by
the PCF instance. If not provided, the PCF can serve any SUPI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/sNSSAIList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/sNSSAIList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/sNSSAIList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/sNSSAIList> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRuleSet/PredefinedPccRules> a owl:ObjectProperty ;
    rdfs:comment "The list of predefined PCC rules." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRuleSet> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRuleSet/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRuleSet> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/accessType> a rdf:Property ;
    rdfs:comment """It provides the condition of access type of the UE when the
session AMBR shall be enforced.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/activationTime> a rdf:Property ;
    rdfs:comment """ It indicates the time (in date-time format) when the decision
data shall be activated.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/afSigProtocol> a rdf:Property ;
    rdfs:comment """Indicates the protocol used for signalling between the UE
and the AF, the default value is NO_INFORMATION.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/appDescriptor> a rdf:Property ;
    rdfs:comment "It is the ATSSS rule application descriptor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/applicationId> a rdf:Property ;
    rdfs:comment """A reference to the application detection filter configured
at the UPF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/burstArrivalTime> a rdf:Property ;
    rdfs:comment """It Indicates the arrival time (in date-time format) of the
data burst in reference to the TSN GM.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/capBatNotificationCapable> a rdf:Property ;
    rdfs:comment "Indicates the capability for AF to adjust the burst sending time." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/condId> a rdf:Property ;
    rdfs:comment "It uniquely identifies the condition data." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/contentVersion> a rdf:Property ;
    rdfs:comment "Indicates the content version of the PCC rule." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/deactivationTime> a rdf:Property ;
    rdfs:comment """It indicates the time (in date-time format) when the decision
data shall be deactivated.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/easRedisIndRequired> a rdf:Property ;
    rdfs:comment "Indicates whether the EAS rediscovery is required for the application." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/flowInfo> a owl:ObjectProperty ;
    rdfs:comment "The list of IP flow packet filter information." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/isAppRelocatable> a rdf:Property ;
    rdfs:comment """It indicates the application relocation possibility, the
default value is NO_INFORMATION.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/isUeAddrPreserved> a rdf:Property ;
    rdfs:comment "It Indicates whether UE IP address should be preserved." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/nscSupportedFeats> a rdf:Property ;
    rdfs:comment "Indicates the Network Function Service Consumer features supported per service." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/packFiltAllPrec> a rdf:Property ;
    rdfs:comment "Determines the order of TFT packet filter allocation for PCC rules." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/pccRuleId> a rdf:Property ;
    rdfs:comment "It identifies the PCC rule." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/periodicity> a rdf:Property ;
    rdfs:comment """It identifies the time period between the start of two bursts
in reference to the TSN GM.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/precedence> a rdf:Property ;
    rdfs:comment """It indicates the order in which this PCC rule is applied
relative to other PCC rules within the same PDU session.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/qosDataInfo> a owl:ObjectProperty ;
    rdfs:comment "The list of QoS control policy data." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/ratType> a rdf:Property ;
    rdfs:comment """It provides the condition of RAT type of the UE when the
session AMBR shall be enforced.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/trafficControlDataInfo> a owl:ObjectProperty ;
    rdfs:comment "The list of traffic control policy data." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/tscaiTimeDom> a rdf:Property ;
    rdfs:comment "Indicates the (g)PTP domain that the (TSN)AF is located in." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules/ueNotifEnabled> a rdf:Property ;
    rdfs:comment "Indicates whether QoS flow parameter signalling to the UE is enabled (TRUE), when the SMF is notified by the NG-RAN of changes in the fulfilled QoS situation," ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/PredefinedPccRules> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/destMacAddr> a rdf:Property ;
    rdfs:comment """It specifies the destination MAC address formatted in the
hexadecimal .""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/destMacAddrEnd> a rdf:Property ;
    rdfs:comment "It specifies the destination MAC address end. If this attribute is present, the destMacAddr attribute specifies the destination MAC address start." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/ethType> a rdf:Property ;
    rdfs:comment "A two-octet string that represents the Ethertype." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/fDesc> a rdf:Property ;
    rdfs:comment "It contains the flow description for the Uplink or Downlink IP flow. It shall be present when the ethtype is IP." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/fDir> a rdf:Property ;
    rdfs:comment "It indicates the packet filter direction." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/flowDescription> a rdf:Property ;
    rdfs:comment "It defines a packet filter for an IP flow." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/flowDirection> a rdf:Property ;
    rdfs:comment "It indicates the direction/directions that a filter is applicable." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/flowLabel> a rdf:Property ;
    rdfs:comment "It specifies the Ipv6 flow label header field." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/packFiltId> a rdf:Property ;
    rdfs:comment "It is the identifier of the packet filter." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/packetFilterUsage> a rdf:Property ;
    rdfs:comment "It indicates if the packet shall be sent to the UE." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/sourceMacAddr> a rdf:Property ;
    rdfs:comment """It specifies the source MAC address formatted in the
hexadecimal notation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/spi> a rdf:Property ;
    rdfs:comment "It is the security parameter index of the IPSec packet." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/srcMacAddrEnd> a rdf:Property ;
    rdfs:comment "It specifies the source MAC address end. If this attribute is present, the sourceMacAddr attribute specifies the source MAC address start. E.g. srcMacAddrEnd with value 00-10-A4-23-3E-FE and sourceMacAddr with value 00-10-A4-23-3E-02 means all MAC addresses from 00-10-A4-23-3E-02 up to and including 00-10-A4-23-3E-FE." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/tosTrafficClass> a rdf:Property ;
    rdfs:comment "It contains the Ipv4 Type-of-Service and mask field or the Ipv6 Traffic-Class field and mask field." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo/vlanTags> a rdf:Property ;
    rdfs:comment """It specifies the Customer-VLAN and/or Service-VLAN tags
containing the VID, PCP/DEI fields as defined in IEEE 802.1Q and
IETF RFC 7042. The first/lower instance in the array stands for the
Customer-VLAN tag and the second/higher instance in the array stands
for the Service-VLAN tag.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/flowInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/extMaxDataBurstVol> a rdf:Property ;
    rdfs:comment "It denotes the largest amount of data that is required to be transferred within a period of 5G-AN PDB, see TS 29.512" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/fiveQIValue> a rdf:Property ;
    rdfs:comment "It indicates the 5QI value." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/gbrDl> a rdf:Property ;
    rdfs:comment "It represents the guaranteed downlink bandwidth." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/gbrUl> a rdf:Property ;
    rdfs:comment "It represents the guaranteed uplink bandwidth." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/maxPacketLossRateDl> a rdf:Property ;
    rdfs:comment "It indicates the downlink maximum rate for lost packets that can be tolerated for the service data flow." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/maxPacketLossRateUl> a rdf:Property ;
    rdfs:comment "It indicates the uplink maximum rate for lost packets that can be tolerated for the service data flow." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/maxbrDl> a rdf:Property ;
    rdfs:comment "It represents the maximum downlink bandwidth." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/maxbrUl> a rdf:Property ;
    rdfs:comment "It represents the maximum uplink bandwidth." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/preemptCap> a rdf:Property ;
    rdfs:comment "It defines whether a service data flow may get resources that were already assigned to another service data flow with a lower priority level." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/preemptVuln> a rdf:Property ;
    rdfs:comment "It defines whether a service data flow may lose the resources assigned to it in order to admit a service data flow with higher priority level." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/priorityLevel> a rdf:Property ;
    rdfs:comment "It defines the relative importance of a resource request." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/qosId> a rdf:Property ;
    rdfs:comment "It identifies the QoS control policy data for a PCC rule." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/qosNotificationControl> a rdf:Property ;
    rdfs:comment "It indicates whether notifications are requested from 3GPP NG-RAN when the GFBR can no longer (or again) be guaranteed for a QoS Flow during the lifetime of the QoS Flow." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/reflectiveQos> a rdf:Property ;
    rdfs:comment "Indicates whether the QoS information is reflective for the corresponding non-GBR service data flow" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/sharingKeyDl> a rdf:Property ;
    rdfs:comment "It indicates, by containing the same value, what PCC rules may share resource in downlink direction." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo/sharingKeyUl> a rdf:Property ;
    rdfs:comment "It indicates, by containing the same value, what PCC rules may share resource in uplink direction." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/qosDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/redirectInfo/redirectAddressType> a rdf:Property ;
    rdfs:comment "It indicates the type of redirect address." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/redirectInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/redirectInfo/redirectEnabled> a rdf:Property ;
    rdfs:comment "It indicates whether the redirect instruction is enabled." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/redirectInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/redirectInfo/redirectServerAddress> a rdf:Property ;
    rdfs:comment "It indicates the address of the redirect server." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/redirectInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc/dnai> a rdf:Property ;
    rdfs:comment "It represents the DNAI (Data network access identifier)." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc/ipv4Addr> a rdf:Property ;
    rdfs:comment """It defines the Ipv4 address of the tunnel end point in the
data network, formatted in the dotted decimal notation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc/ipv6Addr> a rdf:Property ;
    rdfs:comment """It defines the Ipv6 address of the tunnel end point in the
data network.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc/portNumber> a rdf:Property ;
    rdfs:comment """ It defines the UDP port number of the tunnel end point in
the data network, see TS 29.571""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc/routeProfId> a rdf:Property ;
    rdfs:comment "It identifies the routing profile." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/active> a rdf:Property ;
    rdfs:comment "It indicates the active access, see TS 29.571." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/afAckInd> a rdf:Property ;
    rdfs:comment """It identifies whether the AF acknowledgement of UP path
event notification is expected.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/dnaiChgType> a rdf:Property ;
    rdfs:comment "It indicates the type of DNAI change, see TS 29.512" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/flowStatus> a rdf:Property ;
    rdfs:comment """It represents whether the service data flow(s) are enabled
or disabled.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/mulAccCtrl> a rdf:Property ;
    rdfs:comment "It indicates whether the service data flow, corresponding to the service data flow template, is allowed or not allowed." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/muteNotif> a rdf:Property ;
    rdfs:comment """It indicates whether applicat'on's start or stop notification
is to be muted.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/notifCorreId> a rdf:Property ;
    rdfs:comment """It is used to set the value of Notification Correlation ID in
the notification sent by the SMF, see TS 29.512""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/notificationUri> a rdf:Property ;
    rdfs:comment """It provides notification address (Uri) of AF receiving the
event notification.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/prioAcc> a rdf:Property ;
    rdfs:comment "It indicates the high priority access." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/redirectAddressType> a rdf:Property ;
    rdfs:comment "It indicates the type of redirect address." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/redirectEnabled> a rdf:Property ;
    rdfs:comment "It indicates whether the redirect instruction is enabled." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/redirectInfo> a owl:ObjectProperty ;
    rdfs:comment """The list of redirect information indicating whether the
detected application traffic should be redirected to another
controlled address.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/redirectInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/redirectServerAddress> a rdf:Property ;
    rdfs:comment "It indicates the address of the redirect server." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/routeToLoc> a owl:ObjectProperty ;
    rdfs:comment """The list of location which the traffic shall be routed to
for the AF request.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/routeToLoc> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/standby> a rdf:Property ;
    rdfs:comment "It indicates the Standby access, see TS 29.571." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/steerFun> a rdf:Property ;
    rdfs:comment "It indicates the applicable traffic steering functionality." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/steerModeValue> a rdf:Property ;
    rdfs:comment "It indicates the value of the steering mode, see TS 29.512." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/tcId> a rdf:Property ;
    rdfs:comment """It univocally identifies the traffic control policy data
within a PDU session.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/threeGLoad> a rdf:Property ;
    rdfs:comment """It indicates the traffic load to steer to the 3GPP Access
expressed in one percent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/trafficSteeringPolIdDl> a rdf:Property ;
    rdfs:comment "It references to a pre-configured traffic steering policy for downlink traffic at the SMF, see TS 29.512" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo/trafficSteeringPolIdUl> a rdf:Property ;
    rdfs:comment """It references to a pre-configured traffic steering policy for
uplink traffic at the SMF, see TS 29.512""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-predefinedpccruleset/trafficControlDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction/address> a rdf:Property ;
    rdfs:comment "The host address of the SCP." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction/supportedFuncList> a owl:ObjectProperty ;
    rdfs:comment """This parameter lists functionalities supported by a SCP.
Refer to TS 23.501 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/supportedFuncList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SCPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/supportedFuncList/function> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/supportedFuncList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/supportedFuncList/policy> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/supportedFuncList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/fqdn> a rdf:Property ;
    rdfs:comment "The domain name of the SEPP." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/sEPPId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range xsd:unsignedShort ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/sEPPType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/seppInfo> a owl:ObjectProperty ;
    rdfs:comment """This attributes represents information of a SEPP Instance,
as described in clause 6.1.6.2.72 of TS 29.510 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SeppInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SEPPType> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SeppInfo/remotePlmnList> a owl:ObjectProperty ;
    rdfs:comment """It represents a list of remote PLMNs reachable through the
SEPP.
The absence of this attribute indicates that any PLMN is reachable
through the SEPP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SeppInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remotePlmnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SeppInfo/remoteSnpnList> a owl:ObjectProperty ;
    rdfs:comment """This attributes represents list of remote SNPNs reachable
through the SEPP.
The absence of this attribute indicates that no SNPN is reachable
through the SEPP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SeppInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remoteSnpnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SeppInfo/seppPorts> a rdf:Property ;
    rdfs:comment """This attributes represents SEPP port number(s) for HTTP
and/or HTTPS.
This attribute shall be present if the SEPP uses non-default HTTP
and/or HTTPS ports. When present, it shall contain the HTTP and/or
HTTPS ports.
The key of the map shall be 'http' or 'https'.
The value shall indicate the port number for HTTP or
HTTPS respectively.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SeppInfo> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SeppInfo/seppPrefix> a rdf:Property ;
    rdfs:comment """This attributes represents optional deployment specific
string used to construct the apiRoot of the next hop SEPP, as described
in clause 6.10 of TS 29.500""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SeppInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remotePlmnList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remotePlmnList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remotePlmnList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remotePlmnList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remoteSnpnList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remoteSnpnList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remoteSnpnList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remoteSnpnList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remoteSnpnList/nid> a rdf:Property ;
    rdfs:comment """This attribute represents network Identity;
Shall be present if PlmnIdNid identifies an SNPN.
(see clauses 5.30.2.3, 5.30.2.9, 6.3.4, and 6.3.8 in TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/remoteSnpnList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-seppfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/AccessType> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """Specifies a list of commModel. It can be used by NF and
NF services to interact with each other in 5G Core network """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/configurable5QISetRef> a owl:ObjectProperty ;
    rdfs:comment """DN of the Configurable5QISet that the SMFFunction supports
(is associated to).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/dnaiSatelliteMappingList> a owl:ObjectProperty ;
    rdfs:comment """List of the mapping relationship between
satellite ID and at least one DNAI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/dnaiSatelliteMappingList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/dynamic5QISetRef> a owl:ObjectProperty ;
    rdfs:comment """DN of the Dynamic5QISet that the SMFFunction supports
(is associated to).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "Profile definition of a Managed NF (See TS 23.501)" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/nRTACList> a rdf:Property ;
    rdfs:comment """List of Tracking Area Codes (legacy TAC or extended TAC)
where the represented management function is serving.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """A list of PLMN identifiers (Mobile Country Code and Mobile
Network Code).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """The FQDN of the registered NF instance in the service-based
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/accessType> a rdf:Property ;
    rdfs:comment """If included, this IE shall contain the access type
(3GPP_ACCESS and/or NON_3GPP_ACCESS) supported by the SMF.
If not included, it shall be assumed the both
 access types are supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/ismfSupportInd> a rdf:Property ;
    rdfs:comment """This attribute may be used by an SMF to explicitly
indicate the support of I-SMF capability and its preference to be
selected as I-SMF. When present, this attribute shall indicate
whether the I-SMF capability are supported by the SMF:
- TRUE: I-SMF capability supported by the SMF
- FALSE: I-SMF capability not supported by the SMF. Absence of this
attribute indicates the I-SMF capability support of the SMF is not
specified.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/nfInstanceId> a rdf:Property ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/pgwFqdn> a rdf:Property ;
    rdfs:comment "The FQDN of the PGW if the SMF is a combined SMF/PGW-C." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/pgwFqdnList> a rdf:Property ;
    rdfs:comment """When present, this attribute provides additional FQDNs
to the FQDN indicated in the pgwFqdn attribute.
The pgwFqdnList attribute may be present if the pgwFqdn attribute
is present.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/priority> a rdf:Property ;
    rdfs:comment """This parameter defines Priority (relative to other
NFs of the same type) in the range of 0-65535, to be used for
NF selection; lower values indicate a higher priority. If
priority is also present in the nfServiceList parameters,
those will have precedence over this value """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/sNssaiSmfInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of parameters supported by the SMF per S-NSSAI." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssaiSmfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/smfOnboardingCapability> a rdf:Property ;
    rdfs:comment """This attribute indicates the SMF supports SNPN
Onboarding capability and User Plane Remote Provisioning. This
is used for the case of Onboarding of UEs for SNPNs
(see TS 23.501 [2], clauses 5.30.2.10 and 6.2.6.2).
-  FALSE: SMF does not support SNPN Onboarding;
-  TRUE: SMF supports SNPN Onboarding.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/smfUPRPCapability> a rdf:Property ;
    rdfs:comment """This attribute IE indicates the SMF supports User
Plane Remote Provisioning (UPRP) capability. This is used for
the case of Onboarding of UEs for SNPNs ,
clauses 5.30.2.10 and 6.2.6.2).
-  FALSE: SMF does not support UPRP;
-   TRUE: SMF supports UPRP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/taiList> a owl:ObjectProperty ;
    rdfs:comment """The list of TAIs the SMF can serve.
It may contain the non-3GPP access TAI.
The absence of this attribute and the taiRangeList
attribute indicate that
the SMF can be selected for any TAI
in the serving network.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/taiRangeList> a owl:ObjectProperty ;
    rdfs:comment """The range of TAIs the SMF can serve.
The absence of this attribute and the taiList
attribute indicate that the SMF can be selected
for any TAI in the serving network.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo/vsmfSupportInd> a rdf:Property ;
    rdfs:comment """Used by an SMF to explicitly indicate the support of
V-SMF capability and its preference to be selected as V-SMF.
When present it indicate whether the V-SMF capability is supported
by the SMF:
- true: V-SMF capability supported by the SMF
- false: V-SMF capability not supported by the SMF.
When absent the V-SMF capability support of the SMF is not specified.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAI/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAI> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAI/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAI> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAIs/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAIs> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAIs/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAIs> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPLMNs/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPLMNs> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPLMNs/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPLMNs> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPlmns/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPlmns> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPlmns/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPlmns> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedSnpns/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedSnpns> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedSnpns/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedSnpns> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/commModelList/commModelConfiguration> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/commModelList/commModelType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/commModelList/groupId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/commModelList> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/commModelList/targetNFServiceList> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/commModelList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/acceptedEncoding> a rdf:Property ;
    rdfs:comment """It indicates the content encodings that are accepted by a
NF Service Consumer when receiving a notification related to a default
notification subscription""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/binding> a rdf:Property ;
    rdfs:comment """This attribute shall contain the value of the Binding
Indication for the default subscription notification """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/callbackUri> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/callbackUriPrefix> a rdf:Property ;
    rdfs:comment """It indicates the optional path segment(s) used to construct
the prefix of the Callback URIs during the reselection of an NF service
consumer, as described in 3GPP TS 29.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/interPlmnCallbackUri> a rdf:Property ;
    rdfs:comment """It indicates the callback URI to be used by NF Service
Producers located in PLMNs that are different from the PLMN of
the NF consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/n1MessageClass> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/n2InformationClass> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/notificationType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/serviceInfoList> a rdf:Property ;
    rdfs:comment """It indicates a list of service specific information. It may
be present when the notification request of the notification type may be
generated by multiple services, i.e. notifications from different
services may be received by the subscription.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/supportedFeatures> a rdf:Property ;
    rdfs:comment """It is a string, which indicates the features of the service
corresponding to the subscribed default notification, which are supported
by the NF (Service) instance acting as NF service consumer. The string
shall contain a bitmask indicating supported features in hexadecimal
representation:Each character in the string shall take a value
of 0 to 9, a to f or A to F """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions/versions> a rdf:Property ;
    rdfs:comment """This attribute identifies the API versions
(e.g. v1) supported for the default notification type""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/dnaiSatelliteMappingList/dnaiList> a rdf:Property ;
