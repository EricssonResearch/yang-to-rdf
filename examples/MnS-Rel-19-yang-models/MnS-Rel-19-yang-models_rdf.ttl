    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/DPCIConfigurationFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/DPCIConfigurationFunction/nRPciList> a owl:ObjectProperty ;
    rdfs:comment """This holds a list of physical cell identities that can be
assigned to the NR cells. This attribute shall be supported if D-SON
