<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """The attribute specifies a list of commModel which is
defined as a datatype (see clause 5.3.69). It can be used by NF
and NF services to interact with each other in 5G Core network """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment """This parameter defines profile for managed NF.
See TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id). The PLMN Identifier is composed of
a Mobile Country Code (MCC) and a Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SMSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/commModelList/commModelConfiguration> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/commModelList/commModelType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/commModelList/groupId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/commModelList> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/commModelList/targetNFServiceList> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/commModelList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smsffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/InternalGroupIdRange/end> a rdf:Property ;
    rdfs:comment """It indicates last value identifying the end of an
identity range, to be used when the range of identities can be
represented as a consecutive numeric range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/InternalGroupIdRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/InternalGroupIdRange/pattern> a rdf:Property ;
    rdfs:comment """It indicates pattern (regular expression according
to the ECMA-262 dialect [75]) representing the set of identities
belonging to this range. An identity value is considered part of
the range if and only if the identity string fully matches the
regular expression.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/InternalGroupIdRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/InternalGroupIdRange/start> a rdf:Property ;
    rdfs:comment """It indicates first value identifying the start of an
identity range, to be used when the range of identities can be
represented as a consecutive numeric range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/InternalGroupIdRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SuciInfo/hNwPubKeyIds> a rdf:Property ;
    rdfs:comment """It indicating served Home Network Public Key
(see TS 23.003, clause 2.2B). If not provided, the AUSF/UDM
can serve any public key.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SuciInfo> ;
    rdfs:range xsd:long .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SuciInfo/routingInds> a rdf:Property ;
    rdfs:comment """It indicates served Routing Indicator (see TS 23.003,
clause 2.2B). If not provided, the AUSF/UDM
can serve any Routing Indicator.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SuciInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """Specifies a list of commModel. It can be used by NF and
NF services to interact with each other in 5G Core network """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "Profile definition of a Managed NF (See TS 23.501)" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/mdtUserConsentReqList> a rdf:Property ;
    rdfs:comment """represents a list of MDT measurement names that are
subject to user consent at MDT activation.
Any MDT measurement, whose name is not specified in this list, is not
subject to user consent at MDT activation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a
Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """The FQDN of the registered NF instance in the service-based
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/sNSSAIList> a owl:ObjectProperty ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of supporting.
(Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/sNSSAIList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/udmInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents the information of an UDM NF
Instance """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UDMFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo/externalGroupIdentifiersRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of external groups whose profile
data is available in the UDM instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/externalGroupIdentifiersRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo/gpsiRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of GPSIs whose profile data is
available in the UDM instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/gpsiRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo/groupId> a rdf:Property ;
    rdfs:comment """Identity of the UDM group that is served by the
UDM instance. If not provided, the UDM instance does
not pertain to any UDM group.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo/internalGroupIdentifiersRanges> a owl:ObjectProperty ;
    rdfs:comment """It represents list of ranges of Internal Group
Identifiers whose profile data is available in the UDM instance.
If not provided, it does not imply that the UDM supports all
internal groups.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/InternalGroupIdRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo/routingIndicators> a rdf:Property ;
    rdfs:comment """List of Routing Indicator information that allows
to route network signalling with SUCI
to the UDM instance. If not provided,
the UDM can serve any Routing Indicator.
Pattern: '^[0-9]{1,4}$'.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo/suciInfos> a owl:ObjectProperty ;
    rdfs:comment """It represents list of SuciInfo. A SUCI that matches
this information can be served by the UDM .A SUCI that matches
all attributes of at least one entry in this array shall be
considered as a match of this information""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/SuciInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo/supiRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of SUPI's whose profile data is
available in the UDM instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/commModelList/commModelConfiguration> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/commModelList/commModelType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/commModelList/groupId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/commModelList> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/commModelList/targetNFServiceList> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/commModelList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/externalGroupIdentifiersRanges/end> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/externalGroupIdentifiersRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/externalGroupIdentifiersRanges/pattern> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/externalGroupIdentifiersRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/externalGroupIdentifiersRanges/start> a rdf:Property ;
    rdfs:comment """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/externalGroupIdentifiersRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/gpsiRanges/end> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/gpsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/gpsiRanges/pattern> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/gpsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/gpsiRanges/start> a rdf:Property ;
    rdfs:comment """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/gpsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/sNSSAIList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/sNSSAIList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/sNSSAIList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/sNSSAIList> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/DataSetId> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "Profile definition of a Managed NF (See TS 23.501)" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a
Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """The FQDN of the registered NF instance in the service-based
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/sNSSAIList> a owl:ObjectProperty ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of supporting.
(Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/sNSSAIList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UDRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo/externalGroupIdentifiersRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of external groups whose profile
data is available in the UDR instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo/gpsiRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of GPSIs whose profile data is
available in the UDR instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo/groupId> a rdf:Property ;
    rdfs:comment """Identity of the UDR group that is served
by the UDR instance.
If not provided, the UDR instance does not pertain
to any UDR group.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo/nfInstanceId> a rdf:Property ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo/supiRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of SUPI's whose profile data
is available in the UDR instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo/supportedDataSets> a rdf:Property ;
    rdfs:comment """List of supported data sets in the UDR instance.
If not provided, the UDR supports all data sets.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/sNSSAIList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/sNSSAIList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/sNSSAIList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/sNSSAIList> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "Managed Network Function profile" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a
Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """The FQDN of the registered NF instance in the
service-based interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/sNSSAIList> a owl:ObjectProperty ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of supporting.
(Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sNSSAIList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/UDSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sNSSAIList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sNSSAIList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sNSSAIList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/sNSSAIList> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-udsffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/AtsssCapability/atsssLL> a rdf:Property ;
    rdfs:comment """Indicates the ATSSS-LL capability to support procedures
related to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/AtsssCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/AtsssCapability/mptcp> a rdf:Property ;
    rdfs:comment """Indicates the MPTCP capability to support procedures related
to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/AtsssCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/AtsssCapability/rttWithoutPmf> a rdf:Property ;
    rdfs:comment """Indicates whether the UPF supports RTT measurement without
PMF (see clauses 5.32.2, 6.3.3.3 of TS 23.501).
true: Supported
false: Not Supported""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/AtsssCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/dnaiList> a rdf:Property ;
    rdfs:comment """List of Data network access identifiers supported
by the UPF for this DNN.
The absence of this attribute indicates that the UPF
can be selected for this DNN for any DNAI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/dnaiNwInstanceList> a rdf:Property ;
    rdfs:comment """This attribute represents a map of a network instance per
DNAI for the DNN, where the key of the map is the DNAI (Data network
access identifier), see TS 23.501.

When present, the value of each entry of the map shall contain a N6
network instance that is configured for the DNAI indicated by the key.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/dnn> a rdf:Property ;
    rdfs:comment "String representing a Data Network." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/ipv4AddressRanges> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents a list of ranges of IPv4 addresses
handled by UPF. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/ipv4IndexList> a rdf:Property ;
    rdfs:comment """This attribute represents a list of Ipv4 Index supported by
the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/ipv6IndexList> a rdf:Property ;
    rdfs:comment """This attribute represents a list of Ipv6 Index supported
by the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/ipv6PrefixRanges> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents a list of ranges of IPv6 prefixes
handled by the UPF. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/natedIpv4AddressRanges> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents a list of ranges of NATed IPv4
addresses.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/natedIpv6PrefixRanges> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents a list of ranges of NATed IPv6
prefixes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/networkInstance> a rdf:Property ;
    rdfs:comment """This attribute represents the N6 Network Instance
(See TS 29.244) associated with the S-NSSAI and DNN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem/pduSessionTypes> a rdf:Property ;
    rdfs:comment """List of PDU session type(s) supported by
the UPF for a specific DNN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem/fqdn> a rdf:Property ;
    rdfs:comment """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem/interfaceType> a rdf:Property ;
    rdfs:comment """User Plane interface type.
See TS 29.510[23] clause 6.1.6.3.9""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem/ipv4EndpointAddresses> a rdf:Property ;
    rdfs:comment """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem/ipv6EndpointAddresses> a rdf:Property ;
    rdfs:comment """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem/networkInstance> a rdf:Property ;
    rdfs:comment """Network Instance (See TS 29.244) associated to the User
Plane interface""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PduSessionType> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SnssaiUpfInfoItem/dnnUpfInfoList> a owl:ObjectProperty ;
    rdfs:comment """It represents list of parameters supported by the UPF
per DNN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SnssaiUpfInfoItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/DnnUpfInfoItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SnssaiUpfInfoItem/redundantTransport> a rdf:Property ;
    rdfs:comment """This attribute indicates whether the UPF supports redundant
transport path on the transport layer in the corresponding network
slice.
true: supported
false: not supported""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SnssaiUpfInfoItem> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SnssaiUpfInfoItem/sNssai> a owl:ObjectProperty ;
    rdfs:comment "Supported S-NSSAI." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SnssaiUpfInfoItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/cNSIIdList> a rdf:Property ;
    rdfs:comment """It is a set of NSI ID. NSI ID is an identifier for
identifying the Core Network part of a Network Slice instance when
multiple Network Slice instances of the same Network Slice are deployed,
and there is a need to differentiate between them in the 5GC.
See NSI ID definition in clause 3.1 of TS 23.501 and
subclause 6.1.6.2.7 of  TS 29.531. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/energySavingControl> a rdf:Property ;
    rdfs:comment """This attribute allows management system to initiate energy
saving activation or deactivation for the edge UPF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/energySavingState> a rdf:Property ;
    rdfs:comment """This attribute specifies the status regarding the energy
saving in the edge UPF.

If the value of energySavingControl is TO_BE_ENERGYSAVING, then it
shall be tried to achieve the value IS_ENERGYSAVING for the
energySavingState.

If the value of energySavingControl is TO_BE_NOT_ENERGYSAVING, then
it shall be tried to achieve the value IS_NOT_ENERGYSAVING for the
energySavingState. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/isOnboardSatellite> a rdf:Property ;
    rdfs:comment """This attribute indicates whether the function is
on board the satellite.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:boolean ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "Profile definition of a Managed NF (See TS 23.501)" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/nRTACList> a rdf:Property ;
    rdfs:comment """List of Tracking Area Codes (legacy TAC or extended TAC)
where the represented management function is serving.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/onboardSatelliteId> a rdf:Property ;
    rdfs:comment """This attribute indicates the onboard satellite Id.
It shall be formatted as a fixed 5-digit string, padding with
leading digits '0' to complete a 5-digit length.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """A list of PLMN identifiers (Mobile Country Code and Mobile
Network Code).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/supportedBMOList> a rdf:Property ;
    rdfs:comment """List of supported BMOs (Bridge Managed Objects) required
for integration with TSN system.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/uPFCapabilities> a rdf:Property ;
    rdfs:comment """It indicates the operator configurable capability supported
by the UPF.  (see clause 5.8.2.21 in TS 23.501, clause 5.4.2
in TS 29.571)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/upfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents information of an UPF NF Instance.
Multiple upfInfo may be allowed to define different TAI list for each
supported S-NSSAI""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UPInterfaceType> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/atsssCapability> a owl:ObjectProperty ;
    rdfs:comment "Indicate the ATSSS capability of the UPF" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/AtsssCapability> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/dataForwarding> a rdf:Property ;
    rdfs:comment """Indicates whether the UPF is configured for data forwarding.
Based on operator policies, if dedicated UPFs are preferred to be used
for indirect data forwarding during handover scenarios, when setting
up the indirect data forwarding tunnel, the SMF should preferably
select a UPF configured for data forwarding and use the network
instance indicated in the Network Instance ID associated to the
DATA_FORWARDING interface type in the interfaceUpfInfoList attribute.
true: the UPF is configured for data forwarding
false: the UPF is not configured for data forwarding

If the UPF is configured for data forwarding, it shall support UP
network interface with type 'DATA_FORWARDING'.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/interfaceUpfInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of User Plane interfaces configured on the UPF. When
this parameter is provided in the NF Discovery response, the NF Service
Consumer (e.g., SMF) may use this information for UPF selection.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/InterfaceUpfInfoItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/ipups> a rdf:Property ;
    rdfs:comment """Indicates whether the UPF is configured for Inter-PLMN User
Plane Security (IPUPS). Any UPF can support the IPUPS functionality.
In network deployments where specific UPFs are used to provide IPUPS,
UPFs configured for providing IPUPS services shall be selected.
true: The UPF is configured for IPUPS.
false: The UPF is not configured for IPUPS""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/iwkEpsInd> a rdf:Property ;
    rdfs:comment """Indicates whether interworking with EPS is supported by
the UPF.
True: Supported
False: Not Supported""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/pduSessionTypes> a rdf:Property ;
    rdfs:comment "Indicates the type(s) of a PDU session." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/priority> a rdf:Property ;
    rdfs:comment """This parameter defines Priority (relative to other NFs of
the same type) in the range of 0-65535, to be used for NF selection;
lower values indicate a higher priority. If priority is also present
in the nfServiceList parameters, those will have precedence over
this value (See TS 29.510).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/redundantGtpu> a rdf:Property ;
    rdfs:comment """Indicates whether the UPF supports redundant GTP-U path.
true: supported
false: not supported""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/sNssaiUpfInfoList> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents a list of parameters supported by
the UPF per S-NSSAI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/SnssaiUpfInfoItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/smfServingArea> a rdf:Property ;
    rdfs:comment """The SMF service area(s) the UPF can serve. See TS 29.510.
If not provided, the UPF can serve any SMF service area.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/supportedPfcpFeatures> a rdf:Property ;
    rdfs:comment """Supported Packet Forwarding Control Protocol (PFCP) Features.
A string used to indicate the PFCP features supported by the UPF,
which encodes the 'UP Function Features' as specified in
Table 8.2.25-1 of TS 29.244 (starting from Octet 5), in hexadecimal
representation.

Each character in the string shall take a value of '0' to '9', 'a'
to 'f' or 'A' to 'F' and each two characters shall represent one octet
of 'UP Function Features' (starting from Octet 5, to higher octets).
For each two characters representing one octet, the first character
representing the 4 most significant bits of the octet and the second
character the 4 least significant bits of the octet.

The supported PFCP features shall be provisioned in addition and be
consistent with the existing UPF features (atsssCapability, ueIpAddrInd,
redundantGtpu and ipups), e.g., if the ueIpAddrInd is set to 'true',
then the UEIP flag shall also be set to '1' in the supported PFCP
features.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/sxaInd> a rdf:Property ;
    rdfs:comment """This attribute indicates whether the UPF is configured to
support Sxa interface.
true: Supported
false: Not Supported""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/taiList> a owl:ObjectProperty ;
    rdfs:comment "The list of TAIs." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/taiRangeList> a owl:ObjectProperty ;
    rdfs:comment "The range of TAIs." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/tngfInfo> a owl:ObjectProperty ;
    rdfs:comment """Indicate that the UPF is collocated with TNGF. If not
present, the UPF is not collocated with Trusted Non-3GPP Gateway
Function (TNGF).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/twifInfo> a owl:ObjectProperty ;
    rdfs:comment """Indicate that the UPF is collocated with TWIF. If not
present, the UPF is not collocated with Trusted WLAN Interworking
Function (TWIF).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/ueIpAddrInd> a rdf:Property ;
    rdfs:comment """Indicates whether the UPF supports allocating UE IP
addresses/prefixes.
true: supported
false: not supported""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo/wAgfInfo> a owl:ObjectProperty ;
    rdfs:comment """Indicate that the UPF is collocated with W-AGF. If not
present, the UPF is not collocated with Wireline Access Gateway
Function (W-AGF).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRanges/end> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRanges/start> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv4AddressRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRanges/end> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRanges/start> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/ipv6PrefixRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRanges/end> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRanges/start> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv4AddressRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRanges/end> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRanges/start> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/natedIpv6PrefixRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataScope/geoAreas> a owl:ObjectProperty ;
    rdfs:comment "It describes the concrete geographical area(s)" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataScope> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataScope/objectInstancesExcluded> a owl:ObjectProperty ;
    rdfs:comment """List of managed object instances which are not considered
in relation to the described data. Each object instance is identified
by its DN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataScope> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataScope/objectInstancesIncluded> a owl:ObjectProperty ;
    rdfs:comment """List of managed object instances to which the described
data are related. Each object instance is identified by its DN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataScope> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/externalDataScope> a owl:ObjectProperty ;
    rdfs:comment """It describes the concrete scope which the external management
data is applicable.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataScope> .

<urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/externalDataType> a rdf:Property ;
    rdfs:comment """Type of external management data as defined by the
implementation.

Examples: 'Electronic Map', 'Camara Data', 'UE path', 'Camera Photo',
'Event Schedule”""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/externalDataTypeSchema> a rdf:Property ;
    rdfs:comment """URI of the schema to parse a type of external management data.
The detailed schema definition for the different types of external
management data is out of scope of this specification.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType/mediaLocation> a rdf:Property ;
    rdfs:comment """URI of the media which includes the transfer protocol.

Examples:
sftp://companyA.com/datastore/fileName.xml
https://companyA.com/ManagedElement=1/Files=1/File=1""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-externaldata/ExternalDataType> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/cancelJob> a rdf:Property ;
    rdfs:comment """Setting this attribute to TRUE cancels the file download job.
As specified in the definition of ProcessMonitor, cancellation is
possible in the NOT_STARTED and RUNNING state. Setting the attribute
to FALSE has no observable result.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name for the case the file content cannot be retrieved
by reading the 'fileContent' attribute.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/jobMonitor> a owl:ObjectProperty ;
    rdfs:comment "Provides monitoring for the file download job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment "Address of the notification recipient." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/endTime> a rdf:Property ;
    rdfs:comment """Date and time when status changed to 'SUCCESS', 'CANCELLED',
'FAILED' or 'PARTIALLY_FAILED'.

If the time is in the future, it is the estimated time
the process will end.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/id> a rdf:Property ;
    rdfs:comment """Id of the process. It is unique within a single
multivalue attribute of type ProcessMonitor.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/progressPercentage> a rdf:Property ;
    rdfs:comment "Progress of the associated process as percentage" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/progressStateInfo> a rdf:Property ;
    rdfs:comment """Additional textual qualification of the states
'NOT_STARTED', 'CANCELLING' and 'RUNNING'.

For specific processes, specific well-defined strings (e.g. string
patterns or enums) may be defined as a specialisation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/resultStateInfo> a rdf:Property ;
    rdfs:comment """If status is FAILED resultStateInfo will be one of
the following or empty.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/startTime> a rdf:Property ;
    rdfs:comment """Start time of the associated process, i.e. the time when the
status changed from 'NOT_STARTED' to 'RUNNING'.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/status> a rdf:Property ;
    rdfs:comment "Status must not be 'PARTIALLY_FAILED'." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/timer> a rdf:Property ;
    rdfs:comment """Time until the associated process is automatically cancelled.
If set, the system decreases the timer with time. When it reaches zero
the cancellation of the associated process is initiated by the
MnS_Producer.
If not set, there is no time limit for the process.

Once the timer is set, the consumer can not change it anymore.
If the consumer has not set the timer the MnS Producer may set it.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmComment/commentSystemId> a rdf:Property ;
    rdfs:comment """It carries the identification of the system (
Management System) from which the comment is made. That system
supports the user that made the comment.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmComment> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmComment/commentText> a rdf:Property ;
    rdfs:comment "It carries the textual comment." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmComment> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmComment/commentTime> a rdf:Property ;
    rdfs:comment "Date and Time the comment was created." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmComment> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmComment/commentUserId> a rdf:Property ;
    rdfs:comment """It carries the identification of the user who made the
comment.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmComment> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/ackState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/ackSystemId> a rdf:Property ;
    rdfs:comment """It identifies the system (Management System) that last
changed the ackState of an alarm, i.e. acknowledged or unacknowledged
the alarm.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/ackTime> a rdf:Property ;
    rdfs:comment """It identifies the time when the alarm has been
acknowledged or unacknowledged the last time, i.e. it registers the
time when ackState changes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/ackUserId> a rdf:Property ;
    rdfs:comment """It identifies the last user who has changed the
Acknowledgement State.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/additionalInformation> a owl:ObjectProperty ;
    rdfs:comment "Vendor specific alarm information in the alarm." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformation> .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/additionalText> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/alarmChangedTime> a rdf:Property ;
    rdfs:comment "not applicable if related alarm has not changed" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/alarmClearedTime> a rdf:Property ;
    rdfs:comment "not applicable if related alarm was not cleared" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/alarmId> a rdf:Property ;
    rdfs:comment "Identifies the alarmRecord" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/alarmRaisedTime> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/alarmType> a rdf:Property ;
    rdfs:comment "General category for the alarm." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/backUpObject> a owl:ObjectProperty ;
    rdfs:comment """Backup object of the alarmed object as defined in
ITU-T Rec. X. 733""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/backedUpStatus> a rdf:Property ;
    rdfs:comment """Indicates if an object (the MonitoredEntity) has a back
up. See definition in ITU-T Recommendation X.733 clause 8.1.2.4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/clearSystemId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/clearUserId> a rdf:Property ;
    rdfs:comment """Carries the identity of the user who invokes the
clearAlarms operation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/clearingType> a rdf:Property ;
    rdfs:comment """Indicates whether the alarm needs
to be cleared manually by the MnS consumer (ADMC)
or the producer will clear it automatically (ADAC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/comments> a owl:ObjectProperty ;
    rdfs:comment "List of comments and data about the comments." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-fm/AlarmComment> .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/correlatedNotifications> a owl:ObjectProperty ;
    rdfs:comment "List of correlated notifications" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotifications> .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/monitoredAttributes> a owl:ObjectProperty ;
    rdfs:comment """Attributes of the monitored entity and their
values at the time the alarm occurred that are of interest for the
alarm report.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributes> .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/notificationId> a rdf:Property ;
    rdfs:comment "The Id of the last notification updating the AlarmRecord." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/objectInstance> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/perceivedSeverity> a rdf:Property ;
    rdfs:comment """This is Writable only if producer supports consumer
to set perceivedSeverity to CLEARED""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/probableCause> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/proposedRepairActions> a rdf:Property ;
    rdfs:comment """Indicates proposed repair actions. See definition in
ITU-T Recommendation X.733 clause 8.1.2.12.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/rootCauseIndicator> a rdf:Property ;
    rdfs:comment """It indicates that this AlarmInformation is the root cause
of the events captured by the notifications whose identifiers are in
the related CorrelatedNotification instances.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/securityAlarmDetector> a rdf:Property ;
    rdfs:comment """It carries the identity of the detector of the security
alarm.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/serviceProvider> a rdf:Property ;
    rdfs:comment """It identifies the service-provider whose service is
requested by the serviceUser and the service request provokes the
generation of the security alarm.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/serviceUser> a rdf:Property ;
    rdfs:comment """It identifies the service-user whose request for service
provided by the serviceProvider led to the generation of the
security alarm.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/specificProblem> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/stateChangeDefinition> a owl:ObjectProperty ;
    rdfs:comment """Indicates MO attribute value changes associated with the
alarm for state attributes of the monitored entity (state transitions).
The change is reported with the name of the state attribute, the new
value and an optional old value.
See definition in ITU-T Recommendation X.733 [4] clause 8.1.2.10.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition> .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/thresholdInfo> a owl:ObjectProperty ;
    rdfs:comment "Indicates the crossed threshold" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-fm/ThresholdCrossing> .

<urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord/trendIndication> a rdf:Property ;
    rdfs:comment """Indicates if some observed condition is getting better,
worse, or not changing. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/ThresholdCrossing/armTime> a rdf:Property ;
    rdfs:comment """For a gauge threshold, the time at which the threshold
was last re-armed, namely the time after the previous threshold
crossing at which the hysteresis value of the threshold was
exceeded thus again permitting generation of notifications when the
threshold is crossed. For a counter threshold, the later of the time
at which the threshold offset was last applied, or the time at
which the counter was last initialized (for resettable counters)
(Rec. ITU-T X. 733)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/ThresholdCrossing> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/ThresholdCrossing/observedMeasurement> a rdf:Property ;
    rdfs:comment """The name of the monitored measurement that crossed the
threshold and that caused the notification (Rec. ITU-T X. 733 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/ThresholdCrossing> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/ThresholdCrossing/observedValue> a rdf:Property ;
    rdfs:comment """The value of the gauge or counter which crossed the
threshold. This may be different from the threshold value if, for
example, the gauge may only take on discrete values.
Integer values are used for counters and float values for gauges
(Rec. ITU-T X. 733). Note that a 'number' type property can contain
both integers and floating point numbers.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/ThresholdCrossing> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/ThresholdCrossing/thresholdLevel> a owl:ObjectProperty ;
    rdfs:comment """In the case of a gauge the threshold level specifies
a pair of threshold values, the first being the value of the crossed
threshold and the second, its corresponding hysteresis; in the case
of a counter the threshold level specifies only the threshold value
(Rec. ITU-T X. 733).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/ThresholdCrossing> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-fm/ThresholdLevelInd> .

<urn:3gpp:sa5:_3gpp-common-fm/ThresholdHysteresis/high> a rdf:Property ;
    rdfs:comment """Higher value of a threshold with hysteresis, the integer
type is used for counter thresholds and the float type for gauge
thresholds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/ThresholdHysteresis> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-fm/ThresholdHysteresis/low> a rdf:Property ;
    rdfs:comment """Lower value of a threshold with hysteresis, applicable
only to gauge thresholds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/ThresholdHysteresis> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-fm/ThresholdLevelInd/down> a owl:ObjectProperty ;
    rdfs:comment """Indicates for gauge thresholds that the threshold crossing
occurred when going down, applicable only to gauge thresholds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/ThresholdLevelInd> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-fm/ThresholdHysteresis> .

<urn:3gpp:sa5:_3gpp-common-fm/ThresholdLevelInd/up> a owl:ObjectProperty ;
    rdfs:comment """Indicates for counter and gauge thresholds that the
threshold crossing occurred when going up.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-fm/ThresholdLevelInd> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-fm/ThresholdHysteresis> .

<urn:3gpp:sa5:_3gpp-common-fm/eventType> a rdfs:Datatype ;
    rdfs:comment "General category for the alarm." .

<urn:3gpp:sa5:_3gpp-common-fm/probable-causes> a rdfs:Datatype ;
    rdfs:comment "Values are from the (informative) Annex B of 3GPP TS 28.111." .

<urn:3gpp:sa5:_3gpp-common-fm/severity-level> a rdfs:Datatype ;
    rdfs:comment "The possible alarm severities" .

<urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/administrativeState> a rdf:Property ;
    rdfs:comment """When set to UNLOCKED, the alarm list is updated.
When the set to LOCKED, the existing alarm records are not
updated, and new alarm records are not added to the alarm list.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/alarmRecords> a owl:ObjectProperty ;
    rdfs:comment "List of alarmRecords" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> .

<urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/lastModification> a rdf:Property ;
    rdfs:comment "The last time when an alarm record was modified" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/numOfAlarmRecords> a rdf:Property ;
    rdfs:comment "The number of alarm records in the AlarmList" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/operationalState> a rdf:Property ;
    rdfs:comment """The producer sets this attribute to ENABLED, indicating
that it has the resource and ability to record alarm in AlarmList
else, it sets the attribute to DISABLED.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList/unreliableAlarmScope> a owl:ObjectProperty ;
    rdfs:comment """Identifies, the part of the alarm scope that may not be
reliable.

If this parameter is equal to the instance carried in systemDN,
then all AlarmRecord instances in the AlarmList may not be reliable.

If this parameter is equal to some instance represented by
MonitoredEntity, then only AlarmRecord related to this instance and
its descendants may not be reliable.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/AlarmList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/Configurable5QISet/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/Configurable5QISet> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/_5GCNfConnEcmInfoList> a owl:ObjectProperty ;
    rdfs:comment """The attribute specifies a list of 5GCNfConnInfo which is
defined as a datatype (see clause 5.3.120). It is used to
provide 5GC NFs, such as PCF, NEF, SCEF, that are connected EDN NFs,
such as EAS, EES, and ECS.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/_5GCNfConnEcmInfo> .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eASIpAddress> a rdf:Property ;
    rdfs:comment """This parameter defines address of an EAS instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eASServiceArea> a owl:ObjectProperty ;
    rdfs:comment """This parameter defines the EAS service area
(see clause 7.3.3.6 in TS 23.558).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/ServingLocation> .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eCSIpAddress> a rdf:Property ;
    rdfs:comment """This parameter defines address of an ECS instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eDNServiceArea> a owl:ObjectProperty ;
    rdfs:comment """This parameter defines the EDN service area
(see clause 7.3.3.4 in TS 23.558)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/ServingLocation> .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eESIpAddress> a rdf:Property ;
    rdfs:comment """This parameter defines address of an EES instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/eESServiceArea> a owl:ObjectProperty ;
    rdfs:comment """This parameter defines the EES service area
(see clause 7.3.3.5 in TS 23.558).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/ServingLocation> .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/ecmConnectionType> a rdf:Property ;
    rdfs:comment """It indicates the type of ECM connection (i.e., user plane
connection via UPF, control plane connection via PCF or NEF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/ednIdentifier> a rdf:Property ;
    rdfs:comment "The identifier of the edge data network (See TS 23.558)." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo/uPFConnectionInfo> a owl:ObjectProperty ;
    rdfs:comment """The attribute is defined as a datatype UPFConnInfo
(see clause 5.3.121). It is used to provide the UPF IP address and
UPF DN. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/UPFConnInfo> .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/averagingWindow> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/fiveQIValue> a rdf:Property ;
    rdfs:comment "Identifies the 5QI value." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/maximumDataBurstVolume> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/packetDelayBudget> a rdf:Property ;
    rdfs:comment """Indicates the Packet Delay Budget (in unit of 0.5ms)of a 5QI,
as specified in TS 23.501 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/packetErrorRate> a owl:ObjectProperty ;
    rdfs:comment """It indicates the Packet Error Rate of a 5QI,
as specified in TS 23.501.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-configurable5qiset/PacketErrorRate> .

<urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/priorityLevel> a rdf:Property ;
    rdfs:comment """It indicates the Priority Level of a 5QI, as specified
in TS 23.501.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics/resourceType> a rdf:Property ;
    rdfs:comment """It indicates the Resource Type of a 5QI, as specified
in TS 23.501 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/FiveQICharacteristics> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl/heartbeatNtfPeriod> a rdf:Property ;
    rdfs:comment """Specifies the periodicity of heartbeat notification emission.
The value of zero has the special meaning of stopping the heartbeat
notification emission.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl/triggerHeartbeatNtf> a rdf:Property ;
    rdfs:comment """Setting this attribute to 'true' triggers an immediate
additional heartbeat notification emission. Setting the value to
'false' has no observable result.

The periodicity of notifyHeartbeat emission is not changed.

After triggering the heartbeat the system SHALL set the value
back to false.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/HeartbeatControl> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/administrativeState> a rdf:Property ;
    rdfs:comment """It indicates the administrative state of the MWAB instance.
It describes the permission to use or prohibition against using the
MWAB functionalities, imposed through the OAM services.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/allowedArea> a owl:ObjectProperty ;
    rdfs:comment """This specifies the area where the MWAB can act as MWAB-gNB.
If the OAM indicates that the MWAB can act as MWAB-gNB is allowed areas,
it acts as MWAB-gNB only on the allowed area only.
(See sub clause 5.49 TS 28.662).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/allowedTime> a owl:ObjectProperty ;
    rdfs:comment """This specifies the time window for which the MWAB can act
as MWAB-gNB. If the allowed time window/ validity indicates 20th June,
10 am to 5 pm of the day, the MWAB acts as an MWAB g-NB only during 20th
June, 10 am to 5 pm of the day, and does not act as MWAB-gNB for any
other time. (See sub clause 5.49 [11]).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> .

<urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/currentLocation> a owl:ObjectProperty ;
    rdfs:comment """This parameter specifies the current location
of mobile NR node (e.g., IAB-node, MWAB-node).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> .

<urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/mnrOamIPConfig> a owl:ObjectProperty ;
    rdfs:comment """It is IP configutation for OAM connectivity used
by a mobile NR node (e.g., IAB-node, MWAB-node)
to establish connection with management system as specified
in TS 28.314[x] clause 6.1.2""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/MWAB/operationalState> a rdf:Property ;
    rdfs:comment """It indicates the operational state of the MWAB instance.
It describes whether the resource is installed and partially or fully
operable (Enabled) or the resource is not installed or not
operable (Disabled).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/MWAB> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/dnPrefix> a owl:ObjectProperty ;
    rdfs:comment """Provides naming context that allows the Managed
Elements to be partitioned into logical domains.
A Distingushed Name(DN) is defined by 3GPP TS 32.300,
which splits the DN into a DN Prefix and Local DN""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/locationName> a rdf:Property ;
    rdfs:comment """The physical location (e.g. an address) of an entity
represented by a (derivative of) ManagedElement_. It may contain no
information to support the case where the derivative of
ManagedElement_ needs to represent a distributed multi-location NE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/managedBy> a owl:ObjectProperty ;
    rdfs:comment """Relates to the role played by ManagementSystem_ in the
between ManagedSystem_ and ManagedElement_. This attribute contains
a list of the DN(s) of the related subclasses of
ManagementSystem_ instance(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/managedElementTypeList> a rdf:Property ;
    rdfs:comment """The type of functionality provided by the ManagedElement.
It may represent one ME functionality or a combination of
more than one functionality.
1) The allowed values of this attribute are the names of the IOC(s)
that are (a) derived/subclassed from ManagedFunction and (b) directly
name-contained by ManagedElement IOC (on the first level below
ManagedElement), but with the string 'Function' excluded.
2) If a ManagedElement contains multiple instances of a ManagedFunction
this attribute will not contain repeated values.
3) The capitalisation (usage of upper/lower case) of characters in this
attribute is insignificant.  Thus, the NodeB should be case insensitive
when reading these values.
4) Two examples of allowed values are:
-  NodeB;
-  HLR, VLR.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/swVersion> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/userDefinedState> a rdf:Property ;
    rdfs:comment "An operator defined state for operator specific usage" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement/vendorName> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ManagedElement> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule/eCMRInputMaxValue> a rdf:Property ;
    rdfs:comment """The maximum value of to be applied
for mapping from this attribute to the energy cost.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule/eCMRInputMinValue> a rdf:Property ;
    rdfs:comment """The minimum value of to be applied
for mapping from this attribute to the energy cost.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule/eCTimeInterval> a rdf:Property ;
    rdfs:comment """Time interval (in seconds) that
should be applied for collecting values of mapping
rule attribute to be used for computing the energy cost.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NRECMappingRule> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/firstEventTime> a rdf:Property ;
    rdfs:comment """eventTime of first notification available.
The attribute may be missing if and only if there are no notifications
in the NotificationList.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/lastEventTime> a rdf:Property ;
    rdfs:comment """eventTime of latest notification available.
The attribute may be missing if and only if there are no notifications
in the NotificationList.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/notificationEntries> a owl:ObjectProperty ;
    rdfs:comment """Representation of the individual notifications.
The entries shall be ordered based on eventTime of the notification,
newest first.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-subscription-control/NotificationEntry> .

<urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/notificationFilter> a rdf:Property ;
    rdfs:comment """Filter to be applied to candidate notifications identified
by the notificationTypes attribute. Only notifications that pass the
filter criteria are included. All other notifications are discarded.
The filter can be applied to any field of a notification.

The format of the string shall confrm to a
JSON expressions (Jex) 'JexConditionsExpr'""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList/notificationTypes> a rdf:Property ;
    rdfs:comment "List of notification types." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/availabilityStatus> a rdf:Property ;
    rdfs:comment """The availability status provides additional information
about the operational state""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/lastSequenceNo> a rdf:Property ;
    rdfs:comment """The sequence number of the last notification that was sent
by a 'NtfSubscriptionControl' instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/notificationFilter> a rdf:Property ;
    rdfs:comment """Defines a filter to be applied to candidate notifications
identified by the notificationTypes attribute.
If notificationFilter is present, only notifications that pass the
filter criteria are forwarded to the notification recipient; all other
notifications are discarded.
The filter can be applied to any field of a notification.

The format of the string shall confrm to a
JSON expressions (Jex) 'JexConditionsExpr'""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/notificationRecipientAddress> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/notificationTypes> a rdf:Property ;
    rdfs:comment """Defines the types of notifications that are candidates
for being forwarded to the notification recipient.
If the notificationTypes attribute is not supported or not present
all candidate notifications types are forwarded to the notification;
discriminated by notificationFilter attribute.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/operationalState> a rdf:Property ;
    rdfs:comment """Operational state of manged object instance.
The operational state describes if an object instance is operable
('ENABLED') or inoperable ('DISABLED').
This state is set by the object instance or the MnS producer and
is hence READ-ONLY.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl/scope> a owl:ObjectProperty ;
    rdfs:comment "Scopes (selects) data nodes in an object tree." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/NtfSubscriptionControl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-subscription-control/Scope> .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications/notificationProtocols> a rdf:Property ;
    rdfs:comment "List of protocols supported for notifications." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications/notificationTypes> a rdf:Property ;
    rdfs:comment "List of notification types supported by the MnS producer" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedNotifications> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-element/traceTarget> .

<urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformation/name> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformation> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformation/value> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/additionalInformation> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotifications/notificationIds> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotifications> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotifications/sourceObjectInstance> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/correlatedNotifications> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managed-element/geographicalCoordinates/latitude> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalCoordinates> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-managed-element/geographicalCoordinates/longitude> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/geographicalCoordinates> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributes/attributeName> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributes> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributes/value> a rdf:Property ;
    rdfs:comment """The value of the attribute. The content of this data
node shall be in accordance with the data model for the attribute.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/monitoredAttributes> .

<urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/servingPLMN/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/servingPLMN> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/servingPLMN/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/servingPLMN> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition/attributeName> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition/newValue> a rdf:Property ;
    rdfs:comment """The new value of the attribute. The content of this data
node shall be in accordance with the data model for the attribute.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition> .

<urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition/oldValue> a rdf:Property ;
    rdfs:comment """The old value of the attribute. The content of this data
node shall be in accordance with the data model for the attribute.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/stateChangeDefinition> .

<urn:3gpp:sa5:_3gpp-common-managed-element/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-element/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-element/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/Operation/allowedNFTypes> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/Operation/name> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-function/Operation/operationSemantics> a rdf:Property ;
    rdfs:comment "Semantics type of the operation." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/environmentType> a rdf:Property ;
    rdfs:comment """The type of environment where the managedFunction
instance resides.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/equipmentType> a rdf:Property ;
    rdfs:comment """The type of equipment where the managedFunction
instance resides.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/powerInterface> a rdf:Property ;
    rdfs:comment "The type of power." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteAltitude> a rdf:Property ;
    rdfs:comment """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteDescription> a rdf:Property ;
    rdfs:comment """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteIdentification> a rdf:Property ;
    rdfs:comment """The identification of the site where the
ManagedFunction resides.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteLatitude> a rdf:Property ;
    rdfs:comment """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteLongitude> a rdf:Property ;
    rdfs:comment """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters/autoScalable> a rdf:Property ;
    rdfs:comment """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters/flavourId> a rdf:Property ;
    rdfs:comment """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters/vnfInstanceId> a rdf:Property ;
    rdfs:comment "VNF instance identifier" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters/vnfdId> a rdf:Property ;
    rdfs:comment """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/locationName> a rdf:Property ;
    rdfs:comment "The physical location of this entity (e.g. an address)." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/managedElements> a owl:ObjectProperty ;
    rdfs:comment """Contains a list of the DN(s) of the related subclasses of
ManagedElement_ instance(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/swVersion> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/userDefinedState> a rdf:Property ;
    rdfs:comment "An operator defined state for operator specific usage" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode/vendorName> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-management-node/ManagementNode> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest/eutraCellIdList> a rdf:Property ;
    rdfs:comment "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest/geoAreaToCellMapping> a owl:ObjectProperty ;
    rdfs:comment """Contains a geographical area and an association threshold.
The geo-area is defined as a convex polygon using the attribute
'geoArea'.

The MnS producer shall map the geographical area to cells. There are
two evaluation criteria whether a cell belongs to a geographical area
or not. If attribute 'associationThreshold' is absent, the location
of the base station antenna determines the belonging. If attribute
'associationThreshold' is configured, the coverage area is considered.
The attribute 'associationThreshold' determines the lower boundary of
the coverage ratio. For example, if the 'associationThreshold' is
configured to 60%, a cell shall be considered as included in the
geographical area if at least 60% of the coverage area of that
cell overlaps with the specified geographical area.

The mapping of the geographical area to cells is performed at
instantiation of the IOC.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managementdatacollection/GeoAreaToCellMapping> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest/nrCellIdList> a rdf:Property ;
    rdfs:comment "List of NR cells identified by NG-RAN CGI" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest/taiList> a owl:ObjectProperty ;
    rdfs:comment "Tracking Area Identity list" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest/utraCellIdList> a rdf:Property ;
    rdfs:comment "List of UTRAN cells identified by UTRAN CGI" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/GeoAreaToCellMapping/associationThreshold> a rdf:Property ;
    rdfs:comment """It specifies the threshold of coverage area in
percentage whether a cell belongs to the geographical area or not.

If this attribute is absent, the location of the base station
antenna determines whether a cell belongs to the geographical
area or not.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/GeoAreaToCellMapping> ;
    rdfs:range xsd:unsignedByte ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/GeoAreaToCellMapping/geoArea> a owl:ObjectProperty ;
    rdfs:comment """It specifies the geographical area using the cordinates of
the corners of a convex polygon.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/GeoAreaToCellMapping> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/category> a rdf:Property ;
    rdfs:comment """This attributes defines the type of management data that
are requested.

Allowed values for data category are COVERAGE, CAPACITY,
ENERGY_EFFICIENCY, MOBILITY, ACCESSIBILITY. The data categories
will map to certain measurement families defined in TS 28.552, see
below. In addition to the below mappings, MnS producer may map the
provided categories to any additional proprietary management data,
as appropriate.

- The COVERAGE category will map to measurement families of MR
(measurements related to Measurement Report) and L1M (measurements
related to Layer 1 Measurement).

- The CAPACITY category will map to measurement family RRU
(measurements related to Radio Resource Utilization).

- The ENERGY_EFFICIENCY category will map to measurement family PEE
(measurements related to Power, Energy and Environment).

- The MOBILITY category will map to measurement family MM
(measurements related to Mobility Management).

- The ACCESSIBILITY category will map to measurement family CE
(measurements related to Connection Establishment).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/collectionTimeWindow> a owl:ObjectProperty ;
    rdfs:comment """Collection time window for which the management data
should be reported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/condition> a rdf:Property ;
    rdfs:comment """Logical expression of one or several condition(s).

The actual syntax and capabilities of condition is SS specific. However,
each SS should support condition consisting of one or several assertions
that may be grouped using the logical operators AND, OR and NOT. Only if
the whole expression of condition evaluates TRUE, the attribute
conditionStatus will be TRUE.

Each assertion is a pointer to a Boolean parameter or a logical
expression of attribute existence or attribute value comparison
('equal to X, less than Y' etc.).

An empty string is not allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/consolidateOutput> a rdf:Property ;
    rdfs:comment """Indicates whether the management data collection output will
be consolidated into a single file per reporting period.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range xsd:boolean ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/dataScope> a rdf:Property ;
    rdfs:comment """It specifies whether the required data is reported per
S-NSSAI or per 5QI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob, a TraceJob or a QMCJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/name> a rdf:Property ;
    rdfs:comment """List of management data identified by name.

The list may include metrics or set of metrics defined
in TS 28.552, TS 28.554 and TS 32.422.

The metrics are identified with their names/identifiers.
For performance measurements defined in TS 28.552 the name is
constructed as the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined according to the
KPI definitions template as the component designated with a).

For trace metrics (including trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RRC, RLF and RCEF
reports) defined in TS 32.422, the name (metric identifier) is
defined in clause 10 of TS 32.422.

For non-3GPP specified managment data the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/processMonitor> a owl:ObjectProperty ;
    rdfs:comment "Indicates the process of the ManagementDataCollection MOI." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managementdatacollection/processMonitor> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/reportingCtrl> a owl:ObjectProperty ;
    rdfs:comment """Selecting the reporting method and defining associated
control parameters.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection/targetNodeFilter> a owl:ObjectProperty ;
    rdfs:comment """Set of information to target the Object Instance to collect
the measurements from.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/ManagementDataCollection> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter/areaOfInterest> a owl:ObjectProperty ;
    rdfs:comment """It specifies a location(s) from where the management data
shall be collected. It is defined in terms of TAI(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managementdatacollection/AreaOfInterest> .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter/cpUpType> a rdf:Property ;
    rdfs:comment """It specifies the traffic type of the target node. This will
also result in collecting appropriate management data from the nodes
handling the specified traffic (e.g AMF for CP and UPF for UP).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter/networkDomain> a rdf:Property ;
    rdfs:comment """It specifies the network domain of the target node. This
will also result in collecting appropriate management data from the
nodes belonging to the specified domain.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter/objectInstances> a owl:ObjectProperty ;
    rdfs:comment """List of managed object instances. Each object instance is
identified by its DN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter/sst> a rdf:Property ;
    rdfs:comment """It specifies the slice service type (SST) of which the slice
subnet should be targeted. Please refer to 3GPP TS 23.501: 'System
Architecture for the 5G System'""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/NodeFilter> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/mgtDataCategoryType> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managementdatacollection/reportingCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo/hysteresis> a rdf:Property ;
    rdfs:comment """Hysteresis of a threshold. If this attribute is present
the monitored performance metric is not compared against the
threshold value as specified by the thresholdValue attribute but
against a high and low threshold value given by

threshold-high = thresholdValue + hysteresis
threshold-low = thresholdValue - hysteresis

When going up, the threshold is triggered when the performance metric
reaches or crosses the high threshold value. When going down, the
hreshold is triggered when the performance metric reaches or crosses
the low threshold value.

A hysteresis may be present only when the monitored performance
metric is not of type counter that can go up only. If present
for a performance metric of type counter, it shall be ignored.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo/performanceMetrics> a rdf:Property ;
    rdfs:comment """List of performance metrics.
Performance metrics include measurements defined in TS 28.552 and KPIs
defined in TS 28.554 [28]. Performance metrics can also be specified
by other SDOs, or be vendor specific. Performance metrics are
identified with their names.

For measurements defined in TS 28.552 the name is constructed as the
bullet e) of the measurement definition.

A name can also identify a vendor specific performance metric or a
group of vendor specific performance metrics.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo/thresholdDirection> a rdf:Property ;
    rdfs:comment """Direction of a threshold indicating the direction for which
a threshold crossing triggers a threshold.

When the threshold direction is configured to 'UP', the associated
treshold is triggered only when the performance metric value is going
up upon reaching or crossing the threshold value. The treshold is not
triggered, when the performance metric is going down upon reaching or
crossing the threshold value.

Vice versa, when the threshold direction is configured to 'DOWN', the
associated treshold is triggered only when the performance metric is
going down upon reaching or crossing the threshold value. The treshold
is not triggered, when the performance metric is going up upon reaching
or crossing the threshold value.

When the threshold direction is set to 'UP_AND_DOWN' the treshold is
active in both direcions.

In case a threshold with hysteresis is configured, the threshold
direction attribute shall be set to 'UP_AND_DOWN'.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo/thresholdValue> a rdf:Property ;
    rdfs:comment """Value against which the monitored performance metric is
compared at a threshold level in case the hysteresis is zero""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mecontext/MeContext/dnPrefix> a owl:ObjectProperty ;
    rdfs:comment """It carries the DN Prefix information or no information.
The instance of MeContext is the local root instance of the MIB.
Otherwise the attribute shall be absent or carry no information.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mecontext/MeContext> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-mecontext/MeContext/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mecontext/MeContext> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsagent/MnsAgent/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsagent/MnsAgent> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsagent/MnsAgent/systemDN> a owl:ObjectProperty ;
    rdfs:comment "Distinguished Name (DN) of a IRPAgent or a MnSAgent." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsagent/MnsAgent> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/category> a rdf:Property ;
    rdfs:comment """This attributes defines the type of management data that
are requested.

Allowed values for data category are COVERAGE, CAPACITY,
ENERGY_EFFICIENCY, MOBILITY, ACCESSIBILITY. The data categories
will map to certain measurement families defined in TS 28.552, see
below. In addition to the below mappings, MnS producer may map the
provided categories to any additional proprietary management data,
as appropriate.

- The COVERAGE category will map to measurement families of MR
(measurements related to Measurement Report) and L1M (measurements
related to Layer 1 Measurement).

- The CAPACITY category will map to measurement family RRU
(measurements related to Radio Resource Utilization).

- The ENERGY_EFFICIENCY category will map to measurement family PEE
(measurements related to Power, Energy and Environment).

- The MOBILITY category will map to measurement family MM
(measurements related to Mobility Management).

- The ACCESSIBILITY category will map to measurement family CE
(measurements related to Connection Establishment).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/historicalDataPeriod> a rdf:Property ;
    rdfs:comment """This attribute describes the maximum period of the requested
historical data. The period is defined in seconds.
When the value of this attribute is NULL, which means the capability of
querying historical data is not supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/name> a rdf:Property ;
    rdfs:comment """List of management data identified by name.

The list may include metrics or set of metrics defined
in TS 28.552, TS 28.554 and TS 32.422.

The metrics are identified with their names/identifiers.
For performance measurements defined in TS 28.552 the name is
constructed as the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined according to the
KPI definitions template as the component designated with a).

For trace metrics (including trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RRC, RLF and RCEF
reports) defined in TS 32.422, the name (metric identifier) is
defined in clause 10 of TS 32.422.

For non-3GPP specified managment data the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedDataReportingMnSRef> a owl:ObjectProperty ;
    rdfs:comment """List of DN of MnSInfo for the MnS instance(s) which can be
used to report the associated management data""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedDataRequestMnSRef> a owl:ObjectProperty ;
    rdfs:comment """List of DN of MnSInfo for the MnS instance(s) which can be
used to request the associated management data""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedDataScope> a rdf:Property ;
    rdfs:comment """List of supported sub counter capabilities for the associated
management data""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedGranularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the production of
associated management data. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedReportingMethod> a rdf:Property ;
    rdfs:comment """List of supported reporting methods for the associated
management data.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo/supportedReportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated management
data. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MgmtDataInfo> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mgmtDataInfoRef> a owl:ObjectProperty ;
    rdfs:comment """List of DN of MgmtDataInfo instance(s) which are associated
the MnSInfo which represent a management service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsAddress> a rdf:Property ;
    rdfs:comment "Addressing information for Management Service operations." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsCapability> a rdf:Property ;
    rdfs:comment """It describes the types of management capabilities of the
MnS instance provided by the MnS producer. The detailed description for
above enum values see Annex F in TS 28.533.
Note: vendor extension values are allowed for the attribute
'mnsCapability'""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsLabel> a rdf:Property ;
    rdfs:comment "Human-readable name of management service." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsScope> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the information about the
management scope of the Management Service. The management scope is
used to represent  the set of managed object instances that can be
accessed using the Management Service.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsScope> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsType> a rdf:Property ;
    rdfs:comment "Type of management service." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo/mnsVersion> a rdf:Property ;
    rdfs:comment "Version of management service." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsRegistry/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsRegistry> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsScope/geoAreasList> a owl:ObjectProperty ;
    rdfs:comment """This attribute describes geographical areas for the
managed object instances that can be accessed using the Management
Service.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsScope> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsScope/objectInstanceList> a owl:ObjectProperty ;
    rdfs:comment """This attribute describes list of DNs for the managed
object instances that can be accessed using the Management Service.
If a complete SubNetwork can be accessed using the Management Service,
this attribute may contain the DN of the SubNetwork instead of the
DNs of the individual managed entities within the SubNetwork.

If a complete ManagedElement can be accessed using the Management
Service, this attribute may contain the DN of the ManagedElement
instead of the DNs of the individual managed entities within the
ManagedElement.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsScope> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsScope/taiList> a owl:ObjectProperty ;
    rdfs:comment """This attribute describes the list of Tracking Area
Identities (TAI) for the managed object instances that can be accessed
using the Management Service.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-mnsregistry/MnsScope> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/areaScope> a owl:ObjectProperty ;
    rdfs:comment """It defines the area scope of QoE, which is specified
in clause 5.4 of TS 28.405.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/availableRANqoEMetrics> a rdf:Property ;
    rdfs:comment """This parameter indicates available RAN visible QoE metrics
to the gNB. This parameter is optional and is valid for NR only.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/jobId> a rdf:Property ;
    rdfs:comment """The jobId attribute presents the job identifier of a
QMCJob instance. The jobId can be used to associate  multiple QMCJob
instances. For example, it is possible to configure the same jobId
for multiple QMCJob instances required to produce the data
(e.g. Streaming services and MTSI reports) for a specific network
analysis.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/mBSCommunicationServiceType> a rdf:Property ;
    rdfs:comment """This attribute indicates which type of MBS communication
service the QoE measurement configuration pertains to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/mDTAlignmentInformation> a owl:ObjectProperty ;
    rdfs:comment """This parameter indicates the MDT measurements with which
alignment of QoE measurement is required. This parameter is optional
and is valid for NR only.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """Defines the PLMN for which sessions shall be selected in
the network request session in case of area based QMC when several
PLMNs are supported in the RAN (this means that shared cells and not
shared cells are allowed for the specified PLMN. Furthermore, several
PLMNs can be used for not shared RAN cases as well as for shared RAN
cases.). Only the sessions may be selected where the PLMN that the
UE reports as selected PLMN is the same as the PLMN Target.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/qMCConfigFile> a rdf:Property ;
    rdfs:comment """Provides a reference to a file including the parameters for
configuration of application layer measurements, known as Container
for Application Layer Measurement Configuration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/qoECollectionEntityAddress> a rdf:Property ;
    rdfs:comment """Specifies the address to which the QMC records shall be
transferred.  Ipv4 or Ipv6 address(es) may be used.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/qoEReference> a rdf:Property ;
    rdfs:comment """Identifies the QoE measurement collection job in the
Managed Elements and in the measurement collection entity.  The QoE
reference shall be globally unique therefore it is composed as follows:
MCC+MNC+QMC ID, where the MCC and MNC are coming with the QMC
activation request from the management system to identify one PLMN
containing the management system, and QMC ID is a 3 byte Octet String.
The QMC ID is generated by the management system or the operator.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/qoETarget> a rdf:Property ;
    rdfs:comment """Specifies the target object of the QMC in case of
signalling based QMC.  The qoETarget attribute shall be able
to carry IMSI or SUPI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/serviceType> a rdf:Property ;
    rdfs:comment "Specifies an end user service type for QoE measurements." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob/sliceScope> a owl:ObjectProperty ;
    rdfs:comment """Contains a list of S-NSSAIs (Single Network Slice Selection
Assistance Information).  A Network Slice end to end is identified by
S-NSSAI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/QMCJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScope> .

<urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScope/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScope> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScope/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-qmcjob/sliceScope> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/administrativeState> a rdf:Property ;
    rdfs:comment """When set to UNLOCKED, the alarm list is updated.
When the set to LOCKED, the existing alarm records are not
updated, and new alarm records are not added to the alarm list.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/alarmRecords> a owl:ObjectProperty ;
    rdfs:comment "List of alarmRecords" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-fm/AlarmRecord> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/lastModification> a rdf:Property ;
    rdfs:comment "The last time when an alarm record was modified" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/numOfAlarmRecords> a rdf:Property ;
    rdfs:comment "The number of alarm records in the AlarmList" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/operationalState> a rdf:Property ;
    rdfs:comment """The producer sets this attribute to ENABLED, indicating
that it has the resource and ability to record alarm in AlarmList
else, it sets the attribute to DISABLED.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList/unreliableAlarmScope> a owl:ObjectProperty ;
    rdfs:comment """Identifies, the part of the alarm scope that may not be
reliable.

If this parameter is equal to the instance carried in systemDN,
then all AlarmRecord instances in the AlarmList may not be reliable.

If this parameter is equal to some instance represented by
MonitoredEntity, then only AlarmRecord related to this instance and
its descendants may not be reliable.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/AlarmList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/Configurable5QISet/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/Configurable5QISet> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/_5GCNfConnEcmInfoList> a owl:ObjectProperty ;
    rdfs:comment """The attribute specifies a list of 5GCNfConnInfo which is
defined as a datatype (see clause 5.3.120). It is used to
provide 5GC NFs, such as PCF, NEF, SCEF, that are connected EDN NFs,
such as EAS, EES, and ECS.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/_5GCNfConnEcmInfo> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eASIpAddress> a rdf:Property ;
    rdfs:comment """This parameter defines address of an EAS instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eASServiceArea> a owl:ObjectProperty ;
    rdfs:comment """This parameter defines the EAS service area
(see clause 7.3.3.6 in TS 23.558).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/ServingLocation> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eCSIpAddress> a rdf:Property ;
    rdfs:comment """This parameter defines address of an ECS instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eDNServiceArea> a owl:ObjectProperty ;
    rdfs:comment """This parameter defines the EDN service area
(see clause 7.3.3.4 in TS 23.558)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/ServingLocation> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eESIpAddress> a rdf:Property ;
    rdfs:comment """This parameter defines address of an EES instance.
It can be IP address (either IPv4 address (See RFC 791) or IPv6
address (See RFC 2373). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/eESServiceArea> a owl:ObjectProperty ;
    rdfs:comment """This parameter defines the EES service area
(see clause 7.3.3.5 in TS 23.558).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/ServingLocation> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/ecmConnectionType> a rdf:Property ;
    rdfs:comment """It indicates the type of ECM connection (i.e., user plane
connection via UPF, control plane connection via PCF or NEF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/ednIdentifier> a rdf:Property ;
    rdfs:comment "The identifier of the edge data network (See TS 23.558)." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo/uPFConnectionInfo> a owl:ObjectProperty ;
    rdfs:comment """The attribute is defined as a datatype UPFConnInfo
(see clause 5.3.121). It is used to provide the UPF IP address and
UPF DN. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/EcmConnectionInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ecmconnectioninfo/UPFConnInfo> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/averagingWindow> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/fiveQIValue> a rdf:Property ;
    rdfs:comment "Identifies the 5QI value." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/maximumDataBurstVolume> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/packetDelayBudget> a rdf:Property ;
    rdfs:comment """Indicates the Packet Delay Budget (in unit of 0.5ms)of a 5QI,
as specified in TS 23.501 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/packetErrorRate> a owl:ObjectProperty ;
    rdfs:comment """It indicates the Packet Error Rate of a 5QI,
as specified in TS 23.501.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-configurable5qiset/PacketErrorRate> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/priorityLevel> a rdf:Property ;
    rdfs:comment """It indicates the Priority Level of a 5QI, as specified
in TS 23.501.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics/resourceType> a rdf:Property ;
    rdfs:comment """It indicates the Resource Type of a 5QI, as specified
in TS 23.501 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/FiveQICharacteristics> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl/heartbeatNtfPeriod> a rdf:Property ;
    rdfs:comment """Specifies the periodicity of heartbeat notification emission.
The value of zero has the special meaning of stopping the heartbeat
notification emission.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl/triggerHeartbeatNtf> a rdf:Property ;
    rdfs:comment """Setting this attribute to 'true' triggers an immediate
additional heartbeat notification emission. Setting the value to
'false' has no observable result.

The periodicity of notifyHeartbeat emission is not changed.

After triggering the heartbeat the system SHALL set the value
back to false.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/HeartbeatControl> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/administrativeState> a rdf:Property ;
    rdfs:comment """It indicates the administrative state of the MWAB instance.
It describes the permission to use or prohibition against using the
MWAB functionalities, imposed through the OAM services.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/allowedArea> a owl:ObjectProperty ;
    rdfs:comment """This specifies the area where the MWAB can act as MWAB-gNB.
If the OAM indicates that the MWAB can act as MWAB-gNB is allowed areas,
it acts as MWAB-gNB only on the allowed area only.
(See sub clause 5.49 TS 28.662).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/allowedTime> a owl:ObjectProperty ;
    rdfs:comment """This specifies the time window for which the MWAB can act
as MWAB-gNB. If the allowed time window/ validity indicates 20th June,
10 am to 5 pm of the day, the MWAB acts as an MWAB g-NB only during 20th
June, 10 am to 5 pm of the day, and does not act as MWAB-gNB for any
other time. (See sub clause 5.49 [11]).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/currentLocation> a owl:ObjectProperty ;
    rdfs:comment """This parameter specifies the current location
of mobile NR node (e.g., IAB-node, MWAB-node).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/mnrOamIPConfig> a owl:ObjectProperty ;
    rdfs:comment """It is IP configutation for OAM connectivity used
by a mobile NR node (e.g., IAB-node, MWAB-node)
to establish connection with management system as specified
in TS 28.314[x] clause 6.1.2""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB/operationalState> a rdf:Property ;
    rdfs:comment """It indicates the operational state of the MWAB instance.
It describes whether the resource is installed and partially or fully
operable (Enabled) or the resource is not installed or not
operable (Disabled).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/MWAB> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule/eCMRInputMaxValue> a rdf:Property ;
    rdfs:comment """The maximum value of to be applied
for mapping from this attribute to the energy cost.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule/eCMRInputMinValue> a rdf:Property ;
    rdfs:comment """The minimum value of to be applied
for mapping from this attribute to the energy cost.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule/eCTimeInterval> a rdf:Property ;
    rdfs:comment """Time interval (in seconds) that
should be applied for collecting values of mapping
rule attribute to be used for computing the energy cost.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NRECMappingRule> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/firstEventTime> a rdf:Property ;
    rdfs:comment """eventTime of first notification available.
The attribute may be missing if and only if there are no notifications
in the NotificationList.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/lastEventTime> a rdf:Property ;
    rdfs:comment """eventTime of latest notification available.
The attribute may be missing if and only if there are no notifications
in the NotificationList.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/notificationEntries> a owl:ObjectProperty ;
    rdfs:comment """Representation of the individual notifications.
The entries shall be ordered based on eventTime of the notification,
newest first.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-subscription-control/NotificationEntry> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/notificationFilter> a rdf:Property ;
    rdfs:comment """Filter to be applied to candidate notifications identified
by the notificationTypes attribute. Only notifications that pass the
filter criteria are included. All other notifications are discarded.
The filter can be applied to any field of a notification.

The format of the string shall confrm to a
JSON expressions (Jex) 'JexConditionsExpr'""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList/notificationTypes> a rdf:Property ;
    rdfs:comment "List of notification types." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NotificationList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/availabilityStatus> a rdf:Property ;
    rdfs:comment """The availability status provides additional information
about the operational state""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/lastSequenceNo> a rdf:Property ;
    rdfs:comment """The sequence number of the last notification that was sent
by a 'NtfSubscriptionControl' instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/notificationFilter> a rdf:Property ;
    rdfs:comment """Defines a filter to be applied to candidate notifications
identified by the notificationTypes attribute.
If notificationFilter is present, only notifications that pass the
filter criteria are forwarded to the notification recipient; all other
notifications are discarded.
The filter can be applied to any field of a notification.

The format of the string shall confrm to a
JSON expressions (Jex) 'JexConditionsExpr'""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/notificationRecipientAddress> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/notificationTypes> a rdf:Property ;
    rdfs:comment """Defines the types of notifications that are candidates
for being forwarded to the notification recipient.
If the notificationTypes attribute is not supported or not present
all candidate notifications types are forwarded to the notification;
discriminated by notificationFilter attribute.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/operationalState> a rdf:Property ;
    rdfs:comment """Operational state of manged object instance.
The operational state describes if an object instance is operable
('ENABLED') or inoperable ('DISABLED').
This state is set by the object instance or the MnS producer and
is hence READ-ONLY.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl/scope> a owl:ObjectProperty ;
    rdfs:comment "Scopes (selects) data nodes in an object tree." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/NtfSubscriptionControl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-subscription-control/Scope> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/dnPrefix> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/setOfMcc> a rdf:Property ;
    rdfs:comment """Set of Mobile Country Code (MCC).
The MCC uniquely identifies the country of domicile
of the mobile subscriber. MCC is part of the IMSI (3GPP TS 23.003)

This list contains all the MCC values in subordinate object
instances to this SubNetwork instance.

See clause 2.3 of 3GPP TS 23.003 for MCC allocation principles.

It shall be supported if there is more than one value in setOfMcc
of the SubNetwork. Otherwise the support is optional.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/userDefinedNetworkType> a rdf:Property ;
    rdfs:comment "Textual information indicating network type, e.g. 'UTRAN'." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SubNetwork> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications/notificationProtocols> a rdf:Property ;
    rdfs:comment "List of protocols supported for notifications." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications/notificationTypes> a rdf:Property ;
    rdfs:comment "List of notification types supported by the MnS producer" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedNotifications> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-subnetwork/traceTarget> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subnetwork/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subnetwork/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subscription-control/NotificationEntry/eventTime> a rdf:Property ;
    rdfs:comment "eventTime from the header of the notification" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subscription-control/NotificationEntry> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subscription-control/NotificationEntry/notificationContent> a rdf:Property ;
    rdfs:comment """The string representation of a notification as encoded in
the HTTP body (excluding the HTTP headers and the optional VES header).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subscription-control/NotificationEntry> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subscription-control/NotificationEntry/notificationEntryId> a rdf:Property ;
    rdfs:comment """Identifier of an individual notificationEntry; unique within
a NotificationList MOI.

allowedValues:
- If the NotificationList is contained under an NtfSubscriptionControl
the value is the same as the notification's sequenceNo.
- If the NotificationList is contained under SubNetwork or
ManagedElement the value is the DN of the NtfSubscriptionControl that
created the notification followed by a single '*' asterisk character
and the sequenceNo.
e.g. 'ManagedElement=me1,NtfSubscriptionControl=Fault1*12345'""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subscription-control/NotificationEntry> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-subscription-control/NotificationTypes> a rdfs:Datatype ;
    rdfs:comment "An extensible enumeration of notification types" .

<urn:3gpp:sa5:_3gpp-common-subscription-control/Scope/datastore-subtree-filter> a rdf:Property ;
    rdfs:comment "Subtree filter" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subscription-control/Scope> .

<urn:3gpp:sa5:_3gpp-common-subscription-control/Scope/datastore-xpath-filter> a rdf:Property ;
    rdfs:comment "XPath-filter" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subscription-control/Scope> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-subscription-control/Scope/scopeLevel> a rdf:Property ;
    rdfs:comment "See description of scopeType." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subscription-control/Scope> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-common-subscription-control/Scope/scopeType> a rdf:Property ;
    rdfs:comment """If the optional scopeLevel parameter is not supported
or absent, allowed values of scopeType are BASE_ONLY and BASE_ALL.

The value BASE_ONLY indicates only the base object is selected.
The value BASE_ALL indicates the base object and all of its
subordinate objects (incl. the leaf objects) are selected.

If the scopeLevel parameter is supported and present, allowed
values of scopeType are BASE_ALL, BASE_ONLY, BASE_NTH_LEVEL
and BASE_SUBTREE.

The value BASE_NTH_LEVEL indicates all objects on the level,
which is specified by the scopeLevel parameter, below the base
object are selected. The base object is at scopeLevel zero.
The value BASE_SUBTREE indicates the base object and all of its
subordinate objects down to and including the objects on the level,
which is specified by the scopeLevel parameter, are selected.
The base object is at scopeLevel zero.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-subscription-control/Scope> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/AreaConfig/freqInfo> a owl:ObjectProperty ;
    rdfs:comment """It specifies the carrier frequency and bands used in
a cell.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/AreaConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/FreqInfo> .

<urn:3gpp:sa5:_3gpp-common-trace/AreaConfig/pciList> a rdf:Property ;
    rdfs:comment "List of neighbour cells subject for MDT scope." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/AreaConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/ExcessPacketDelayThresholds/excessPacketDelayThresholdValue> a rdf:Property ;
    rdfs:comment """Value of excess packet delay threshold
for M6 UL measurement in milliseconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ExcessPacketDelayThresholds> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-trace/ExcessPacketDelayThresholds/fiveQIValue> a rdf:Property ;
    rdfs:comment "It indicates 5QI value." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ExcessPacketDelayThresholds> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-trace/FreqInfo/arfcn> a rdf:Property ;
    rdfs:comment """RF Reference Frequency as defined in TS 38.104,
clause 5.4.2.1. The frequency provided identifies the absolute
frequency position of the reference resource block (Common RB 0)
of the carrier. Its lowest subcarrier is also known as Point A.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/FreqInfo> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/FreqInfo/freqBands> a rdf:Property ;
    rdfs:comment """List of NR frequency operating bands. Primary NR
Operating Band as defined in TS 38.104, clause 5.4.2.3.
The value 1 corresponds to n1, value 2 corresponds to NR operating
band n2, etc.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/FreqInfo> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/beamLevelMeasurement> a rdf:Property ;
    rdfs:comment """Indicates whether the NR M1 beam level measurements shall
be included or not.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/collectionPeriodM6LTE> a rdf:Property ;
    rdfs:comment """Specifies the collection period for the Packet Delay
measurement (M6) for MDT taken by the eNB. The attribute is applicable
only for Immediate MDT. In case this attribute is not used,
it carries a null semantic.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/collectionPeriodM6NR> a rdf:Property ;
    rdfs:comment """It specifies the collection period for the Packet Delay
measurement (M6) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/collectionPeriodM7LTE> a rdf:Property ;
    rdfs:comment """It specifies the collection period for the Packet Loss Rate
measurement (M7) for LTE MDT taken by the eNB. The attribute is
applicable only for Immediate MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/collectionPeriodM7NR> a rdf:Property ;
    rdfs:comment """It specifies the collection period for the Packet Loss Rate
measurement (M7) for NR MDT taken by the gNB. The attribute is
applicable only for Immediate MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/collectionPeriodRRMLTE> a rdf:Property ;
    rdfs:comment """Specifies the collection period for collecting RRM configured
measurement samples for M3 in LTE. The attribute is applicable only
for Immediate MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/collectionPeriodRRMNR> a rdf:Property ;
    rdfs:comment """Specifies the collection period for collecting RRM
configured measurement samples for M4, M5 in NR. The attribute is
applicable only for Immediate MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/collectionPeriodRRMUMTS> a rdf:Property ;
    rdfs:comment """Specifies the collection period for collecting RRM configured
measurement samples for M3, M4, M5 in UMTS. The attribute is applicable
only for Immediate MDT. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/eventThreshold> a rdf:Property ;
    rdfs:comment """Specifies the threshold which should trigger the reporting
in case A2 event reporting in LTE or 1F/1l event in UMTS. The attribute
is applicable only for Immediate MDT and when reportingTrigger is
configured for A2 event in LTE or 1F event or 1l event in UMTS.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:long .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/eventThresholdUphUMTS> a rdf:Property ;
    rdfs:comment """It specifies the threshold which should trigger
the reporting in case of event-triggered periodic reporting for M4
(UE power headroom measurement) in UMTS.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/excessPacketDelayThresholds> a owl:ObjectProperty ;
    rdfs:comment "Excess packet delay thresholds info for M6 UL measurement." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/ExcessPacketDelayThresholds> .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/listOfMeasurements> a rdf:Property ;
    rdfs:comment """It specifies the UE measurements that shall be
collected in an Immediate MDT job. The attribute is
applicable only for Immediate MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/measurementPeriodLTE> a rdf:Property ;
    rdfs:comment """It specifies the measurement period for the
Data Volume (M4) and Scheduled IP throughput
measurements (M5) for LTE MDT taken by the eNB.
The attribute is applicable only for Immediate MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/measurementPeriodUMTS> a rdf:Property ;
    rdfs:comment """It specifies the measurement period for the Data Volume and
Throughput measurements for MDT taken by RNC.
The attribute is applicable only for Immediate MDT. In case this
attribute is not used, it carries a null semantic.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/measurementQuantity> a rdf:Property ;
    rdfs:comment """It specifies the measurements that are collected in an MDT
job for a UMTS MDT configured for event triggered reporting.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/positioningMethod> a rdf:Property ;
    rdfs:comment """It specifies what positioning method should be used in the
MDT job.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmount> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM1LTE> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM1NR> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM4LTE> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM4NR> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM5LTE> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM5NR> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM6LTE> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM6NR> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM7LTE> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for LTE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportAmountM7NR> a rdf:Property ;
    rdfs:comment """It specifies the number of measurement reports that shall be
taken for periodic reporting while the UE is in connected mode.
The attribute is applicable only for Immediate MDT and combined Trace
and Immediate MDT and when reportingTrigger is configured for periodical
measurements and applicable only for NR.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportInterval> a rdf:Property ;
    rdfs:comment """It specifies the interval between the periodical measurements
that shall be taken when the UE is in connected mode.
The attribute is applicable only for Immediate MDT and when
reportingTrigger is configured for periodical measurements.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig/reportingTrigger> a rdf:Property ;
    rdfs:comment """It specifies whether periodic or event based measurements
should be collected.
The attribute is applicable only for Immediate MDT and when the
listOfMeasurements is configured for M1 (for both UMTS and LTE)
or M2 (only for UMTS).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/areaConfigurationForNeighCell> a owl:ObjectProperty ;
    rdfs:comment """It specifies the area for which UE is requested to perform
measurement logging for neighbour cells which have list of frequencies.
If it is not configured, the UE shall perform measurement logging for
all the neighbour cells.

Applicable only to NR Logged MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/AreaConfig> .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/eventListForEventTriggeredMeasurement> a rdf:Property ;
    rdfs:comment """Specifies event types for event triggered measurement in the
case of logged NR MDT.  Each trace session may configure at most one
event. The UE shall perform logging of measurements only upon certain
condition being fulfilled:
- Out of coverage.
- A2 event.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/eventThresholdL1> a rdf:Property ;
    rdfs:comment """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT and when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/hysteresisL1> a rdf:Property ;
    rdfs:comment """It specifies the hysteresis used within the entry and leave
condition of the L1 event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/loggingDuration> a rdf:Property ;
    rdfs:comment """Specifies how long the MDT configuration is valid at the
UE in case of Logged MDT. The attribute is applicable only for
Logged MDT and Logged MBSFN MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/loggingInterval> a rdf:Property ;
    rdfs:comment """Specifies the periodicty for Logged MDT. The attribute is
applicable only for Logged MDT and Logged MBSFN MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/mbsfnAreaList> a owl:ObjectProperty ;
    rdfs:comment """The MBSFN Area consists of a MBSFN Area ID and Carrier
Frequency (EARFCN). The target MBSFN area List can have up to 8 entries.
This parameter is applicable only if the job type is Logged MBSFN MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MbsfnArea> .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/nPNIdentityList> a owl:ObjectProperty ;
    rdfs:comment """It defines which NPNs that can be served by the NR cell,
and which CAG IDs or NIDs can be supported by the NR cell for
corresponding PNI-NPN or SNPN in case of the cell is NPN-only cell.
(NPN-Identity referring to TS 38.331)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/reportType> a rdf:Property ;
    rdfs:comment "It specifies report type for logged NR MDT" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/timeToTriggerL1> a rdf:Property ;
    rdfs:comment """It specifies the threshold which should trigger
the reporting in case of event based reporting of logged NR MDT.
The attribute is applicable only for Logged MDT, when reportType
is configured for event triggered reporting and when
eventListForEventTriggeredMeasurement is configured for L1 event.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig/traceCollectionEntityId> a rdf:Property ;
    rdfs:comment """It specifies the TCE Id which is sent to the UE in
Logged MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> ;
    rdfs:range xsd:long .

<urn:3gpp:sa5:_3gpp-common-trace/MbsfnArea/earfcn> a rdf:Property ;
    rdfs:comment "Carrier Frequency" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MbsfnArea> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/MbsfnArea/mbsfnAreaId> a rdf:Property ;
    rdfs:comment "MBSFN Area Identifier" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MbsfnArea> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/MdtConfig/anonymizationOfMdtData> a rdf:Property ;
    rdfs:comment """Specifies level of anonymization of MDT data.
This attribute is only applicable for management based activation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/MdtConfig/areaScope> a owl:ObjectProperty ;
    rdfs:comment "It specifies the area where data shall be collected. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> .

<urn:3gpp:sa5:_3gpp-common-trace/MdtConfig/immediateMdtConfig> a owl:ObjectProperty ;
    rdfs:comment """The set of parameters specific for Immediate MDT
configuration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/ImmediateMdtConfig> .

<urn:3gpp:sa5:_3gpp-common-trace/MdtConfig/loggedMdtConfig> a owl:ObjectProperty ;
    rdfs:comment """The set of parameters specific for Logged MDT and Logged
MBSFN MDT configuration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/LoggedMdtConfig> .

<urn:3gpp:sa5:_3gpp-common-trace/MdtConfig/mNOnly> a rdf:Property ;
    rdfs:comment """Specifies whether the MDT configuration is for MN
only or not. The value FALSE means the MDT configuration is for
both MN and SN. The value TRUE means the MDT configuration is
for MN only.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-trace/MdtConfig/plmnList> a owl:ObjectProperty ;
    rdfs:comment """It indicates the PLMNs where measurement collection, status
indication and log reporting is allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnList> .

<urn:3gpp:sa5:_3gpp-common-trace/MdtConfig/sensorInformation> a rdf:Property ;
    rdfs:comment """It specifies which sensor information shall be included in
logged NR MDT and immediate NR MDT measurement if they are available.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/MdtConfig/trsrPrefixCfg> a owl:ObjectProperty ;
    rdfs:comment """The TRSR prefix configuration parameters which are used by
NR-RAN at TRSR assignment for a given C-MDT job. It defines both the
base TRSR prefix and the size of the TRSR prefix. The attribute
trstPrefix specifies the base TRSR prefix. The attribute
trsrPrefixLength defines the size of base TRSR prefix.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TrsrPrefixCfg> .

<urn:3gpp:sa5:_3gpp-common-trace/TraceConfig/listOfInterfaces> a rdf:Property ;
    rdfs:comment """Specifies the interfaces that need to be traced in the given
ManagedEntityFunction.The attribute is applicable only for Trace. In
case this attribute is not used, it carries a null semantic.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/TraceConfig/listOfNeTypes> a rdf:Property ;
    rdfs:comment """Specifies the network element types where the trace should
be activated. The attribute is applicable only for Trace with
Signalling Based Trace activation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/TraceConfig/traceDepth> a rdf:Property ;
    rdfs:comment """It specifies the trace depth. The attribute is applicable
only for Trace.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/TraceConfig/triggeringEvents> a owl:ObjectProperty ;
    rdfs:comment """It specifies the triggering event parameter of the trace
session. The attribute is applicable only for Trace.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/triggeringEvents> .

<urn:3gpp:sa5:_3gpp-common-trace/TraceReference/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/TraceReference/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/TraceReference/traceId> a rdf:Property ;
    rdfs:comment """An identifier, which identifies the Trace
(together with MCC and MNC). This is a 3 byte Octet String,
expressed in hexadecimal form e.g., '1a7b3d').""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/TrsrPrefixCfg/trsrPrefix> a rdf:Property ;
    rdfs:comment "A 2 byte Octet String. This is the base TRSR prefix" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/TrsrPrefixCfg> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/TrsrPrefixCfg/trsrPrefixLength> a rdf:Property ;
    rdfs:comment """An integer to indicate how many bits are used for the
TRSR prefix""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/TrsrPrefixCfg> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig/nfTypeToMeasure> a rdf:Property ;
    rdfs:comment """It indicates the type of NE to produce the 5GC UE level
measurements.

allowedValues: The NF types represented by the measured object
classes as defined by f) of the 5GC UE level measurements specified
in TS 28.558.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig/objectInstances> a rdf:Property ;
    rdfs:comment """List of object instances.
Each object instance is identified by its DN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig/rootObjectInstances> a rdf:Property ;
    rdfs:comment """List of root object instances.
Each object instance is identified by its DN and designates
the root of a substree that contains the root object and all
descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig/ueCoreMeasGranularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce 5GC UE
level measurements. The period is defined in milliseconds (ms).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig/ueCoreMeasurements> a rdf:Property ;
    rdfs:comment """List of 5GC UE level measurements identified by name.

The list may include 5GC UE level measurements defined in TS 28.558,
or vendor specific measurements.

For non-3GPP specified 5GC UE level measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor/condition> a rdf:Property ;
    rdfs:comment """A logical condition containing an XPath expression.
The leaf contains an XPath 1.0 string with the following restrictions
- The accessible tree is the full Network Resource Model
- The root node is the list representing the top level MOI
(E.g. ManagedElement)
- In the accessible tree, all leafs and leaf-lists with default values
in use exist
- The data tree has no concept of document order except when 'ordered-by
user' is declared.
- The set of variable bindings is empty.
- The function library is the core function library defined in XPATH
- Namespaces should be ignored when evaluating the expression

An empty string is not allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor/conditionStatus> a rdf:Property ;
    rdfs:comment """The boolean result of the condition.
Switches between TRUE and FALSE depending upon whether the
configured constraints are fulfilled or not.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/ConditionMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-util/Scheduler/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/Scheduler> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-util/Scheduler/schedulerStatus> a rdf:Property ;
    rdfs:comment """Switches between TRUE and FALSE depending upon whether the
configured time constraints are fulfilled or not.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/Scheduler> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-util/Scheduler/schedulingTimes> a owl:ObjectProperty ;
    rdfs:comment "It defines the active scheduling times." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/Scheduler> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-util/SchedulingTime> .

<urn:3gpp:sa5:_3gpp-common-util/SchedulingTime/daysOfMonth> a rdf:Property ;
    rdfs:comment """Shall be present in case of Monthly periodicity,
otherwise not""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/SchedulingTime> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-util/SchedulingTime/daysOfWeek> a rdf:Property ;
    rdfs:comment """Shall be present in case of Weekly periodicity,
otherwise not""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/SchedulingTime> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-util/SchedulingTime/endTime> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/SchedulingTime> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-util/SchedulingTime/startTime> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/SchedulingTime> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-util/SchedulingTime/timeIntervals> a owl:ObjectProperty ;
    rdfs:comment """List of intervals within one day for which the service
shall be active.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/SchedulingTime> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-util/TimeInterval> .

<urn:3gpp:sa5:_3gpp-common-util/TimeInterval/intervalEnd> a rdf:Property ;
    rdfs:comment """It indicates the time (in 'full-time' format) when the
service shall be stopped.
'FullTime' defines the time as specified by 'full-time' in RFC3339.
intervalEnd should use the same timezone as intervalStart and shall
be later then intervalStart""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/TimeInterval> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-util/TimeInterval/intervalStart> a rdf:Property ;
    rdfs:comment """It indicates the time (in 'full-time' format) when the
service shall be started.
Data type 'FullTime' defines the time as specified by 'full-time'
in RFC3339.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-util/TimeInterval> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-yang-types/AdministrativeState> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/Altitude> a rdfs:Datatype ;
    rdfs:comment "Height from a reference 0 value." .

<urn:3gpp:sa5:_3gpp-common-yang-types/AmfPointer> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/AmfRegionId> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/AmfSetId> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/AvailabilityStatus> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/BasicAdministrativeState> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/CagId> a rdfs:Datatype ;
    rdfs:comment """This represents the identifier of a Closed Access
Group (CAG), which together with a PLMN ID is used to
identify a PNI-NPN.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/CellState> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/DateMonth> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/DateMonthDay> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/DayOfWeek> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/DistinguishedName> a rdfs:Datatype ;
    rdfs:comment """Represents the 3GPP standard for DistinguishedName.

Limitations:
- RDNSeparator: don't allow SpaceChar or CarriageReturnChar
- NullDN: Disallow nullDN that is the same as not providing a DN
- NamesOfClassAndNamingAttribute format not allowed
(eg. ManagedElement.mykey=345436)""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/EnabledDisabled> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/EutraCellId> a rdfs:Datatype ;
    rdfs:comment """28-bit string identifying an E-UTRA Cell Id
as specified in clause 9.3.1.9 of 3GPP TS 38.413
in hexadecimal representation. Each character in the
string shall take a value of '0' to '9', 'a' to 'f'
or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most
significant bits of the Cell Id shall appear first in the
string, and the character representing the 4 least
significant bit of the Cell Id shall appear last in the
string.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/FullTime> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea/geoPolygon> a owl:ObjectProperty ;
    rdfs:comment """Specifies the geographical area with a convex polygon.
The convex polygon is specified by its corners.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate/altitude> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate/latitude> a rdf:Property ;
    rdfs:comment """Latitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to the
northern hemisphere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate/longitude> a rdf:Property ;
    rdfs:comment """Longitude based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/GeoCoordinate> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-yang-types/Latitude> a rdfs:Datatype ;
    rdfs:comment "Latitude values" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Load> a rdfs:Datatype ;
    rdfs:comment "Latest known load information of the NF, percentage " .

<urn:3gpp:sa5:_3gpp-common-yang-types/Longitude> a rdfs:Datatype ;
    rdfs:comment "Longitude values" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Mcc> a rdfs:Datatype ;
    rdfs:comment """The mobile country code consists of three decimal digits,
The first digit of the mobile country code identifies the geographic
region (the digits 1 and 8 are not used):""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Mnc> a rdfs:Datatype ;
    rdfs:comment """The mobile network code consists of two or three
decimal digits (for example: MNC of 001 is not the same as MNC of 01)""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/N1MessageClass> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/N2InformationClass> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/Nci> a rdfs:Datatype ;
    rdfs:comment """NR Cell Identity. The NCI shall be of fixed length of 36 bits
and shall be coded using full hexadecimal representation.
The exact coding of the NCI is the responsibility of each PLMN operator""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/NfType> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/Nid> a rdfs:Datatype ;
    rdfs:comment """This represents the Network Identifier, which
together with a PLMN ID is used to identify a SNPN.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/NotificationType> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/NpnId/cAGIdList> a rdf:Property ;
    rdfs:comment """It identifies a CAG list containing up to 12
CAG-identifiers per Ue or up to 12 CAG-identifiers per cell,
see TS 38.331.
CAG ID is used to combine with PLMN ID to identify a PNI-NPN.CAG ID is
a hexadecimal range with size 32 bit""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-yang-types/NpnId/nIDList> a rdf:Property ;
    rdfs:comment """It identifies a list of NIDs containing up to 16 NIDs, see
TS 38.331. NID is used to combine with PLMN ID to identify an SNPN.
NID is a hexadecimal range with size 44 bit.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-yang-types/NpnId/plmnId> a owl:ObjectProperty ;
    rdfs:comment "It specifies the PLMN Id of the NPN network." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-common-yang-types/NrCellId> a rdfs:Datatype ;
    rdfs:comment """36-bit string identifying an NR Cell Id
as specified in clause 9.3.1.7 of 3GPP TS 38.413
in hexadecimal representation. Each character in the
string shall take a value of '0' to '9', 'a' to 'f'
or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most
significant bits of the Cell Id shall appear first in the
string, and the character representing the 4 least
significant bit of the Cell Id shall appear last in the
string.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Nrpci> a rdfs:Datatype ;
    rdfs:comment "Physical Cell Identity (PCI) of the NR cell." .

<urn:3gpp:sa5:_3gpp-common-yang-types/NsiId> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/OnOff> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/OperationalState> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/QOffsetRange> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/ResourceSharingLevel> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/SAP/host> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-yang-types/SAP/port> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-common-yang-types/Tac> a rdfs:Datatype ;
    rdfs:comment """Tracking Area Code
2 or 3-octet string identifying a tracking area code as specified in
clause 9.3.3.10 of 3GPP TS 38.413 [34], in hexadecimal representation.
Each character in the string shall take a value of
'0' to '9', 'a' to 'f' or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most significant
bits of the TAC shall appear first in the string, and the character
representing the 4 least significant bit of the TAC shall appear last
in the string.

pattern: '(^[A-Fa-f0-9]{4}$)|(^[A-Fa-f0-9]{6}$)'

Examples:
A legacy TAC 0x4305 shall be encoded as '4305'.
An extended TAC 0x63F84B shall be encoded as '63F84B'""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/Tai/plmnId> a owl:ObjectProperty ;
    rdfs:comment "PLMN Identity." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-common-yang-types/Tai/tac> a rdf:Property ;
    rdfs:comment "Tracking Area Code" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-yang-types/TenthOfDegrees> a rdfs:Datatype ;
    rdfs:comment """A single integral value corresponding to an angle in degrees
between 0 and 360 with a resolution of 0.1 degrees.""" .

<urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow/endTime> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow/startTime> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-yang-types/TxDirection> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/UeMobilityLevel> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-common-yang-types/usageState> a rdfs:Datatype ;
    rdfs:comment """It describes whether or not the resource is actively in
use at a specific instant, and if so, whether or not it has spare
capacity for additional users at that instant. The value is READ-ONLY.""" .

<urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup/energySupplyModeRefList> a owl:ObjectProperty ;
    rdfs:comment """The list of energy supply modes for the Network Elements
of the group. This information is configured by the operator with the
information obtained from external sources.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup/memberDNList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the DNs of managed entities
that are members of the energy info group.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergyInfoGroup> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo/energySupplyModeRefList> a owl:ObjectProperty ;
    rdfs:comment """The list of energy supply modes for the Network Elements
of the group. This information is configured by the operator with the
information obtained from external sources.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo/memberDNList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the DNs of managed entities
that are members of the energy info group.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-engy-nrm-energyinformation/EnergySupplyInfo> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/beamTilt> a rdf:Property ;
    rdfs:comment """The beam tilt of the wanted antenna beam
in the vertical plane. A positive value on the
beamtilt indicates an antenna beam direction below the
vertical plane.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/bearing> a rdf:Property ;
    rdfs:comment """The bearing in degrees that the antenna is pointing in.
AllowedValues: See "Antenna bearing" in 3GPP TS 25.463.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/elevation> a rdf:Property ;
    rdfs:comment """The elevation the antenna function should have,
based on World Geodetic System (1984 version) global
reference frame (WGS 84). Positive values correspond to
meters above sea level, negative values correspond to meters
below sea level. If empty, value is not defined.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/horizBeamWidth> a rdf:Property ;
    rdfs:comment """The 3 dB power beamwidth of the antenna pattern
in the horizontal plane.
A value of 360 indicates an omnidirectional antenna.
Note: The value of this attribute has no operational impact
on the network, e.g. the NE behaviour is not affected by the
value setting of this attribute.
Note as well that this attribute is not supported over the
Iuant interface according to 3GPP TS37.466.
A single integral value corresponding to an angle in degrees
between 0 and 360.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/latitude> a rdf:Property ;
    rdfs:comment """Latitude of transmitter antenna position.
Positive value means north, negative value means south.

Specification: WGS 84
Allowed Values: { -90.000000..90.000000 }""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/longititude> a rdf:Property ;
    rdfs:comment """Longitude of transmitter antenna position.
Positive value means east, negative value means west.
Specification: WGS 84
Allowed Values: { -180.000000..180.000000 }""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/maxAzimuthValue> a rdf:Property ;
    rdfs:comment """The maximum amount of change of azimuth the RET
system can support. This is the change in degrees clockwise
from bearing.
Note: The value of this attribute has no operational impact
on the network, e.g. the NE behaviour is not affected by the
value setting of this attribute.
Note as well that this attribute is not supported over the
Iuant interface according to Ref. 3GPP TS 37.466.
A single decimal value corresponding to an angle in degrees
between 0 and 360 with a resolution of 0.1 degrees.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/minAzimuthValue> a rdf:Property ;
    rdfs:comment """The minimum amount of change of azimuth the RET
system can support. This is the change in degrees clockwise
from bearing.
Note: The value of this attribute has no operational impact
on the network, e.g. the NE behaviour is not affected by the
value setting of this attribute.
Note as well that this attribute is not supported over the
Iuant interface according to Ref. 3GPP TS 37.466.
A single decimal value corresponding to an angle in degrees
between 0 and 360 with a resolution of 0.1 degrees.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/referenceFrom> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the DNs of one or more objects
that refer to this object.

In the case of  AntennaFunction,  these referring objects may
include DNs of SectorEquipmentFunction instances if associations
between them and the AntennaFunction exist.

Note: referencedBy is a DN datatype and so can reference an MOI
under a different ME""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/retGroupName> a rdf:Property ;
    rdfs:comment """The group name is a textual, alpha-numeric string to
define a logical grouping of antennas which may be in different cells.

This attribute permits the definition of a logical grouping
of the antennas. This may be defined either at
installation time, or by management activity""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/retTiltValue> a rdf:Property ;
    rdfs:comment """The electrical tilt setting of the antenna, "Tilt value" in
3GPP TS 37.466.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/vertBeamWidth> a rdf:Property ;
    rdfs:comment """The 3 dB power beamwidth of the antenna pattern in
the vertical plane.
The value of this attribute has no operational impact on
the network, e.g. the NE behaviour is not affected by the
value setting of this attribute.
This attribute is not supported over the Iuant interface
according to Ref. 3GPP TS 37.466.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/AntennaFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-antennafunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/confOutputPower> a rdf:Property ;
    rdfs:comment """It defines the allowed total power to use for all
cells together in this sector.
It may be set by the operator and/or limited by HW limitation
or licensed power, e.g.: 20, 40, 60, 80,120 watts""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/fqBandList> a rdf:Property ;
    rdfs:comment """The list of frequency bands/ranges supported by the
hardware associated with the SectorEquipmentFunction. The
earfcnDl and earfcnUl or earfcn of cells associated with the
SectorEquipmentFunction must be assigned one of the specified
frequency range values within the supported range.

Valid frequency bands/ranges may be found in 3GPP TS 25.104 (UTRA),
36.104 (E-UTRA) and 38.104 (NR).

AllowedValues:
Operating band id or supported frequency tuple
<UL,DL,mode> expressed as a string.

Examples for NR:
Bands:  {'n1', 'n12'}
Frequencies: {'1920–1980, 2110–2170, FDD', '699–716, 729–746, FDD'}""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/referenceFrom> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the DNs of one or more objects
that refer to this object.

In the case of SectorEquipmentFunction , these referring objects
may include e.g. Cells, NRSectorCarriers if associations from them
and the SectorEquipmentFunction exist.

Note: referencedBy is a DN datatype and so can reference an MOI
under a different ME""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/referenceTo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the DNs of one or more objects
referred to by this object.

In the case of SectorEquipmentFunction , these referred to objects
may include e.g. TMAFunction if associations to them
and the SectorEquipmentFunction exist.

Note: referencedBy is a DN datatype and so can reference an MOI
under a different ME""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SectorEquipmentFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/administrativeState> a rdf:Property ;
    rdfs:comment """It indicates the administrative state of the AIOTReader.
It describes the permission to use or prohibition against using the
AIOT reader, imposed through the OAM services.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/nRSectorCarrierRef> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the DN of the referenced
NRSectorCarrier.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/pLMNId> a owl:ObjectProperty ;
    rdfs:comment "Defines which PLMN that can be served by the AIOT reader." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/readerId> a rdf:Property ;
    rdfs:comment """It defines the reader identifier to uniquely identify a
reader within a gNB.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/readerLocation> a rdf:Property ;
    rdfs:comment """This specifies the geographical location of a A-IoT reader.
Reader Location may represent any of latitude/longitude, or any
geographical location/coordinate/area polygon.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/servedAIOTAreas> a owl:ObjectProperty ;
    rdfs:comment """This attribute is used to specify the A-IoT areas supported
by the A-IoT reader. It contains one or multiple A-IoT Area ID, which
is used to uniquely identify an A-IoT Area.

A-IoT Area ID = PLMN ID +NID (optional) + A-IoT Area Code
(OCTET STRING (SIZE(3))), which is defined in TS 38.413.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID> .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader/supportedAIOTServices> a rdf:Property ;
    rdfs:comment """It indicates the supported AIOT service type for an
AIOT reader.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/AIOTReader> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-aiotreader/pLMNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamAzimuth> a rdf:Property ;
    rdfs:comment """The azimuth of a beam transmission, which means the
horizontal beamforming pointing angle (beam peak direction) in the
Phi-axis in 1/10th degree resolution. The pointing angle is the
direction equal to the geometric centre of the half-power contour
of the beam relative to the reference plane. Zero degree implies
explicit antenna bearing (boresight). Positive angle implies clockwise
from the antenna bearing.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamHorizWidth> a rdf:Property ;
    rdfs:comment """ The Horizontal beamWidth of a beam transmission, which
means the horizontal beamforming half-power (3dB down) beamwidth in the
Phi-axis in 1/10th degree resolution.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamIndex> a rdf:Property ;
    rdfs:comment "Index of the beam. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamTilt> a rdf:Property ;
    rdfs:comment """The tilt of a beam transmission, which means the vertical
beamforming pointing angle (beam peak direction) in the Theta-axis in
1/10th degree resolution.
The pointing angle is the direction equal to the geometric centre of
the half-power contour of the beam relative to the reference plane.
Positive value implies downtilt.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamType> a rdf:Property ;
    rdfs:comment "The type of the beam. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamVertWidth> a rdf:Property ;
    rdfs:comment """ The Vertical beamWidth of a beam transmission, which means
the vertical beamforming half-power (3dB down) beamwidth in the
Theta-axis in 1/10th degree resolution.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/BeamType> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/bwpContext> a rdf:Property ;
    rdfs:comment """Identifies whether the object is used for downlink, uplink
or supplementary uplink.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/cyclicPrefix> a rdf:Property ;
    rdfs:comment "Cyclic prefix, which may be normal or extended." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/isInitialBwp> a rdf:Property ;
    rdfs:comment """Identifies whether the object is used for initial or other
BWP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/numberOfRBs> a rdf:Property ;
    rdfs:comment "Number of physical resource blocks for a BWP." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/startRB> a rdf:Property ;
    rdfs:comment """Offset in common resource blocks to common resource block 0
for the applicable subcarrier spacing for a BWP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/subCarrierSpacing> a rdf:Property ;
    rdfs:comment "Subcarrier spacing configuration for a BWP." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BWP> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/BwpContext> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/CyclicPrefix> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/IsInitialBwp> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwp/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/BWPSet> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTarget> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-bwpset/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOFunction/cCOControl> a rdf:Property ;
    rdfs:comment """This attribute determines whether the centralized
SON CCO Function is enabled or disabled.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOFunction> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOFunction/id> a rdf:Property ;
