    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/localAddress> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5C/remoteAddress> a rdf:Property ;
    rdfs:comment "Remote IP address." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5C> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5C/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5C> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U/farEndEntity> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U/localAddress> a owl:ObjectProperty ;
    rdfs:comment "Local IP address and VLAN ID." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/localAddress> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U/remoteAddress> a rdf:Property ;
    rdfs:comment "Remote IP address." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/EP_S5U> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/localAddress/ipAddress> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/localAddress> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/localAddress/vlanId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/localAddress> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/remotePlmnId/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/remotePlmnId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ep/remotePlmnId/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ep/remotePlmnId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at least one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ExternalNRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnrffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at least one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ExternalNSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-externalnssffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/fqdn> a rdf:Property ;
    rdfs:comment "The domain name of the SEPP." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/sEPPId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range xsd:unsignedShort ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ExternalSEPPFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-extternalseppfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """The attribute specifies a list of commModel which is
defined as a datatype (see clause 5.3.69). It can be used by NF
and NF services to interact with each other in 5G Core network """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/gmlcInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents information of an GMLC NF
Instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GmlcInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment """This parameter defines profile for managed NF.
See TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/pLMNInfoList> a owl:ObjectProperty ;
    rdfs:comment "It defines the PLMN(s) of a Network Function. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/sBIFqdn> a rdf:Property ;
    rdfs:comment """FQDN of the registered NF instance in the
service-based interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GMLCFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GmlcInfo/gmlcNumbers> a rdf:Property ;
    rdfs:comment """This attribute represents each item of the array
shall carry an OctetString indicating the ISDN number of the GMLC in
international number format as described in ITU-T Rec. E.164 [94] and
shall be encoded as a TBCD-string.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GmlcInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GmlcInfo/servingClientTypes> a rdf:Property ;
    rdfs:comment """Identity of the GMLC group that is served by
the GMLC instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GmlcInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/commModelList/commModelConfiguration> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/commModelList/commModelType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/commModelList/groupId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/commModelList> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/commModelList/targetNFServiceList> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/commModelList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNInfoList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNInfoList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/aIMLInferenceFunctionRefList> a owl:ObjectProperty ;
    rdfs:comment """This attribute holds a DN list of
aIMLInferenceFunction""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """The attribute specifies a list of commModel. It can be used
by NF and NF services to interact with each other in 5G Core network
(see TS 23.501)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/ephemerisInfos> a owl:ObjectProperty ;
    rdfs:comment "This is the list of Ephemeris related information" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/lmfInfo> a owl:ObjectProperty ;
    rdfs:comment "This attribute represents information of an LMF NF Instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/mLModelRefList> a owl:ObjectProperty ;
    rdfs:comment "This attribute holds a DN list of MLModel." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "This parameter defines profile for managed NF. See TS 23.501" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/mappedCellIdInfoList> a owl:ObjectProperty ;
    rdfs:comment """It provides the list of mapping between GEO area and
Mapped Cell ID.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a
Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/trpInfoList> a owl:ObjectProperty ;
    rdfs:comment """This is the list of TRP (Transmission-Reception Point)
related information on LMF (see TS 38.305 clause 5.4.4).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LMFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo/lmfId> a rdf:Property ;
    rdfs:comment """This attribute represents the LMF identification.
See clause 6.1.6.3.6 TS 29.572""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo/servingAccessTypes> a rdf:Property ;
    rdfs:comment """This attribute contains the access type (3GPP_ACCESS and/or
NON_3GPP_ACCESS) supported by the SMF.
If not included, it shall be assumed the both access types are
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo/servingAnNodeTypes> a rdf:Property ;
    rdfs:comment """This attribute contains the AN node type (i.e. gNB or NG-eNB)
supported by the LMF.
If not included, it shall be assumed that all AN node types are
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo/servingClientTypes> a rdf:Property ;
    rdfs:comment """This attribute represents a list of external client type(s),
e.g. emergency client. The NRF should only include this LMF instance
to NF discovery with 'client-type' query parameter indicating one of
the external client types in the list.

Absence of this attribute means the LMF is not dedicated to serve
specific client types.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo/servingRatTypes> a rdf:Property ;
    rdfs:comment """This attribute contains the RAT type (e.g. 5G NR, eLTE or
any of the RAT Types specified for NR satellite access) supported by
the LMF.
If not included, it shall be assumed that all RAT types are supported
allowedValues: see clause 5.4.3.2 of TS 29.571""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo/supportedGADShapes> a rdf:Property ;
    rdfs:comment """This attribute contains the GAD shapes supported by the LMF.
If not included, it doesn't indicate that the LMF doesn't support any
GAD shapes.
The allowedValues are: see clause 6.1.6.3.4 of TS 29.572 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo/taiList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains TAI list that the LMF can serve.
It may contain one or more non-3GPP access TAIs.
The absence of both this attribute and the taiRangeList attribute
indicates that the LMF can be selected for any TAI in the serving
network.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo/taiRangeList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains TAI range list that the LMF can
serve. It may contain one or more non-3GPP access TAI ranges.
The absence of both this attribute and the taiList attribute indicates
that the LMF can be selected for any TAI in the serving network.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpInfo/gNBId> a rdf:Property ;
    rdfs:comment """It identifies a gNB within a PLMN. The gNB ID is part of
the NR Cell Identifier (NCI) of the gNB cells.
See 'gNB Identifier (gNB ID)' of subclause 8.2 of TS 38.300. See
'Global gNB ID' in subclause 9.3.1.6 of TS 38.413""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpInfo> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpInfo/trpMappingInfoList> a owl:ObjectProperty ;
    rdfs:comment "This is the list of TRP mapping between satellite and TRPs." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpMappingInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpMappingInfo/satelliteId> a rdf:Property ;
    rdfs:comment """This attribute indicates satellite Id. It shall be formatted
as a fixed 5-digit string, padding with leading digits '0' to complete
a 5-digit length.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpMappingInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpMappingInfo/trpIds> a rdf:Property ;
    rdfs:comment """This attribute indicates TRPs uniquely within an NG-RAN
node (see TS 38.455 clause 9.2.24). A gNB may serve several TRPs.
For NTN, a TRP may be located on board the satellite.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/TrpMappingInfo> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/commModelList/commModelConfiguration> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/commModelList/commModelType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/commModelList/groupId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/commModelList> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/commModelList/targetNFServiceList> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/commModelList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance/nfInstanceId> a rdf:Property ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance/nfType> a rdf:Property ;
    rdfs:comment "Type of Network Function." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/consumerNfTypes> a rdf:Property ;
    rdfs:comment """It represents the NF types of the consumers for
which the conditions included in this ConditionItem apply.
If this attribute is absent, the conditions are applicable
to all NF consumer types.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/dnnList> a rdf:Property ;
    rdfs:comment """ It represents a set of TAIs where the NF
(Service) instance under CANARY_RELEASE status shall be
selected for a certain UE""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/gpsiRangeList> a owl:ObjectProperty ;
    rdfs:comment """It represents a set of GPSIs for which the NF
(Service)
instance under CANARY_RELEASE status shall be selected""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/gpsiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/id> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/impiRangeList> a owl:ObjectProperty ;
    rdfs:comment """It represents a set of IMS Private Identities
for which theNF (Service) instance under
CANARY_RELEASE status shall be selected.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/impiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/impuRangeList> a owl:ObjectProperty ;
    rdfs:comment """It represents a set of IMS Public Identities
for which the NF (Service) instance under CANARY_RELEASE
status shall be selected""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/impuRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/peiList> a rdf:Property ;
    rdfs:comment """It represents a set of PEIs of the UEs for
which the NF(Service) instance under CANARY_RELEASE status
shall be selected""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/serviceFeature> a rdf:Property ;
    rdfs:comment """It represents a feature number of that NF Service
Instance,under CANARY_RELEASE status. This attribute only
applies when the          selectionConditions, where this
ConditionItem is included, is included in a NF Service Instance
This condition is evaluated to <true> when the service requests
froma consumer of this NF Service Instance require the support
of the indicated feature on the NF Service Instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/supiRangeList> a owl:ObjectProperty ;
    rdfs:comment """It represents a set of SUPIs for which
the NF (Service) instance under CANARY_RELEASE status shall
be selected.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/taiRangeList> a owl:ObjectProperty ;
    rdfs:comment """It represents a set of TAIs where the
NF(Service) instance under CANARY_RELEASE status shall
be selected for a certain UE""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem/vsServiceFeature> a rdf:Property ;
    rdfs:comment """It represents a Vendor-Specific feature
number of thatNF Service Instance, under CANARY_RELEASE
status. This attribute only applies when the
selectionConditions, where this ConditionItem is included,
is included in a NF Service Instance.This condition is
evaluated to true when the service requests from a
consumer of this NF Service Instance require the support
of the indicated Vendor-Specific feature on the NF
Service Instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedNSSAIs> a owl:ObjectProperty ;
    rdfs:comment """S-NSSAI of the allowed slices to access the NF instance.
If not provided, any slice is allowed to access the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAIs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedNfDomains> a rdf:Property ;
    rdfs:comment """Pattern (regular expression according to the ECMA-262
dialect [75]) representing the NF domain names within the PLMN of
the NRF allowed to access the NF instance If not provided,
any NF domain is allowed to access the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedNfTypes> a rdf:Property ;
    rdfs:comment """Type of the NFs allowed to access the NF instance.
If not provided, any NF type is allowed to access the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedPlmns> a owl:ObjectProperty ;
    rdfs:comment """PLMNs allowed to access the NF instance.
If not provided, any PLMN is allowed to access the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPlmns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/allowedSNPNs> a owl:ObjectProperty ;
    rdfs:comment """SNPNs allowed to access the NF instance.
The absence of this attribute in the NF profile indicates that no SNPN,
other than the SNPN(s) registered in the snpnList attribute of the
NF Profile, is allowed to access the service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/authzInfo> a rdf:Property ;
    rdfs:comment """This parameter defines NF Specific Service authorization
information. It shall include the NF type (s) and NF realms/origins
allowed to consume NF Service(s) of NF Service Producer """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/canaryPrecedenceOverPreferred> a rdf:Property ;
    rdfs:comment """ManagedNFProfile.canaryPrecedenceOverPreferred  This
attribute indicates whether the NRF shall prioritize the NF Service
Producer in Canary Release condition over the preferences
(preferred-xxx, ext-preferred-xxx) present in NF discovery requests.
allowedValues:
True NRF shall prioritize NF Service Producers in Canary Release
condition at NF discovery requests, i.e. NF Service Producers
determined according to preferred-xxx and/or ext-preferred-xxx
shall be prioritized after the NF Service Producers in Canary
Release condition. The associated NF (service) priorities for Service
Producers in Canary Release condition shall not be modified by NRF.
False NRF shall prioritize the NF Service Producers according to
preferred-xxx and/or ext-preferred-xxx (i.e. Canary Release condition
in NF Service Producers shall not be prioritized over NF Service
Consumer preferences at NF discovery requests)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/canaryRelease> a rdf:Property ;
    rdfs:comment """This attribute indicates whether an NF instance whose
nfStatus is set to REGISTERED is in Canary Release condition,
i.e. it should only be selected by NF Service Consumers under the
conditions indicated by the selectionConditions attribute.
True: the NF is under Canary Release condition, even if the
nfStatus is set to REGISTERED
False: the NF instance indicates its Canary Release condition
via the nfStatus attribute""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/capacity> a rdf:Property ;
    rdfs:comment """Static capacity information in the range of 0-65535,
expressed as a weight relative to other NF instances of
the same type; if capacity is also present in the nfServiceList
parameters, those will have precedence over this value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/collocatedNfInstances> a owl:ObjectProperty ;
    rdfs:comment """It represents information related to collocated NF
type(s) and corresponding NF Instances when the NF is collocated
with NFs supporting other NF types.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/CollocatedNfInstance> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/defaultNotificationSubscriptions> a owl:ObjectProperty ;
    rdfs:comment """Notification endpoints for different notification types.
This attribute may contain multiple default subscriptions for a same
notification type; in that case, those default subscriptions are used
as alternative notification endpoints.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/exclusiveCanaryReleaseSelection> a rdf:Property ;
    rdfs:comment """This attribute indicates whether an NF Service
Consumer should only select an NF Service Producer in Canary
Release condition.
True: the consumer shall only select producers in Canary Release
condition
False: the consumer may select producers not in Canary Release
condition""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/extLocality> a rdf:Property ;
    rdfs:comment """It indicates the operator defined information about the
location of the NF instance. The key of the map shall be a (unique)
valid JSON string per clause 7 of IETF RFC 8259 [92], with a maximum
of 32 characters, representing a type of locality as defined in
clause 6.1.6.3.18.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/fqdn> a rdf:Property ;
    rdfs:comment """FQDN of the Network Function. For AMF, the
FQDN registered with the NRF shall be that of the AMF Name.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/heartBeatTimer> a rdf:Property ;
    rdfs:comment """Time in seconds expected between 2 consecutive
heart-beat messages from an NF Instance to the NRF.
It may be included in the registration request.
When present in the request it shall contain the
heartbeat time proposed by the NF service consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/hniList> a rdf:Property ;
    rdfs:comment """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/hostAddr> a rdf:Property ;
    rdfs:comment "Host address of a NF" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/interPlmnFqdn> a rdf:Property ;
    rdfs:comment """If the NF needs to be discoverable by other
NFs in a different PLMN, then an FQDN that is used
for inter-PLMN routing is specified.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/lcHSupportInd> a rdf:Property ;
    rdfs:comment """This parameter indicates whether the NF supports or does
not support Load Control based on LCI Header.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/load> a rdf:Property ;
    rdfs:comment """Dynamic load information, ranged from 0 to 100,
indicates the current load percentage of the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/loadTimeStamp> a rdf:Property ;
    rdfs:comment """It indicates the point in time in which the latest load
information (sent by the NF in the load attribute of the NF Profile)
was generated at the NF Instance.If the NF did not provide a timestamp,
the NRF should set it to the instant when the NRF received the message
where the NF provided the latest load information.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/locality> a rdf:Property ;
    rdfs:comment """Operator defined information about the location
of the NF instance (e.g. geographic location, data center).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfInstanceId> a rdf:Property ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfInstanceName> a rdf:Property ;
    rdfs:comment "It represents human readable name of the NF Instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfProfileChangesInd> a rdf:Property ;
    rdfs:comment """NF Profile Changes Indicator. This IE shall be absent
in the request to the NRF and may be included by the NRF
in NFRegister or NFUpdate (NF Profile Complete Replacement) response.
true: the NF Profile contains NF Profile changes.
false (default): complete NF Profile.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfProfileChangesSupportInd> a rdf:Property ;
    rdfs:comment """This parameter indicates if the NF Service Consumer supports
or does not support receiving NF Profile Changes. It may be present in
the NFRegister or NFUpdate (NF Profile Complete Replacement) request and
shall be absent in the response (see Annex B 3GPP TS 29.510 [23]).  """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfProfilePartialUpdateChangesSupportInd> a rdf:Property ;
    rdfs:comment """It represents NF Profile Partial Update Changes Support
Indicator. TRUE: the NF Service Consumer supports receiving NF Profile
Changes in the response to an NF Profile Partial Update operation.
FALSE (default): the NF Service Consumer does not support receiving
NF Profile Changes in the response to an NF Profile Partial Update
operation""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfServicePersistence> a rdf:Property ;
    rdfs:comment """This parameter indicates whether the different service
instances of a same NF Service in the NF instance, supporting a same
API version, are capable to persist their resource state in shared
storage and therefore these resources are available after a new NF
service instance supporting the same API version is selected by a NF
Service Consumer """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfServices> a owl:ObjectProperty ;
    rdfs:comment """List of NF Service Instances. It shall include
the services produced by the NF that can be
discovered by other NFs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfSetIdList> a rdf:Property ;
    rdfs:comment """A NF Set Identifier is a globally unique identifier of
a set of equivalent and interchangeable CP NFs from a given network
that provide distribution, redundancy and scalability
(see clause 5.21.3 of 3GPP TS 23.501 [2]).An NF Set Identifier shall
be constructed from the MCC, MNC, NID (for SNPN), NF type and a Set ID.
A NF Set Identifier shall be formatted as the following string:
set<Set ID>.<nftype>set.5gc.mnc<MNC>.mcc<MCC> for a NF Set in a PLMN, or
set<Set ID>.<nftype>set.5gc.nid<NID>.mnc<MNC>.mcc<MCC> for a NF Set
in a SNPN.At most one NF Set ID shall be indicated per PLMN-ID or SNPN
of the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfSetRecoveryTimeList> a rdf:Property ;
    rdfs:comment """This parameter contains the recovery time of NF Set(s)
indicated by the NfSetId, where the NF instance belongs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfStatus> a rdf:Property ;
    rdfs:comment "Status of the NF Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/nfType> a rdf:Property ;
    rdfs:comment "Type of Network Function." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/olcHSupportInd> a rdf:Property ;
    rdfs:comment """This parameter indicates whether the NF supports or does
not support Overload Control based on OCI Header .""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/perPlmnSnssaiList> a owl:ObjectProperty ;
    rdfs:comment """It includes the S-NSSAIs supported by the Network Function
for each PLMN supported by the Network Function. When present, it shall
override sNssais IE.If the perPlmnSnssaiList attribute is provided in
at least one NF Service, the S-NSSAIs supported per PLMN in the
NF Profile shall be the set or a superset of the perPlmnSnssaiList
of the NFService(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/perPlmnSnssaiList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/plmnList> a owl:ObjectProperty ;
    rdfs:comment """PLMN(s) of the Network Function.
This IE shall be present if this information
is available for the NF. If not provided, PLMN ID(s)
of the PLMN of the NRF are assumed for the NF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/recoveryTime> a rdf:Property ;
    rdfs:comment """Timestamp when the NF was (re)started. The NRF shall notify
NFs subscribed to receiving notifications of changes of the NF profile,
if the NF recoveryTime is changed""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/sNPNList> a owl:ObjectProperty ;
    rdfs:comment """SNPN(s) of the Network Function. This attributeIE shall be
present if the NF pertains to one or more SNPNs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/sNssais> a owl:ObjectProperty ;
    rdfs:comment """S-NSSAIs of the Network Function. If not
provided, the NF can serve any S-NSSAI. When present
this IE represents the list of S-NSSAIs supported in
all the PLMNs listed in the plmnList IE.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sNssais> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/scpDomains> a rdf:Property ;
    rdfs:comment """This parameter shall carry the list of SCP domains the
SCP belongs to, or the SCP domain the NF (other than SCP) or the SEPP
belongs to..""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/selectionConditions> a owl:ObjectProperty ;
    rdfs:comment """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SelectionConditions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/serviceSetRecoveryTimeList> a rdf:Property ;
    rdfs:comment """This parameter contains the recovery time of NF Service
Set(s) configured in the NF instance, which are indicated by the
NfServiceSetId""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/servingScope> a rdf:Property ;
    rdfs:comment """This parameter indicates the served geographical areas
of a NF instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/sharedProfileDataId> a rdf:Property ;
    rdfs:comment """This attribute indicates a string uniquely identifying
Shared Profile Data. The format of the sharedProfileDataId shall be
a Universally Unique Identifier (UUID) version 4, as described in
IETF RFC 4122 [44]. The hexadecimal letters should be formatted as
lower-case characters by the sender, and they shall be handled as
case-insensitive by the receiver.
Example: 4ace9d34-2c69-4f99-92d5-a73a3fe8e23b""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/shutdownTime> a rdf:Property ;
    rdfs:comment """It indicates the timestamp when the NF Instance is
planned to be shut down. This attribute may be present if the
nfStatus is set to UNDISCOVERABLE due to scheduled shutdown""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/supportedRcfs> a rdf:Property ;
    rdfs:comment "It represents a list of Resource Content Filter IDs" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/supportedVendorSpecificFeatures> a owl:ObjectProperty ;
    rdfs:comment """It indicates a map of Vendor-Specific features, where the
key of the map is the IANA-assigned SMI Network Management Private
Enterprise Codes and the value of each entry of the map shall be
a list (array) of VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/supportedVendorSpecificFeatures> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile/vendorId> a rdf:Property ;
    rdfs:comment """Vendor ID of the NF instance, according to the
IANA-assigned SMI Network Management Private Enterprise Codes [77].
allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits 0 to complete
a 6-digit string value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId/mcc> a rdf:Property ;
    rdfs:comment "Mobile Country Code (MCC) of the SNPN." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId/mnc> a rdf:Property ;
    rdfs:comment "Mobile Network Code (MNC) of the SNPN." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId/nId> a rdf:Property ;
    rdfs:comment "Network Identifier (NID) of the SNPN." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SPNInfoId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SelectionConditions/conditionItem> a owl:ObjectProperty ;
    rdfs:comment """It represent a single condition item that shall be
evaluated Instance shall be selected.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SelectionConditions> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ConditionItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange/end> a rdf:Property ;
    rdfs:comment """Last value identifying the end of a SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g. IMSI ranges).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange/pattern> a rdf:Property ;
    rdfs:comment """Pattern representing the set of SUPI's belonging to
this range.A SUPI value is considered part of the range if and
only if the SUPI string fully matches the regular expression.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange/start> a rdf:Property ;
    rdfs:comment """First value identifying the start ofa SUPI range.To be
used when the range of SUPI's can be represented as a numeric range
(e.g., IMSI ranges).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """The attribute specifies a list of commModel which is
defined as a datatype (see clause 5.3.69). It can be used by NF
and NF services to interact with each other in 5G Core network """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id). The PLMN Identifier is composed of
a Mobile Country Code (MCC) and a Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/N3IWFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/commModelList/commModelConfiguration> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/commModelList/commModelType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/commModelList/groupId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/commModelList> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/commModelList/targetNFServiceList> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/commModelList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-n3iwffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AIoTNEFMapping/internalTargetArea> a owl:ObjectProperty ;
    rdfs:comment """This is the (internal) target area mapped to external
target area. It is provided to NEF by NRF.
It could refer to any of TAC/TAI(list), PLMN or any geographical
location/coordinate/area polygon""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AIoTNEFMapping> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AIoTNEFMapping/targetAreaAF> a owl:ObjectProperty ;
    rdfs:comment """It represents the external target area provided by an AF
to NEF for triggering A-IoT services. It could refer to a geographical
location.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AIoTNEFMapping> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AfEventExposureData/afEvents> a rdf:Property ;
    rdfs:comment """It represents AF Event(s) exposed by the NEF after
registration of the AF(s) at the NEF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AfEventExposureData> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AfEventExposureData/afIds> a rdf:Property ;
    rdfs:comment """It represents list of application function identifiers of
the managed PFDs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AfEventExposureData> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AfEventExposureData/appIds> a rdf:Property ;
    rdfs:comment "It represents list of internal application identifiers." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AfEventExposureData> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/DnnInfoItem/dnn> a rdf:Property ;
    rdfs:comment """String representing a Data Network as defined in clause 9A
of 3GPP TS 23.003; it shall contain either a DNN Network Identifier,
or a full DNN with both the Network Identifier and Operator Identifier,
as specified in 3GPP TS 23.003 clause 9.1.1 and 9.1.2. It shall be
coded as string in which the labels are separated by dots
(e.g. 'Label1.Label2.Label3').

Whether the dnn data type contains just the DNN Network Identifier, or
the Network Identifier plus the Operator Identifier, shall be
documented in each API where this data type is used.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/DnnInfoItem> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/AIoTNEFMapping> a owl:ObjectProperty ;
    rdfs:comment """It represents mapping information between external target
area (provided by AF) and (5G core internal) target area that is to
be provided to NRF""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AIoTNEFMapping> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/capabilityList> a rdf:Property ;
    rdfs:comment "List of supported capabilities of the NEF." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/isCAPIFSup> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range xsd:boolean ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "This parameter defines profile for managed NF(See TS 23.501)" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/nefInfo> a owl:ObjectProperty ;
    rdfs:comment "This attribute represents information of an NEF NF Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """The FQDN of the registered NF instance in the
service-based interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/sNSSAIList> a owl:ObjectProperty ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of supporting.
(Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNSSAIList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NEFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/afEeData> a owl:ObjectProperty ;
    rdfs:comment """It represents the AF provided event exposure data. The NEF
registers such information in the NRF on behalf of the AF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/AfEventExposureData> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/dnaiList> a rdf:Property ;
    rdfs:comment """It represents list of Data network access identifiers
supported by the NEF. The absence of this attribute indicates that
the NEF can be selected for any DNAI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/externalGroupIdentifiersRanges> a owl:ObjectProperty ;
    rdfs:comment """It represents list of ranges of external groups whose
profile data is available.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/externalGroupIdentifiersRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/gpsiRanges> a owl:ObjectProperty ;
    rdfs:comment """It represents list of ranges of GPSIs whose profile data
is available.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/gpsiRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/memberUESelAssistInd> a rdf:Property ;
    rdfs:comment """This attribute indicates whether the NEF supports member
UE selection assistance functionality:

- TRUE: member UE selection assistance functionality is supported by
the NEF
- FALSE (default): member UE selection assistance functionality is
not supported by the NEF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/multiMemAfSessQosInd> a rdf:Property ;
    rdfs:comment """This attribute indicates whether the NEF supports
Multi-member AF session with required QoS functionality:

- TRUE: Multi-member AF session with required QoS functionality is
supported by the NEF
- FALSE (default): Multi-member AF session with required QoS
functionality is not supported by the NEF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/nefId> a rdf:Property ;
    rdfs:comment """It represents the NEF ID.
(see clause 6.1.6.3.2 of TS 29.510)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/pfdData> a owl:ObjectProperty ;
    rdfs:comment """It represents PFD data, containing the list of internal
application identifiers and/or the list of application function
identifiers for which the PFDs can be provided.

Absence of this attribute indicates that the PFDs for any internal
application identifier and for any application function identifier
can be provided.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PfdData> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/servedFqdnList> a rdf:Property ;
    rdfs:comment """It represents pattern (regular expression according to
the ECMA-262 dialect [75]) representing the Domain names served by
the NEF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/taiList> a owl:ObjectProperty ;
    rdfs:comment "List of TAIs" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/taiRangeList> a owl:ObjectProperty ;
    rdfs:comment "Range of TAIs" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/uasNfFunctionalityInd> a rdf:Property ;
    rdfs:comment """When present, this attribute shall indicate whether the ,
NEF supports UAS NF functionality:
- True: UAS NF functionality is supported by the NEF.
- False (default): UAS NF functionality is not supported by the NEF""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo/unTrustAfInfoList> a owl:ObjectProperty ;
    rdfs:comment "It represents list of information corresponding to the AFs." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/NefInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/UnTrustAfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PfdData/afIds> a rdf:Property ;
    rdfs:comment """It represents list of application function identifiers of
the managed PFDs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PfdData> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PfdData/appIds> a rdf:Property ;
    rdfs:comment "It represents list of internal application identifiers." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/PfdData> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SnssaiInfoItem/dnnInfoList> a owl:ObjectProperty ;
    rdfs:comment """It represents list of parameters supported by the
NF per DNN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SnssaiInfoItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/DnnInfoItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SnssaiInfoItem/sNssai> a owl:ObjectProperty ;
    rdfs:comment """It represents the S-NSSAI the NetworkSlice managed object
is supporting. The S-NSSAI is defined in TS 23.003.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SnssaiInfoItem> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNssai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/UnTrustAfInfo/afId> a rdf:Property ;
    rdfs:comment "It represents associated AF id." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/UnTrustAfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/UnTrustAfInfo/mappingInd> a rdf:Property ;
    rdfs:comment """When present, this attribute indicates whether the
AF supports mapping between UE IP address (IPv4 address or IPv6 prefix)
and UE ID (i.e. GPSI).
True: the AF supports mapping between UE IP address and UE ID;
False: the AF does not support mapping between UE IP address
and UE ID.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/UnTrustAfInfo> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/UnTrustAfInfo/sNssaiInfoList> a owl:ObjectProperty ;
    rdfs:comment "It represents S-NSSAIs and DNNs supported by the AF." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/UnTrustAfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/SnssaiInfoItem> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/externalGroupIdentifiersRanges/end> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/externalGroupIdentifiersRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/externalGroupIdentifiersRanges/pattern> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/externalGroupIdentifiersRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/externalGroupIdentifiersRanges/start> a rdf:Property ;
    rdfs:comment """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/externalGroupIdentifiersRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/gpsiRanges/end> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/gpsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/gpsiRanges/pattern> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/gpsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/gpsiRanges/start> a rdf:Property ;
    rdfs:comment """First value identifying the start of an identity range.
To be used when the range of identities can be represented
as a numeric range (e.g., MSISDN ranges).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/gpsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNSSAIList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNSSAIList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNSSAIList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNSSAIList> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNssai/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNssai> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNssai/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/sNssai> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-neffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedNSSAI> a owl:ObjectProperty ;
    rdfs:comment """S-NSSAI of the allowed slices to access the service
instance. The absence of this attribute indicates that any slice
is allowed to access the service instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAI> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedNfDomains> a rdf:Property ;
    rdfs:comment """Pattern representing the NF domain names allowed to
access the service instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedNfTypes> a rdf:Property ;
    rdfs:comment "SNPNs allowed to access the NF instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedOperationsPerNfInstance> a rdf:Property ;
    rdfs:comment """It indicates the allowed operations on resources for
a given NF Instance; the key of the map is the NF Instance Id, and
the value is an array of scopes""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedOperationsPerNfInstanceOverrides> a rdf:Property ;
    rdfs:comment """When it is present and set to true, indicates that
the scopes defined in attribute allowedOperationsPerNfInstance
for a given NF Instance ID take precedence over the scopes defined
in attribute allowedOperationsPerNfType for the corresponding
NF type of the NF Instance associated to such NF Instance ID..""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedOperationsPerNfType> a rdf:Property ;
    rdfs:comment """It indicates the allowed operations on resources for
each type of NF; the key of the map is the NF Type, and the value
is an array of scopes""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedPLMNs> a owl:ObjectProperty ;
    rdfs:comment """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPLMNs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedSnpns> a owl:ObjectProperty ;
    rdfs:comment """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedSnpns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/apiPrefix> a rdf:Property ;
    rdfs:comment """Optional path segment(s) used to construct the {apiRoot}
variable of the different API URIs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/capacity> a rdf:Property ;
    rdfs:comment """Static capacity information in the range of 0-65535,
expressed as a weight relative to other services of the same type.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/defaultNotificationSubscriptions> a owl:ObjectProperty ;
    rdfs:comment "Notification endpoints for different notification types." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/fqdn> a rdf:Property ;
    rdfs:comment "FQDN of the NF Service Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/interPlmnFqdn> a rdf:Property ;
    rdfs:comment """If the NF service needs to be discoverable by other NFs in a
different PLMN, then an FQDN that is used for inter PLMN routing.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/ipEndPoints> a owl:ObjectProperty ;
    rdfs:comment """IP address(es) and port information of the Network Function
(including IPv4 and/or IPv6 address)where the service is listening
for incoming service requests.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPoints> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/nfServiceStatus> a rdf:Property ;
    rdfs:comment "Status of the NF Service Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/oauth2Required> a rdf:Property ;
    rdfs:comment """It indicates whether the NF Service Instance requires
Oauth2-based authorization""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/priority> a rdf:Property ;
    rdfs:comment """Priority (relative to other services of the same type)
in the range of 0-65535, to be used for NF Service selection; lower
values indicate a higher priority.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/recoveryTime> a rdf:Property ;
    rdfs:comment "Timestamp when the NF was (re)started." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/scheme> a rdf:Property ;
    rdfs:comment "URI scheme (e.g. 'http', 'https')." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/serviceInstanceID> a rdf:Property ;
    rdfs:comment "Unique ID of the service instance within a given NF Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/serviceName> a rdf:Property ;
    rdfs:comment "Name of the service instance (e.g. 'nudm-sdm')." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/sharedServiceDataId> a rdf:Property ;
    rdfs:comment """String uniquely identifying SharedServiceData. The format
of the sharedServiceDataId shall be a Universally Unique Identifier
(UUID) version 4, as described in IETF RFC 4122 [44]. The hexadecimal
letters should be formatted as lower-case characters by the sender,
and they shall be handled as case-insensitive by the receiver.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/vendorId> a rdf:Property ;
    rdfs:comment "Vendor ID of the NF instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/versions> a owl:ObjectProperty ;
    rdfs:comment """API versions supported by the NF Service and if available,
the corresponding retirement date of the NF Service.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/versions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFServiceStatus> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId/mCC> a rdf:Property ;
    rdfs:comment """This is the Mobile Country Code (MCC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId/mNC> a rdf:Property ;
    rdfs:comment """This is the Mobile Network Code (MNC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId/nId> a rdf:Property ;
    rdfs:comment """Network Identity; Shall be present if PlmnIdNid
identifies an SNPN""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/ServiceName> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SupportedFeatures> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/TransportProtocol> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/UriScheme> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """Specifies a list of commModel. It can be used by NF and
NF services to interact with each other in 5G Core network """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment """This parameter defines profile for managed NF.
See TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and
a Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/sNSSAIList> a owl:ObjectProperty ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of supporting.
(Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/sNSSAIList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/NGEIRFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/commModelList/commModelConfiguration> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/commModelList/commModelType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/commModelList/groupId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/commModelList> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/commModelList/targetNFServiceList> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/commModelList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/sNSSAIList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/sNSSAIList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/sNSSAIList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/sNSSAIList> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-ngeirfunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMapping/aIOTFdN> a owl:ObjectProperty ;
    rdfs:comment """Represents the distinguished name (DN) identifier of the
AIOTF that serves the (internal) target area provided by NEF to NRF""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMapping> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMapping/internalTargetArea> a owl:ObjectProperty ;
    rdfs:comment """It is the (internal) target area used by NRF (as provided
by NEF) to accurately locate the AIOTF instance. It is mapped to aIOTFdN.
It could refer to a list of AIoT Areas.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMapping> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-aiot/ServedAIOTAreaID> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/additionalDiamAddresses> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the Additional Diameter Addresses
of the HSS;may be present if hssDiameterAddress is present """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/externalGroupIdentifiersRanges> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the list of ranges of external
group IDs that can be served by this HSS instance.If not provided,
the HSS instance does not serve any external groups. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/externalGroupIdentifiersRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/groupID> a rdf:Property ;
    rdfs:comment """This attribute defines the identity of the HSS group
that is served by the HSS instance.If not provided, the HSS instance
does not pertain to any HSS group.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/hssDiameterAddress> a owl:ObjectProperty ;
    rdfs:comment "This attribute defines the Diameter Address of the HSS " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/imsPrivateIdentityRanges> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the list of ranges of IMS Private
Identities whose profile data is available in the HSS instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPrivateIdentityRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/imsPublicIdentityRanges> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the list of ranges of MSISDNs whose
profile data is available in the HSS instance. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsPublicIdentityRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/imsiRanges> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the list of ranges of IMSIs whose
profile data is available in the HSS instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/msisdnRanges> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the list of ranges of IMS Public
Identities whose profile data is available in the HSS instance """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo/nfInstanceId> a rdf:Property ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/aIoTNRFMapping> a owl:ObjectProperty ;
    rdfs:comment """Represents mapping information between (Internal) target
area (provided by NEF) and AIOTF DN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/AIoTNRFMapping> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/cNSIIdList> a rdf:Property ;
    rdfs:comment """NSI ID. NSI ID is an identifier for identifying the Core
Network part of a Network Slice instance when multiple Network Slice
instances of the same Network Slice are deployed, and there is a need
to differentiate between them in the 5GC, see clause 3.1 of TS 23.501
and subclause 6.1.6.2.7 of 3GPP TS 29.531""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "This parameter defines profile for managed NF" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/nFProfileList> a owl:ObjectProperty ;
    rdfs:comment """It is a set of NFProfile(s) to be registered in the NRF
instance. NFProfile is defined in 3GPP TS 29.510 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/nrfInfo> a owl:ObjectProperty ;
    rdfs:comment "Represents information of an NRF NF Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/pLMNInfoList> a owl:ObjectProperty ;
    rdfs:comment "It defines the PLMN(s) of a Network Function." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """It is used to indicate the FQDN of the registered NF instance
in service-based interface, for example, NF instance FQDN structure is:
nftype<nfnum>.slicetype<sliceid>.mnc<MNC>.mcc<MCC>.3gppnetwork.org""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NRFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/served5gDdnmfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the 5gDdnmfInfo
attribute locally configured in the NRF or that the NRF
received during NF registration. The key of the map is
the nfInstanceId to which the map entry belongs to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/served5gDdnmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedAmfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the amfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/AmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedAusfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the
ausfInfo attributes
locally configured in the NRF or the NRF
received during NF registration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-ausffunction/AusfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedBsfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the bsfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedChfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the bsfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedGmlcInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the gmlcInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId of which
the nefInfo belongs to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-gmlcfunction/GmlcInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedHssInfoList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains list of HssInfo attribute
locally configured in the NRF or that the NRF received during NF
registration. The key of the map is the nfInstanceId to which the
map entry belongs to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/HssInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedLmfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the lmfInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId of which
the lmfInfo belongs to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-lmffunction/LmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedNfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains information of other NFs
without corresponding NF type specific Info extensions locally
configured in the NRF or the NRF received during NF registration.
The key of the map is the nfInstanceId of the NF. The map entry
is the NfInfo as defined in clause 5.3.229 representing the
information of a generic NF instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/nfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedNwdafInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the nwdafInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId of which
the nwdafInfo belongs to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedPcfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the pcfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedPcscfInfoList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the pcscfInfo attributes
locally configured in the NRF or the NRF received during NF
registration. The key of the map is the nfInstanceId to which
the map entry belongs to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedSmfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the smfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/SmfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedUdmInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the udmInfo
attributes
locally configured in the NRF or the NRF
received during NF registration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udmfunction/UdmInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedUdrInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the udrInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-udrfunction/UdrInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo/servedUpfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains all the upfInfo
attributes
locally configured in the NRF or the NRF received
during NF registration.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/NrfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/UpfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PduSessionType> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses/id> a rdf:Property ;
    rdfs:comment "Unique identifier for the IMSI range." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses/name> a rdf:Property ;
    rdfs:comment """This attribute indicates the Diameter
name of the network node diameter address.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses/realm> a rdf:Property ;
    rdfs:comment """This attribute indicates the Diameter realm of the
network node diameter addres. See TS 29.571 [61]. String contains
a Diameter Identity (FQDN).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/additionalDiamAddresses> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnSmfInfoList/dnaiList> a rdf:Property ;
    rdfs:comment """List of Data network access identifiers supported by
the SMF for this DNN. The absence of this attribute indicates that
the SMF can be selected for this DNN for any DNAI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnSmfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnSmfInfoList/dnn> a rdf:Property ;
    rdfs:comment "Supported DNN." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnSmfInfoList> ;
    rdfs:range xsd:string .

