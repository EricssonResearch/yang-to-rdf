<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/ipv4AddressRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of IPv4 addresses handled by BSF.
If not provided, the BSF can serve any IPv4 address.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/ipv6PrefixRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of IPv6 prefixes handled by the BSF.
If not provided, the BSF can serve any IPv6 prefix.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/nfInstanceId> a rdf:Property ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/gpsiRangeList> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of GPSI that can be served
by the CHF instance. If not provided, the CHF can serve any GPSI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/nfInstanceId> a rdf:Property ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/plmnRangeList> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of PLMNs (including the PLMN
IDs of the CHF instance) that can be served by the CHF instance.
If not provided, the CHF can serve any PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/primaryChfInstance> a rdf:Property ;
    rdfs:comment """This attribute represents the NF Instance Id of the
primary CHF instance. This attribute shall be absent if the
secondaryChfInstance is present.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/secondaryChfInstance> a rdf:Property ;
    rdfs:comment """This attribute represents the NF Instance Id of the
secondary CHF instance.This attribute shall be absent if the
primaryChfInstance is present.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/supiRangeList> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of SUPIs that can be served by
the CHF instance. If not provided, the CHF can serve any SUPI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/accessType> a rdf:Property ;
    rdfs:comment """It provides the condition of access type of the UE when
the session AMBR shall be enforced, see TS 29.512 [60].If this
attribute is included in SmfInfo, it shall contain the access type
(3GPP_ACCESS and/or NON_3GPP_ACCESS) supported by the SMF.If not
included, it shall be assumed the both access types are supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/dnnList> a rdf:Property ;
    rdfs:comment """It represents the DNNs supported by the PCF. The DNN,
as defined in clause 9A of TS 23.003 [13], shall contain the Network
Identifier and it may additionally contain an Operator Identifier,
as specified in TS 23.003 [13] clause 9.1.1 and 9.1.2. If the Operator
Identifier is not included, the DNN is supported for all the PLMNs in
the plmnList of the NF Profile.If not provided, the PCF can serve any
DNN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/gmFqdn> a rdf:Property ;
    rdfs:comment """This attribute represents FQDN of the P-CSCF for the Gm
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/gmIpv4Addresses> a rdf:Property ;
    rdfs:comment """This attribute represents list of IPv4 addresses of of
the P-CSCF for the Gm interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/gmIpv6Addresses> a rdf:Property ;
    rdfs:comment """This attribute represents list of IPv6 addresses of of the
P-CSCF for the Gm interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/mwFqdn> a rdf:Property ;
    rdfs:comment """This attribute represents FQDN of the P-CSCF for the Mw
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/mwIpv4Addresses> a rdf:Property ;
    rdfs:comment """List of ranges of PLMNs (including the PLMN
IDs of the CHF instance) that can be served by the CHF instance.
If not provided, the CHF can serve any PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/mwIpv6Addresses> a rdf:Property ;
    rdfs:comment """This attribute represents list of IPv4 addresses of
the P-CSCF for the Mw interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/nfInstanceId> a rdf:Property ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/servedIpv4AddressRanges> a owl:ObjectProperty ;
    rdfs:comment """List of ranges of PLMNs (including the PLMN
IDs of the CHF instance) that can be served by the CHF instance.
If not provided, the CHF can serve any PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/cNSIIdList> a rdf:Property ;
    rdfs:comment """NSI ID. NSI ID is an identifier for identifying the Core
Network part of a Network Slice instance when multiple Network Slice
instances of the same Network Slice are deployed, and there is a need
to differentiate between them in the 5GC, see clause 3.1 of TS 23.501
and subclause 6.1.6.2.7 of 3GPP TS 29.531""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "Profile definition of a Managed NF (See TS 23.501)" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at least
one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a
Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """The FQDN of the registered NF instance in the service-based
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/sNSSAIList> a owl:ObjectProperty ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of supporting.
(Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sNSSAIList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/NSSFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNIdList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sNSSAIList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sNSSAIList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sNSSAIList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/sNSSAIList> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nssffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo/flCapabilityType> a rdf:Property ;
    rdfs:comment """This attribute defines the federated learning capability
type supported by NWDAF containing MTLF.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo/flTimeInterval> a owl:ObjectProperty ;
    rdfs:comment """This attribute defines the time window at which the
indicated flCapabilityType supported by NWDAF MTLF is available.
This attribute shall be present only if flCapabilityType attribute
is present.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo/mlAnalyticsIds> a rdf:Property ;
    rdfs:comment """This attribute represents the Analytic functionalities
(identified by nwdafEvent defined in TS 29.520 [85]) of the NWDAF
instance. MnS consumer can configure this attribute to specify
which Analytic functionalities (identified by nwdafEvent) can be
performed the NWDAF instance. If the value of this attribute is not
present, the NWDAF instance can perform any NWDAFEvents

Analytics Id(s) supported by the Nnwdaf_MLModelProvision service,
if none are provided the NWDAF can serve any mlAnalyticsId.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo/mlModelInterInfo> a rdf:Property ;
    rdfs:comment """This attribute defines the list of NWDAF vendors that are
allowed to retrieve ML models from the NWDAF containing MTLF. The
absence of this attribute indicates that none of the NWDAF vendors
can retrieve the ML models.

allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits '0' to complete a
6-digit string value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo/sNSSAIList> a owl:ObjectProperty ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of
supporting.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo/trackingAreaList> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents area of Interest of the ML model,
if none are provided the ML model for the analytics can apply to any
TAIs.

If present, it represents the list of TAIs, it may contain one or
more non-3GPP access TAIs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/administrativeState> a rdf:Property ;
    rdfs:comment """This attribute determines whether the NWDAF is enabled or
disabled. MnS consumer can configure this attribute to activate or
de-activate the analytic functionalities (identified by nwdafEvent
defined in TS 29.520) of the NWDAF instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """Specifies a list of commModel. It can be used by NF and
NF services to interact with each other in 5G Core network """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "Profile definition of a Managed NF (See TS 23.501)" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/networkSliceInfoList> a owl:ObjectProperty ;
    rdfs:comment """The attribute specifies a list of NetworkSliceInfo which
is defined as a datatype (see clause 5.3.95). It is used by an
authorized consumer, e.g. NWDAF, to facilitate the data collection
from OAM.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NetworkSliceInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/nwdafInfo> a owl:ObjectProperty ;
    rdfs:comment "It represents specific data for the NWDAF." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/nwdafLogicalFuncSupported> a rdf:Property ;
    rdfs:comment """It represents the logical functions supported by the NWDAF.
If not present, the NWDAF shall be regarded with no logical
decomposition, in that case the NWDAF only supports the analytics
services.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/pLMNInfoList> a owl:ObjectProperty ;
    rdfs:comment "It defines the PLMN(s) of a Network Function." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/roamingAnalytics> a rdf:Property ;
    rdfs:comment """It indicates whether the NWDAF supports
Nnwdaf_RoamingAnalytics service""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/roamingData> a rdf:Property ;
    rdfs:comment """It indicates whether the NWDAF supports
Nnwdaf_RoamingData service""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """The FQDN of the registered NF instance in the service-based
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NWDAFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NetworkSliceInfo/cNSIId> a rdf:Property ;
    rdfs:comment """It represents NSI ID which is an identifier for identifying
the Core Network part of a Network Slice instance when multiple
Network Slice instances of the same Network Slice are deployed,
and there is a need to differentiate between them in the 5GC.
See NSI ID definition in clause 3.1 of TS 23.501 and
subclause 6.1.6.2.7 of TS 29.531.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NetworkSliceInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NetworkSliceInfo/networkSliceRef> a owl:ObjectProperty ;
    rdfs:comment """This holds a DN of the NetworkSlice managed object relating
to the NetworkSlice instance differentiated by sNSSAI and optional
cNSIId.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NetworkSliceInfo> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NetworkSliceInfo/sNSSAI> a owl:ObjectProperty ;
    rdfs:comment """It represents the S-NSSAI the NetworkSlice managed object
is supporting. The S-NSSAI is defined in TS 23.003 """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NetworkSliceInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAI> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafCapability/analyticsAggregation> a rdf:Property ;
    rdfs:comment """It indicates whether the NWDAF supports analytics
aggregation""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafCapability/analyticsMetadataProvisioning> a rdf:Property ;
    rdfs:comment """It indicate whether the NWDAF supports analytics metadata
provisioning:""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafCapability/roamingExchange> a rdf:Property ;
    rdfs:comment """It indicates whether the NWDAF
supports roaming exchange capability""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafEvent> a rdfs:Datatype ;
    rdfs:comment """The detailed ENUM value for NwdafEvent see the
Table 5.1.6.3.4-1 in TS 29.520""" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo/analyticsDelay> a rdf:Property ;
    rdfs:comment """It represents the supported Analytics Delay related to the
eventIds and nwdafEvents.
It is an unsigned integer identifying a period of time in units of
seconds.(see clause 5.2.2 TS 29.571).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo/eventIds> a rdf:Property ;
    rdfs:comment """It represents the EventId(s) supported by the
Nnwdaf_AnalyticsInfo service, if none are provided the NWDAF can serve
any eventId. (see clause TS 29.520)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo/mlAnalyticsList> a owl:ObjectProperty ;
    rdfs:comment """It represents ML Analytics Filter information supported by
the Nnwdaf_MLModelProvision service.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/MlAnalyticsInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo/nwdafCapability> a owl:ObjectProperty ;
    rdfs:comment """This attribute indicates the capability of the NWDAF.
If not present, the NWDAF shall be regarded with no capability.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafCapability> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo/nwdafEvents> a rdf:Property ;
    rdfs:comment """This attribute represents the Analytic functionalities
(identified by nwdafEvent defined in TS 29.520) of the NWDAF instance.
MnS consumer can configure this attribute to specify which Analytic
functionalities (identified by nwdafEvent) can be performed the NWDAF
instance. If the value of this attribute is not present, the NWDAF
instance can perform any NWDAFEvents.
The detailed ENUM value for NwdafEvent see the Table 5.1.6.3.4-1
in TS 29.520""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo/servingNfSetIdList> a rdf:Property ;
    rdfs:comment """It contains the list of NF type(s) from which the NWDAF NF
can collect data. The absence of this attribute indicates that the
NWDAF can collect data from any NF type. (see clause 5.4.2 NfSetId
in TS 29.571)""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo/servingNfTypeList> a rdf:Property ;
    rdfs:comment """It contains the list of NF type(s) from which the NWDAF NF
can collect data. The absence of this attribute indicates that the
NWDAF can collect data from any NF type.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo/taiList> a owl:ObjectProperty ;
    rdfs:comment "The list of TAIs. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo/taiRangeList> a owl:ObjectProperty ;
    rdfs:comment "The range of TAIs." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/NwdafInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl/administrativeState> a rdf:Property ;
    rdfs:comment """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl/operationalState> a rdf:Property ;
    rdfs:comment "It is used by STM consumer to report its working state" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl/reportingNFList> a owl:ObjectProperty ;
    rdfs:comment """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl/stmTargetUri> a rdf:Property ;
    rdfs:comment """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl/targetInterfaceInfoList> a owl:ObjectProperty ;
    rdfs:comment """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/StmCtrl> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-stm-nrm-stmfunction/NetworkInterface> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/SupportedPerfMetricGroups/granularityPeriods> a rdf:Property ;
    rdfs:comment """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/SupportedPerfMetricGroups/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/SupportedPerfMetricGroups/reportingMethods> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/SupportedPerfMetricGroups/reportingPeriods> a rdf:Property ;
    rdfs:comment """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/SupportedPerfMetricGroups> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor/administrativeState> a rdf:Property ;
    rdfs:comment "Enables or disables the ThresholdMonitor." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor/monitorGranularityPeriod> a rdf:Property ;
    rdfs:comment """ Granularity period used to monitor measurements for
threshold crossings. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the ThresholdMonitor is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor/thresholdInfoList> a owl:ObjectProperty ;
    rdfs:comment "List of threshold info." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/ThresholdMonitor> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-measurements/ThresholdInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a TraceJob" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/jobType> a rdf:Property ;
    rdfs:comment """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/listOfTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/mdtConfig> a owl:ObjectProperty ;
    rdfs:comment """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/MdtConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/nPNTarget> a owl:ObjectProperty ;
    rdfs:comment """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/pLMNTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/rrcReportType> a rdf:Property ;
    rdfs:comment "Specifies the RRC reports requested. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/traceCollectionEntityIPAddress> a rdf:Property ;
    rdfs:comment """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/traceConfig> a owl:ObjectProperty ;
    rdfs:comment "Trace config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/traceReference> a owl:ObjectProperty ;
    rdfs:comment """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/TraceReference> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/traceReportingConsumerUri> a rdf:Property ;
    rdfs:comment """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/traceReportingFormat> a rdf:Property ;
    rdfs:comment """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/traceTarget> a owl:ObjectProperty ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/traceTarget> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob/ueCoreMeasConfig> a owl:ObjectProperty ;
    rdfs:comment "5GC UE level measurements config" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/TraceJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-trace/UECoreMeasConfig> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/commModelList/commModelConfiguration> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/commModelList/commModelType> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/commModelList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/commModelList/groupId> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/commModelList> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/commModelList/targetNFServiceList> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/commModelList> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNInfoList/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNInfoList/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNInfoList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNInfoList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNInfoList> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNTarget/mcc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNTarget/mnc> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/pLMNTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAI/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAI> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAI/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAI> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIList/sd> a rdf:Property ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIList/sst> a rdf:Property ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/sNSSAIList> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nwdaffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/fileCompression> a rdf:Property ;
    rdfs:comment """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/fileContent> a rdf:Property ;
    rdfs:comment """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:base64Binary ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/fileDataType> a rdf:Property ;
    rdfs:comment "Type of the management data stored in the file." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/fileExpirationTime> a rdf:Property ;
    rdfs:comment "Date and time after which the file may be deleted." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/fileFormat> a rdf:Property ;
    rdfs:comment """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/fileReadyTime> a rdf:Property ;
    rdfs:comment """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/fileSize> a rdf:Property ;
    rdfs:comment "Size of the file" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:unsignedLong ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/File> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/Files/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/Files> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/Files/jobId> a rdf:Property ;
    rdfs:comment "Identifier of a PerfMetricJob job or a TraceJob." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/Files> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/Files/jobRef> a owl:ObjectProperty ;
    rdfs:comment """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/Files> ;
    nrm:isInvariant true ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/Files/numberOfFiles> a rdf:Property ;
    rdfs:comment "Number of files in a file collection." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/Files> ;
    rdfs:range xsd:unsignedLong .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService/administrativeState> a rdf:Property ;
    rdfs:comment "Permission to use or prohibition against using the instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService/nFServiceType> a rdf:Property ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService/operationalState> a rdf:Property ;
    rdfs:comment "Describes whether the resource is installed and working" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService/operations> a owl:ObjectProperty ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService/registrationState> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService/sAP> a owl:ObjectProperty ;
    rdfs:comment "The service access point of the managed NF service instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-yang-types/SAP> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService/usageState> a rdf:Property ;
    rdfs:comment """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ManagedNFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/SupportedPerfMetricGroups> a owl:ObjectProperty ;
    rdfs:comment """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/SupportedPerfMetricGroups> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/commModelList> a owl:ObjectProperty ;
    rdfs:comment """Specifies a list of commModel. It can be used by NF and
NF services to interact with each other in 5G Core network """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/commModelList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/configurable5QISetRef> a owl:ObjectProperty ;
    rdfs:comment """DN of the Configurable5QISet that the PCFFunction supports
(is associated to).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/dynamic5QISetRef> a owl:ObjectProperty ;
    rdfs:comment """DN of the Dynamic5QISet that the PCFFunction supports
(is associated to).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/managedNFProfile> a owl:ObjectProperty ;
    rdfs:comment "Profile definition of a Managed NF (See TS 23.501)" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/ManagedNFProfile> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/pLMNIdList> a owl:ObjectProperty ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id).
The PLMN Identifier is composed of a Mobile Country Code (MCC) and a
Mobile Network Code (MNC).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pLMNIdList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/pcfInfo> a owl:ObjectProperty ;
    rdfs:comment """This attribute represents information of a PCF NF Instance.
Multiple pcfInfo may be allowed to define different DNN list for each
supiranges.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/pcfInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/peeParameterslist> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/priorityLabel> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/sBIFQDN> a rdf:Property ;
    rdfs:comment """The FQDN of the registered NF instance in the service-based
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/sNSSAIList> a owl:ObjectProperty ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of supporting.
(Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/sNSSAIList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/supportedBMOList> a rdf:Property ;
    rdfs:comment """It is used to indicate the list of supported BMOs
(Bridge Managed Objects) required for integration with TSN system.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/supportedTraceMetrics> a rdf:Property ;
    rdfs:comment """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/userLabel> a rdf:Property ;
    rdfs:comment "A user-friendly (and user assignable) name of this object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction/vnfParametersList> a owl:ObjectProperty ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PCFFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/_linkToFiles> a rdf:Property ;
    rdfs:comment "Link to a 'Files' object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/administrativeState> a rdf:Property ;
    rdfs:comment "Enable or disables production of the metrics" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/conditionMonitorRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a ConditionMonitor object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/fileLocation> a rdf:Property ;
    rdfs:comment """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/fileReportingPeriod> a rdf:Property ;
    rdfs:comment """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/granularityPeriod> a rdf:Property ;
    rdfs:comment """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/jobId> a rdf:Property ;
    rdfs:comment "Id for a PerfMetricJob job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/objectInstances> a owl:ObjectProperty ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/operationalState> a rdf:Property ;
    rdfs:comment "Indicates whether the PerfMetricJob is working." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/performanceMetrics> a rdf:Property ;
    rdfs:comment """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/rootObjectInstances> a owl:ObjectProperty ;
    rdfs:comment """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/schedulerRef> a owl:ObjectProperty ;
    rdfs:comment "Pointer to a Scheduler object." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    nrm:isReference true .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob/streamTarget> a rdf:Property ;
    rdfs:comment """Applicable when stream-based reporting method is
supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/PerfMetricJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseDirectCommunication> a rdf:Property ;
    rdfs:comment "Indicates support for ProSe Direct Communication." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseDirectDiscovery> a rdf:Property ;
    rdfs:comment "Indicates support for ProSe Direct Discovery." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL2EndUe> a rdf:Property ;
    rdfs:comment "Indicates support for ProSe Layer-2 End UE." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-pcffunction/ProSeCapability/proseL2RemoteUe> a rdf:Property ;
