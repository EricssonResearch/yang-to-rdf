<urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/DPCIConfigurationFunction/dPciConfigurationControl> a rdf:Property ;
    rdfs:comment """This attribute determines whether the Distributed SON PCI
configuration Function is enabled or disabled.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-dpciconfigurationfunction/DPCIConfigurationFunction> ;
