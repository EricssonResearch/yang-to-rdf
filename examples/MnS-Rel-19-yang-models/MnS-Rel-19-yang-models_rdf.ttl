    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/versions/apiVersionInUri> a rdf:Property ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/versions> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/versions/expiry> a rdf:Property ;
