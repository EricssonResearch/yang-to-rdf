econn3gpp:GeoLoc a rdfs:Class ;
    rdfs:label "GeoLoc" ;
    rdfs:comment """This refers to the Geographical Service Area,
(see clause 7.3.3.3 in TS 23.558 that is defined as a datatype
(see clause 6.3.4).""" ;
    y2r:hasAttribute me3gpp:geographicalCoordinates .

econn3gpp:ServingLocation a rdfs:Class ;
    rdfs:label "ServingLocation" ;
    rdfs:comment """This parameter defines the EAS service area
(see clause 7.3.3.6 in TS 23.558).""" ;
