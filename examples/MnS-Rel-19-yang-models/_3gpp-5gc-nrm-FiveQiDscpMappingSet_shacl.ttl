@prefix FiveQiDscpM3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-FiveQiDscpMappingSet#> .
@prefix FiveQiDscpM3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-5gc-nrm-FiveQiDscpMappingSet#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

FiveQiDscpM3gpp-shapes:FiveQiDscpMappingSet a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path FiveQiDscpM3gpp:FiveQiDscpMappingSet.id ],
        [ sh:class FiveQiDscpM3gpp:fiveQiDscpMappingList ;
            sh:description "It provides the list of mapping between 5QIs and DSCP." ;
            sh:path FiveQiDscpM3gpp:FiveQiDscpMappingSet.fiveQiDscpMappingList ] ;
    sh:targetClass FiveQiDscpM3gpp:FiveQiDscpMappingSet .

FiveQiDscpM3gpp-shapes:fiveQiDscpMappingList a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description " Identifies the 5QI values that are mapped to a same DSCP" ;
            sh:minCount 1 ;
            sh:path FiveQiDscpM3gpp:fiveQiDscpMappingList.fiveQIValues ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path FiveQiDscpM3gpp:fiveQiDscpMappingList.dscp ] ;
    sh:targetClass FiveQiDscpM3gpp:fiveQiDscpMappingList .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-FiveQiDscpMappingSet> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-FiveQiDscpMappingSet" ;
    dcterms:description """ This IOC represents the set of mapping between 5QIs and DSCP.
