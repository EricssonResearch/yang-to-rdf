@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-common-managed-function/Operation> a rdfs:Class ;
    rdfs:label "Operation" ;
    rdfs:comment """Set of operations supported by the managed NF
service instance""" .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> a rdfs:Class ;
    rdfs:label "PeeParameters" ;
    rdfs:comment """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ .

<urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> a rdfs:Class ;
    rdfs:label "VnfParameters" ;
    rdfs:comment """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ .

<urn:3gpp:sa5:_3gpp-common-managed-function> a owl:Ontology ;
    rdfs:label "_3gpp-common-managed-function" ;
    dcterms:description """The module defines a base class/grouping for major 3GPP
functions.
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source """3GPP TS 28.622
Generic Network Resource Model (NRM)
Integration Reference Point (IRP);
Information Service (IS)

3GPP TS 28.620
Umbrella Information Model (UIM)""" ;
    dcterms:title "_3gpp-common-managed-function" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-08-13 (CR-0551)" .

<urn:3gpp:sa5:_3gpp-common-managed-function/Operation/allowedNFTypes> a rdf:Property ;
    rdfs:label "Operation.allowedNFTypes" ;
    rdfs:comment """The type of the managed NF service instance
The specifc values allowed are described in TS 23.501""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/Operation/name> a rdf:Property ;
    rdfs:label "Operation.name" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-function/Operation/operationSemantics> a rdf:Property ;
    rdfs:label "Operation.operationSemantics" ;
    rdfs:comment "Semantics type of the operation." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/Operation> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/environmentType> a rdf:Property ;
    rdfs:label "PeeParameters.environmentType" ;
    rdfs:comment """The type of environment where the managedFunction
instance resides.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/equipmentType> a rdf:Property ;
    rdfs:label "PeeParameters.equipmentType" ;
    rdfs:comment """The type of equipment where the managedFunction
instance resides.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/powerInterface> a rdf:Property ;
    rdfs:label "PeeParameters.powerInterface" ;
    rdfs:comment "The type of power." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteAltitude> a rdf:Property ;
    rdfs:label "PeeParameters.siteAltitude" ;
    rdfs:comment """The altitude of the site where the ManagedFunction
instance resides, in the unit of meter. This attribute is
optional for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteDescription> a rdf:Property ;
    rdfs:label "PeeParameters.siteDescription" ;
    rdfs:comment """An operator defined description of the site where
the ManagedFunction instance resides.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteIdentification> a rdf:Property ;
    rdfs:label "PeeParameters.siteIdentification" ;
    rdfs:comment """The identification of the site where the
ManagedFunction resides.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteLatitude> a rdf:Property ;
    rdfs:label "PeeParameters.siteLatitude" ;
    rdfs:comment """The latitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
the northern hemisphere. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier instance(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters/siteLongitude> a rdf:Property ;
    rdfs:label "PeeParameters.siteLongitude" ;
    rdfs:comment """The longitude of the site where the ManagedFunction
instance resides, based on World Geodetic System (1984 version)
global reference frame (WGS 84). Positive values correspond to
degrees east of 0 degrees longitude. This attribute is optional
for BTSFunction, RNCFunction, GNBDUFunction and
NRSectorCarrier
instance(s).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/PeeParameters> ;
    rdfs:range xsd:decimal .

<urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters/autoScalable> a rdf:Property ;
    rdfs:label "VnfParameters.autoScalable" ;
    rdfs:comment """Indicator of whether the auto-scaling of this
VNF instance is enabled or disabled.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters/flavourId> a rdf:Property ;
    rdfs:label "VnfParameters.flavourId" ;
    rdfs:comment """Identifier of the VNF Deployment Flavour applied to this
VNF instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters/vnfInstanceId> a rdf:Property ;
    rdfs:label "VnfParameters.vnfInstanceId" ;
    rdfs:comment "VNF instance identifier" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters/vnfdId> a rdf:Property ;
    rdfs:label "VnfParameters.vnfdId" ;
    rdfs:comment """Identifier of the VNFD on which the VNF instance is based.
The absence of the leaf or a string length of zero for vnfInstanceId
means the VNF instance(s) does not exist (e.g. has not been
instantiated yet, has already been terminated).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-managed-function/VnfParameters> ;
    rdfs:range xsd:string .

