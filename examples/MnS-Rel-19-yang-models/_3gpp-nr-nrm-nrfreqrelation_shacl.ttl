@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nrfreqrel3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nrfreqrelation#> .
@prefix nrfreqrel3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-nr-nrm-nrfreqrelation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix redcap3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-redcapaccess#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

nrfreqrel3gpp-shapes:NRFreqRelation a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.id ],
        [ sh:datatype xsd:byte ;
            sh:description "Offset value of rsrpOffsetSSB." ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.rsrpOffsetSsb ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Indicates a fractional value to be added to the value of
cellReselectionPriority to obtain the absolute priority of the
concerned carrier frequency for E-UTRA and NR.""" ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.cellReselectionSubPriority ],
        [ sh:datatype xsd:int ;
            sh:description """Used for calculation of the parameter Pcompensation
(defined in 3GPP TS 38.304), at cell reselection to a cell.""" ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.pMax ],
        [ sh:datatype xsd:byte ;
            sh:description """The frequency specific offset applied when evaluating
candidates for cell reselection.""" ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.qOffsetFreq ],
        [ sh:datatype xsd:int ;
            sh:description """Indicates the minimum required quality level in the cell.
Value 0 means that it is not sent and UE applies in such case the
(default) value of negative infinity for Qqualmin. Sent in SIB3 or
SIB5.""" ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.qQualMin ],
        [ sh:datatype xsd:int ;
            sh:description """Indicates the required minimum received Reference Symbol
Received Power (RSRP) level in the NR frequency for cell reselection.
Broadcast in SIB3 or SIB5, depending on whether the related frequency
is intra- or inter-frequency. Resolution is 2.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.qRxLevMin ],
        [ sh:datatype xsd:int ;
            sh:description """Specifies the Srxlev threshold used by the UE when
reselecting towards a higher priority RAT/frequency than the current
serving frequency. Each frequency of NR and E-UTRAN might have a
specific threshold. Resolution is 2.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.threshXHighP ],
        [ sh:datatype xsd:int ;
            sh:description """Specifies the Squal threshold used by the UE when
reselecting towards a higher priority RAT/frequency than the current
serving frequency. Each frequency of NR and E-UTRAN might have a
specific threshold.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.threshXHighQ ],
        [ sh:datatype xsd:int ;
            sh:description """Specifies the Srxlev threshold used by the UE when
reselecting towards a lower priority RAT/frequency than the current
serving frequency. Each frequency of NR and E-UTRAN might have a
specific threshold. Resolution is 2.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.threshXLowP ],
        [ sh:datatype xsd:int ;
            sh:description """Specifies the Squal threshold used by the UE when
reselecting towards a lower priority RAT/frequency than the current
serving frequency. Each frequency of NR and E-UTRAN might have a
specific threshold.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.threshXLowQ ],
        [ sh:datatype xsd:int ;
            sh:description "Cell reselection timer for NR." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.tReselectionNr ],
        [ sh:datatype xsd:byte ;
            sh:description "Offset value of rsrqOffsetSSB." ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.rsrqOffsetSsb ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """The attribute tReselectionNr (parameter TreselectionNR in
3GPP TS 38.304) is multiplied with this scaling factor if the UE is
in high mobility state.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.tReselectionNRSfHigh ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """The attribute tReselectionNr (parameter TreselectionNR in
3GPP TS 38.304) multiplied with this scaling factor if the UE is in
medium mobility state.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.tReselectionNRSfMedium ],
        [ sh:description "Reference to a corresponding NRFrequency instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.nRFrequencyRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class redcap3gpp:CellReselectionRedcap ;
            sh:description """This attribute indicates the configuration parameters
to allow relaxation of RRM measurement requirements for redcap UE
cell reselection""" ;
            sh:path nrfreqrel3gpp:NRFreqRelation.cellReselectionRedcap ],
        [ sh:datatype xsd:byte ;
            sh:description "Offset value of sinrOffsetSSB." ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.sinrOffsetSsb ],
        [ sh:datatype xsd:byte ;
            sh:description "Offset value of rsrpOffsetCSI-RS." ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.rsrpOffsetCsiRs ],
        [ sh:datatype xsd:byte ;
            sh:description "Offset value of rsrqOffsetCSI-RS." ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.rsrqOffsetCsiRs ],
        [ sh:datatype xsd:byte ;
            sh:description "Offset value of sinrOffsetCSI-RS." ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.sinrOffsetCsiRs ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """A list of Physical Cell Identities (PCIs) that are
blocklisted in NR measurements.""" ;
            sh:path nrfreqrel3gpp:NRFreqRelation.blockListEntry ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """A list of Physical Cell Identities (PCIs) that are
blocklisted in SIB4 and SIB5.""" ;
            sh:path nrfreqrel3gpp:NRFreqRelation.blockListEntryIdleMode ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """The absolute priority of the carrier frequency used by the
cell reselection procedure. Value 0 means lowest priority. The value
must not already used by other RAT, i.e. equal priorities between RATs
are not supported. The UE behaviour when no value is entered is
specified in subclause 5.2.4.1 of 3GPP TS 38.304.""" ;
            sh:maxCount 1 ;
            sh:path nrfreqrel3gpp:NRFreqRelation.cellReselectionPriority ] ;
    sh:targetClass nrfreqrel3gpp:NRFreqRelation .

<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nrfreqrelation> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-nrfreqrelation" ;
    dcterms:description """Defines the YANG mapping of the NRFreqRelation Information
Object Class (IOC) that is part of the NR Network Resource Model (NRM).
Copyright 2026, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-nrfreqrelation" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-05-19 (CR-1702)" ;
    y2r:yangModuleName "_3gpp-nr-nrm-nrfreqrelation" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation> .

