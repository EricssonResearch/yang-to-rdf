            sh:path PredPccRules3gpp:qosDataInfo.preemptVuln ],
        [ sh:datatype xsd:boolean ;
            sh:description "It indicates whether notifications are requested from 3GPP NG-RAN when the GFBR can no longer (or again) be guaranteed for a QoS Flow during the lifetime of the QoS Flow." ;
            sh:maxCount 1 ;
            sh:path PredPccRules3gpp:qosDataInfo.qosNotificationControl ] ;
    sh:targetClass PredPccRules3gpp:qosDataInfo .

PredPccRules3gpp-shapes:redirectInfo a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description "It indicates whether the redirect instruction is enabled." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path PredPccRules3gpp:redirectInfo.redirectEnabled ],
        [ sh:description "It indicates the type of redirect address." ;
            sh:in ( "IPV4_ADDR" "IPV6_ADDR" "URL" "SIP_URI" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path PredPccRules3gpp:redirectInfo.redirectAddressType ],
        [ sh:datatype xsd:string ;
            sh:description "It indicates the address of the redirect server." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path PredPccRules3gpp:redirectInfo.redirectServerAddress ] ;
    sh:targetClass PredPccRules3gpp:redirectInfo .

PredPccRules3gpp-shapes:routeToLoc a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "It represents the DNAI (Data network access identifier)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path PredPccRules3gpp:routeToLoc.dnai ],
        [ sh:datatype xsd:string ;
            sh:description """It defines the Ipv4 address of the tunnel end point in the
data network, formatted in the dotted decimal notation.""" ;
            sh:maxCount 1 ;
            sh:path PredPccRules3gpp:routeToLoc.ipv4Addr ],
        [ sh:datatype xsd:string ;
            sh:description """It defines the Ipv6 address of the tunnel end point in the
data network.""" ;
            sh:maxCount 1 ;
            sh:path PredPccRules3gpp:routeToLoc.ipv6Addr ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ It defines the UDP port number of the tunnel end point in
the data network, see TS 29.571""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path PredPccRules3gpp:routeToLoc.portNumber ],
        [ sh:datatype xsd:string ;
            sh:description "It identifies the routing profile." ;
            sh:maxCount 1 ;
            sh:path PredPccRules3gpp:routeToLoc.routeProfId ] ;
    sh:targetClass PredPccRules3gpp:routeToLoc .

PredPccRules3gpp-shapes:sNSSAIList a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path PredPccRules3gpp:sNSSAIList.sd ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path PredPccRules3gpp:sNSSAIList.sst ] ;
    sh:targetClass PredPccRules3gpp:sNSSAIList .

