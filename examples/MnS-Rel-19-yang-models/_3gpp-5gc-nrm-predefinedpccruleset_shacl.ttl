            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path PredPccRules3gpp:flowInfo.sourceMacAddr ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Customer-VLAN and/or Service-VLAN tags
