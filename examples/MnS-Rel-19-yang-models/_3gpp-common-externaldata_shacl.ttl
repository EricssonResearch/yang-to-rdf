@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix exdata3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-externaldata#> .
@prefix exdata3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-common-externaldata#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix types3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-yang-types#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

exdata3gpp-shapes:ExternalDataScope a sh:NodeShape ;
    sh:property [ sh:description """List of managed object instances to which the described
data are related. Each object instance is identified by its DN.""" ;
            sh:path exdata3gpp:ExternalDataScope.objectInstancesIncluded ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """List of managed object instances which are not considered
in relation to the described data. Each object instance is identified
by its DN.""" ;
            sh:path exdata3gpp:ExternalDataScope.objectInstancesExcluded ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class types3gpp:GeoArea ;
            sh:description "It describes the concrete geographical area(s)" ;
            sh:path exdata3gpp:ExternalDataScope.geoAreas ] ;
    sh:targetClass exdata3gpp:ExternalDataScope .

exdata3gpp-shapes:ExternalDataType a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path exdata3gpp:ExternalDataType.id ],
        [ sh:datatype xsd:string ;
            sh:description """Type of external management data as defined by the
implementation.

Examples: 'Electronic Map', 'Camara Data', 'UE path', 'Camera Photo',
'Event Schedule”""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path exdata3gpp:ExternalDataType.externalDataType ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the media which includes the transfer protocol.

Examples:
sftp://companyA.com/datastore/fileName.xml
https://companyA.com/ManagedElement=1/Files=1/File=1""" ;
            sh:path exdata3gpp:ExternalDataType.mediaLocation ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the schema to parse a type of external management data.
The detailed schema definition for the different types of external
management data is out of scope of this specification.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path exdata3gpp:ExternalDataType.externalDataTypeSchema ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:class exdata3gpp:ExternalDataScope ;
            sh:description """It describes the concrete scope which the external management
data is applicable.""" ;
            sh:path exdata3gpp:ExternalDataType.externalDataScope ] ;
    sh:targetClass exdata3gpp:ExternalDataType .

<https://semantics.ericsson.com/yang/_3gpp-common-externaldata> a owl:Ontology ;
    rdfs:label "_3gpp-common-externaldata" ;
    dcterms:description """Defines the YANG mapping of the external data.
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.623 Generic Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-common-externaldata" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-07-19 (CR-0551)" ;
    y2r:yangModuleName "_3gpp-common-externaldata" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-common-externaldata> .

