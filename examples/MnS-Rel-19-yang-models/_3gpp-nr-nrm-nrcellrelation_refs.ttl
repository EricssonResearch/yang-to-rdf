    nrm:inferredBy "dn-name-suffix" .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrcellrelation/NRCellRelation/nRFreqRelationRef> rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-nrfreqrelation/NRFreqRelation> ;
