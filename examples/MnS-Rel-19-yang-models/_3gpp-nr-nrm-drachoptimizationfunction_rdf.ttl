@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/DRACHOptimizationFunction> a rdfs:Class ;
    rdfs:label "DRACHOptimizationFunction" ;
    rdfs:comment """This IOC represents the management capabilities of
Centralized SON Energy Saving (ES) functions. This is provided for
Energy Saving purposes.

In the case where multiple CESManagement MOIs exist at different
levels of the containment tree, the CESManagement MOI at the lower
level overrides the CESManagement MOIs at higher level(s) of the
same containment tree.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/NumPreableAccessDelay> .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/NumPreableAccessDelay> a rdfs:Class ;
    rdfs:label "NumPreableAccessDelay" ;
    rdfs:comment """This is a list of target Access Probability (APn) for the
RACH optimization function.""" .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-drachoptimizationfunction" ;
    dcterms:description """Defines the YANG mapping of the DRACHOptimizationFunction
Information Object Class (IOC) that is part of the NR Network Resource
Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-drachoptimizationfunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-03-25 (CR-1504)" .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/AccessdelayT> a rdfs:Datatype ;
    rdfs:label "AccessdelayT" .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/DRACHOptimizationFunction/drachOptimizationControl> a rdf:Property ;
    rdfs:label "DRACHOptimizationFunction.drachOptimizationControl" ;
    rdfs:comment """This attribute determines whether the RACH Optimization
function is enabled or disabled.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/DRACHOptimizationFunction> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/DRACHOptimizationFunction/id> a rdf:Property ;
    rdfs:label "DRACHOptimizationFunction.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/DRACHOptimizationFunction> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/DRACHOptimizationFunction/ueAccDelayProbilityDist> a owl:ObjectProperty ;
    rdfs:label "DRACHOptimizationFunction.ueAccDelayProbilityDist" ;
    rdfs:comment """This is a list of target Access Delay probability (ADP)
for the RACH optimization function.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/DRACHOptimizationFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/NumPreableAccessDelay> .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/DRACHOptimizationFunction/ueAccProbilityDist> a owl:ObjectProperty ;
    rdfs:label "DRACHOptimizationFunction.ueAccProbilityDist" ;
    rdfs:comment """This is a list of target Access Probability (APn) for the
RACH optimization function.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/DRACHOptimizationFunction> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/NumPreableAccessDelay> .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/NumPreableAccessDelay/numberofpreamblessent> a rdf:Property ;
    rdfs:label "NumPreableAccessDelay.numberofpreamblessent" ;
    rdfs:comment """This attribute indicates the number of preambles sent
used to configure a wanted distribution of RACH preambles in a
vendor implemented DRACH optimisation function.
Note: The DRACH optimization function may configure preambleTransMax
as defined in TS 38.331 [54]. The allowed values for preambleTransMax
are 3, 4, 5, 6, 7, 8, 10, 20, 50, 100, 200 (see 38.331 [54],
subclause 6.3.2).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/NumPreableAccessDelay> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/NumPreableAccessDelay/targetProbability> a rdf:Property ;
    rdfs:label "NumPreableAccessDelay.targetProbability" ;
    rdfs:comment "This attribute determines the target Probability." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/NumPreableAccessDelay> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/NumberofpreamblessentT> a rdfs:Datatype ;
    rdfs:label "NumberofpreamblessentT" .

<urn:3gpp:sa5:_3gpp-nr-nrm-drachoptimizationfunction/TargetProbabilityT> a rdfs:Datatype ;
    rdfs:label "TargetProbabilityT" .

