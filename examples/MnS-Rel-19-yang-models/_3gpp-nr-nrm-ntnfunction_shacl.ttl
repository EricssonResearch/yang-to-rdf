ntn3gpp-shapes:Ephemeris a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This attribute indicates satellite Id.number.
It shall be formatted as a fixed 5-digit string, padding with
leading digits '0' to complete a 5-digit length.
allowedValues: 00000..00255""" ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Ephemeris.satelliteId ;
            sh:pattern "00([01][0-9][0-9])|(2[0-4][0-9]|(25[0-5]))" ],
        [ sh:datatype xsd:string ;
            sh:description "It defines the ephemeris reference time." ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Ephemeris.epochTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:class ntn3gpp:PositionVelocity ;
            sh:description """It indicates ephemeris is in format of NTN payload
position and velocity state vectors.""" ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Ephemeris.positionVelocity ],
        [ sh:class ntn3gpp:Orbital ;
            sh:description """It indicates ephemeris is in orbital parameter ephemeris
format.""" ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Ephemeris.orbital ] ;
    sh:targetClass ntn3gpp:Ephemeris .

ntn3gpp-shapes:EphemerisInfoSet a sh:NodeShape ;
