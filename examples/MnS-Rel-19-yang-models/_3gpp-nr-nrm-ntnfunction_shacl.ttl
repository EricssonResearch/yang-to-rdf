ntn3gpp-shapes:Orbital a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedLong ;
            sh:description """Satellite orbital parameter: semi major axis alpha.
Step of 4.249 * 10**-3 m.
Actual value = 6500000 + field value * (4.249 * 10**-3).""" ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Orbital.semiMajorAxis ],
        [ sh:datatype xsd:int ;
            sh:description """Satellite orbital parameter: eccentricity e.
Step 1.431 * 10**-8.
Actual value = field value * (1.431 * 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Orbital.eccentricity ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Satellite orbital parameter: argument of periapsis omega.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Orbital.periapsis ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Satellite orbital parameter: longitude of ascending node
omega.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Orbital.longitude ],
        [ sh:datatype xsd:int ;
            sh:description """Satellite orbital parameter: inclination i.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Orbital.inclination ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Satellite orbital parameter: Mean anomaly M at epoch time.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path ntn3gpp:Orbital.meanAnomaly ] ;
    sh:targetClass ntn3gpp:Orbital .

