@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-ntnfunction" ;
    dcterms:description """Implements support the C-SON function of Capacity and
Coverage optimization .
Copyright 2026, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-nr-nrm-ntnfunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-02-02 (CR-1682 CR-1683)" .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSet/id> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> ;
            sh:description "This is the list of Ephemeris related information." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSet/EphemerisInfos> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisInfoSet> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/EphemerisShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This attribute indicates satellite Id.number.
It shall be formatted as a fixed 5-digit string, padding with
leading digits '0' to complete a 5-digit length.
allowedValues: 00000..00255""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris/satelliteId> ;
            sh:pattern "00([01][0-9][0-9])|(2[0-4][0-9]|(25[0-5]))" ],
        [ sh:datatype xsd:string ;
            sh:description "It defines the ephemeris reference time." ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris/epochTime> ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> ;
            sh:description """It indicates ephemeris is in format of NTN payload
position and velocity state vectors.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris/positionVelocity> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> ;
            sh:description """It indicates ephemeris is in orbital parameter ephemeris
format, as specified in NIMA TR 8350.2""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris/orbital> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Ephemeris> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfigShape> a sh:NodeShape ;
    sh:property [ sh:description """Specifies the DN of a specific NTN related MOI.
allowedValues:  DN of of the following MOIs:
EP_NgC, NRCellCU, NRCellDU, NRSectorCarrier,
SectorEquipmentFunction, NRCellRelation.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig/nTNConfEntity> ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList> ;
            sh:description """Specifies the list of configuration parameters and values.
The content of the attribute is a list of attributeName- attributeValue
pairs.  AttributeValues may be complex types.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig/nTNConfigList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction/id> ],
        [ sh:datatype xsd:string ;
            sh:description """It is the list of Tracking Area Codes (either legacy TAC or
extended TAC) for NR NTN.
Legacy TAC and Extended TAC are defined in clause 9.3.3.10 of
TS 38.413.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction/nTNTAClist> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList> ;
            sh:description """It defines which PLMNs that can be served by the NR NTN cell,
and which S-NSSAIs can be supported by the NR NTN cell for
corresponding PLMN in case of network slicing feature is supported.
The pLMNId of the first entry of the list is the PLMNId used to
construct the nCGI for the NR cell.""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction/nTNpLMNInfoList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig/id> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-yang-types/TimeWindow> ;
            sh:description "It defines the time window." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig/timeWindow> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNEntityConfig> ;
            sh:description """It contains a list of configuration
updates to be applied to specified NTN entities.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig/nTNEntityConfigList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/NTNTimeBasedConfig> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/OrbitalShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedLong ;
            sh:description """Satellite orbital parameter: semi major axis alpha,
see NIMA TR 8350.2.
Step of 4.249 * 10**-3 m.
Actual value = 6500000 + field value * (4.249 * 10**-3).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/semiMajorAxis> ],
        [ sh:datatype xsd:int ;
            sh:description """Satellite orbital parameter: eccentricity e,
see NIMA TR 8350.2.
Step 1.431 * 10**-8.
Actual value = field value * (1.431 * 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/eccentricity> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Satellite orbital parameter: argument of periapsis omega,
see NIMA TR 8350.2.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/periapsis> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Satellite orbital parameter: longitude of ascending node
OMEGA, see NIMA TR 8350.2.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/longitude> ],
        [ sh:datatype xsd:int ;
            sh:description """Satellite orbital parameter: inclination i,
see NIMA TR 8350.2.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/inclination> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Satellite orbital parameter: Mean anomaly M at epoch time,
see NIMA TR 8350.2.
Step of 2.341* 10**-8 rad.
Actual value = field value * (2.341* 10**-8).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital/meanAnomaly> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/Orbital> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocityShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """X, Y, Z coordinate of satellite position state vector
in ECEF. Unit is meter.
Step of 1.3 m. Actual value = field value * 1.3.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/positionX> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """X, Y, Z coordinate of satellite position state vector
in ECEF. Unit is meter.
Step of 1.3 m. Actual value = field value * 1.3.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/positionY> ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """X, Y, Z coordinate of satellite position state vector
in ECEF. Unit is meter.
Step of 1.3 m. Actual value = field value * 1.3.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/positionZ> ],
        [ sh:datatype xsd:int ;
            sh:description """X, Y, Z coordinate of satellite velocity state vector
in ECEF.
Step of 0.06 m/s. Actual value = field value * 0.06.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/velocityVX> ],
        [ sh:datatype xsd:int ;
            sh:description """X, Y, Z coordinate of satellite velocity state vector
in ECEF.
Step of 0.06 m/s. Actual value = field value * 0.06.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/velocityVY> ],
        [ sh:datatype xsd:int ;
            sh:description """X, Y, Z coordinate of satellite velocity state vector
in ECEF.
Step of 0.06 m/s. Actual value = field value * 0.06.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity/velocityVZ> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/PositionVelocity> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList/name> ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList/value> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNConfigList> .

<urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList/mcc> ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList/sd> ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-ntnfunction/nTNpLMNInfoList> .

