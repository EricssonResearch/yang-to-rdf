    y2r:inferredBy "dn-name-suffix" .

extgnbcucp3gpp:StmCtrl.reportingNFList y2r:candidate "ReportingNF" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

extgnbcucp3gpp:ThresholdMonitor.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

extgnbcucp3gpp:ThresholdMonitor.rootObjectInstances y2r:candidate "RootObjectInstances" ;
