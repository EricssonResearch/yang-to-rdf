    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

extgnbcucp3gpp:PerfMetricJob.conditionMonitorRef rdfs:range util3gpp:ConditionMonitor ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

extgnbcucp3gpp:PerfMetricJob.objectInstances y2r:candidate "ObjectInstances" ;
