<urn:3gpp:sa5:_3gpp-nr-nrm-externalgnbcucpfunction> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-externalgnbcucpfunction" ;
    dcterms:description """Defines the YANG mapping of the ExternalGNBCUCPFunction
Information Object Class (IOC), that is part of the NR Network Resource
Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-externalgnbcucpfunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-04-25 (CR-1526 CR-1527)" .

