@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nrcelldu3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nrcelldu#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix redcap3gpp: <https://semantics.ericsson.com/yang/_3gpp-nr-nrm-redcapaccess#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-redcapaccess> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-redcapaccess" ;
    dcterms:description """Defines the YANG mapping of the NRCellDU Information Object
Class (IOC) that is part of the NR Network Resource Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-redcapaccess" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-11-07 (CR-1640)" ;
    y2r:yangModuleName "_3gpp-nr-nrm-redcapaccess" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-nr-nrm-redcapaccess> .

redcap3gpp:RedCapAccessCriteria.criteriaConditionRef y2r:candidate "CriteriaCondition" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

redcap3gpp:RedCapAccessCriteria.nRCellDURef rdfs:range nrcelldu3gpp:NRCellDU ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

