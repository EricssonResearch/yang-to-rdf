mnfp3gpp-shapes:ManagedNFProfile a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String uniquely identifying a NF instance." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfInstanceId ],
        [ sh:description "Type of Network Function." ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" "NWDAF" "PCSCF" "CBCF" "HSS" "UCMF" "SOR_AF" "SPAF" "MME" "SCSAS" "SCEF" "SCP" "NSSAAF" "ICSCF" "SCSCF" "DRA" "IMS_AS" "AANF" "5G_DDNMF" "NSACF" "MFAF" "EASDF" "DCCF" "MB_SMF" "TSCTSF" "ADRF" "GBA_BSF" "CEF" "MB_UPF" "NSWOF" "PKMF" "MNPF" "SMS_GMSC" "SMS_IWMSC" "MBSF" "MBSTF" "PANF" "TNGF" "W_AGF" "TWIF" "TSN_AF" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfType ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern (regular expression according to the ECMA-262
dialect [75]) representing the NF domain names within the PLMN of
the NRF allowed to access the NF instance If not provided,
any NF domain is allowed to access the NF.""" ;
            sh:path mnfp3gpp:ManagedNFProfile.allowedNfDomains ],
        [ sh:datatype xsd:string ;
            sh:description """Operator defined information about the location
of the NF instance (e.g. geographic location, data center).""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.locality ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the operator defined information about the
location of the NF instance. The key of the map shall be a (unique)
valid JSON string per clause 7 of IETF RFC 8259 [92], with a maximum
of 32 characters, representing a type of locality as defined in
clause 6.1.6.3.18.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.extLocality ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Static capacity information in the range of 0-65535,
expressed as a weight relative to other NF instances of
the same type; if capacity is also present in the nfServiceList
parameters, those will have precedence over this value.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.capacity ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Dynamic load information, ranged from 0 to 100,
indicates the current load percentage of the NF.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.load ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the point in time in which the latest load
information (sent by the NF in the load attribute of the NF Profile)
was generated at the NF Instance. If the NF did not provide a
timestamp, the NRF should set it to the instant when the NRF received
the message where the NF provided the latest load information.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.loadTimeStamp ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """Timestamp when the NF was (re)started. The NRF shall
notify NFs subscribed to receiving notifications of changes of the
NF profile, if the NF recoveryTime is changed.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.recoveryTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the different service
instances of a same NF Service in the NF instance, supporting a same
API version, are capable to persist their resource state in shared
storage and therefore these resources are available after a new NF
service instance supporting the same API version is selected by a NF
Service Consumer.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfServicePersistence ],
        [ sh:datatype xsd:string ;
            sh:description """A NF Set Identifier is a globally unique identifier of
a set of equivalent and interchangeable CP NFs from a given network
that provide distribution, redundancy and scalability
(see clause 5.21.3 of 3GPP TS 23.501 [2]).An NF Set Identifier shall
be constructed from the MCC, MNC, NID (for SNPN), NF type and a Set ID.
A NF Set Identifier shall be formatted as the following string:
set<Set ID>.<nftype>set.5gc.mnc<MNC>.mcc<MCC> for a NF Set in a PLMN, or
set<Set ID>.<nftype>set.5gc.nid<NID>.mnc<MNC>.mcc<MCC> for a NF Set
in a SNPN.At most one NF Set ID shall be indicated per PLMN-ID or SNPN
of the NF.""" ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfSetIdList ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates if the NF Service Consumer
supports or does not support receiving NF Profile Changes. It may
be present in the NFRegister or NFUpdate (NF Profile Complete
Replacement) request and shall be absent in the response.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfProfileChangesSupportInd ],
        [ sh:description "Status of the NF Instance." ;
            sh:in ( "REGISTERED" "SUSPENDED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfStatus ],
        [ sh:datatype xsd:boolean ;
            sh:description """It represents NF Profile Partial Update Changes Support
Indicator. TRUE: the NF Service Consumer supports receiving NF
Profile Changes in the response to an NF Profile Partial Update
operation. FALSE (default): the NF Service Consumer does not
support receiving NF Profile Changes in the response to an NF
Profile Partial Update operation.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfProfilePartialUpdateChangesSupportInd ],
        [ sh:datatype xsd:boolean ;
            sh:description """NF Profile Changes Indicator. This IE shall be absent
in the request to the NRF and may be included by the NRF in
NFRegister or NFUpdate (NF Profile Complete Replacement) response.
true: the NF Profile contains NF Profile changes.
false (default): complete NF Profile.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfProfileChangesInd ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter indicates the served geographical areas
of a NF instance.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.servingScope ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Load Control based on LCI Header.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.lcHSupportInd ],
        [ sh:datatype xsd:boolean ;
            sh:description """This parameter indicates whether the NF supports or does
not support Overload Control based on OCI Header .""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.olcHSupportInd ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Set(s)
indicated by the NfSetId, where the NF instance belongs.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfSetRecoveryTimeList ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter contains the recovery time of NF Service
Set(s) configured in the NF instance, which are indicated by the
NfServiceSetId""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.serviceSetRecoveryTimeList ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter shall carry the list of SCP domains the
SCP belongs to, or the SCP domain the NF (other than SCP) or the SEPP
belongs to..""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.scpDomains ],
        [ sh:datatype xsd:string ;
            sh:description """Vendor ID of the NF instance, according to the
IANA-assigned SMI Network Management Private Enterprise Codes [77].
allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits 0 to complete
a 6-digit string value.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.vendorId ],
        [ sh:datatype xsd:string ;
            sh:description """Identifications of Credentials Holder or Default Credentials
Server. It is an array of FQDN.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.hniList ],
        [ sh:datatype xsd:string ;
            sh:description "It represents human readable name of the NF Instance" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfInstanceName ],
        [ sh:datatype xsd:string ;
            sh:description """If the NF needs to be discoverable by other
NFs in a different PLMN, then an FQDN that is used
for inter-PLMN routing is specified.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.interPlmnFqdn ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF instance whose
nfStatus is set to REGISTERED is in Canary Release condition,
i.e. it should only be selected by NF Service Consumers under the
conditions indicated by the selectionConditions attribute.
True: the NF is under Canary Release condition, even if the
nfStatus is set to REGISTERED.
False: the NF instance indicates its Canary Release condition
via the nfStatus attribute.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.canaryRelease ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether an NF Service Consumer
should only select an NF Service Producer in Canary Release
condition.
True: the consumer shall only select producers in Canary Release
condition.
False: the consumer may select producers not in Canary Release
condition.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.exclusiveCanaryReleaseSelection ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates a string uniquely identifying
Shared Profile Data. The format of the sharedProfileDataId shall be
a Universally Unique Identifier (UUID) version 4, as described in
IETF RFC 4122 [44]. The hexadecimal letters should be formatted as
lower-case characters by the sender, and they shall be handled as
case-insensitive by the receiver.
Example: 4ace9d34-2c69-4f99-92d5-a73a3fe8e23b""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.sharedProfileDataId ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the timestamp when the NF Instance is
planned to be shut down. This attribute may be present if the
nfStatus is set to UNDISCOVERABLE due to scheduled shutdown.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.shutdownTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "It represents a list of Resource Content Filter IDs." ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.supportedRcfs ],
        [ sh:datatype xsd:boolean ;
            sh:description """ManagedNFProfile.canaryPrecedenceOverPreferred  This
attribute indicates whether the NRF shall prioritize the NF Service
Producer in Canary Release condition over the preferences
(preferred-xxx, ext-preferred-xxx) present in NF discovery requests.
allowedValues:
True NRF shall prioritize NF Service Producers in Canary Release
condition at NF discovery requests, i.e. NF Service Producers
determined according to preferred-xxx and/or ext-preferred-xxx
shall be prioritized after the NF Service Producers in Canary
Release condition. The associated NF (service) priorities for Service
Producers in Canary Release condition shall not be modified by NRF.
False NRF shall prioritize the NF Service Producers according to
preferred-xxx and/or ext-preferred-xxx (i.e. Canary Release condition
in NF Service Producers shall not be prioritized over NF Service
Consumer preferences at NF discovery requests)""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.canaryPrecedenceOverPreferred ],
        [ sh:class mnfp3gpp:CollocatedNfInstance ;
            sh:description """It represents information related to collocated NF
type(s) and corresponding NF Instances when the NF is collocated
with NFs supporting other NF types.""" ;
            sh:path mnfp3gpp:ManagedNFProfile.collocatedNfInstances ],
        [ sh:class smf3gpp:plmnList ;
            sh:description """PLMN(s) of the Network Function.
This IE shall be present if this information
is available for the NF. If not provided, PLMN ID(s)
of the PLMN of the NRF are assumed for the NF.""" ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.plmnList ],
        [ sh:class smf3gpp:sNssais ;
            sh:description """S-NSSAIs of the Network Function. If not
provided, the NF can serve any S-NSSAI. When present
this IE represents the list of S-NSSAIs supported in
all the PLMNs listed in the plmnList IE.""" ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.sNssais ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Time in seconds expected between 2 consecutive
heart-beat messages from an NF Instance to the NRF.
It may be included in the registration request.
When present in the request it shall contain the
heartbeat time proposed by the NF service consumer.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.heartBeatTimer ],
        [ sh:class smf3gpp:allowedPlmns ;
            sh:description """PLMNs allowed to access the NF instance.
If not provided, any PLMN is allowed to access the NF.""" ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.allowedPlmns ],
        [ sh:class mnfp3gpp:SPNInfoId ;
            sh:description """SNPN(s) of the Network Function. This attributeIE shall be
present if the NF pertains to one or more SNPNs.""" ;
            sh:path mnfp3gpp:ManagedNFProfile.sNPNList ],
        [ sh:class smf3gpp:perPlmnSnssaiList ;
            sh:description """It includes the S-NSSAIs supported by the Network Function
for each PLMN supported by the Network Function. When present, it shall
override sNssais IE.If the perPlmnSnssaiList attribute is provided in
at least one NF Service, the S-NSSAIs supported per PLMN in the
NF Profile shall be the set or a superset of the perPlmnSnssaiList
of the NFService(s).""" ;
            sh:path mnfp3gpp:ManagedNFProfile.perPlmnSnssaiList ],
        [ sh:class nfs3gpp:SNPNId ;
            sh:description """SNPNs allowed to access the NF instance.
The absence of this attribute in the NF profile indicates that no SNPN,
other than the SNPN(s) registered in the snpnList attribute of the
NF Profile, is allowed to access the service instance""" ;
            sh:path mnfp3gpp:ManagedNFProfile.allowedSNPNs ],
        [ sh:class smf3gpp:allowedNSSAIs ;
            sh:description """S-NSSAI of the allowed slices to access the NF instance.
If not provided, any slice is allowed to access the NF.""" ;
            sh:path mnfp3gpp:ManagedNFProfile.allowedNSSAIs ],
        [ sh:class types5g3gpp:RuleSet ;
            sh:description """It represents map of rules specifying NF-Consumers
allowed or denied to access the NF-Producer. It may be present
when the NF-Producer and the NRF support Allowed-ruleset feature
as specified in clause 6.1.9.""" ;
            sh:path mnfp3gpp:ManagedNFProfile.allowedRuleSet ],
        [ sh:class smf3gpp:defaultNotificationSubscriptions ;
            sh:description """Notification endpoints for different notification types.
This attribute may contain multiple default subscriptions for a same
notification type; in that case, those default subscriptions are used
as alternative notification endpoints.""" ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.defaultNotificationSubscriptions ],
        [ sh:class nfs3gpp:NFService ;
            sh:description """List of NF Service Instances. It shall include
the services produced by the NF that can be discovered by
other NFs.""" ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.nfServiceList ],
        [ sh:class smf3gpp:supportedVendorSpecificFeatures ;
            sh:description """It indicates a map of Vendor-Specific features, where the
key of the map is the IANA-assigned SMI Network Management Private
Enterprise Codes and the value of each entry of the map shall be
a list (array) of VendorSpecificFeature objects as defined
in the clause 5.3.247.""" ;
            sh:path mnfp3gpp:ManagedNFProfile.supportedVendorSpecificFeatures ],
        [ sh:class nfs3gpp:SelectionConditions ;
            sh:description """This attribute includes the conditions under which an NF
Instance with an NFStatus value set to CANARY_RELEASE, or with a
canaryRelease attribute set to true, shall be selected by an NF
Service Consumer.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.selectionConditions ],
        [ sh:datatype xsd:string ;
            sh:description """FQDN of the Network Function. For AMF, the
FQDN registered with the NRF shall be that of the AMF Name.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.fqdn ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description "Host address of a NF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.hostAddr ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines NF Specific Service authorization
information. It shall include the NF type (s) and NF realms/origins
allowed to consume NF Service(s) of NF Service Producer """ ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.authzInfo ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """Priority (relative weight) of the NF instance, in the
range of 0-65535, compared to other NF instances of the same type,
to be used for NF selection; if capacity is also present in the
nfServiceList parameters, those will have precedence over this value.""" ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.priority ],
        [ sh:description """Type of the NFs allowed to access the NF instance.
If not provided, any NF type is allowed to access the NF.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" "NWDAF" "PCSCF" "CBCF" "HSS" "UCMF" "SOR_AF" "SPAF" "MME" "SCSAS" "SCEF" "SCP" "NSSAAF" "ICSCF" "SCSCF" "DRA" "IMS_AS" "AANF" "5G_DDNMF" "NSACF" "MFAF" "EASDF" "DCCF" "MB_SMF" "TSCTSF" "ADRF" "GBA_BSF" "CEF" "MB_UPF" "NSWOF" "PKMF" "MNPF" "SMS_GMSC" "SMS_IWMSC" "MBSF" "MBSTF" "PANF" "TNGF" "W_AGF" "TWIF" "TSN_AF" ) ;
            sh:minCount 1 ;
            sh:path mnfp3gpp:ManagedNFProfile.allowedNfTypes ] ;
    sh:targetClass mnfp3gpp:ManagedNFProfile .

mnfp3gpp-shapes:SPNInfoId a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Mobile Country Code (MCC) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:SPNInfoId.mcc ],
        [ sh:datatype xsd:string ;
            sh:description "Mobile Network Code (MNC) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:SPNInfoId.mnc ],
        [ sh:datatype xsd:string ;
            sh:description "Network Identifier (NID) of the SNPN." ;
            sh:maxCount 1 ;
            sh:path mnfp3gpp:SPNInfoId.nId ] ;
    sh:targetClass mnfp3gpp:SPNInfoId .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-managed-nfprofile> a owl:Ontology ;
