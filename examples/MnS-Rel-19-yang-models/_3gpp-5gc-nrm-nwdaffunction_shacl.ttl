@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix meas3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-measurements#> .
@prefix mf3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-managed-function#> .
@prefix mnfp3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-managed-nfprofile#> .
@prefix nwdaf3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-nwdaffunction#> .
@prefix nwdaf3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-5gc-nrm-nwdaffunction#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix stm3gpp: <https://semantics.ericsson.com/yang/_3gpp-stm-nrm-stmfunction#> .
@prefix trace3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-trace#> .
@prefix types3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-yang-types#> .
@prefix types5g3gpp: <https://semantics.ericsson.com/yang/_3gpp-5g-common-yang-types#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

nwdaf3gpp-shapes:File a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:File.id ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:File.fileLocation ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:File.jobId ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:File.fileContent ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:File.fileCompression ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:File.fileSize ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:File.fileDataType ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:File.fileFormat ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:File.fileReadyTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:File.fileExpirationTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path nwdaf3gpp:File.jobRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass nwdaf3gpp:File .

nwdaf3gpp-shapes:Files a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:Files.id ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:Files.numberOfFiles ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path nwdaf3gpp:Files.jobRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:Files.jobId ] ;
    sh:targetClass nwdaf3gpp:Files .

nwdaf3gpp-shapes:ManagedNFService a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:ManagedNFService.id ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:ManagedNFService.userLabel ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:ManagedNFService.nFServiceType ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:ManagedNFService.administrativeState ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:ManagedNFService.operationalState ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:ManagedNFService.usageState ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:ManagedNFService.registrationState ],
        [ sh:class types3gpp:SAP ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:ManagedNFService.sAP ],
        [ sh:class mf3gpp:Operation ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:ManagedNFService.operations ] ;
    sh:targetClass nwdaf3gpp:ManagedNFService .

nwdaf3gpp-shapes:MlAnalyticsInfo a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This attribute represents the Analytic functionalities
(identified by nwdafEvent defined in TS 29.520 [85]) of the NWDAF
instance. MnS consumer can configure this attribute to specify
which Analytic functionalities (identified by nwdafEvent) can be
performed the NWDAF instance. If the value of this attribute is not
present, the NWDAF instance can perform any NWDAFEvents

Analytics Id(s) supported by the Nnwdaf_MLModelProvision service,
if none are provided the NWDAF can serve any mlAnalyticsId.""" ;
            sh:path nwdaf3gpp:MlAnalyticsInfo.mlAnalyticsIds ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute defines the list of NWDAF vendors that are
allowed to retrieve ML models from the NWDAF containing MTLF. The
absence of this attribute indicates that none of the NWDAF vendors
can retrieve the ML models.

allowedValues: 6 decimal digits; if the SMI code has less than
6 digits, it shall be padded with leading digits '0' to complete a
6-digit string value.""" ;
            sh:path nwdaf3gpp:MlAnalyticsInfo.mlModelInterInfo ;
            sh:pattern "[0-9]{6}" ],
        [ sh:description """This attribute defines the federated learning capability
type supported by NWDAF containing MTLF.""" ;
            sh:in ( "FL_SERVER" "FL_CLIENT" "FL_SERVER_AND_CLIENT" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:MlAnalyticsInfo.flCapabilityType ],
        [ sh:class nwdaf3gpp:sNSSAIList ;
            sh:description """List of S-NSSAIs the managed object is capable of
supporting.""" ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:MlAnalyticsInfo.sNSSAIList ],
        [ sh:class types3gpp:Tai ;
            sh:description """This attribute represents area of Interest of the ML model,
if none are provided the ML model for the analytics can apply to any
TAIs.

If present, it represents the list of TAIs, it may contain one or
more non-3GPP access TAIs.""" ;
            sh:path nwdaf3gpp:MlAnalyticsInfo.trackingAreaList ],
        [ sh:class types3gpp:TimeWindow ;
            sh:description """This attribute defines the time window at which the
indicated flCapabilityType supported by NWDAF MTLF is available.
This attribute shall be present only if flCapabilityType attribute
is present.""" ;
            sh:path nwdaf3gpp:MlAnalyticsInfo.flTimeInterval ] ;
    sh:targetClass nwdaf3gpp:MlAnalyticsInfo .

nwdaf3gpp-shapes:NWDAFFunction a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.id ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.userLabel ],
        [ sh:class mf3gpp:PeeParameters ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path nwdaf3gpp:NWDAFFunction.peeParameterslist ],
        [ sh:class nwdaf3gpp:SupportedPerfMetricGroups ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path nwdaf3gpp:NWDAFFunction.SupportedPerfMetricGroups ],
        [ sh:class nwdaf3gpp:pLMNInfoList ;
            sh:description "It defines the PLMN(s) of a Network Function." ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.pLMNInfoList ],
        [ sh:class mnfp3gpp:ManagedNFProfile ;
            sh:description "Profile definition of a Managed NF (See TS 23.501)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.managedNFProfile ],
        [ sh:class nwdaf3gpp:commModelList ;
            sh:description """Specifies a list of commModel. It can be used by NF and
NF services to interact with each other in 5G Core network """ ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.commModelList ],
        [ sh:class nwdaf3gpp:NetworkSliceInfo ;
            sh:description """The attribute specifies a list of NetworkSliceInfo which
is defined as a datatype (see clause 5.3.95). It is used by an
authorized consumer, e.g. NWDAF, to facilitate the data collection
from OAM.""" ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.networkSliceInfoList ],
        [ sh:class nwdaf3gpp:NwdafInfo ;
            sh:description "It represents specific data for the NWDAF." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.nwdafInfo ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.priorityLabel ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path nwdaf3gpp:NWDAFFunction.supportedTraceMetrics ],
        [ sh:datatype xsd:string ;
            sh:description """The FQDN of the registered NF instance in the service-based
interface.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.sBIFQDN ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:description """This attribute determines whether the NWDAF is enabled or
disabled. MnS consumer can configure this attribute to activate or
de-activate the analytic functionalities (identified by nwdafEvent
defined in TS 29.520) of the NWDAF instance.""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.administrativeState ],
        [ sh:description """It represents the logical functions supported by the NWDAF.
If not present, the NWDAF shall be regarded with no logical
decomposition, in that case the NWDAF only supports the analytics
services.""" ;
            sh:in ( "NWDAF_WITH_ANLF" "NWDAF_WITH_MTLF" "NWDAF_WITH_ANLF_MTLF" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.nwdafLogicalFuncSupported ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the NWDAF supports
Nnwdaf_RoamingAnalytics service""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.roamingAnalytics ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the NWDAF supports
Nnwdaf_RoamingData service""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NWDAFFunction.roamingData ],
        [ sh:class mf3gpp:VnfParameters ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path nwdaf3gpp:NWDAFFunction.vnfParametersList ] ;
    sh:targetClass nwdaf3gpp:NWDAFFunction .

nwdaf3gpp-shapes:NetworkSliceInfo a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It represents NSI ID which is an identifier for identifying
the Core Network part of a Network Slice instance when multiple
Network Slice instances of the same Network Slice are deployed,
and there is a need to differentiate between them in the 5GC.
See NSI ID definition in clause 3.1 of TS 23.501 and
subclause 6.1.6.2.7 of TS 29.531.""" ;
            sh:path nwdaf3gpp:NetworkSliceInfo.cNSIId ],
        [ sh:description """This holds a DN of the NetworkSlice managed object relating
to the NetworkSlice instance differentiated by sNSSAI and optional
cNSIId.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NetworkSliceInfo.networkSliceRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class nwdaf3gpp:sNSSAI ;
            sh:description """It represents the S-NSSAI the NetworkSlice managed object
is supporting. The S-NSSAI is defined in TS 23.003 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NetworkSliceInfo.sNSSAI ] ;
    sh:targetClass nwdaf3gpp:NetworkSliceInfo .

nwdaf3gpp-shapes:NwdafCapability a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the NWDAF supports analytics
aggregation""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NwdafCapability.analyticsAggregation ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicate whether the NWDAF supports analytics metadata
provisioning:""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NwdafCapability.analyticsMetadataProvisioning ],
        [ sh:datatype xsd:boolean ;
            sh:description """It indicates whether the NWDAF
supports roaming exchange capability""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NwdafCapability.roamingExchange ] ;
    sh:targetClass nwdaf3gpp:NwdafCapability .

nwdaf3gpp-shapes:NwdafInfo a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This attribute represents the Analytic functionalities
(identified by nwdafEvent defined in TS 29.520) of the NWDAF instance.
MnS consumer can configure this attribute to specify which Analytic
functionalities (identified by nwdafEvent) can be performed the NWDAF
instance. If the value of this attribute is not present, the NWDAF
instance can perform any NWDAFEvents.
The detailed ENUM value for NwdafEvent see the Table 5.1.6.3.4-1
in TS 29.520""" ;
            sh:path nwdaf3gpp:NwdafInfo.nwdafEvents ],
        [ sh:datatype xsd:string ;
            sh:description """It represents the EventId(s) supported by the
Nnwdaf_AnalyticsInfo service, if none are provided the NWDAF can serve
any eventId. (see clause TS 29.520)""" ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NwdafInfo.eventIds ],
        [ sh:datatype xsd:int ;
            sh:description """It represents the supported Analytics Delay related to the
eventIds and nwdafEvents.
It is an unsigned integer identifying a period of time in units of
seconds.(see clause 5.2.2 TS 29.571).""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NwdafInfo.analyticsDelay ],
        [ sh:description """It contains the list of NF type(s) from which the NWDAF NF
can collect data. The absence of this attribute indicates that the
NWDAF can collect data from any NF type.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" "NWDAF" "PCSCF" "CBCF" "HSS" "UCMF" "SOR_AF" "SPAF" "MME" "SCSAS" "SCEF" "SCP" "NSSAAF" "ICSCF" "SCSCF" "DRA" "IMS_AS" "AANF" "5G_DDNMF" "NSACF" "MFAF" "EASDF" "DCCF" "MB_SMF" "TSCTSF" "ADRF" "GBA_BSF" "CEF" "MB_UPF" "NSWOF" "PKMF" "MNPF" "SMS_GMSC" "SMS_IWMSC" "MBSF" "MBSTF" "PANF" "TNGF" "W_AGF" "TWIF" "TSN_AF" ) ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NwdafInfo.servingNfTypeList ],
        [ sh:datatype xsd:string ;
            sh:description """It contains the list of NF type(s) from which the NWDAF NF
can collect data. The absence of this attribute indicates that the
NWDAF can collect data from any NF type. (see clause 5.4.2 NfSetId
in TS 29.571)""" ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NwdafInfo.servingNfSetIdList ],
        [ sh:class types3gpp:Tai ;
            sh:description "The list of TAIs. " ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NwdafInfo.taiList ],
        [ sh:class types5g3gpp:TaiRange ;
            sh:description "The range of TAIs." ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NwdafInfo.taiRangeList ],
        [ sh:class nwdaf3gpp:NwdafCapability ;
            sh:description """This attribute indicates the capability of the NWDAF.
If not present, the NWDAF shall be regarded with no capability.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:NwdafInfo.nwdafCapability ],
        [ sh:class nwdaf3gpp:MlAnalyticsInfo ;
            sh:description """It represents ML Analytics Filter information supported by
the Nnwdaf_MLModelProvision service.""" ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:NwdafInfo.mlAnalyticsList ] ;
    sh:targetClass nwdaf3gpp:NwdafInfo .

nwdaf3gpp-shapes:PerfMetricJob a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.id ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.administrativeState ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.notificationRecipientAddress ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.streamTarget ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob._linkToFiles ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.schedulerRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.conditionMonitorRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.operationalState ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.jobId ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.performanceMetrics ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.granularityPeriod ],
        [ sh:path nwdaf3gpp:PerfMetricJob.objectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path nwdaf3gpp:PerfMetricJob.rootObjectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.fileReportingPeriod ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:PerfMetricJob.fileLocation ] ;
    sh:targetClass nwdaf3gpp:PerfMetricJob .

nwdaf3gpp-shapes:StmCtrl a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:StmCtrl.id ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path nwdaf3gpp:StmCtrl.reportingNFList ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:StmCtrl.stmTargetUri ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:StmCtrl.administrativeState ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:StmCtrl.operationalState ],
        [ sh:class stm3gpp:NetworkInterface ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path nwdaf3gpp:StmCtrl.targetInterfaceInfoList ] ;
    sh:targetClass nwdaf3gpp:StmCtrl .

nwdaf3gpp-shapes:SupportedPerfMetricGroups a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:SupportedPerfMetricGroups.performanceMetrics ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path nwdaf3gpp:SupportedPerfMetricGroups.granularityPeriods ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:SupportedPerfMetricGroups.reportingMethods ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path nwdaf3gpp:SupportedPerfMetricGroups.reportingPeriods ] ;
    sh:targetClass nwdaf3gpp:SupportedPerfMetricGroups .

nwdaf3gpp-shapes:ThresholdMonitor a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:ThresholdMonitor.id ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:ThresholdMonitor.administrativeState ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:ThresholdMonitor.operationalState ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:ThresholdMonitor.monitorGranularityPeriod ],
        [ sh:path nwdaf3gpp:ThresholdMonitor.objectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path nwdaf3gpp:ThresholdMonitor.rootObjectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class meas3gpp:ThresholdInfo ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:ThresholdMonitor.thresholdInfoList ] ;
    sh:targetClass nwdaf3gpp:ThresholdMonitor .

nwdaf3gpp-shapes:TraceJob a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.id ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.jobType ],
        [ sh:class nwdaf3gpp:traceTarget ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.traceTarget ],
        [ sh:class trace3gpp:TraceConfig ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.traceConfig ],
        [ sh:class trace3gpp:MdtConfig ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed. For NTN MDT, if the list of plmnList is included, it will
only log measurements for the cells belonging to the listed PLMNs.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.mdtConfig ],
        [ sh:class trace3gpp:UECoreMeasConfig ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.ueCoreMeasConfig ],
        [ sh:class types3gpp:NpnId ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.nPNTarget ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path nwdaf3gpp:TraceJob.rrcReportType ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path nwdaf3gpp:TraceJob.listOfTraceMetrics ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.traceCollectionEntityIPAddress ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.traceReportingConsumerUri ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.jobId ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:TraceJob.traceReportingFormat ],
        [ sh:class nwdaf3gpp:pLMNTarget ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path nwdaf3gpp:TraceJob.pLMNTarget ],
        [ sh:class trace3gpp:TraceReference ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:TraceJob.traceReference ] ;
    sh:targetClass nwdaf3gpp:TraceJob .

nwdaf3gpp-shapes:commModelList a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedShort ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:commModelList.groupId ],
        [ sh:in ( "DIRECT_COMMUNICATION_WO_NRF" "DIRECT_COMMUNICATION_WITH_NRF" "INDIRECT_COMMUNICATION_WO_DEDICATED_DISCOVERY" "INDIRECT_COMMUNICATION_WITH_DEDICATED_DISCOVERY" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:commModelList.commModelType ],
        [ sh:path nwdaf3gpp:commModelList.targetNFServiceList ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:commModelList.commModelConfiguration ] ;
    sh:targetClass nwdaf3gpp:commModelList .

nwdaf3gpp-shapes:pLMNInfoList a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:pLMNInfoList.mcc ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:pLMNInfoList.mnc ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:pLMNInfoList.sd ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:pLMNInfoList.sst ] ;
    sh:targetClass nwdaf3gpp:pLMNInfoList .

nwdaf3gpp-shapes:pLMNTarget a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:pLMNTarget.mcc ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nwdaf3gpp:pLMNTarget.mnc ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass nwdaf3gpp:pLMNTarget .

nwdaf3gpp-shapes:sNSSAI a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:sNSSAI.sd ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:sNSSAI.sst ] ;
    sh:targetClass nwdaf3gpp:sNSSAI .

nwdaf3gpp-shapes:sNSSAIList a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:sNSSAIList.sd ;
            sh:pattern "([0-9a-fA-F]{2}(:[0-9a-fA-F]{2})*)?" ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:sNSSAIList.sst ] ;
    sh:targetClass nwdaf3gpp:sNSSAIList .

nwdaf3gpp-shapes:traceTarget a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path nwdaf3gpp:traceTarget.traceTargetType ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path nwdaf3gpp:traceTarget.traceTargetValueList ] ;
    sh:targetClass nwdaf3gpp:traceTarget .

