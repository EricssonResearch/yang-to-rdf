@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix util3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-util#> .
@prefix util3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-common-util#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

util3gpp-shapes:ConditionMonitor a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path util3gpp:ConditionMonitor.id ],
        [ sh:datatype xsd:string ;
            sh:description """A logical condition containing an XPath expression.
The leaf contains an XPath 1.0 string with the following restrictions
- The accessible tree is the full Network Resource Model
- The root node is the list representing the top level MOI
(E.g. ManagedElement)
- In the accessible tree, all leafs and leaf-lists with default values
in use exist
- The data tree has no concept of document order except when 'ordered-by
user' is declared.
- The set of variable bindings is empty.
- The function library is the core function library defined in XPATH
- Namespaces should be ignored when evaluating the expression

An empty string is not allowed.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path util3gpp:ConditionMonitor.condition ],
        [ sh:datatype xsd:boolean ;
            sh:description """The boolean result of the condition.
Switches between TRUE and FALSE depending upon whether the
configured constraints are fulfilled or not.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path util3gpp:ConditionMonitor.conditionStatus ] ;
    sh:targetClass util3gpp:ConditionMonitor .

util3gpp-shapes:Scheduler a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path util3gpp:Scheduler.id ],
        [ sh:datatype xsd:boolean ;
            sh:description """Switches between TRUE and FALSE depending upon whether the
configured time constraints are fulfilled or not.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path util3gpp:Scheduler.schedulerStatus ],
        [ sh:class util3gpp:SchedulingTime ;
            sh:description "It defines the active scheduling times." ;
            sh:minCount 1 ;
            sh:path util3gpp:Scheduler.schedulingTimes ] ;
    sh:targetClass util3gpp:Scheduler .

util3gpp-shapes:SchedulingTime a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path util3gpp:SchedulingTime.startTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path util3gpp:SchedulingTime.endTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Shall be present in case of Weekly periodicity,
otherwise not""" ;
            sh:in ( "MONDAY" "TUESDAY" "WEDNESDAY" "THURSDAY" "FRIDAY" "SATURDAY" "SUNDAY" ) ;
            sh:maxCount 1 ;
            sh:path util3gpp:SchedulingTime.daysOfWeek ],
        [ sh:datatype xsd:unsignedByte ;
            sh:description """Shall be present in case of Monthly periodicity,
otherwise not""" ;
            sh:maxCount 1 ;
            sh:path util3gpp:SchedulingTime.daysOfMonth ],
        [ sh:class util3gpp:TimeInterval ;
            sh:description """List of intervals within one day for which the service
shall be active.""" ;
            sh:minCount 1 ;
            sh:path util3gpp:SchedulingTime.timeIntervals ] ;
    sh:targetClass util3gpp:SchedulingTime .

util3gpp-shapes:TimeInterval a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It indicates the time (in 'full-time' format) when the
service shall be started.
Data type 'FullTime' defines the time as specified by 'full-time'
in RFC3339.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path util3gpp:TimeInterval.intervalStart ;
            sh:pattern "(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the time (in 'full-time' format) when the
service shall be stopped.
'FullTime' defines the time as specified by 'full-time' in RFC3339.
intervalEnd should use the same timezone as intervalStart and shall
be later then intervalStart""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path util3gpp:TimeInterval.intervalEnd ;
            sh:pattern "(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ] ;
    sh:targetClass util3gpp:TimeInterval .

<https://semantics.ericsson.com/yang/_3gpp-common-util> a owl:Ontology ;
    rdfs:label "_3gpp-common-util" ;
    dcterms:description """Defines Utility IOCs: ConditionMonitor, Scheduler
Copyright 2024, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.623" ;
    dcterms:title "_3gpp-common-util" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2024-08-13 (CR-0387)" ;
    y2r:yangModuleName "_3gpp-common-util" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-common-util> .

