@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scp3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-scpfunction#> .
@prefix util3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-util#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-scpfunction> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-scpfunction" ;
    dcterms:description """This IOC represents the SCP function in 5GC. For more
information about the SCP, see 3GPP TS 23.501.
Copyright 2023, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5gc-nrm-scpfunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2023-09-18 (CR-1043)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-scpfunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-scpfunction> .

scp3gpp:File.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

scp3gpp:Files.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

scp3gpp:PerfMetricJob.conditionMonitorRef rdfs:range util3gpp:ConditionMonitor ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

scp3gpp:PerfMetricJob.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

scp3gpp:PerfMetricJob.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

scp3gpp:PerfMetricJob.schedulerRef rdfs:range util3gpp:Scheduler ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

scp3gpp:StmCtrl.reportingNFList y2r:candidate "ReportingNF" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

scp3gpp:ThresholdMonitor.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

scp3gpp:ThresholdMonitor.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

