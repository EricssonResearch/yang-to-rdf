cco3gpp-shapes:CCOFunction a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path cco3gpp:CCOFunction.id ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute determines whether the centralized
SON CCO Function is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cco3gpp:CCOFunction.cCOControl ] ;
    sh:targetClass cco3gpp:CCOFunction .

cco3gpp-shapes:CCOOvershootCoverageParameters a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path cco3gpp:CCOOvershootCoverageParameters.id ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It indicates the coverage shape of specific sites which
can be selected to optimize radio coverage.""" ;
            sh:path cco3gpp:CCOOvershootCoverageParameters.coverageShapeList ],
        [ sh:class cco3gpp:ParameterRange ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of downlinkTransmitPower to optimize radio coverage.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cco3gpp:CCOOvershootCoverageParameters.downlinkTransmitPowerRange ],
        [ sh:class cco3gpp:ParameterRange ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of antennaTilt to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cco3gpp:CCOOvershootCoverageParameters.antennaTiltRange ],
        [ sh:class cco3gpp:ParameterRange ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of antennaAzimuth to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cco3gpp:CCOOvershootCoverageParameters.antennaAzimuthRange ],
        [ sh:class cco3gpp:ParameterRange ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of digitalTilt to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cco3gpp:CCOOvershootCoverageParameters.digitalTiltRange ],
        [ sh:class cco3gpp:ParameterRange ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of digitalAzimuth to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path cco3gpp:CCOOvershootCoverageParameters.digitalAzimuthRange ] ;
    sh:targetClass cco3gpp:CCOOvershootCoverageParameters .

