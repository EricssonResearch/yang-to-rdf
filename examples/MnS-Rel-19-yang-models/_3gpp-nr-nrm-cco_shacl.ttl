@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-cco> a owl:Ontology .

<urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOFunctionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOFunction/id> ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute determines whether the centralized
SON CCO Function is enabled or disabled.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOFunction/cCOControl> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParametersShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters/id> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """It indicates the coverage shape of specific sites which
can be selected to optimize radio coverage.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters/coverageShapeList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/ParameterRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of downlinkTransmitPower to optimize radio coverage.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters/downlinkTransmitPowerRange> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/ParameterRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of antennaTilt to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters/antennaTiltRange> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/ParameterRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of antennaAzimuth to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters/antennaAzimuthRange> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/ParameterRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of digitalTilt to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters/digitalTiltRange> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-nr-nrm-cco/ParameterRange> ;
            sh:description """It indicates adjustment range (including maximum value,
minimum value) of digitalAzimuth to optimize radio coverage.
units 0.1 degree""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters/digitalAzimuthRange> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-nr-nrm-cco/CCOOvershootCoverageParameters> .

