@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix meas3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-measurements#> .
@prefix mf3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-managed-function#> .
@prefix mnfp3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-managed-nfprofile#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix stm3gpp: <https://semantics.ericsson.com/yang/_3gpp-stm-nrm-stmfunction#> .
@prefix trace3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-trace#> .
@prefix types3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-yang-types#> .
@prefix types5g3gpp: <https://semantics.ericsson.com/yang/_3gpp-5g-common-yang-types#> .
@prefix upf3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-upffunction#> .
@prefix upf3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-5gc-nrm-upffunction#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

upf3gpp-shapes:AtsssCapability a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """Indicates the ATSSS-LL capability to support procedures
related to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:AtsssCapability.atsssLL ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates the MPTCP capability to support procedures related
to Access Traffic Steering, Switching, Splitting
(see clauses 4.2.10, 5.32 of TS 23.501).
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:AtsssCapability.mptcp ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF supports RTT measurement without
PMF (see clauses 5.32.2, 6.3.3.3 of TS 23.501).
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:AtsssCapability.rttWithoutPmf ] ;
    sh:targetClass upf3gpp:AtsssCapability .

upf3gpp-shapes:DnnUpfInfoItem a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "String representing a Data Network." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:DnnUpfInfoItem.dnn ],
        [ sh:datatype xsd:string ;
            sh:description """List of Data network access identifiers supported
by the UPF for this DNN.
The absence of this attribute indicates that the UPF
can be selected for this DNN for any DNAI.""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:DnnUpfInfoItem.dnaiList ],
        [ sh:class upf3gpp:natedIpv6PrefixRanges ;
            sh:description """This attribute represents a list of ranges of NATed IPv6
prefixes.""" ;
            sh:path upf3gpp:DnnUpfInfoItem.natedIpv6PrefixRanges ],
        [ sh:description """List of PDU session type(s) supported by
the UPF for a specific DNN.""" ;
            sh:in ( "IPV4" "IPV6" "IPV4V6" "UNSTRUCTURED" "ETHERNET" ) ;
            sh:minCount 1 ;
            sh:path upf3gpp:DnnUpfInfoItem.pduSessionTypes ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a list of Ipv4 Index supported by
the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
            sh:path upf3gpp:DnnUpfInfoItem.ipv4IndexList ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a list of Ipv6 Index supported
by the UPF.
This <<choice>> represents the IP Index to be sent from UDM to the SMF.
(See clause 6.1.6.2.77 TS 29.503)
It is a list of non-exclusive alternatives (Integer or String).""" ;
            sh:path upf3gpp:DnnUpfInfoItem.ipv6IndexList ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents the N6 Network Instance
(See TS 29.244) associated with the S-NSSAI and DNN.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:DnnUpfInfoItem.networkInstance ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute represents a map of a network instance per
DNAI for the DNN, where the key of the map is the DNAI (Data network
access identifier), see TS 23.501.

When present, the value of each entry of the map shall contain a N6
network instance that is configured for the DNAI indicated by the key.""" ;
            sh:path upf3gpp:DnnUpfInfoItem.dnaiNwInstanceList ],
        [ sh:class upf3gpp:ipv4AddressRanges ;
            sh:description """This attribute represents a list of ranges of IPv4 addresses
handled by UPF. """ ;
            sh:path upf3gpp:DnnUpfInfoItem.ipv4AddressRanges ],
        [ sh:class upf3gpp:ipv6PrefixRanges ;
            sh:description """This attribute represents a list of ranges of IPv6 prefixes
handled by the UPF. """ ;
            sh:path upf3gpp:DnnUpfInfoItem.ipv6PrefixRanges ],
        [ sh:class upf3gpp:natedIpv4AddressRanges ;
            sh:description """This attribute represents a list of ranges of NATed IPv4
addresses.""" ;
            sh:path upf3gpp:DnnUpfInfoItem.natedIpv4AddressRanges ] ;
    sh:targetClass upf3gpp:DnnUpfInfoItem .

upf3gpp-shapes:File a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:File.id ],
        [ sh:datatype xsd:string ;
            sh:description """Location of the file incl. the file transfer protocol,
and the file name.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:File.fileLocation ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:File.jobId ],
        [ sh:datatype xsd:base64Binary ;
            sh:description """File content as a Base64 encoded string according to
RFC 4648 section 4.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:File.fileContent ],
        [ sh:datatype xsd:string ;
            sh:description """Name of the algorithm used for compressing the file.
An absent 'fileCompression' parameter indicates the file is
not compressed. The MnS producer selects the compression algorithm.
It is encouraged to use popular algorithms such as GZIP.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:File.fileCompression ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Size of the file" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:File.fileSize ],
        [ sh:description "Type of the management data stored in the file." ;
            sh:in ( "PERFORMANCE" "TRACE" "ANALYTICS" "PROPRIETARY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:File.fileDataType ],
        [ sh:datatype xsd:string ;
            sh:description """Identifier of the schema (incl. its version)
used to produce the file content. If there is no schema for the file
or it is not available, the fileFormat parameter is absent.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:File.fileFormat ],
        [ sh:datatype xsd:string ;
            sh:description """Date and time, when the file was closed (the last time)
and made available on the MnS producer.
The file content will not be changed anymore.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:File.fileReadyTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:datatype xsd:string ;
            sh:description "Date and time after which the file may be deleted." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:File.fileExpirationTime ;
            sh:pattern "[0-9]{4}-(1[0-2]|0[1-9])-(0[1-9]|[1-2][0-9]|3[0-1])T(0[0-9]|1[0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[\\+\\-]((1[0-3]|0[0-9]):([0-5][0-9])|14:00))?" ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path upf3gpp:File.jobRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ] ;
    sh:targetClass upf3gpp:File .

upf3gpp-shapes:Files a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:Files.id ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description "Number of files in a file collection." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:Files.numberOfFiles ],
        [ sh:description """Object instance of the 'PerfMetricJob' or 'TraceJob'
that produced the file.""" ;
            sh:path upf3gpp:Files.jobRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a PerfMetricJob job or a TraceJob." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:Files.jobId ] ;
    sh:targetClass upf3gpp:Files .

upf3gpp-shapes:InterfaceUpfInfoItem a sh:NodeShape ;
    sh:property [ sh:description """User Plane interface type.
See TS 29.510[23] clause 6.1.6.3.9""" ;
            sh:in ( "N3" "N6" "N9" "DATA_FORWARDING" "N6MB" "N19MB" "N3MB" "NMB9" "S1U" "S5U" "S8U" "S11U" "S12" "S2AU" "S2BU" "N3TRUSTEDN3GPP" "N3UNTRUSTEDN3GPP" "N9ROAMING" "SGI" "N19" "SXAU" "SXBU" "N4U" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:InterfaceUpfInfoItem.interfaceType ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path upf3gpp:InterfaceUpfInfoItem.ipv4EndpointAddresses ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path upf3gpp:InterfaceUpfInfoItem.ipv6EndpointAddresses ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:InterfaceUpfInfoItem.fqdn ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ],
        [ sh:datatype xsd:string ;
            sh:description """Network Instance (See TS 29.244) associated to the User
Plane interface""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:InterfaceUpfInfoItem.networkInstance ] ;
    sh:targetClass upf3gpp:InterfaceUpfInfoItem .

upf3gpp-shapes:ManagedNFService a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ManagedNFService.id ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ManagedNFService.userLabel ],
        [ sh:datatype xsd:string ;
            sh:description """The type of the managed NF service instance
The specifc values allowed are described in clause 7.2 of TS 23.501""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:ManagedNFService.nFServiceType ],
        [ sh:description "Permission to use or prohibition against using the instance" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ManagedNFService.administrativeState ],
        [ sh:description "Describes whether the resource is installed and working" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:ManagedNFService.operationalState ],
        [ sh:description """Describes whether the resource is actively in use at a
specific instant, and if so, whether or not it has spare
capacity for additional users.""" ;
            sh:in ( "IDLE" "ACTIVE" "BUSY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:ManagedNFService.usageState ],
        [ sh:in ( "REGISTERED" "DEREGISTERED" ) ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ManagedNFService.registrationState ],
        [ sh:class types3gpp:SAP ;
            sh:description "The service access point of the managed NF service instance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:ManagedNFService.sAP ],
        [ sh:class mf3gpp:Operation ;
            sh:description """Set of operations supported by the managed NF
service instance""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:ManagedNFService.operations ] ;
    sh:targetClass upf3gpp:ManagedNFService .

upf3gpp-shapes:PerfMetricJob a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:PerfMetricJob.id ],
        [ sh:description "Enable or disables production of the metrics" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path upf3gpp:PerfMetricJob.administrativeState ],
        [ sh:datatype xsd:string ;
            sh:description """Must be present when the notification-based reporting
method is supported, and the the files are available as
notifications for the MnS consumer to subscribe to.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:PerfMetricJob.notificationRecipientAddress ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable when stream-based reporting method is
supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:PerfMetricJob.streamTarget ],
        [ sh:datatype xsd:string ;
            sh:description "Link to a 'Files' object." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:PerfMetricJob._linkToFiles ],
        [ sh:description "Pointer to a Scheduler object." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:PerfMetricJob.schedulerRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Pointer to a ConditionMonitor object." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:PerfMetricJob.conditionMonitorRef ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description "Indicates whether the PerfMetricJob is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:PerfMetricJob.operationalState ],
        [ sh:datatype xsd:string ;
            sh:description "Id for a PerfMetricJob job." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:PerfMetricJob.jobId ],
        [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554. Performance metrics can
also be those specified by other SDOs or vendor specific metrics.
Performance metrics are identfied with their names. A name can also
identify a vendor specific group of performance metrics.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:PerfMetricJob.performanceMetrics ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity period used to produce measurements. The value
must be one of the supported granularity periods for the metric.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:PerfMetricJob.granularityPeriod ],
        [ sh:path upf3gpp:PerfMetricJob.objectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path upf3gpp:PerfMetricJob.rootObjectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:PerfMetricJob.fileReportingPeriod ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:PerfMetricJob.fileLocation ] ;
    sh:targetClass upf3gpp:PerfMetricJob .

upf3gpp-shapes:SnssaiUpfInfoItem a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether the UPF supports redundant
transport path on the transport layer in the corresponding network
slice.
true: supported
false: not supported""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:SnssaiUpfInfoItem.redundantTransport ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Identifier of the DNN UPF Info List." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:SnssaiUpfInfoItem.dnnUpfInfoListId ],
        [ sh:class types5g3gpp:ExtSnssai ;
            sh:description "Supported S-NSSAI." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:SnssaiUpfInfoItem.sNssai ],
        [ sh:class upf3gpp:DnnUpfInfoItem ;
            sh:description """It represents list of parameters supported by the UPF
per DNN.""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:SnssaiUpfInfoItem.dnnUpfInfoList ] ;
    sh:targetClass upf3gpp:SnssaiUpfInfoItem .

upf3gpp-shapes:StmCtrl a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:StmCtrl.id ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path upf3gpp:StmCtrl.reportingNFList ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:StmCtrl.stmTargetUri ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path upf3gpp:StmCtrl.administrativeState ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:StmCtrl.operationalState ],
        [ sh:class stm3gpp:NetworkInterface ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path upf3gpp:StmCtrl.targetInterfaceInfoList ] ;
    sh:targetClass upf3gpp:StmCtrl .

upf3gpp-shapes:SupportedPerfMetricGroups a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:SupportedPerfMetricGroups.performanceMetrics ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path upf3gpp:SupportedPerfMetricGroups.granularityPeriods ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path upf3gpp:SupportedPerfMetricGroups.reportingMethods ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path upf3gpp:SupportedPerfMetricGroups.reportingPeriods ] ;
    sh:targetClass upf3gpp:SupportedPerfMetricGroups .

upf3gpp-shapes:ThresholdMonitor a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ThresholdMonitor.id ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ThresholdMonitor.administrativeState ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:ThresholdMonitor.operationalState ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:ThresholdMonitor.monitorGranularityPeriod ],
        [ sh:path upf3gpp:ThresholdMonitor.objectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path upf3gpp:ThresholdMonitor.rootObjectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class meas3gpp:ThresholdInfo ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path upf3gpp:ThresholdMonitor.thresholdInfoList ] ;
    sh:targetClass upf3gpp:ThresholdMonitor .

upf3gpp-shapes:TraceJob a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.id ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.jobType ],
        [ sh:class upf3gpp:traceTarget ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.traceTarget ],
        [ sh:class trace3gpp:TraceConfig ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.traceConfig ],
        [ sh:class trace3gpp:MdtConfig ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed. For NTN MDT, if the list of plmnList is included, it will
only log measurements for the cells belonging to the listed PLMNs.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.mdtConfig ],
        [ sh:class trace3gpp:UECoreMeasConfig ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.ueCoreMeasConfig ],
        [ sh:class types3gpp:NpnId ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.nPNTarget ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path upf3gpp:TraceJob.rrcReportType ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path upf3gpp:TraceJob.listOfTraceMetrics ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.traceCollectionEntityIPAddress ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.traceReportingConsumerUri ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.jobId ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path upf3gpp:TraceJob.traceReportingFormat ],
        [ sh:class upf3gpp:pLMNTarget ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path upf3gpp:TraceJob.pLMNTarget ],
        [ sh:class trace3gpp:TraceReference ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:TraceJob.traceReference ] ;
    sh:targetClass upf3gpp:TraceJob .

upf3gpp-shapes:UPFFunction a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UPFFunction.id ],
        [ sh:datatype xsd:string ;
            sh:description "A user-friendly (and user assignable) name of this object." ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UPFFunction.userLabel ],
        [ sh:datatype xsd:string ;
            sh:description """This attribute indicates the onboard satellite Id.
It shall be formatted as a fixed 5-digit string, padding with
leading digits '0' to complete a 5-digit length.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UPFFunction.onboardSatelliteId ;
            sh:pattern "[0-9]{5}" ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates the operator configurable capability supported
by the UPF.  (see clause 5.8.2.21 in TS 23.501, clause 5.4.2
in TS 29.571)""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UPFFunction.uPFCapabilities ],
        [ sh:class mf3gpp:VnfParameters ;
            sh:description """This attribute contains the parameter set of the VNF
instance(s) corresponding to an NE. The presence of this attribute
indicates that the ManagedFunction represented by the MOI is a
virtualized function """ ;
            sh:path upf3gpp:UPFFunction.vnfParametersList ],
        [ sh:class mf3gpp:PeeParameters ;
            sh:description """This attribute contains the parameter list for the control
and monitoring of power, energy and environmental parameters of
ManagedFunction instance(s). """ ;
            sh:path upf3gpp:UPFFunction.peeParameterslist ],
        [ sh:class upf3gpp:SupportedPerfMetricGroups ;
            sh:description """Captures a group of supported performance metrics and
associated parameters related to their production and reporting.
A SupportedPerfMetricGroup attribute which is part of an MOI may
define performanceMetrics for any MOI under the subtree contained
under that MOI, e.g. SupportedPerfMetricGroup on a ManagedElement
can specify supported metrics for contained ManagedFunctions
like a GNBDUFunction.""" ;
            sh:path upf3gpp:UPFFunction.SupportedPerfMetricGroups ],
        [ sh:class upf3gpp:pLMNIdList ;
            sh:description """A list of PLMN identifiers (Mobile Country Code and Mobile
Network Code).""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:UPFFunction.pLMNIdList ],
        [ sh:class mnfp3gpp:ManagedNFProfile ;
            sh:description "Profile definition of a Managed NF (See TS 23.501)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:UPFFunction.managedNFProfile ],
        [ sh:class upf3gpp:UpfInfo ;
            sh:description """This attribute represents information of an UPF NF Instance.
Multiple upfInfo may be allowed to define different TAI list for each
supported S-NSSAI""" ;
            sh:path upf3gpp:UPFFunction.upfInfo ],
        [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UPFFunction.priorityLabel ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics. When this attribute is contained in
a managed object it defines the trace metrics supported for this
object and all descendant objects.

Trace metrics include trace messages, MDT measurements
(Immediate MDT, Logged MDT, Logged MBSFN MDT), RLF and RCEF reports,
see TS 32.422. Trace metrics are identified with their metric
identifier. The metric identifier is constructed as defined
in clause 10 of TS 32.422.""" ;
            sh:path upf3gpp:UPFFunction.supportedTraceMetrics ],
        [ sh:datatype xsd:string ;
            sh:description """List of Tracking Area Codes (legacy TAC or extended TAC)
where the represented management function is serving.""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:UPFFunction.nRTACList ],
        [ sh:datatype xsd:string ;
            sh:description """It is a set of NSI ID. NSI ID is an identifier for
identifying the Core Network part of a Network Slice instance when
multiple Network Slice instances of the same Network Slice are deployed,
and there is a need to differentiate between them in the 5GC.
See NSI ID definition in clause 3.1 of TS 23.501 and
subclause 6.1.6.2.7 of  TS 29.531. """ ;
            sh:path upf3gpp:UPFFunction.cNSIIdList ],
        [ sh:description """This attribute allows management system to initiate energy
saving activation or deactivation for the edge UPF.""" ;
            sh:in ( "TO_BE_ENERGYSAVING" "TO_BE_NOT_ENERGYSAVING" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:UPFFunction.energySavingControl ],
        [ sh:description """This attribute specifies the status regarding the energy
saving in the edge UPF.

If the value of energySavingControl is TO_BE_ENERGYSAVING, then it
shall be tried to achieve the value IS_ENERGYSAVING for the
energySavingState.

If the value of energySavingControl is TO_BE_NOT_ENERGYSAVING, then
it shall be tried to achieve the value IS_NOT_ENERGYSAVING for the
energySavingState. """ ;
            sh:in ( "IS_NOT_ENERGYSAVING" "IS_ENERGYSAVING" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:UPFFunction.energySavingState ],
        [ sh:datatype xsd:string ;
            sh:description """List of supported BMOs (Bridge Managed Objects) required
for integration with TSN system.""" ;
            sh:path upf3gpp:UPFFunction.supportedBMOList ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether the function is
on board the satellite.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UPFFunction.isOnboardSatellite ] ;
    sh:targetClass upf3gpp:UPFFunction .

upf3gpp-shapes:UpfInfo a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """The SMF service area(s) the UPF can serve. See TS 29.510.
If not provided, the UPF can serve any SMF service area.""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.smfServingArea ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether interworking with EPS is supported by
the UPF.
True: Supported
False: Not Supported""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.iwkEpsInd ],
        [ sh:class upf3gpp:SnssaiUpfInfoItem ;
            sh:description """This attribute represents a list of parameters supported by
the UPF per S-NSSAI.""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.sNssaiUpfInfoList ],
        [ sh:class upf3gpp:InterfaceUpfInfoItem ;
            sh:description """List of User Plane interfaces configured on the UPF. When
this parameter is provided in the NF Discovery response, the NF Service
Consumer (e.g., SMF) may use this information for UPF selection.""" ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.interfaceUpfInfoList ],
        [ sh:class upf3gpp:AtsssCapability ;
            sh:description "Indicate the ATSSS capability of the UPF" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.atsssCapability ],
        [ sh:class types3gpp:Tai ;
            sh:description "The list of TAIs." ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.taiList ],
        [ sh:class types5g3gpp:TaiRange ;
            sh:description "The range of TAIs." ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.taiRangeList ],
        [ sh:class types5g3gpp:IpInterface ;
            sh:description """Indicate that the UPF is collocated with W-AGF. If not
present, the UPF is not collocated with Wireline Access Gateway
Function (W-AGF).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.wAgfInfo ],
        [ sh:class types5g3gpp:IpInterface ;
            sh:description """Indicate that the UPF is collocated with TNGF. If not
present, the UPF is not collocated with Trusted Non-3GPP Gateway
Function (TNGF).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.tngfInfo ],
        [ sh:class types5g3gpp:IpInterface ;
            sh:description """Indicate that the UPF is collocated with TWIF. If not
present, the UPF is not collocated with Trusted WLAN Interworking
Function (TWIF).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.twifInfo ],
        [ sh:description "Indicates the type(s) of a PDU session." ;
            sh:in ( "IPV4" "IPV6" "IPV4V6" "UNSTRUCTURED" "ETHERNET" ) ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.pduSessionTypes ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF supports allocating UE IP
addresses/prefixes.
true: supported
false: not supported""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UpfInfo.ueIpAddrInd ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """This parameter defines Priority (relative to other NFs of
the same type) in the range of 0-65535, to be used for NF selection;
lower values indicate a higher priority. If priority is also present
in the nfServiceList parameters, those will have precedence over
this value (See TS 29.510).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path upf3gpp:UpfInfo.priority ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF supports redundant GTP-U path.
true: supported
false: not supported""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UpfInfo.redundantGtpu ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF is configured for Inter-PLMN User
Plane Security (IPUPS). Any UPF can support the IPUPS functionality.
In network deployments where specific UPFs are used to provide IPUPS,
UPFs configured for providing IPUPS services shall be selected.
true: The UPF is configured for IPUPS.
false: The UPF is not configured for IPUPS""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UpfInfo.ipups ],
        [ sh:datatype xsd:boolean ;
            sh:description """Indicates whether the UPF is configured for data forwarding.
Based on operator policies, if dedicated UPFs are preferred to be used
for indirect data forwarding during handover scenarios, when setting
up the indirect data forwarding tunnel, the SMF should preferably
select a UPF configured for data forwarding and use the network
instance indicated in the Network Instance ID associated to the
DATA_FORWARDING interface type in the interfaceUpfInfoList attribute.
true: the UPF is configured for data forwarding
false: the UPF is not configured for data forwarding

If the UPF is configured for data forwarding, it shall support UP
network interface with type 'DATA_FORWARDING'.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UpfInfo.dataForwarding ],
        [ sh:datatype xsd:string ;
            sh:description """Supported Packet Forwarding Control Protocol (PFCP) Features.
A string used to indicate the PFCP features supported by the UPF,
which encodes the 'UP Function Features' as specified in
Table 8.2.25-1 of TS 29.244 (starting from Octet 5), in hexadecimal
representation.

Each character in the string shall take a value of '0' to '9', 'a'
to 'f' or 'A' to 'F' and each two characters shall represent one octet
of 'UP Function Features' (starting from Octet 5, to higher octets).
For each two characters representing one octet, the first character
representing the 4 most significant bits of the octet and the second
character the 4 least significant bits of the octet.

The supported PFCP features shall be provisioned in addition and be
consistent with the existing UPF features (atsssCapability, ueIpAddrInd,
redundantGtpu and ipups), e.g., if the ueIpAddrInd is set to 'true',
then the UEIP flag shall also be set to '1' in the supported PFCP
features.""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UpfInfo.supportedPfcpFeatures ],
        [ sh:datatype xsd:boolean ;
            sh:description """This attribute indicates whether the UPF is configured to
support Sxa interface.
true: Supported
false: Not Supported""" ;
            sh:maxCount 1 ;
            sh:path upf3gpp:UpfInfo.sxaInd ] ;
    sh:targetClass upf3gpp:UpfInfo .

upf3gpp-shapes:ipv4AddressRanges a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ipv4AddressRanges.start ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ipv4AddressRanges.end ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ] ;
    sh:targetClass upf3gpp:ipv4AddressRanges .

upf3gpp-shapes:ipv6PrefixRanges a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ipv6PrefixRanges.start ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path upf3gpp:ipv6PrefixRanges.end ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))" ] ;
    sh:targetClass upf3gpp:ipv6PrefixRanges .

