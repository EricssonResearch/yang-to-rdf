@prefix y2r: <https://semantics.ericsson.com/vocab#> .

<https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-amfregion> a owl:Ontology ;
    rdfs:label "_3gpp-5gc-nrm-amfregion" ;
    dcterms:description """This IOC represents the AMF Region which consists one or
multiple AMF Sets.
Copyright 2024, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3gpp SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-5gc-nrm-amfregion" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2024-05-24 (CR-1273)" ;
    y2r:yangModuleName "_3gpp-5gc-nrm-amfregion" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5gc-nrm-amfregion> .

amfr3gpp:File.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

amfr3gpp:Files.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

amfr3gpp:PerfMetricJob.conditionMonitorRef rdfs:range util3gpp:ConditionMonitor ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

amfr3gpp:PerfMetricJob.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

amfr3gpp:PerfMetricJob.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

amfr3gpp:PerfMetricJob.schedulerRef rdfs:range util3gpp:Scheduler ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

amfr3gpp:StmCtrl.reportingNFList y2r:candidate "ReportingNF" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

amfr3gpp:ThresholdMonitor.objectInstances y2r:candidate "ObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

amfr3gpp:ThresholdMonitor.rootObjectInstances y2r:candidate "RootObjectInstances" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

