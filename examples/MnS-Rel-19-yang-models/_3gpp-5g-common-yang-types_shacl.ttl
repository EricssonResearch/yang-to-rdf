@prefix amf3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-amffunction#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix me3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-managed-element#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix smf3gpp: <https://semantics.ericsson.com/yang/_3gpp-5gc-nrm-smffunction#> .
@prefix types3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-yang-types#> .
@prefix types5g3gpp: <https://semantics.ericsson.com/yang/_3gpp-5g-common-yang-types#> .
@prefix types5g3gpp-shapes: <https://semantics.ericsson.com/shapes/_3gpp-5g-common-yang-types#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

types5g3gpp-shapes:AreaScope a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:AreaScope.eutraCellIdList ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:AreaScope.tacList ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path types5g3gpp:AreaScope.cAGIdList ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path types5g3gpp:AreaScope.nrCellIdList ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class types3gpp:GeoArea ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path types5g3gpp:AreaScope.ntnGeoAreaList ],
        [ sh:class types3gpp:NpnId ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path types5g3gpp:AreaScope.nPNIdentityList ],
        [ sh:class types3gpp:Tai ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path types5g3gpp:AreaScope.taiList ],
        [ sh:class smf3gpp:sliceIdList ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:AreaScope.sliceIdList ] ;
    sh:targetClass types5g3gpp:AreaScope .

types5g3gpp-shapes:CaraConfiguration a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """IP address or FQDN of the CMP (Certificate Management
Protocol)
server""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:CaraConfiguration.caraAddress ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """This parameter specifies the port number used by
CMP (Certificate Management Protocol) server. The port for HTTP/HTTPSs
transfer of CMP messages is not explicitly given in RFC 9811, therefore
this parameter is required. The port number is usually
represented as 2 octets.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:CaraConfiguration.portNumber ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter specifies the path (in ASCII string) to
the CMP server directory. A CMP server may be located in an
arbitrary path other than root.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:CaraConfiguration.path ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter specifies the subject name (in ASCII
string) of the CA/RA. The use is described in 3GPP TS 33.310
clause 9.5.3.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:CaraConfiguration.subjectName ],
        [ sh:description """This parameter specifies the protocol (HTTP or HTTPS)
to be used for certificate enrolment. The use is described in
3GPP TS 33.310 clause 9.6.""" ;
            sh:in ( "HTTP" "HTTPS" ) ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:CaraConfiguration.protocol ] ;
    sh:targetClass types5g3gpp:CaraConfiguration .

types5g3gpp-shapes:ExtSnssai a sh:NodeShape ;
    sh:property [ sh:class smf3gpp:snssai ;
            sh:description """It represents the S-NSSAI the NetworkSlice managed object
is supporting. The S-NSSAI is defined in TS 23.003 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:ExtSnssai.snssai ],
        [ sh:class types5g3gpp:SnssaiExtension ;
            sh:description "It represents extensions to the Snssai." ;
            sh:minCount 1 ;
            sh:path types5g3gpp:ExtSnssai.snssaiExtension ] ;
    sh:targetClass types5g3gpp:ExtSnssai .

types5g3gpp-shapes:IdentityRange a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "First value identifying the start of an identity range." ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:IdentityRange.start ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Last value identifying the end of an identity range." ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:IdentityRange.end ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the set of identities belonging to
this range.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:IdentityRange.pattern ] ;
    sh:targetClass types5g3gpp:IdentityRange .

types5g3gpp-shapes:InternalGroupIdRange a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It indicates first value identifying
the start of an identity range, to be used when
the range of identities can be represented as a
consecutive numeric range.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:InternalGroupIdRange.start ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates last value identifying
the end of an identity range, to be used when
the range of identities can be represented as a
consecutive numeric range.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:InternalGroupIdRange.end ],
        [ sh:datatype xsd:string ;
            sh:description """It indicates pattern (regular
expression according to the ECMA-262 dialect)
representing the set of identities belonging to
this range. An identity value is considered part
of the range if and only if the identity string
fully matches the regular expression.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:InternalGroupIdRange.pattern ] ;
    sh:targetClass types5g3gpp:InternalGroupIdRange .

types5g3gpp-shapes:IpInterface a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path types5g3gpp:IpInterface.ipv4EndpointAddresses ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path types5g3gpp:IpInterface.ipv6EndpointAddresses ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:IpInterface.fqdn ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ] ;
    sh:targetClass types5g3gpp:IpInterface .

types5g3gpp-shapes:LocationInfo a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:LocationInfo.id ],
        [ sh:datatype xsd:long ;
            sh:description """It is either the gNB ID of the IAB-donor-CU that target IAB-DU
connects to or the gNB Id of the IAB-nonor-CU that serves IAB-MT, or
the gNBId of the gNB that serves MWAB-UE.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:LocationInfo.gNBId ],
        [ sh:datatype xsd:int ;
            sh:description """Identifies an NR cell where IAB-MT or MWAB-UE
is connected to.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:LocationInfo.cellLocalId ],
        [ sh:datatype xsd:string ;
            sh:description """It is TAC pertaining to the cells where IAB-MT or MWAB-UE is
connected.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:LocationInfo.nRTAC ],
        [ sh:class me3gpp:pLMNId ;
            sh:description "The PLMN ID where IAB-MT or MWAB-UE is connected to" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:LocationInfo.pLMNId ],
        [ sh:class types3gpp:Tai ;
            sh:description """It is the TAI (see subclause 9.3.3.11 in TS 38.413) pertaining
to the cells where IAB-MT or MWAB-UE is connected""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:LocationInfo.tAI ],
        [ sh:class types3gpp:GeoArea ;
            sh:description """It specifies geographical area of mobile NR node
(e.g., IAB-node or MWAB-node).""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:LocationInfo.geoArea ] ;
    sh:targetClass types5g3gpp:LocationInfo .

types5g3gpp-shapes:MappedCellIdInfo a sh:NodeShape ;
    sh:property [ sh:class types3gpp:GeoArea ;
            sh:description """This attribute indicates a specific geographical location
mapped to Mapped Cell ID(s).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:MappedCellIdInfo.ntnGeoArea ],
        [ sh:class types5g3gpp:Ncgi ;
            sh:description """This attribute is in format of NCGI to indicate a fixed
geographical area (See subclause 16.14.5 in TS 38.300)""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:MappedCellIdInfo.mappedCellId ] ;
    sh:targetClass types5g3gpp:MappedCellIdInfo .

types5g3gpp-shapes:MnrOamIPConfig a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:MnrOamIPConfig.id ],
        [ sh:datatype xsd:string ;
            sh:description """this parameter specifies IP address or
FQDN of security gateway (SeGW) used for an
an NR mobile node (e.g., IAB-node or MWAB)
to establish secure connection as specified in TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:MnrOamIPConfig.seGwConfiguration ],
        [ sh:datatype xsd:string ;
            sh:description """this parameter specifies IP address or FQDN of
configuration server (SCS) used for
an NR mobile node (e.g., IAB-node or MWAB)
to establish connection as specified in TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:MnrOamIPConfig.scsConfiguration ],
        [ sh:class types5g3gpp:CaraConfiguration ;
            sh:description """configuration used for  an NR mobile node (e.g., IAB-node or MWAB),
to perform certificate enrolment procedure as specified in
TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:MnrOamIPConfig.caraConfiguration ] ;
    sh:targetClass types5g3gpp:MnrOamIPConfig .

types5g3gpp-shapes:Ncgi a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This attribute represents NR Cell Identity.
It's a 36-bit string identifying an NR Cell Id as specified in
clause 9.3.1.7 of TS 38.413, in hexadecimal representation. Each
character in the string shall take a value of
'0' to '9', 'a' to 'f' or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most significant
bits of the Cell Id shall appear first in the string, and the
character representing the 4 least significant bit of the
Cell Id shall appear last in the string.

Pattern: '^[A-Fa-f0-9]{9}$'

Example:
An NR Cell Id 0x225BD6007 shall be encoded as '225BD6007'.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:Ncgi.nrCellId ],
        [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid identifies
an SNPN (see clauses 5.30.2.3, 5.30.2.9, 6.3.4, and 6.3.8 in
3GPP TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:Ncgi.nId ],
        [ sh:class amf3gpp:plmnId ;
            sh:description "This attribute represents a PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:Ncgi.plmnId ] ;
    sh:targetClass types5g3gpp:Ncgi .

types5g3gpp-shapes:RuleSet a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """It indicates the unique Priority of the rule. Lower value
means higher priority.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:RuleSet.priority ],
        [ sh:description """It indicates type of the NFs allowed/dis-allowed to
access the service instance. When absent, NF-Consumers of all
nfTypes are assumed to match this criteria.""" ;
            sh:in ( "NRF" "UDM" "AMF" "SMF" "AUSF" "NEF" "PCF" "SMSF" "NSSF" "UDR" "LMF" "GMLC" "5G_EIR" "SEPP" "UPF" "N3IWF" "AF" "UDSF" "BSF" "CHF" "NWDAF" "PCSCF" "CBCF" "HSS" "UCMF" "SOR_AF" "SPAF" "MME" "SCSAS" "SCEF" "SCP" "NSSAAF" "ICSCF" "SCSCF" "DRA" "IMS_AS" "AANF" "5G_DDNMF" "NSACF" "MFAF" "EASDF" "DCCF" "MB_SMF" "TSCTSF" "ADRF" "GBA_BSF" "CEF" "MB_UPF" "NSWOF" "PKMF" "MNPF" "SMS_GMSC" "SMS_IWMSC" "MBSF" "MBSTF" "PANF" "TNGF" "W_AGF" "TWIF" "TSN_AF" ) ;
            sh:path types5g3gpp:RuleSet.nfTypes ],
        [ sh:datatype xsd:string ;
            sh:description """It represents pattern (regular expression according to
the ECMA-262 dialect) representing the NF domain names within the
PLMN of the NRF allowed/dis-allowed to access the service instance.
When absent, NF-Consumers of all nfDomains are assumed to match
this criteria.""" ;
            sh:path types5g3gpp:RuleSet.nfDomains ],
        [ sh:datatype xsd:string ;
            sh:description """It represents NF-Instance IDs of the NF-Consumers
allowed/dis-allowed to access the NF/NF-Service instance. When
absent, all the NF-Consumers are assumed to match this criteria.""" ;
            sh:path types5g3gpp:RuleSet.nfInstances ],
        [ sh:datatype xsd:string ;
            sh:description """It represents list of scopes allowed or denied to the
NF-Consumers matching the rule. The scopes shall be any of those
defined in the API that defines the current service. When absent,
the NF-Consumer is allowed or denied full access to all the
resources/operations of service instance.""" ;
            sh:path types5g3gpp:RuleSet.scopes ],
        [ sh:description """It specifies whether the scopes/access mentioned are
allowed or denied for a specific NF-Consumer.
ALLOW: The NF consumer is allowed to access NF producer.
DENY: The NF consumer is not allowed to access NF Producer.""" ;
            sh:in ( "ALLOW" "DENY" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:RuleSet.action ],
        [ sh:class smf3gpp:plmns ;
            sh:description """It indicates PLMNs allowed/dis-allowed to access the
service instance. When absent, NF-Consumers of all PLMNs are
assumed to match this criteria.""" ;
            sh:path types5g3gpp:RuleSet.plmns ],
        [ sh:class smf3gpp:snpns ;
            sh:description """It indicates SNPNs allowed/dis-allowed to access the
service instance. When absent, NF-Consumers of all SNPNs are
assumed to match this criteria.""" ;
            sh:path types5g3gpp:RuleSet.snpns ],
        [ sh:class types5g3gpp:ExtSnssai ;
            sh:description """It represents S-NSSAIs of the NF-Consumers
allowed/dis-allowed to access the service instance. When absent,
NF-Consumers of all slices are assumed to match this criteria.""" ;
            sh:path types5g3gpp:RuleSet.nssais ] ;
    sh:targetClass types5g3gpp:RuleSet .

types5g3gpp-shapes:SdRange a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an SD range.
This string shall be formatted as specified for the sd attribute of the
Snssai data type in clause 5.4.4.2 of TS 29.571.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:SdRange.start ;
            sh:pattern "[A-Fa-f0-9]{6}" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of an SD range.
This string shall be formatted as specified for the sd attribute of the
Snssai data type in clause 5.4.4.2 in TS 29.571""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:SdRange.end ;
            sh:pattern "[A-Fa-f0-9]{6}" ] ;
    sh:targetClass types5g3gpp:SdRange .

types5g3gpp-shapes:SnssaiExtension a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """It indicates that all SD values are supported for the
Slice/Service Type value indicated in the sst attribute of the Snssai
data type (see clause 5.4.4.2 in TS 29.571).""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:SnssaiExtension.wildcardSd ],
        [ sh:class types5g3gpp:SdRange ;
            sh:description """It shall contain the range(s) of Slice Differentiator values
supported for the Slice/Service Type value indicated in the sst
attribute of the Snssai data type (see clause 5.4.4.2 in TS 29.571).""" ;
            sh:minCount 1 ;
            sh:path types5g3gpp:SnssaiExtension.sdRanges ] ;
    sh:targetClass types5g3gpp:SnssaiExtension .

types5g3gpp-shapes:SupiRange a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "First value identifying the start of a SUPI range." ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:SupiRange.start ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description "Last value identifying the end of a SUPI range." ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:SupiRange.end ;
            sh:pattern "^[0-9]+$" ],
        [ sh:datatype xsd:string ;
            sh:description """Pattern representing the set of SUPIs belonging to
this range.""" ;
            sh:maxCount 1 ;
            sh:path types5g3gpp:SupiRange.pattern ] ;
    sh:targetClass types5g3gpp:SupiRange .

types5g3gpp-shapes:TaiRange a sh:NodeShape ;
    sh:property [ sh:class smf3gpp:plmnId ;
            sh:description "PLMN ID related to the TacRange." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:TaiRange.plmnId ],
        [ sh:class smf3gpp:tacRangeList ;
            sh:description "The range of the TACs." ;
            sh:minCount 1 ;
            sh:path types5g3gpp:TaiRange.tacRangeList ] ;
    sh:targetClass types5g3gpp:TaiRange .

types5g3gpp-shapes:VendorSpecificFeature a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It is a string representing a proprietary feature
specific to a given vendor.
It is recommended that the case convention for these strings is the
same as for enumerated data types (i.e. UPPER_WITH_UNDERSCORE;
see 3GPP TS 29.501, clause 5.1.1).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:VendorSpecificFeature.featureName ],
        [ sh:datatype xsd:string ;
            sh:description "It is a string representing the version of the feature." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path types5g3gpp:VendorSpecificFeature.featureVersion ] ;
    sh:targetClass types5g3gpp:VendorSpecificFeature .

<https://semantics.ericsson.com/yang/_3gpp-5g-common-yang-types> a owl:Ontology ;
    rdfs:label "_3gpp-5g-common-yang-types" ;
    dcterms:description """The model defines common types for 5G networks and
network slicing.
Copyright 2026, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5g-common-yang-types" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-03-25 (CR-1694)" ;
    y2r:yangModuleName "_3gpp-5g-common-yang-types" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-5g-common-yang-types> .

