@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types> a owl:Ontology ;
    rdfs:label "_3gpp-5g-common-yang-types" ;
    dcterms:description """The model defines common types for 5G networks and
network slicing.
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541" ;
    dcterms:title "_3gpp-5g-common-yang-types" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-01-07 (CR-)" .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScopeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "List of E-UTRAN cells identified by E-UTRAN-CGI" ;
            sh:maxCount 32 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/eutraCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{7}$" ],
        [ sh:datatype xsd:string ;
            sh:description "Tracking Area Code list" ;
            sh:maxCount 8 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/tacList> ;
            sh:pattern "([A-Fa-f0-9]{4})|([A-Fa-f0-9]{6})" ],
        [ sh:datatype xsd:string ;
            sh:description """It identifies a CAG list containing up to
256 CAG-identifiers per UE or up to 12 CAG-identifiers
per cell, see TS 38.331 [38]. CAG ID is used to combine
with PLMN ID to identify a PNI-NPN.AG ID is a hexadecimal
range with size 32 bit.""" ;
            sh:maxCount 256 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/cAGIdList> ;
            sh:pattern "^[A-Fa-f0-9]{8}$" ],
        [ sh:datatype xsd:string ;
            sh:description "List of NR cells identified by NG-RAN CGI" ;
            sh:maxCount 32 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/nrCellIdList> ;
            sh:pattern "^[A-Fa-f0-9]{9}$" ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> ;
            sh:description "geographical areas for NTN MDT" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/ntnGeoAreaList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-yang-types/NpnId> ;
            sh:description """list of NPN IDs of in NR. It is either
a list of PNI-NPNs identified by CAG ID with
associated plmn-Identity or a list of SNPN
identified by Network ID with associated plmn-Identity""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/nPNIdentityList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> ;
            sh:description "Tracking Area Identity list" ;
            sh:maxCount 8 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/taiList> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/sliceIdList> ;
            sh:description "Network Slice Id list" ;
            sh:maxCount 16384 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope/sliceIdList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/AreaScope> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfigurationShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """IP address or FQDN of the CMP (Certificate Management
Protocol)
server""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/caraAddress> ],
        [ sh:datatype xsd:unsignedShort ;
            sh:description """This parameter specifies the port number used by
CMP (Certificate Management Protocol) server. The port for HTTP/HTTPSs
transfer of CMP messages is not explicitly given in RFC 9811, therefore
this parameter is required. The port number is usually
represented as 2 octets.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/portNumber> ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter specifies the path (in ASCII string) to
the CMP server directory. A CMP server may be located in an
arbitrary path other than root.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/path> ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter specifies the subject name (in ASCII
string) of the CA/RA. The use is described in 3GPP TS 33.310
clause 9.5.3.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/subjectName> ],
        [ sh:description """This parameter specifies the protocol (HTTP or HTTPS)
to be used for certificate enrolment. The use is described in
3GPP TS 33.310 clause 9.6.""" ;
            sh:in ( "HTTP" "HTTPS" ) ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration/protocol> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssaiShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-upffunction/snssai> ;
            sh:description """It represents the S-NSSAI the NetworkSlice managed object
is supporting. The S-NSSAI is defined in TS 23.003 """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssai/snssai> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension> ;
            sh:description "It represents extensions to the Snssai." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssai/snssaiExtension> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/ExtSnssai> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterfaceShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv4 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface/ipv4EndpointAddresses> ;
            sh:pattern "(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){3}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?" ],
        [ sh:datatype xsd:string ;
            sh:description """Available endpoint IPv6 address(es) of
the User Plane interface.""" ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface/ipv6EndpointAddresses> ;
            sh:pattern "((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))(%[A-Za-z0-9][A-Za-z0-9\\-\\._~/]*)?" ],
        [ sh:datatype xsd:string ;
            sh:description """This parameter defines FQDN of the Network Function
(See TS 23.003).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface/fqdn> ;
            sh:pattern "((([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.)*([a-zA-Z0-9_]([a-zA-Z0-9\\-_]){0,61})?[a-zA-Z0-9]\\.?)|\\." ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/IpInterface> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfoShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/id> ],
        [ sh:datatype xsd:long ;
            sh:description """It is either the gNB ID of the IAB-donor-CU that target IAB-DU
connects to or the gNB Id of the IAB-nonor-CU that serves IAB-MT, or
the gNBId of the gNB that serves MWAB-UE.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/gNBId> ],
        [ sh:datatype xsd:int ;
            sh:description """Identifies an NR cell where IAB-MT or MWAB-UE
is connected to.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/cellLocalId> ],
        [ sh:datatype xsd:string ;
            sh:description """It is TAC pertaining to the cells where IAB-MT or MWAB-UE is
connected.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/nRTAC> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-managed-element/pLMNId> ;
            sh:description "The PLMN ID where IAB-MT or MWAB-UE is connected to" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/pLMNId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-yang-types/Tai> ;
            sh:description """It is the TAI (see subclause 9.3.3.11 in TS 38.413) pertaining
to the cells where IAB-MT or MWAB-UE is connected""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/tAI> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> ;
            sh:description """It specifies geographical area of mobile NR node
(e.g., IAB-node or MWAB-node).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo/geoArea> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/LocationInfo> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfoShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-common-yang-types/GeoArea> ;
            sh:description """This attribute indicates a specific geographical location
mapped to Mapped Cell ID(s).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfo/ntnGeoArea> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi> ;
            sh:description """This attribute is in format of NCGI to indicate a fixed
geographical area (See subclause 16.14.5 in TS 38.300)""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfo/mappedCellId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MappedCellIdInfo> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfigShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig/id> ],
        [ sh:datatype xsd:string ;
            sh:description """this parameter specifies IP address or
FQDN of security gateway (SeGW) used for an
an NR mobile node (e.g., IAB-node or MWAB)
to establish secure connection as specified in TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig/seGwConfiguration> ],
        [ sh:datatype xsd:string ;
            sh:description """this parameter specifies IP address or FQDN of
configuration server (SCS) used for
an NR mobile node (e.g., IAB-node or MWAB)
to establish connection as specified in TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig/scsConfiguration> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5g-common-yang-types/CaraConfiguration> ;
            sh:description """configuration used for  an NR mobile node (e.g., IAB-node or MWAB),
to perform certificate enrolment procedure as specified in
TS 28.315.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig/caraConfiguration> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/MnrOamIPConfig> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/NcgiShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """This attribute represents NR Cell Identity.
It's a 36-bit string identifying an NR Cell Id as specified in
clause 9.3.1.7 of TS 38.413, in hexadecimal representation. Each
character in the string shall take a value of
'0' to '9', 'a' to 'f' or 'A' to 'F' and shall represent 4 bits.
The most significant character representing the 4 most significant
bits of the Cell Id shall appear first in the string, and the
character representing the 4 least significant bit of the
Cell Id shall appear last in the string.

Pattern: '^[A-Fa-f0-9]{9}$'

Example:
An NR Cell Id 0x225BD6007 shall be encoded as '225BD6007'.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi/nrCellId> ],
        [ sh:datatype xsd:string ;
            sh:description """Network Identity; Shall be present if PlmnIdNid identifies
an SNPN (see clauses 5.30.2.3, 5.30.2.9, 6.3.4, and 6.3.8 in
3GPP TS 23.501.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi/nId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/plmnId> ;
            sh:description "This attribute represents a PLMN Identity." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi/plmnId> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/Ncgi> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRangeShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """First value identifying the start of an SD range.
This string shall be formatted as specified for the sd attribute of the
Snssai data type in clause 5.4.4.2 of TS 29.571.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange/start> ;
            sh:pattern "[A-Fa-f0-9]{6}" ],
        [ sh:datatype xsd:string ;
            sh:description """Last value identifying the end of an SD range.
This string shall be formatted as specified for the sd attribute of the
Snssai data type in clause 5.4.4.2 in TS 29.571""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange/end> ;
            sh:pattern "[A-Fa-f0-9]{6}" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtensionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:boolean ;
            sh:description """It indicates that all SD values are supported for the
Slice/Service Type value indicated in the sst attribute of the Snssai
data type (see clause 5.4.4.2 in TS 29.571).""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension/wildcardSd> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SdRange> ;
            sh:description """It shall contain the range(s) of Slice Differentiator values
supported for the Slice/Service Type value indicated in the sst
attribute of the Snssai data type (see clause 5.4.4.2 in TS 29.571).""" ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension/sdRanges> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/SnssaiExtension> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRangeShape> a sh:NodeShape ;
    sh:property [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/plmnId> ;
            sh:description "PLMN ID related to the TacRange." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange/plmnId> ],
        [ sh:class <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/tacRangeList> ;
            sh:description "The range of the TACs." ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange/tacRangeList> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/TaiRange> .

<urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeatureShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """It is a string representing a proprietary feature
specific to a given vendor.
It is recommended that the case convention for these strings is the
same as for enumerated data types (i.e. UPPER_WITH_UNDERSCORE;
see 3GPP TS 29.501, clause 5.1.1).""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature/featureName> ],
        [ sh:datatype xsd:string ;
            sh:description "It is a string representing the version of the feature." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature/featureVersion> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5g-common-yang-types/VendorSpecificFeature> .

