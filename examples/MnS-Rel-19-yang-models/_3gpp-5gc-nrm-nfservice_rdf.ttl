nfs3gpp:CallbackUriPrefixItem a rdfs:Class ;
    rdfs:label "CallbackUriPrefixItem" ;
    rdfs:comment """It indicates the optional path segment(s) used to construct
the prefix of the Callback URIs during the reselection of an NF
service consumer.""" .

nfs3gpp:ConditionItem a rdfs:Class ;
    rdfs:label "ConditionItem" ;
    rdfs:comment """It represent a single condition item that shall be
evaluated to determine whether a discovered NF (Service) Instance
shall be selected.""" ;
    y2r:hasAttribute types5g3gpp:IdentityRange,
        types5g3gpp:SupiRange,
        types5g3gpp:TaiRange .

nfs3gpp:NFService a rdfs:Class ;
    rdfs:label "NFService" ;
    rdfs:comment """List of NF Service Instances. It shall include
the services produced by the NF that can be discovered by
other NFs.""" ;
    y2r:hasAttribute types5g3gpp:RuleSet,
        nfs3gpp:CallbackUriPrefixItem,
        nfs3gpp:PlmnOauth2,
        nfs3gpp:SelectionConditions,
        smf3gpp:allowedNSSAIs,
        smf3gpp:allowedPLMNs,
        smf3gpp:allowedSnpns,
        smf3gpp:defaultNotificationSubscriptions,
        smf3gpp:ipEndPoints,
        smf3gpp:perPlmnSnssaiList,
        smf3gpp:sNssais,
        smf3gpp:supportedVendorSpecificFeatures,
        smf3gpp:versions .

nfs3gpp:PlmnOauth2 a rdfs:Class ;
    rdfs:label "PlmnOauth2" ;
    rdfs:comment """This attribute includes the Oauth2-based authorization
requirement supported by the NF Service Instance per PLMN of the
NF Service Consumer. This attribute may be included when the
Oauth2.0 authorization requirement supported by the NF Service
Instance for different PLMN is different. When the requester
PLMN Id is available in perPlmnOauth2ReqList IE, this IE shall
override the oauth2Required IE. If the requester PLMN ID is not
present in perPlmnOauth2ReqList IE, then the value of
oauth2Required IE shall be applicable if available.""" ;
    y2r:hasAttribute smf3gpp:oauth2NotRequiredPlmnIdList,
        smf3gpp:oauth2RequiredPlmnIdList .

nfs3gpp:SNPNId a rdfs:Class ;
    rdfs:label "SNPNId" ;
    rdfs:comment """SNPNs allowed to access the NF instance.
The absence of this attribute in the NF profile indicates that no SNPN,
other than the SNPN(s) registered in the snpnList attribute of the
NF Profile, is allowed to access the service instance""" .

nfs3gpp:SelectionConditions a rdfs:Class ;
    rdfs:label "SelectionConditions" ;
    rdfs:comment """This attribute includes the conditions under which an NF
Instance with an NFStatus value set to CANARY_RELEASE, or with a
canaryRelease attribute set to true, shall be selected by an NF
Service Consumer.""" ;
    y2r:hasAttribute nfs3gpp:ConditionItem,
        smf3gpp:conditionGroup .

