@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> a rdfs:Class ;
    rdfs:comment """List of NF Service Instances. It shall include
the services produced by the NF that can be
discovered by other NFs.""" ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAI>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPLMNs>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedSnpns>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPoints>,
        <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/versions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId> a rdfs:Class ;
    rdfs:comment """SNPNs allowed to access the NF instance.
The absence of this attribute in the NF profile indicates that no SNPN,
other than the SNPN(s) registered in the snpnList attribute of the
NF Profile, is allowed to access the service instance""" .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice> a owl:Ontology .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedNSSAI> a owl:ObjectProperty ;
    rdfs:comment """S-NSSAI of the allowed slices to access the service
instance. The absence of this attribute indicates that any slice
is allowed to access the service instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedNSSAI> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedNfDomains> a rdf:Property ;
    rdfs:comment """Pattern representing the NF domain names allowed to
access the service instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedNfTypes> a rdf:Property ;
    rdfs:comment "SNPNs allowed to access the NF instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedOperationsPerNfInstance> a rdf:Property ;
    rdfs:comment """It indicates the allowed operations on resources for
a given NF Instance; the key of the map is the NF Instance Id, and
the value is an array of scopes""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedOperationsPerNfInstanceOverrides> a rdf:Property ;
    rdfs:comment """When it is present and set to true, indicates that
the scopes defined in attribute allowedOperationsPerNfInstance
for a given NF Instance ID take precedence over the scopes defined
in attribute allowedOperationsPerNfType for the corresponding
NF type of the NF Instance associated to such NF Instance ID..""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedOperationsPerNfType> a rdf:Property ;
    rdfs:comment """It indicates the allowed operations on resources for
each type of NF; the key of the map is the NF Type, and the value
is an array of scopes""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedPLMNs> a owl:ObjectProperty ;
    rdfs:comment """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedPLMNs> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/allowedSnpns> a owl:ObjectProperty ;
    rdfs:comment """PLMNs allowed to access the service instance.
The absence of this attribute indicates that any PLMN is allowed to
access the service instance.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/allowedSnpns> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/apiPrefix> a rdf:Property ;
    rdfs:comment """Optional path segment(s) used to construct the {apiRoot}
variable of the different API URIs.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/capacity> a rdf:Property ;
    rdfs:comment """Static capacity information in the range of 0-65535,
expressed as a weight relative to other services of the same type.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/defaultNotificationSubscriptions> a owl:ObjectProperty ;
    rdfs:comment "Notification endpoints for different notification types." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/defaultNotificationSubscriptions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/fqdn> a rdf:Property ;
    rdfs:comment "FQDN of the NF Service Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/interPlmnFqdn> a rdf:Property ;
    rdfs:comment """If the NF service needs to be discoverable by other NFs in a
different PLMN, then an FQDN that is used for inter PLMN routing.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/ipEndPoints> a owl:ObjectProperty ;
    rdfs:comment """IP address(es) and port information of the Network Function
(including IPv4 and/or IPv6 address)where the service is listening
for incoming service requests.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/ipEndPoints> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/nfServiceStatus> a rdf:Property ;
    rdfs:comment "Status of the NF Service Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/oauth2Required> a rdf:Property ;
    rdfs:comment """It indicates whether the NF Service Instance requires
Oauth2-based authorization""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/priority> a rdf:Property ;
    rdfs:comment """Priority (relative to other services of the same type)
in the range of 0-65535, to be used for NF Service selection; lower
values indicate a higher priority.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/recoveryTime> a rdf:Property ;
    rdfs:comment "Timestamp when the NF was (re)started." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/scheme> a rdf:Property ;
    rdfs:comment "URI scheme (e.g. 'http', 'https')." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/serviceInstanceID> a rdf:Property ;
    rdfs:comment "Unique ID of the service instance within a given NF Instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/serviceName> a rdf:Property ;
    rdfs:comment "Name of the service instance (e.g. 'nudm-sdm')." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/sharedServiceDataId> a rdf:Property ;
    rdfs:comment """String uniquely identifying SharedServiceData. The format
of the sharedServiceDataId shall be a Universally Unique Identifier
(UUID) version 4, as described in IETF RFC 4122 [44]. The hexadecimal
letters should be formatted as lower-case characters by the sender,
and they shall be handled as case-insensitive by the receiver.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/vendorId> a rdf:Property ;
    rdfs:comment "Vendor ID of the NF instance" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService/versions> a owl:ObjectProperty ;
    rdfs:comment """API versions supported by the NF Service and if available,
the corresponding retirement date of the NF Service.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFService> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-smffunction/versions> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/NFServiceStatus> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId/mCC> a rdf:Property ;
    rdfs:comment """This is the Mobile Country Code (MCC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId/mNC> a rdf:Property ;
    rdfs:comment """This is the Mobile Network Code (MNC) of the PLMN
identifier. See TS 23.003 [13] subclause 2.2 and 12.1.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId/nId> a rdf:Property ;
    rdfs:comment """Network Identity; Shall be present if PlmnIdNid
identifies an SNPN""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SNPNId> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/ServiceName> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/SupportedFeatures> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/TransportProtocol> a rdfs:Datatype .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nfservice/UriScheme> a rdfs:Datatype .

