<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-nrsectorcarrier> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-nrsectorcarrier" ;
    dcterms:description """Defines the YANG mapping of the NRSectorCarrier Information
Object Class (IOC) that is part of the NR Network Resource Model (NRM).
Copyright 2023, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
