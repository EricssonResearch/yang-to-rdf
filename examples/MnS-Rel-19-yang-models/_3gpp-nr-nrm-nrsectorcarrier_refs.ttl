    dcterms:title "_3gpp-nr-nrm-nrsectorcarrier" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2023-09-18 (CR-1043)" ;
    y2r:yangModuleName "_3gpp-nr-nrm-nrsectorcarrier" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-nr-nrm-nrnetwork-nrsectorcarrier> .

