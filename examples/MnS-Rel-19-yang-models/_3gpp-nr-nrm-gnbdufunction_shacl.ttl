            sh:path gnbdu3gpp:PerfMetricJob.granularityPeriod ],
        [ sh:path gnbdu3gpp:PerfMetricJob.objectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path gnbdu3gpp:PerfMetricJob.rootObjectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """For the file-based reporting method this is the time
window during which collected measurements are stored into the same
file before the file is closed and a new file is opened.
The time-period must be a multiple of the granularityPeriod.

Applicable when the file-based reporting method is supported.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:PerfMetricJob.fileReportingPeriod ],
        [ sh:datatype xsd:string ;
            sh:description """Applicable and must be present when the file-based
reporting method is supported, and the files are stored on the
MnS consumer.""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:PerfMetricJob.fileLocation ] ;
    sh:targetClass gnbdu3gpp:PerfMetricJob .

gnbdu3gpp-shapes:RimRSReportConf a sh:NodeShape ;
    sh:property [ sh:description """Used to enable or disable the RS report on a gNB.
If the indication is 'enable', the gNB starts to periodically report
necessary information derived from the detected RIM-RS to OAM.
If the indication is 'disable', the gNB stops reporting.""" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:RimRSReportConf.reportIndicator ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description "Used to define reporting interval of a gNB in ms." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:RimRSReportConf.reportInterval ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Used to define the maximum number of RIMRSReportInfo in
a single report.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:RimRSReportConf.nrofRIMRSReportInfo ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Used to define the maximum reported OFDM symbol number for
the propagation delay of the detected RIM-RS in each RIMRSReportInfo.

allowedValues: 0, 1..20**2*maxNrofSymbols-1, where maxNrofSymbols=14.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:RimRSReportConf.maxPropagationDelay ],
        [ sh:class gnbdu3gpp:RimRSReportInfo ;
            sh:description """Represents a list (the length of the list is
nrofRIMRSReportInfo) of necessary information derived from the
detected RIM-RS.""" ;
            sh:path gnbdu3gpp:RimRSReportConf.RimRSReportInfoList ] ;
    sh:targetClass gnbdu3gpp:RimRSReportConf .

gnbdu3gpp-shapes:RimRSReportInfo a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedInt ;
            sh:description """Set ID of the detected RIM-RS
allowedValues: 0,1...max{totalnrofSetIdofRS1, totalnrofSetIdofRS2}""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:RimRSReportInfo.detectedSetID ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """This attribute indicates the propagation delay of the
detected RIM-RS, in number of OFDM symbol.""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:RimRSReportInfo.propagationDelay ],
        [ sh:description """Indicates the functionality of the detected RIM-RS.
If the indication of enableEnoughNotEnoughIndication is 'enabled',
valid values are {RS2, RS1forEnoughMitigation,
RS1forNotEnoughMitigation};
If the indication of enableEnoughNotEnoughIndication is 'disabled',
valid values are {RS1, RS2}.

RS1forEnoughMitigation means RIM-RS type 1 is used to indicate
'enough mitigation' functionality.
RS1forNotEnoughMitigation means RIM-RS type 1 is used to indicate
'Not enough mitigation' functionality.""" ;
            sh:in ( "RS1" "RS2" "RS1_FOR_ENOUGH_MITIGATION" "RS1_FOR_NOT_ENOUGH_MITIGATION" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:RimRSReportInfo.functionalityOfRIMRS ] ;
    sh:targetClass gnbdu3gpp:RimRSReportInfo .

gnbdu3gpp-shapes:StmCtrl a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:StmCtrl.id ],
        [ sh:description """List of Network Function Distinguished Name, which
specifies the target network interface type to be monitored. If
this parameter is not present or it is empty, then all applicable
interface types from the target NF shall be monitored""" ;
            sh:path gnbdu3gpp:StmCtrl.reportingNFList ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the Uniform Resource Identifier (URI) of the STM
consumer that shall receive the monitored signalling message copies """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:StmCtrl.stmTargetUri ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:description """It is used by the STM consumer to lock or unlock the
StmCtrl instance in order to stop or start the signalling traffic
monitoring""" ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:StmCtrl.administrativeState ],
        [ sh:description "It is used by STM consumer to report its working state" ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:StmCtrl.operationalState ],
        [ sh:class stm3gpp:NetworkInterface ;
            sh:description """List of network interface to be monitored. If this
parameter is not present or it is empty, then all Network Functions
within the SubNetwork or ManagedElement shall be monitored. This
parameter shall be omitted if the STM control object is specified
under a ManagedFunction. """ ;
            sh:path gnbdu3gpp:StmCtrl.targetInterfaceInfoList ] ;
    sh:targetClass gnbdu3gpp:StmCtrl .

gnbdu3gpp-shapes:SupportedPerfMetricGroups a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Performance metrics include measurements defined in
TS 28.552 and KPIs defined in TS 28.554.

Measurements are identified by name.

For measurements defined in TS 28.552 the name is constructed as
the bullet e) of the measurement definition.

For KPIs defined in TS 28.554 the name is defined in the KPI
definitions template as the component designated with e).

For non-3GPP specified measurements the name is defined
elsewhere.""" ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:SupportedPerfMetricGroups.performanceMetrics ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Granularity periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path gnbdu3gpp:SupportedPerfMetricGroups.granularityPeriods ],
        [ sh:in ( "FILE_BASED_LOC_SET_BY_PRODUCER" "FILE_BASED_LOC_SET_BY_CONSUMER" "STREAM_BASED" ) ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:SupportedPerfMetricGroups.reportingMethods ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path gnbdu3gpp:SupportedPerfMetricGroups.reportingPeriods ] ;
    sh:targetClass gnbdu3gpp:SupportedPerfMetricGroups .

gnbdu3gpp-shapes:ThresholdMonitor a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:ThresholdMonitor.id ],
        [ sh:description "Enables or disables the ThresholdMonitor." ;
            sh:in ( "LOCKED" "UNLOCKED" ) ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:ThresholdMonitor.administrativeState ],
        [ sh:description "Indicates whether the ThresholdMonitor is working." ;
            sh:in ( "DISABLED" "ENABLED" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:ThresholdMonitor.operationalState ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """ Granularity period used to monitor measurements for
threshold crossings. """ ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:ThresholdMonitor.monitorGranularityPeriod ],
        [ sh:path gnbdu3gpp:ThresholdMonitor.objectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:description """Each object instance designates the root of a subtree that
contains the root object and all descendant objects.""" ;
            sh:path gnbdu3gpp:ThresholdMonitor.rootObjectInstances ;
            sh:pattern "[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?(,[A-Z][^,=+<>#;\\\\\"\\r\\n*.]*=([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2}))(([^,=+<>#;\\\\\"\\r\\n*]|(\\\\[a-fA-F0-9]{2}))*([^,=+<>#;\\\\\"\\r\\n* ]|(\\\\[a-fA-F0-9]{2})))?)*" ],
        [ sh:class meas3gpp:ThresholdInfo ;
            sh:description "List of threshold info." ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:ThresholdMonitor.thresholdInfoList ] ;
    sh:targetClass gnbdu3gpp:ThresholdMonitor .

gnbdu3gpp-shapes:TraceJob a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:description """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.id ],
        [ sh:description """It specifies whether the
TraceJob represents only MDT, Trace, RLF, RCEF, RRC or 5GC UE
level measurements job, or a combined job. It also defines the
MDT mode.""" ;
            sh:in ( "IMMEDIATE_MDT_ONLY" "LOGGED_MDT_ONLY" "TRACE_ONLY" "IMMEDIATE_MDT_AND_TRACE" "RLF_REPORT_ONLY" "RCEF_REPORT_ONLY" "LOGGED_MBSFN_MDT" "5GC_UE_LEVEL_MEASUREMENTS_ONLY" "TRACE_AND_5GC_UE_LEVEL_MEASUREMENTS" "IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "TRACE_AND_IMMEDIATE_MDT_AND_5GC_UE_LEVEL_MEASUREMENTS" "RRC_REPORT" "IMMEDIATE_MDT_AND_LOGGED_MDT" ) ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.jobType ],
        [ sh:class gnbdu3gpp:traceTarget ;
            sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.
In case of management based Immediate MDT, RLF reporting, RCEF
reporting or RRC reposring, the traceTarget attribute shall be null
value.""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.traceTarget ],
        [ sh:class trace3gpp:TraceConfig ;
            sh:description "Trace config" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.traceConfig ],
        [ sh:class trace3gpp:MdtConfig ;
            sh:description """This <<dataType>> defines the configuration parameters of
IOC TraceJob which are specific for MDT or any combination of MDT.
The attribute anonymizationOfMdtData specifies the level of
anonymization of MDT data.
The optional attribute areaScopedefines the area scope of MDT, which
is specified in clause 5.10.2 of TS 32.422.
The attribute sensorInformation allows to specify the sensor
information to include.
The attribute trsrPrefixCfg contains the TRSR prefix
configuration parameters which shall be used by the NR-RAN nodes
during TRSR assignment for a C-MDT job.
Based on the value configured for attribute jobType in IOC TraceJob,
the attributes immediateMdtConfig or loggedMdtConfig or both are
available: If the attribute jobType indictes immediate MDT, the
attribute immediateMdtConfig is applicable. If the attribute jobType
indictes logged MDT or logged MBSFN MDT, the attribute loggedMdtConfig
is applicable. If the attribute jobType indictes both immediate MDT
and logged MDT, both the attribute immediateMdtConfig and the
attribute loggedMdtConfig are applicable.
The optional attribute plmnList allows to specify the PLMNs where
measurements collection, status indication and log reporting is
allowed. For NTN MDT, if the list of plmnList is included, it will
only log measurements for the cells belonging to the listed PLMNs.""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.mdtConfig ],
        [ sh:class trace3gpp:UECoreMeasConfig ;
            sh:description "5GC UE level measurements config" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.ueCoreMeasConfig ],
        [ sh:class types3gpp:NpnId ;
            sh:description """applicable only for NR and shall be present in case of NPN
either a PNI-NPN or a SNPN) and for management-based activation when
several NPNs are supported in the RAN.""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.nPNTarget ],
        [ sh:description "Specifies the RRC reports requested. " ;
            sh:in ( "RLF_REPORT" "RCEF_REPORT" "SHR" "SPR" "MHI" "RA_REPORT" ) ;
            sh:path gnbdu3gpp:TraceJob.rrcReportType ],
        [ sh:datatype xsd:string ;
            sh:description """List of trace metrics identified by name.
Includes trace messages, MDT measurements (Immediate MDT,
Logged MDT, Logged MBSFN MDT), RLF, RCEF and RRC reports,
see TS 32.422 Trace messages are identified with their message
identifier. Trace metric identifier is constructed as defined
in clause 10 of TS 32.422.
For non-3GPP specified trace metrics the name is defined elsewhere.
""" ;
            sh:path gnbdu3gpp:TraceJob.listOfTraceMetrics ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the address of the Trace Collection Entity
when the attribute traceReportingFormat is configured for the
file-based reporting. The attribute is applicable for both Trace and
MDT.""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.traceCollectionEntityIPAddress ],
        [ sh:datatype xsd:string ;
            sh:description """URI of the Streaming Trace data reporting MnS consumer
(a.k.a. streaming target).""" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.traceReportingConsumerUri ;
            sh:pattern "[a-z][a-z0-9+.-]*:.*" ],
        [ sh:datatype xsd:string ;
            sh:description "Identifier of a TraceJob" ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.jobId ],
        [ sh:description """Specifies the trace reporting format - streaming trace
reporting or file-based trace reporting""" ;
            sh:in ( "FILE_BASED" "STREAMING" ) ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:TraceJob.traceReportingFormat ],
        [ sh:class gnbdu3gpp:pLMNTarget ;
            sh:description """It specifies which PLMN that the subscriber of the session to
be recorded uses as selected PLMN.""" ;
            sh:path gnbdu3gpp:TraceJob.pLMNTarget ],
        [ sh:class trace3gpp:TraceReference ;
            sh:description """A globally unique identifier, which uniquely identifies the
Trace Session that is created by the TraceJob.
In case of shared network, it is the MCC and MNC of the Participating
Operator that request the trace session that shall be provided.
The attribute is applicable for both Trace and MDT.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:TraceJob.traceReference ] ;
    sh:targetClass gnbdu3gpp:TraceJob .

gnbdu3gpp-shapes:pLMNTarget a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:pLMNTarget.mcc ;
            sh:pattern "[02-79][0-9][0-9]" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path gnbdu3gpp:pLMNTarget.mnc ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass gnbdu3gpp:pLMNTarget .

gnbdu3gpp-shapes:traceTarget a sh:NodeShape ;
    sh:property [ sh:description """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
            sh:in ( "IMSI" "IMEI" "IMEISV" "PUBLIC_ID" "UTRAN_CELL" "E_UTRAN_CELL" "NG_RAN_CELL" "ENB" "RNC" "GNB" "SUPI" "N4_SESSION_ID" ) ;
            sh:maxCount 1 ;
            sh:path gnbdu3gpp:traceTarget.traceTargetType ],
        [ sh:datatype xsd:string ;
            sh:description """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
            sh:path gnbdu3gpp:traceTarget.traceTargetValueList ] ;
    sh:targetClass gnbdu3gpp:traceTarget .

<https://semantics.ericsson.com/yang/_3gpp-nr-nrm-gnbdufunction> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-gnbdufunction" ;
    dcterms:description """Defines the YANG mapping of the GNBDUFunction Information
Object Class (IOC) that is part of the NR Network Resource Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-gnbdufunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-08-15 (CR-1598 CR-1558)" ;
    y2r:yangModuleName "_3gpp-nr-nrm-gnbdufunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-nr-nrm-gnbdufunction> .

