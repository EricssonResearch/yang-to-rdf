beam3gpp:Beam.beamAzimuth a rdf:Property ;
    rdfs:label "Beam.beamAzimuth" ;
    rdfs:comment """The azimuth of a beam transmission, which means the
horizontal beamforming pointing angle (beam peak direction) in the
Phi-axis in 1/10th degree resolution. The pointing angle is the
direction equal to the geometric centre of the half-power contour
of the beam relative to the reference plane. Zero degree implies
explicit antenna bearing (boresight). Positive angle implies clockwise
from the antenna bearing.""" ;
    rdfs:domain beam3gpp:Beam ;
    rdfs:range xsd:int .

beam3gpp:Beam.beamHorizWidth a rdf:Property ;
    rdfs:label "Beam.beamHorizWidth" ;
    rdfs:comment """ The Horizontal beamWidth of a beam transmission, which
means the horizontal beamforming half-power (3dB down) beamwidth in the
Phi-axis in 1/10th degree resolution.""" ;
    rdfs:domain beam3gpp:Beam ;
    rdfs:range xsd:int .

beam3gpp:Beam.beamIndex a rdf:Property ;
    rdfs:label "Beam.beamIndex" ;
    rdfs:comment "Index of the beam. " ;
    rdfs:domain beam3gpp:Beam ;
    rdfs:range xsd:int .

beam3gpp:Beam.beamTilt a rdf:Property ;
    rdfs:label "Beam.beamTilt" ;
    rdfs:comment """The tilt of a beam transmission, which means the vertical
beamforming pointing angle (beam peak direction) in the Theta-axis in
1/10th degree resolution.
The pointing angle is the direction equal to the geometric centre of
the half-power contour of the beam relative to the reference plane.
Positive value implies downtilt.""" ;
    rdfs:domain beam3gpp:Beam ;
    rdfs:range xsd:int .

beam3gpp:Beam.beamType a rdf:Property ;
    rdfs:label "Beam.beamType" ;
    rdfs:comment "The type of the beam. " ;
    rdfs:domain beam3gpp:Beam ;
    rdfs:range xsd:string .

beam3gpp:Beam.beamVertWidth a rdf:Property ;
    rdfs:label "Beam.beamVertWidth" ;
    rdfs:comment """ The Vertical beamWidth of a beam transmission, which means
the vertical beamforming half-power (3dB down) beamwidth in the
Theta-axis in 1/10th degree resolution.""" ;
    rdfs:domain beam3gpp:Beam ;
    rdfs:range xsd:int .

beam3gpp:Beam.id a rdf:Property ;
    rdfs:label "Beam.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain beam3gpp:Beam ;
    rdfs:range xsd:string .

