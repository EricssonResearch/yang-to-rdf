@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> a rdfs:Class ;
    rdfs:comment """Represents the per-Beam information required for,
e.g. beam performance management utilizing measurements generated in
the RAN. Can have spatial attributes of horizontal/azimuth
(ie: Phi-axis) and vertical/tilt (ie: Theta-axis) beam pointing
direction and beam width attributes.""" .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam> a owl:Ontology ;
    owl:versionInfo "revision 2023-09-18 (CR-1043)" .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamAzimuth> a rdf:Property ;
    rdfs:comment """The azimuth of a beam transmission, which means the
horizontal beamforming pointing angle (beam peak direction) in the
Phi-axis in 1/10th degree resolution. The pointing angle is the
direction equal to the geometric centre of the half-power contour
of the beam relative to the reference plane. Zero degree implies
explicit antenna bearing (boresight). Positive angle implies clockwise
from the antenna bearing.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamHorizWidth> a rdf:Property ;
    rdfs:comment """ The Horizontal beamWidth of a beam transmission, which
means the horizontal beamforming half-power (3dB down) beamwidth in the
Phi-axis in 1/10th degree resolution.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamIndex> a rdf:Property ;
    rdfs:comment "Index of the beam. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamTilt> a rdf:Property ;
    rdfs:comment """The tilt of a beam transmission, which means the vertical
beamforming pointing angle (beam peak direction) in the Theta-axis in
1/10th degree resolution.
The pointing angle is the direction equal to the geometric centre of
the half-power contour of the beam relative to the reference plane.
Positive value implies downtilt.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamType> a rdf:Property ;
    rdfs:comment "The type of the beam. " ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/beamVertWidth> a rdf:Property ;
    rdfs:comment """ The Vertical beamWidth of a beam transmission, which means
the vertical beamforming half-power (3dB down) beamwidth in the
Theta-axis in 1/10th degree resolution.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:int .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-beam/Beam> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-beam/BeamType> a rdfs:Datatype .

