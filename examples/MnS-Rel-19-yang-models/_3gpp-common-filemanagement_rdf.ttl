filemgmt3gpp:jobMonitor.startTime a rdf:Property ;
    rdfs:label "jobMonitor.startTime" ;
    rdfs:comment """Start time of the associated process, i.e. the time when the
status changed from 'NOT_STARTED' to 'RUNNING'.""" ;
    rdfs:domain filemgmt3gpp:jobMonitor ;
    rdfs:range xsd:string .

filemgmt3gpp:jobMonitor.status a rdf:Property ;
    rdfs:label "jobMonitor.status" ;
    rdfs:comment "Status must not be 'PARTIALLY_FAILED'." ;
