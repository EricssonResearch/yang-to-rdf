@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> a rdfs:Class ;
    rdfs:comment "Specifies the FileDownloadJob IOC, see 3GPP TS 28.622." ;
    nrm:hasAttribute <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> a rdfs:Class ;
    rdfs:comment "Provides monitoring for the file download job." .

<urn:3gpp:sa5:_3gpp-common-filemanagement> a owl:Ontology ;
    owl:versionInfo "revision 2024-11-07 (CR-0474)" .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/cancelJob> a rdf:Property ;
    rdfs:comment """Setting this attribute to TRUE cancels the file download job.
As specified in the definition of ProcessMonitor, cancellation is
possible in the NOT_STARTED and RUNNING state. Setting the attribute
to FALSE has no observable result.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range xsd:boolean .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/fileLocation> a rdf:Property ;
    rdfs:comment """Location of the file incl. the file transfer protocol,
and the file name for the case the file content cannot be retrieved
by reading the 'fileContent' attribute.

The allowed file transfer protocols are:
- sftp
- ftpes
- https

Examples:
'sftp://companyA.com/datastore/fileName.xml',
'https://companyA.com/ManagedElement=1/Files=1/File=1'
""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/id> a rdf:Property ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/jobMonitor> a owl:ObjectProperty ;
    rdfs:comment "Provides monitoring for the file download job." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> .

<urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob/notificationRecipientAddress> a rdf:Property ;
    rdfs:comment "Address of the notification recipient." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/FileDownloadJob> ;
    rdfs:range xsd:string ;
    nrm:isInvariant true .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/endTime> a rdf:Property ;
    rdfs:comment """Date and time when status changed to 'SUCCESS', 'CANCELLED',
'FAILED' or 'PARTIALLY_FAILED'.

If the time is in the future, it is the estimated time
the process will end.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/id> a rdf:Property ;
    rdfs:comment """Id of the process. It is unique within a single
multivalue attribute of type ProcessMonitor.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/progressPercentage> a rdf:Property ;
    rdfs:comment "Progress of the associated process as percentage" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/progressStateInfo> a rdf:Property ;
    rdfs:comment """Additional textual qualification of the states
'NOT_STARTED', 'CANCELLING' and 'RUNNING'.

For specific processes, specific well-defined strings (e.g. string
patterns or enums) may be defined as a specialisation.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/resultStateInfo> a rdf:Property ;
    rdfs:comment """If status is FAILED resultStateInfo will be one of
the following or empty.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/startTime> a rdf:Property ;
    rdfs:comment """Start time of the associated process, i.e. the time when the
status changed from 'NOT_STARTED' to 'RUNNING'.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/status> a rdf:Property ;
    rdfs:comment "Status must not be 'PARTIALLY_FAILED'." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor/timer> a rdf:Property ;
    rdfs:comment """Time until the associated process is automatically cancelled.
If set, the system decreases the timer with time. When it reaches zero
the cancellation of the associated process is initiated by the
MnS_Producer.
If not set, there is no time limit for the process.

Once the timer is set, the consumer can not change it anymore.
If the consumer has not set the timer the MnS Producer may set it.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-common-filemanagement/jobMonitor> ;
    rdfs:range xsd:unsignedInt .

