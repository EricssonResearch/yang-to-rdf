        [ sh:class <urn:3gpp:sa5:_3gpp-ns-nrm-common/ServAttrCom> ;
            sh:description """This list represents the common properties of service
requirement related attributes.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-ns-nrm-networkslicesubnet/termDensity/servAttrCom> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-ns-nrm-networkslicesubnet/termDensity> .

