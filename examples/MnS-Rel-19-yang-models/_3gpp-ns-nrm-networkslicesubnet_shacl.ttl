            sh:path nss3gpp:TopSliceSubnetProfile.survivalTime ] ;
    sh:targetClass nss3gpp:TopSliceSubnetProfile .

nss3gpp-shapes:delayTolerance a sh:NodeShape ;
    sh:property [ sh:description """An attribute specifies whether or not the network
