            sh:maxCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.termDensity ],
        [ sh:class types3gpp:Tai ;
            sh:description "A list of TrackingAreas where the NSI can be selected." ;
            sh:minCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.coverageAreaTAList ],
        [ sh:class nss3gpp:deterministicComm ;
            sh:description """This list represents the properties of the deterministic
