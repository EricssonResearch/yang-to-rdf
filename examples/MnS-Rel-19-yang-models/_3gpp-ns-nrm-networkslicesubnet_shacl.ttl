nss3gpp-shapes:TopSliceSubnetProfile a sh:NodeShape ;
    sh:property [ sh:datatype xsd:unsignedShort ;
            sh:description """The packet transmission latency (milliseconds) through
the RAN, CN, and TN part of 5G network, used to evaluate
utilization performance of the end-to-end network slice instance.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.latency ],
        [ sh:datatype xsd:unsignedLong ;
            sh:description """Specifies the maximum number of UEs may simultaneously
access the network slice instance.""" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.maxNumberofUEs ],
        [ sh:class ns3cmn3gpp:XLThpt ;
            sh:description """This attribute defines achievable data rate of the
network slice subnet in downlink that is available ubiquitously
across the coverage area of the slice""" ;
            sh:maxCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.dLThptPerSliceSubnet ],
        [ sh:class ns3cmn3gpp:XLThpt ;
            sh:description """This attribute defines data rate supported by the
network slice per UE, refer NG.116.""" ;
            sh:maxCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.dLThptPerUE ],
        [ sh:class ns3cmn3gpp:XLThpt ;
            sh:description """This attribute defines achievable data rate of the
network slice subnet in uplink that is available ubiquitously
across the coverage area of the slice""" ;
            sh:maxCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.uLThptPerSliceSubnet ],
        [ sh:class ns3cmn3gpp:XLThpt ;
            sh:description """This attribute defines data rate supported by the
network slice per UE, refer NG.116""" ;
            sh:maxCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.uLThptPerUE ],
        [ sh:class nss3gpp:maxPktSize ;
            sh:description """This parameter specifies the maximum packet size
supported by the network slice""" ;
            sh:maxCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.maxPktSize ],
        [ sh:class nss3gpp:maxNumberofPDUSessions ;
            sh:description """Represents the maximum number of
concurrent PDU sessions supported by the network slice""" ;
            sh:maxCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.maxNumberofPDUSessions ],
        [ sh:class nss3gpp:delayTolerance ;
            sh:description """An attribute specifies the properties of service delivery
flexibility, especially for the vertical services that are not
chasing a high system performance.""" ;
            sh:maxCount 1 ;
            sh:path nss3gpp:TopSliceSubnetProfile.delayTolerance ],
        [ sh:class nss3gpp:termDensity ;
            sh:description """An attribute specifies the overall user density over
