<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges/end> a rdf:Property ;
    rdfs:label "end" ;
    rdfs:comment """This attribute indicates the last value identifying
the end of a IMSI range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges/id> a rdf:Property ;
    rdfs:label "id" ;
    rdfs:comment "Unique identifier for the IMSI range." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges/pattern> a rdf:Property ;
    rdfs:label "pattern" ;
    rdfs:comment """This attribute indicates pattern (regular expression
according to the ECMA-262 dialect [75]) representing the set of
IMSIs belonging to this range. An IMSI value is considered part
of the range if and only if the IMSI string fully matches the
regular expression.Either the start and end attributes, or the
pattern attribute, shall be present.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges/start> a rdf:Property ;
    rdfs:label "start" ;
    rdfs:comment """This attribute indicates the first value identifying
the start of a IMSI range. """ ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/imsiRanges> ;
    rdfs:range xsd:string .

