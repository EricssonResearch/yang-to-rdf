    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress/id> a rdf:Property ;
