<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList/sd> a rdf:Property ;
    rdfs:label "sd" ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
