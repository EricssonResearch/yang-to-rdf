<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress/realm> a rdf:Property ;
    rdfs:label "realm" ;
    rdfs:comment """This attribute indicates the Diameter realm of the
network node diameter addres. See TS 29.571 [61]. String contains
a Diameter Identity (FQDN).""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/hssDiameterAddress> ;
    rdfs:range xsd:string .

