<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges/end> a rdf:Property ;
    rdfs:label "end" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges> ;
