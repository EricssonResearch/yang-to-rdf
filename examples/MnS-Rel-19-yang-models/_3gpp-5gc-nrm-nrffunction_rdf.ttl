    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList/mcc> a rdf:Property ;
    rdfs:label "mcc" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/pLMNInfoList/mnc> a rdf:Property ;
