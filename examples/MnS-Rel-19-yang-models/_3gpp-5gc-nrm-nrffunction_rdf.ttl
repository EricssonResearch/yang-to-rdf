<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssai/sd> a rdf:Property ;
    rdfs:label "sd" ;
    rdfs:comment """Slice Differentiator
If not needed, the value can be set to ff:ff:ff.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssai> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssai/sst> a rdf:Property ;
    rdfs:label "sst" ;
    rdfs:comment """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssai> ;
    rdfs:range xsd:unsignedByte .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssaiSmfInfoList/dnnSmfInfoList> a owl:ObjectProperty ;
    rdfs:label "dnnSmfInfoList" ;
    rdfs:comment """List of parameters supported by the SMF per DNN.
The absence indicates the DNN can be selected for any DNAI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssaiSmfInfoList> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/dnnSmfInfoList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssaiSmfInfoList/sNssai> a owl:ObjectProperty ;
    rdfs:label "sNssai" ;
    rdfs:comment "Supported S-NSSAI." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssaiSmfInfoList> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/sNssai> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/served5gDdnmfInfo/nfInstanceId> a rdf:Property ;
    rdfs:label "nfInstanceId" ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/served5gDdnmfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/served5gDdnmfInfo/plmnId> a owl:ObjectProperty ;
    rdfs:label "plmnId" ;
    rdfs:comment """PLMN ID for which list of supported S-NSSAI(s)
is provided.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/served5gDdnmfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/dnnList> a rdf:Property ;
    rdfs:label "dnnList" ;
    rdfs:comment """List of DNNs handled by the BSF
If not provided, the BSF can serve any DNN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/ipDomainList> a rdf:Property ;
    rdfs:label "ipDomainList" ;
    rdfs:comment """List of IPv4 address domains, as described in
subclause 6.2 of 3GPP TS 29.513, handled by the BSF.
If not provided, the BSF can serve any IP domain.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/ipv4AddressRanges> a owl:ObjectProperty ;
    rdfs:label "ipv4AddressRanges" ;
    rdfs:comment """List of ranges of IPv4 addresses handled by BSF.
If not provided, the BSF can serve any IPv4 address.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/ipv6PrefixRanges> a owl:ObjectProperty ;
    rdfs:label "ipv6PrefixRanges" ;
    rdfs:comment """List of ranges of IPv6 prefixes handled by the BSF.
If not provided, the BSF can serve any IPv6 prefix.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo/nfInstanceId> a rdf:Property ;
    rdfs:label "nfInstanceId" ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedBsfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/gpsiRangeList> a owl:ObjectProperty ;
    rdfs:label "gpsiRangeList" ;
    rdfs:comment """List of ranges of GPSI that can be served
by the CHF instance. If not provided, the CHF can serve any GPSI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/nfInstanceId> a rdf:Property ;
    rdfs:label "nfInstanceId" ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/plmnRangeList> a owl:ObjectProperty ;
    rdfs:label "plmnRangeList" ;
    rdfs:comment """List of ranges of PLMNs (including the PLMN
IDs of the CHF instance) that can be served by the CHF instance.
If not provided, the CHF can serve any PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/plmnRangeList> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/primaryChfInstance> a rdf:Property ;
    rdfs:label "primaryChfInstance" ;
    rdfs:comment """This attribute represents the NF Instance Id of the
primary CHF instance. This attribute shall be absent if the
secondaryChfInstance is present.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/secondaryChfInstance> a rdf:Property ;
    rdfs:label "secondaryChfInstance" ;
    rdfs:comment """This attribute represents the NF Instance Id of the
secondary CHF instance.This attribute shall be absent if the
primaryChfInstance is present.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo/supiRangeList> a owl:ObjectProperty ;
    rdfs:label "supiRangeList" ;
    rdfs:comment """List of ranges of SUPIs that can be served by
the CHF instance. If not provided, the CHF can serve any SUPI.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedChfInfo> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-managed-nfprofile/SupiRange> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges/mcc> a rdf:Property ;
    rdfs:label "mcc" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges/mnc> a rdf:Property ;
    rdfs:label "mnc" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/accessType> a rdf:Property ;
    rdfs:label "accessType" ;
    rdfs:comment """It provides the condition of access type of the UE when
the session AMBR shall be enforced, see TS 29.512 [60].If this
attribute is included in SmfInfo, it shall contain the access type
(3GPP_ACCESS and/or NON_3GPP_ACCESS) supported by the SMF.If not
included, it shall be assumed the both access types are supported.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/dnnList> a rdf:Property ;
    rdfs:label "dnnList" ;
    rdfs:comment """It represents the DNNs supported by the PCF. The DNN,
as defined in clause 9A of TS 23.003 [13], shall contain the Network
Identifier and it may additionally contain an Operator Identifier,
as specified in TS 23.003 [13] clause 9.1.1 and 9.1.2. If the Operator
Identifier is not included, the DNN is supported for all the PLMNs in
the plmnList of the NF Profile.If not provided, the PCF can serve any
DNN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/gmFqdn> a rdf:Property ;
    rdfs:label "gmFqdn" ;
    rdfs:comment """This attribute represents FQDN of the P-CSCF for the Gm
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/gmIpv4Addresses> a rdf:Property ;
    rdfs:label "gmIpv4Addresses" ;
    rdfs:comment """This attribute represents list of IPv4 addresses of of
the P-CSCF for the Gm interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/gmIpv6Addresses> a rdf:Property ;
    rdfs:label "gmIpv6Addresses" ;
    rdfs:comment """This attribute represents list of IPv6 addresses of of the
P-CSCF for the Gm interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/mwFqdn> a rdf:Property ;
    rdfs:label "mwFqdn" ;
    rdfs:comment """This attribute represents FQDN of the P-CSCF for the Mw
interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/mwIpv4Addresses> a rdf:Property ;
    rdfs:label "mwIpv4Addresses" ;
    rdfs:comment """List of ranges of PLMNs (including the PLMN
IDs of the CHF instance) that can be served by the CHF instance.
If not provided, the CHF can serve any PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/mwIpv6Addresses> a rdf:Property ;
    rdfs:label "mwIpv6Addresses" ;
    rdfs:comment """This attribute represents list of IPv4 addresses of
the P-CSCF for the Mw interface.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/nfInstanceId> a rdf:Property ;
    rdfs:label "nfInstanceId" ;
    rdfs:comment "String uniquely identifying a NF instance." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList/servedIpv4AddressRanges> a owl:ObjectProperty ;
    rdfs:label "servedIpv4AddressRanges" ;
    rdfs:comment """List of ranges of PLMNs (including the PLMN
IDs of the CHF instance) that can be served by the CHF instance.
If not provided, the CHF can serve any PLMN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedPcscfInfoList> ;
    rdfs:range <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/servedIpv4AddressRanges> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget/traceTargetType> a rdf:Property ;
    rdfs:label "traceTargetType" ;
    rdfs:comment """It specifies the target object of the Trace, MDT and
5GC UE level measurements collection. The attribute is applicable for
Trace, MDT, and 5GC UE level measurements collection.

The targetIdType shall be PUBLIC_ID in case of a Management Based
Activation is done to an SCSCFFunction (Serving Call Session Control
Function) or PCSCFFunction (Proxy Call Session Control Function)

The targetIdType shall be UTRAN_CELL only in case of
UTRAN cell traffic trace function.

The targetIdType shall be E-UTRAN_CELL only in case of E-UTRAN cell
traffic trace function.

The targetIdType shall be NG-RAN_CELL only in case of NR cell
traffic trace function.

The targetIdType shall be either IMSI, IMEI or
IMEISV if the Trace Session is activated to any of the following
ManagedEntity(ies):
- HssFunction
- MscServerFunction
- SgsnFunction
- GgsnFunction
- BmscFunction
- RncFunction
- MmeFunction
- ServingGWFunction
- PGWFunction

The targetIdType shall be either SUPI or IMEISV if the Trace Session
is activated to any of the following ManagedEntity(ies):
- AFFunction
- AMFFunction
- AUSFunction
- NEFFunction
- NRFFunction
- NSSFFunction
- PCFFunction
- SMFFunction
- UPFFunction
- UDMFunction

In case of signalling based MDT, the targetIdType shall be
able to carry PUBLIC_ID, IMSI, IMEI, IMEISV or SUPI.

In case of management based Logged MDT, the targetIdType
shall carry an eNB or a gNB or an RNC.
The Logged MDT should be initiated on the specified eNB/gNB/RNC in
targetIdValueList.

In case of signalling based 5GC UE level measurements collection,
the targetIdTypee shall be able to carry IMEISV or SUPI.

In case of management based 5GC UE level measurements collection,
the targetIdType shall be able to carry the corresponding
Measured UE Identifier as defined by the bullet g) of the 5GC UE
level measurements (see TS 28.558) when the TraceJob is created at
the subject ManagedEntity.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget/traceTargetValueList> a rdf:Property ;
    rdfs:label "traceTargetValueList" ;
    rdfs:comment """It specifies the ID value(s) of the target object defined
by traceTargetType""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/traceTarget> ;
    rdfs:range xsd:string .

