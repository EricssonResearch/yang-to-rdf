    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRangeList> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/gpsiRanges/end> a rdf:Property ;
