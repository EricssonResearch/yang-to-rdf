    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/ipv6PrefixRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges/end> a rdf:Property ;
    rdfs:label "end" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges/id> a rdf:Property ;
    rdfs:label "id" ;
    rdfs:comment "Unique identifier for the IMSI range." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-5gc-nrm-nrffunction/msisdnRanges/pattern> a rdf:Property ;
