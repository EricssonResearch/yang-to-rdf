    y2r:inferredBy "dn-name-suffix" .

udm3gpp:PerfMetricJob.schedulerRef rdfs:range util3gpp:Scheduler ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

udm3gpp:StmCtrl.reportingNFList y2r:candidate "ReportingNF" ;
