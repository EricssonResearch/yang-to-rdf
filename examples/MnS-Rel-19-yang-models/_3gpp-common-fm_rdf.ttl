@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fm3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-fm#> .
@prefix me3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-managed-element#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

fm3gpp:AlarmComment a rdfs:Class ;
    rdfs:label "AlarmComment" ;
    rdfs:comment "List of comments and data about the comments." .

fm3gpp:AlarmRecord a rdfs:Class ;
    rdfs:label "AlarmRecord" ;
    rdfs:comment "List of alarmRecords" ;
    y2r:hasAttribute fm3gpp:AlarmComment,
        fm3gpp:ThresholdCrossing,
        me3gpp:additionalInformation,
        me3gpp:correlatedNotifications,
        me3gpp:monitoredAttributes,
        me3gpp:stateChangeDefinition .

fm3gpp:ThresholdCrossing a rdfs:Class ;
    rdfs:label "ThresholdCrossing" ;
    rdfs:comment "Indicates the crossed threshold" ;
    y2r:hasAttribute fm3gpp:ThresholdLevelInd .

fm3gpp:ThresholdHysteresis a rdfs:Class ;
    rdfs:label "ThresholdHysteresis" ;
    rdfs:comment """Indicates for counter and gauge thresholds that the
threshold crossing occurred when going up.""" .

fm3gpp:ThresholdLevelInd a rdfs:Class ;
    rdfs:label "ThresholdLevelInd" ;
    rdfs:comment """In the case of a gauge the threshold level specifies
a pair of threshold values, the first being the value of the crossed
threshold and the second, its corresponding hysteresis; in the case
of a counter the threshold level specifies only the threshold value
(Rec. ITU-T X. 733).""" ;
    y2r:hasAttribute fm3gpp:ThresholdHysteresis .

<https://semantics.ericsson.com/yang/_3gpp-common-fm> a owl:Ontology ;
    rdfs:label "_3gpp-common-fm" ;
    dcterms:description """Defines a Fault Management model
Copyright 2026, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.111" ;
    dcterms:title "_3gpp-common-fm" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2026-01-25 (CR-0060)" ;
    y2r:yangModuleName "_3gpp-common-fm" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-common-fm> .

fm3gpp:AlarmComment.commentSystemId a rdf:Property ;
    rdfs:label "AlarmComment.commentSystemId" ;
    rdfs:comment """It carries the identification of the system (
Management System) from which the comment is made. That system
supports the user that made the comment.""" ;
    rdfs:domain fm3gpp:AlarmComment ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

fm3gpp:AlarmComment.commentText a rdf:Property ;
    rdfs:label "AlarmComment.commentText" ;
    rdfs:comment "It carries the textual comment." ;
    rdfs:domain fm3gpp:AlarmComment ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

fm3gpp:AlarmComment.commentTime a rdf:Property ;
    rdfs:label "AlarmComment.commentTime" ;
    rdfs:comment "Date and Time the comment was created." ;
    rdfs:domain fm3gpp:AlarmComment ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

fm3gpp:AlarmComment.commentUserId a rdf:Property ;
    rdfs:label "AlarmComment.commentUserId" ;
    rdfs:comment """It carries the identification of the user who made the
comment.""" ;
    rdfs:domain fm3gpp:AlarmComment ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

fm3gpp:AlarmRecord.ackState a rdf:Property ;
    rdfs:label "AlarmRecord.ackState" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.ackSystemId a rdf:Property ;
    rdfs:label "AlarmRecord.ackSystemId" ;
    rdfs:comment """It identifies the system (Management System) that last
changed the ackState of an alarm, i.e. acknowledged or unacknowledged
the alarm.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.ackTime a rdf:Property ;
    rdfs:label "AlarmRecord.ackTime" ;
    rdfs:comment """It identifies the time when the alarm has been
acknowledged or unacknowledged the last time, i.e. it registers the
time when ackState changes.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.ackUserId a rdf:Property ;
    rdfs:label "AlarmRecord.ackUserId" ;
    rdfs:comment """It identifies the last user who has changed the
Acknowledgement State.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.additionalInformation a owl:ObjectProperty ;
    rdfs:label "AlarmRecord.additionalInformation" ;
    rdfs:comment "Vendor specific alarm information in the alarm." ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range me3gpp:additionalInformation .

fm3gpp:AlarmRecord.additionalText a rdf:Property ;
    rdfs:label "AlarmRecord.additionalText" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.alarmChangedTime a rdf:Property ;
    rdfs:label "AlarmRecord.alarmChangedTime" ;
    rdfs:comment "not applicable if related alarm has not changed" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.alarmClearedTime a rdf:Property ;
    rdfs:label "AlarmRecord.alarmClearedTime" ;
    rdfs:comment "not applicable if related alarm was not cleared" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.alarmId a rdf:Property ;
    rdfs:label "AlarmRecord.alarmId" ;
    rdfs:comment "Identifies the alarmRecord" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

fm3gpp:AlarmRecord.alarmRaisedTime a rdf:Property ;
    rdfs:label "AlarmRecord.alarmRaisedTime" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

fm3gpp:AlarmRecord.alarmType a rdf:Property ;
    rdfs:label "AlarmRecord.alarmType" ;
    rdfs:comment "General category for the alarm." ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

fm3gpp:AlarmRecord.backUpObject a owl:ObjectProperty ;
    rdfs:label "AlarmRecord.backUpObject" ;
    rdfs:comment """Backup object of the alarmed object as defined in
ITU-T Rec. X. 733""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    y2r:isReference true .

fm3gpp:AlarmRecord.backedUpStatus a rdf:Property ;
    rdfs:label "AlarmRecord.backedUpStatus" ;
    rdfs:comment """Indicates if an object (the MonitoredEntity) has a back
up. See definition in ITU-T Recommendation X.733 clause 8.1.2.4.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:boolean .

fm3gpp:AlarmRecord.clearSystemId a rdf:Property ;
    rdfs:label "AlarmRecord.clearSystemId" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.clearUserId a rdf:Property ;
    rdfs:label "AlarmRecord.clearUserId" ;
    rdfs:comment """Carries the identity of the user who invokes the
clearAlarms operation.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.clearingType a rdf:Property ;
    rdfs:label "AlarmRecord.clearingType" ;
    rdfs:comment """Indicates whether the alarm needs
to be cleared manually by the MnS consumer (ADMC)
or the producer will clear it automatically (ADAC).""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.comments a owl:ObjectProperty ;
    rdfs:label "AlarmRecord.comments" ;
    rdfs:comment "List of comments and data about the comments." ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range fm3gpp:AlarmComment .

fm3gpp:AlarmRecord.correlatedNotifications a owl:ObjectProperty ;
    rdfs:label "AlarmRecord.correlatedNotifications" ;
    rdfs:comment "List of correlated notifications" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range me3gpp:correlatedNotifications .

fm3gpp:AlarmRecord.monitoredAttributes a owl:ObjectProperty ;
    rdfs:label "AlarmRecord.monitoredAttributes" ;
    rdfs:comment """Attributes of the monitored entity and their
values at the time the alarm occurred that are of interest for the
alarm report.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range me3gpp:monitoredAttributes .

fm3gpp:AlarmRecord.notificationId a rdf:Property ;
    rdfs:label "AlarmRecord.notificationId" ;
    rdfs:comment "The Id of the last notification updating the AlarmRecord." ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:int .

fm3gpp:AlarmRecord.objectInstance a owl:ObjectProperty ;
    rdfs:label "AlarmRecord.objectInstance" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    y2r:isInvariant true ;
    y2r:isReference true .

fm3gpp:AlarmRecord.perceivedSeverity a rdf:Property ;
    rdfs:label "AlarmRecord.perceivedSeverity" ;
    rdfs:comment """This is Writable only if producer supports consumer
to set perceivedSeverity to CLEARED""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.probableCause a rdf:Property ;
    rdfs:label "AlarmRecord.probableCause" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

fm3gpp:AlarmRecord.proposedRepairActions a rdf:Property ;
    rdfs:label "AlarmRecord.proposedRepairActions" ;
    rdfs:comment """Indicates proposed repair actions. See definition in
ITU-T Recommendation X.733 clause 8.1.2.12.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.rootCauseIndicator a rdf:Property ;
    rdfs:label "AlarmRecord.rootCauseIndicator" ;
    rdfs:comment """It indicates that this AlarmInformation is the root cause
of the events captured by the notifications whose identifiers are in
the related CorrelatedNotification instances.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:boolean .

fm3gpp:AlarmRecord.securityAlarmDetector a rdf:Property ;
    rdfs:label "AlarmRecord.securityAlarmDetector" ;
    rdfs:comment """It carries the identity of the detector of the security
alarm.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.serviceProvider a rdf:Property ;
    rdfs:label "AlarmRecord.serviceProvider" ;
    rdfs:comment """It identifies the service-provider whose service is
requested by the serviceUser and the service request provokes the
generation of the security alarm.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.serviceUser a rdf:Property ;
    rdfs:label "AlarmRecord.serviceUser" ;
    rdfs:comment """It identifies the service-user whose request for service
provided by the serviceProvider led to the generation of the
security alarm.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:AlarmRecord.specificProblem a rdf:Property ;
    rdfs:label "AlarmRecord.specificProblem" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string ;
    y2r:isInvariant true .

fm3gpp:AlarmRecord.stateChangeDefinition a owl:ObjectProperty ;
    rdfs:label "AlarmRecord.stateChangeDefinition" ;
    rdfs:comment """Indicates MO attribute value changes associated with the
alarm for state attributes of the monitored entity (state transitions).
The change is reported with the name of the state attribute, the new
value and an optional old value.
See definition in ITU-T Recommendation X.733 [4] clause 8.1.2.10.""" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range me3gpp:stateChangeDefinition .

fm3gpp:AlarmRecord.thresholdInfo a owl:ObjectProperty ;
    rdfs:label "AlarmRecord.thresholdInfo" ;
    rdfs:comment "Indicates the crossed threshold" ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range fm3gpp:ThresholdCrossing .

fm3gpp:AlarmRecord.trendIndication a rdf:Property ;
    rdfs:label "AlarmRecord.trendIndication" ;
    rdfs:comment """Indicates if some observed condition is getting better,
worse, or not changing. """ ;
    rdfs:domain fm3gpp:AlarmRecord ;
    rdfs:range xsd:string .

fm3gpp:ThresholdCrossing.armTime a rdf:Property ;
    rdfs:label "ThresholdCrossing.armTime" ;
    rdfs:comment """For a gauge threshold, the time at which the threshold
was last re-armed, namely the time after the previous threshold
crossing at which the hysteresis value of the threshold was
exceeded thus again permitting generation of notifications when the
threshold is crossed. For a counter threshold, the later of the time
at which the threshold offset was last applied, or the time at
which the counter was last initialized (for resettable counters)
(Rec. ITU-T X. 733)""" ;
    rdfs:domain fm3gpp:ThresholdCrossing ;
    rdfs:range xsd:string .

fm3gpp:ThresholdCrossing.observedMeasurement a rdf:Property ;
    rdfs:label "ThresholdCrossing.observedMeasurement" ;
    rdfs:comment """The name of the monitored measurement that crossed the
threshold and that caused the notification (Rec. ITU-T X. 733 """ ;
    rdfs:domain fm3gpp:ThresholdCrossing ;
    rdfs:range xsd:string .

fm3gpp:ThresholdCrossing.observedValue a rdf:Property ;
    rdfs:label "ThresholdCrossing.observedValue" ;
    rdfs:comment """The value of the gauge or counter which crossed the
threshold. This may be different from the threshold value if, for
example, the gauge may only take on discrete values.
Integer values are used for counters and float values for gauges
(Rec. ITU-T X. 733). Note that a 'number' type property can contain
both integers and floating point numbers.""" ;
    rdfs:domain fm3gpp:ThresholdCrossing ;
    rdfs:range xsd:string .

fm3gpp:ThresholdCrossing.thresholdLevel a owl:ObjectProperty ;
    rdfs:label "ThresholdCrossing.thresholdLevel" ;
    rdfs:comment """In the case of a gauge the threshold level specifies
a pair of threshold values, the first being the value of the crossed
threshold and the second, its corresponding hysteresis; in the case
of a counter the threshold level specifies only the threshold value
(Rec. ITU-T X. 733).""" ;
    rdfs:domain fm3gpp:ThresholdCrossing ;
    rdfs:range fm3gpp:ThresholdLevelInd .

fm3gpp:ThresholdHysteresis.high a rdf:Property ;
    rdfs:label "ThresholdHysteresis.high" ;
    rdfs:comment """Higher value of a threshold with hysteresis, the integer
type is used for counter thresholds and the float type for gauge
thresholds.""" ;
    rdfs:domain fm3gpp:ThresholdHysteresis ;
    rdfs:range xsd:string .

fm3gpp:ThresholdHysteresis.low a rdf:Property ;
    rdfs:label "ThresholdHysteresis.low" ;
    rdfs:comment """Lower value of a threshold with hysteresis, applicable
only to gauge thresholds.""" ;
    rdfs:domain fm3gpp:ThresholdHysteresis ;
    rdfs:range xsd:decimal .

fm3gpp:ThresholdLevelInd.down a owl:ObjectProperty ;
    rdfs:label "ThresholdLevelInd.down" ;
    rdfs:comment """Indicates for gauge thresholds that the threshold crossing
occurred when going down, applicable only to gauge thresholds.""" ;
    rdfs:domain fm3gpp:ThresholdLevelInd ;
    rdfs:range fm3gpp:ThresholdHysteresis .

fm3gpp:ThresholdLevelInd.up a owl:ObjectProperty ;
    rdfs:label "ThresholdLevelInd.up" ;
    rdfs:comment """Indicates for counter and gauge thresholds that the
threshold crossing occurred when going up.""" ;
    rdfs:domain fm3gpp:ThresholdLevelInd ;
    rdfs:range fm3gpp:ThresholdHysteresis .

fm3gpp:eventType a rdfs:Datatype ;
    rdfs:label "eventType" ;
    rdfs:comment "General category for the alarm." .

fm3gpp:probable-causes a rdfs:Datatype ;
    rdfs:label "probable-causes" ;
    rdfs:comment "Values are from the (informative) Annex B of 3GPP TS 28.111." .

fm3gpp:severity-level a rdfs:Datatype ;
    rdfs:label "severity-level" ;
    rdfs:comment "The possible alarm severities" .

