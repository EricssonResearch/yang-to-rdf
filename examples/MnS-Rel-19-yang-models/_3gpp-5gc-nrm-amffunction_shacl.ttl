        [ sh:datatype xsd:unsignedByte ;
            sh:description """Slice/Service Type.
Values 0 to 127 belong to standardized SST range and are defined in
3GPP TS 23.501. Values 128 to 255 belong to operator-specific range.""" ;
            sh:maxCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNInfo/sst> ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNInfo> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNTargetShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNTarget/mcc> ;
