            sh:minCount 1 ;
            sh:path <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNId/mnc> ;
            sh:pattern "[0-9][0-9][0-9]|[0-9][0-9]" ] ;
    sh:targetClass <urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNId> .

<urn:3gpp:sa5:_3gpp-5gc-nrm-amffunction/pLMNInfoListShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
