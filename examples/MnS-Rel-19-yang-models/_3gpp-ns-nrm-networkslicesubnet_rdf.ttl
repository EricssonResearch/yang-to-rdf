@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns3cmn3gpp: <https://semantics.ericsson.com/yang/_3gpp-ns-nrm-common#> .
@prefix nss3gpp: <https://semantics.ericsson.com/yang/_3gpp-ns-nrm-networkslicesubnet#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix types3gpp: <https://semantics.ericsson.com/yang/_3gpp-common-yang-types#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix y2r: <https://semantics.ericsson.com/vocab#> .

nss3gpp:NetworkSliceSubnet a rdfs:Class ;
    rdfs:label "NetworkSliceSubnet" ;
    rdfs:comment """Represents the properties of a network slice subnet
instance in a 5G network.

The NetworkSliceSubnet can be categorized by following types:
- RANSliceSubne represent the RAN network slice subnet in a 5G network,
which is associated to one or multiple 'RANSliceSubnetProfile'.
- CNSliceSubnet represent the CN network slice subnet in a 5G network,
which is associated to one or multiple 'CNSliceSubnetProfile'.
- TopSliceSubnet represent the top network slice subnet in a 5G network,
which is associated to one or multiple 'TopSliceSubnetProfile'.

The attribute epTransportRef is used to specify a list of EP_Transport
instance as transport resources to be aggregated to a NetworkSliceSubnet
instance. The MnS consumer determines the EP_Transport instance(s) to
support EP_Application instances as part of the NetworkSliceSubnet
instance and request the MnS producer to configure the attribute
epTransportRef of the NetworkSliceSubnet.

The EP_Transport is name contained by SubNetwork, and an EP_Transport
instance can be a new instance created for the EP_Application instances
as part of NetworkSliceSubnet instance or an existing instance reused
for EP_Application instance.""" ;
    y2r:hasAttribute nss3gpp:NsInfo,
        nss3gpp:SliceProfile .

nss3gpp:NsInfo a rdfs:Class ;
    rdfs:label "NsInfo" ;
    rdfs:comment """This list represents the properties of network service
information corresponding to the network slice subnet instance.""" .

nss3gpp:Positioning a rdfs:Class ;
    rdfs:label "Positioning" ;
    rdfs:comment """Specifies whether the network slice provides
geo-localization methods or supporting methods""" .

nss3gpp:SliceProfile a rdfs:Class ;
    rdfs:label "SliceProfile" ;
    rdfs:comment """List of SliceProfiles supported by the network slice
subnet instance. All members of the list, instances of SliceProfile,
shall contain the same datatype representing slice profile requirements:
TopSliceSubnetProfile, RANSliceSubnetProfile or CNSliceSubnetProfile.
Members of the list may contain TopSliceSubnetProfile datatype
only when this attribute (sliceProfileList) belongs to
a NetworkSliceSubnet that is directly referenced by a NetworkSlice""" ;
    y2r:hasAttribute types3gpp:Tai,
        nss3gpp:TopSliceSubnetProfile,
        nss3gpp:pLMNIdList,
        nss3gpp:sNSSAIList .

nss3gpp:TopSliceSubnetProfile a rdfs:Class ;
    rdfs:label "TopSliceSubnetProfile" ;
    rdfs:comment """ This represents the requirements for the top slice associated with the
network slice. """ ;
    y2r:hasAttribute types3gpp:Tai,
        ns3cmn3gpp:XLThpt,
        nss3gpp:Positioning,
        nss3gpp:delayTolerance,
        nss3gpp:deterministicComm,
        nss3gpp:maxNumberofPDUSessions,
        nss3gpp:maxPktSize,
        nss3gpp:termDensity .

nss3gpp:delayTolerance a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet:delayTolerance" ;
    rdfs:comment """An attribute specifies the properties of service delivery
flexibility, especially for the vertical services that are not
chasing a high system performance.""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

nss3gpp:deterministicComm a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet:deterministicComm" ;
    rdfs:comment """This list represents the properties of the deterministic
communication for periodic user traffic. Periodic traffic refers to the
type of traffic with periodic transmissions.""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

nss3gpp:maxNumberofPDUSessions a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet:maxNumberofPDUSessions" ;
    rdfs:comment """Represents the maximum number of
concurrent PDU sessions supported by the network slice""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

nss3gpp:maxPktSize a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet:maxPktSize" ;
    rdfs:comment """This parameter specifies the maximum packet size
supported by the network slice""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

nss3gpp:pLMNIdList a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet:pLMNIdList" ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id).  The PLMN Identifier is composed
of a Mobile Country Code (MCC) and a Mobile Network Code (MNC).""" .

nss3gpp:sNSSAIList a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet:sNSSAIList" ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of
supporting. (Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" .

nss3gpp:termDensity a rdfs:Class ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet:termDensity" ;
    rdfs:comment """An attribute specifies the overall user density over
the coverage area of the network slice""" ;
    y2r:hasAttribute ns3cmn3gpp:ServAttrCom .

<https://semantics.ericsson.com/yang/_3gpp-ns-nrm-networkslicesubnet> a owl:Ontology ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet" ;
    dcterms:description """This IOC represents the properties of a network slice subnet
instance in a 5G network.
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source """3GPP TS 28.541
Management and orchestration;
5G Network Resource Model (NRM);
Information model definitions for network slice NRM (chapter 6)
""" ;
    dcterms:title "_3gpp-ns-nrm-networkslicesubnet" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-01-25 (CR-1442)" ;
    y2r:yangModuleName "_3gpp-ns-nrm-networkslicesubnet" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-ns-nrm-networkslicesubnet> .

nss3gpp:ETSI-GS-NFV-Identifier a rdfs:Datatype ;
    rdfs:label "ETSI-GS-NFV-Identifier" .

nss3gpp:NetworkSliceSubnet.administrativeState a rdf:Property ;
    rdfs:label "NetworkSliceSubnet.administrativeState" ;
    rdfs:comment """The administrative state of the network slice instance.
It describes the permission to use or prohibition against
using the instance, imposed through the OAM services.""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    rdfs:range xsd:string .

nss3gpp:NetworkSliceSubnet.epTransportRef a owl:ObjectProperty ;
    rdfs:label "NetworkSliceSubnet.epTransportRef" ;
    rdfs:comment """List of transport level EPs associated with the
application level EP (i.e. EP_N3 or EP_NgU) or network slice subnet.""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    y2r:isReference true .

nss3gpp:NetworkSliceSubnet.id a rdf:Property ;
    rdfs:label "NetworkSliceSubnet.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    rdfs:range xsd:string .

nss3gpp:NetworkSliceSubnet.managedFunctionRef a owl:ObjectProperty ;
    rdfs:label "NetworkSliceSubnet.managedFunctionRef" ;
    rdfs:comment """This holds a list of DN of ManagedFunction instances
supporting the NetworkSliceSubnet instance.""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    y2r:isReference true .

nss3gpp:NetworkSliceSubnet.networkSliceSubnetRef a owl:ObjectProperty ;
    rdfs:label "NetworkSliceSubnet.networkSliceSubnetRef" ;
    rdfs:comment """List of DNs of constituent NetworkSliceSubnet supporting
NetworkSliceSubnet instance .""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    y2r:isReference true .

nss3gpp:NetworkSliceSubnet.networkSliceSubnetType a rdf:Property ;
    rdfs:label "NetworkSliceSubnet.networkSliceSubnetType" ;
    rdfs:comment """Indicates the type of network slice subnet, including:
- Top network slice subnet
- RAN network slice subnet
- CN network slice subnet""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    rdfs:range xsd:string .

nss3gpp:NetworkSliceSubnet.nsInfo a owl:ObjectProperty ;
    rdfs:label "NetworkSliceSubnet.nsInfo" ;
    rdfs:comment """This list represents the properties of network service
information corresponding to the network slice subnet instance.""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    rdfs:range nss3gpp:NsInfo .

nss3gpp:NetworkSliceSubnet.operationalState a rdf:Property ;
    rdfs:label "NetworkSliceSubnet.operationalState" ;
    rdfs:comment """The operational state of the resouce.
It describes whether or not the resource is installed
and working.""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    rdfs:range xsd:string .

nss3gpp:NetworkSliceSubnet.priorityLabel a rdf:Property ;
    rdfs:label "NetworkSliceSubnet.priorityLabel" ;
    rdfs:comment """Specifies a label that consumer would assign a value on
an instance of network slice subnet. The management system takes
the value of this attribute into account. The effect of this
attribute value to the subject managed entity is not standardized""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    rdfs:range xsd:int .

nss3gpp:NetworkSliceSubnet.sliceProfileList a owl:ObjectProperty ;
    rdfs:label "NetworkSliceSubnet.sliceProfileList" ;
    rdfs:comment """List of SliceProfiles supported by the network slice
subnet instance. All members of the list, instances of SliceProfile,
shall contain the same datatype representing slice profile requirements:
TopSliceSubnetProfile, RANSliceSubnetProfile or CNSliceSubnetProfile.
Members of the list may contain TopSliceSubnetProfile datatype
only when this attribute (sliceProfileList) belongs to
a NetworkSliceSubnet that is directly referenced by a NetworkSlice""" ;
    rdfs:domain nss3gpp:NetworkSliceSubnet ;
    rdfs:range nss3gpp:SliceProfile .

nss3gpp:NsInfo.description a rdf:Property ;
    rdfs:label "NsInfo.description" ;
    rdfs:comment "Human readable description of the NS instance." ;
    rdfs:domain nss3gpp:NsInfo ;
    rdfs:range xsd:string .

nss3gpp:NsInfo.nSInstanceId a rdf:Property ;
    rdfs:label "NsInfo.nSInstanceId" ;
    rdfs:comment "Uniquely identifies the NS instance." ;
    rdfs:domain nss3gpp:NsInfo ;
    rdfs:range xsd:string .

nss3gpp:NsInfo.nsName a rdf:Property ;
    rdfs:label "NsInfo.nsName" ;
    rdfs:comment "Human readable name of the NS instance." ;
    rdfs:domain nss3gpp:NsInfo ;
    rdfs:range xsd:string .

nss3gpp:Positioning.accuracy a rdf:Property ;
    rdfs:label "Positioning.accuracy" ;
    rdfs:comment """Specifies the accuracy of the location information.
Accuracy depends on the respective positioning solution applied in the
RAN domain of the network slice.""" ;
    rdfs:domain nss3gpp:Positioning ;
    rdfs:range xsd:decimal .

nss3gpp:Positioning.availability a rdf:Property ;
    rdfs:label "Positioning.availability" ;
    rdfs:comment """Specifies if this attribute is provided by the RAN domain
of the network slice and contains a list of positioning methods
provided by the RAN domain. If the list is empty this attribute is
not available in the RAN domain and the other parameters might be
ignored, see NG.116. Values allowed: are
CIDE-CID (LTE and NR), OTDOA (LTE and NR), RF fingerprinting, AECID,
Hybrid positioning, NET-RTK.""" ;
    rdfs:domain nss3gpp:Positioning ;
    rdfs:range xsd:string .

nss3gpp:Positioning.category a rdf:Property ;
    rdfs:label "Positioning.category" ;
    rdfs:comment """This attribute specifies the category of a service
requirement/attribute of GST""" ;
    rdfs:domain nss3gpp:Positioning ;
    rdfs:range xsd:string .

nss3gpp:Positioning.exposure a rdf:Property ;
    rdfs:label "Positioning.exposure" ;
    rdfs:comment """This attribute specifies exposure mode of a service
requirement/attribute of GST""" ;
    rdfs:domain nss3gpp:Positioning ;
    rdfs:range xsd:string .

nss3gpp:Positioning.predictionfrequency a rdf:Property ;
    rdfs:label "Positioning.predictionfrequency" ;
    rdfs:comment """Specifies how often location information is provided.
This parameter simply defines how often the customer is allowed to
request location information. This is not related to the time it
takes to determine the location, which is a characteristic of the
positioning method.
If leaf-list availability is empty, the value has no meaning.""" ;
    rdfs:domain nss3gpp:Positioning ;
    rdfs:range xsd:string .

nss3gpp:Positioning.tagging a rdf:Property ;
    rdfs:label "Positioning.tagging" ;
    rdfs:comment """This attribute specifies the tagging of a service
requirement/attribute of GST in character category""" ;
    rdfs:domain nss3gpp:Positioning ;
    rdfs:range xsd:string .

nss3gpp:SliceProfile.CNSliceSubnetProfile a owl:ObjectProperty ;
    rdfs:label "SliceProfile.CNSliceSubnetProfile" ;
    rdfs:comment """ This represents the requirements for the top slice associated with the
network slice. """ ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range nss3gpp:TopSliceSubnetProfile .

nss3gpp:SliceProfile.RANSliceSubnetProfile a owl:ObjectProperty ;
    rdfs:label "SliceProfile.RANSliceSubnetProfile" ;
    rdfs:comment """ This represents the requirements for the top slice associated with the
network slice. """ ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range nss3gpp:TopSliceSubnetProfile .

nss3gpp:SliceProfile.TopSliceSubnetProfile a owl:ObjectProperty ;
    rdfs:label "SliceProfile.TopSliceSubnetProfile" ;
    rdfs:comment """ This represents the requirements for the top slice associated with the
network slice. """ ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range nss3gpp:TopSliceSubnetProfile .

nss3gpp:SliceProfile.coverageAreaTAList a owl:ObjectProperty ;
    rdfs:label "SliceProfile.coverageAreaTAList" ;
    rdfs:comment "A list of TrackingAreas where the NSI can be selected." ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range types3gpp:Tai .

nss3gpp:SliceProfile.latency a rdf:Property ;
    rdfs:label "SliceProfile.latency" ;
    rdfs:comment """The packet transmission latency (milliseconds) through
the RAN, CN, and TN part of 5G network, used to evaluate
utilization performance of the end-to-end network slice instance.""" ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range xsd:unsignedShort .

nss3gpp:SliceProfile.maxNumberofUEs a rdf:Property ;
    rdfs:label "SliceProfile.maxNumberofUEs" ;
    rdfs:comment """Specifies the maximum number of UEs may simultaneously
access the network slice instance.""" ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range xsd:unsignedLong .

nss3gpp:SliceProfile.pLMNIdList a owl:ObjectProperty ;
    rdfs:label "SliceProfile.pLMNIdList" ;
    rdfs:comment """List of at most six entries of PLMN Identifiers, but at
least one (the primary PLMN Id).  The PLMN Identifier is composed
of a Mobile Country Code (MCC) and a Mobile Network Code (MNC).""" ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range nss3gpp:pLMNIdList .

nss3gpp:SliceProfile.resourceSharingLevel a rdf:Property ;
    rdfs:label "SliceProfile.resourceSharingLevel" ;
    rdfs:comment """Specifies whether the resources to be allocated to the
network slice subnet  instance may be shared with another network
slice subnet instance(s).""" ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range xsd:string .

nss3gpp:SliceProfile.sNSSAIList a owl:ObjectProperty ;
    rdfs:label "SliceProfile.sNSSAIList" ;
    rdfs:comment """List of S-NSSAIs the managed object is capable of
supporting. (Single Network Slice Selection Assistance Information)
An S-NSSAI has an SST (Slice/Service type) and an optional SD
(Slice Differentiator) field.""" ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range nss3gpp:sNSSAIList .

nss3gpp:SliceProfile.sliceProfileId a owl:ObjectProperty ;
    rdfs:label "SliceProfile.sliceProfileId" ;
    rdfs:comment """A unique identifier of the property of network slice
subnet related requirement should be supported by the network
slice subnet instance.""" ;
    rdfs:domain nss3gpp:SliceProfile ;
    y2r:isReference true .

nss3gpp:SliceProfile.uEMobilityLevel a rdf:Property ;
    rdfs:label "SliceProfile.uEMobilityLevel" ;
    rdfs:comment """The mobility level of UE accessing the network slice
instance.""" ;
    rdfs:domain nss3gpp:SliceProfile ;
    rdfs:range xsd:string .

nss3gpp:TopSliceSubnetProfile.activityFactor a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.activityFactor" ;
    rdfs:comment """An attribute specifies the percentage value of the
amount of simultaneous active UEs to the total number of UEs where
active means the UEs are exchanging data with the network""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:decimal .

nss3gpp:TopSliceSubnetProfile.coverageAreaTAList a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.coverageAreaTAList" ;
    rdfs:comment "A list of TrackingAreas where the NSI can be selected." ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range types3gpp:Tai .

nss3gpp:TopSliceSubnetProfile.dLThptPerSliceSubnet a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.dLThptPerSliceSubnet" ;
    rdfs:comment """This attribute defines achievable data rate of the
network slice subnet in downlink that is available ubiquitously
across the coverage area of the slice""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range ns3cmn3gpp:XLThpt .

nss3gpp:TopSliceSubnetProfile.dLThptPerUE a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.dLThptPerUE" ;
    rdfs:comment """This attribute defines data rate supported by the
network slice per UE, refer NG.116.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range ns3cmn3gpp:XLThpt .

nss3gpp:TopSliceSubnetProfile.delayTolerance a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.delayTolerance" ;
    rdfs:comment """An attribute specifies the properties of service delivery
flexibility, especially for the vertical services that are not
chasing a high system performance.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range nss3gpp:delayTolerance .

nss3gpp:TopSliceSubnetProfile.deterministicComm a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.deterministicComm" ;
    rdfs:comment """This list represents the properties of the deterministic
communication for periodic user traffic. Periodic traffic refers to the
type of traffic with periodic transmissions.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range nss3gpp:deterministicComm .

nss3gpp:TopSliceSubnetProfile.latency a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.latency" ;
    rdfs:comment """The packet transmission latency (milliseconds) through
the RAN, CN, and TN part of 5G network, used to evaluate
utilization performance of the end-to-end network slice instance.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:unsignedShort .

nss3gpp:TopSliceSubnetProfile.maxNumberofPDUSessions a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.maxNumberofPDUSessions" ;
    rdfs:comment """Represents the maximum number of
concurrent PDU sessions supported by the network slice""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range nss3gpp:maxNumberofPDUSessions .

nss3gpp:TopSliceSubnetProfile.maxNumberofUEs a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.maxNumberofUEs" ;
    rdfs:comment """Specifies the maximum number of UEs may simultaneously
access the network slice instance.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:unsignedLong .

nss3gpp:TopSliceSubnetProfile.maxPktSize a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.maxPktSize" ;
    rdfs:comment """This parameter specifies the maximum packet size
supported by the network slice""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range nss3gpp:maxPktSize .

nss3gpp:TopSliceSubnetProfile.positioning a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.positioning" ;
    rdfs:comment """Specifies whether the network slice provides
geo-localization methods or supporting methods""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range nss3gpp:Positioning .

nss3gpp:TopSliceSubnetProfile.reliability a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.reliability" ;
    rdfs:comment """An attribute specifies in the context of network layer
packet transmissions, percentage value of the amount of sent
network layer packets successfully delivered to a given system
entity within the time constraint required by the targeted service,
divided by the total number of sent network layer packets.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:string .

nss3gpp:TopSliceSubnetProfile.resourceSharingLevel a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.resourceSharingLevel" ;
    rdfs:comment """Specifies whether the resources to be allocated to the
network slice subnet instance may be shared with another network
slice subnet instance(s).""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:string .

nss3gpp:TopSliceSubnetProfile.serviceType a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.serviceType" ;
    rdfs:comment """An attribute specifies the standardized network slice type.
allowedValues: eMBB, URLLC, MIoT, V2X.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:string .

nss3gpp:TopSliceSubnetProfile.sliceSimultaneousUse a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.sliceSimultaneousUse" ;
    rdfs:comment """This attribute describes whether a network slice
can be simultaneously used by a device together with other
network slices and if so, with which other classes of network slices.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:string .

nss3gpp:TopSliceSubnetProfile.survivalTime a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.survivalTime" ;
    rdfs:comment """An attribute specifies the time that an application
consuming a communication service may continue without an
anticipated message.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:string .

nss3gpp:TopSliceSubnetProfile.termDensity a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.termDensity" ;
    rdfs:comment """An attribute specifies the overall user density over
the coverage area of the network slice""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range nss3gpp:termDensity .

nss3gpp:TopSliceSubnetProfile.uEMobilityLevel a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.uEMobilityLevel" ;
    rdfs:comment """The mobility level of UE accessing the network slice
instance.""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:string .

nss3gpp:TopSliceSubnetProfile.uESpeed a rdf:Property ;
    rdfs:label "TopSliceSubnetProfile.uESpeed" ;
    rdfs:comment """An attribute specifies the maximum speed (in km/hour)
supported by the network slice at which a defined QoS can be
achieved""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range xsd:unsignedInt .

nss3gpp:TopSliceSubnetProfile.uLThptPerSliceSubnet a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.uLThptPerSliceSubnet" ;
    rdfs:comment """This attribute defines achievable data rate of the
network slice subnet in uplink that is available ubiquitously
across the coverage area of the slice""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range ns3cmn3gpp:XLThpt .

nss3gpp:TopSliceSubnetProfile.uLThptPerUE a owl:ObjectProperty ;
    rdfs:label "TopSliceSubnetProfile.uLThptPerUE" ;
    rdfs:comment """This attribute defines data rate supported by the
network slice per UE, refer NG.116""" ;
    rdfs:domain nss3gpp:TopSliceSubnetProfile ;
    rdfs:range ns3cmn3gpp:XLThpt .

nss3gpp:delayTolerance.servAttrCom a owl:ObjectProperty ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet:delayTolerance.servAttrCom" ;
    rdfs:comment """This list represents the common properties of service
requirement related attributes.""" ;
    rdfs:domain nss3gpp:delayTolerance ;
    rdfs:range ns3cmn3gpp:ServAttrCom .

nss3gpp:delayTolerance.support a rdf:Property ;
    rdfs:label "_3gpp-ns-nrm-networkslicesubnet:delayTolerance.support" ;
    rdfs:comment """An attribute specifies whether or not the network
slice supports service delivery flexibility, especially for the
vertical services that are not chasing a high system performance.""" ;
    rdfs:domain nss3gpp:delayTolerance ;
    rdfs:range xsd:string .

