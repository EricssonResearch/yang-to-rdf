@prefix y2r: <https://semantics.ericsson.com/vocab#> .

<https://semantics.ericsson.com/yang/_3gpp-eqp-sectorequipmentfunction> a owl:Ontology ;
    rdfs:label "_3gpp-eqp-sectorequipmentfunction" ;
    dcterms:description """Defines the YANG mapping of the Sector Equipment Function
Information Object Class (IOC) that is part of the Generic Network Resource
Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-eqp-sectorequipmentfunction" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-11-07 (CR1660)" ;
    y2r:yangModuleName "_3gpp-eqp-sectorequipmentfunction" ;
    y2r:yangNamespace <urn:3gpp:sa5:_3gpp-eqp-sectorequipmentfunction> .

scteqp3gpp:File.jobRef y2r:candidate "Job" ;
    y2r:confidence "unresolved" ;
    y2r:inferredBy "dn-name-suffix" .

