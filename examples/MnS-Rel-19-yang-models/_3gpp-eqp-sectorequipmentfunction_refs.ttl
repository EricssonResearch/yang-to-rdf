    y2r:inferredBy "dn-name-suffix" .

scteqp3gpp:PerfMetricJob.schedulerRef rdfs:range util3gpp:Scheduler ;
    y2r:confidence "unambiguous" ;
    y2r:inferredBy "dn-name-suffix" .

scteqp3gpp:SectorEquipmentFunction.referenceFrom y2r:candidate "ReferenceFrom" ;
