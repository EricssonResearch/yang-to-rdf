@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency/NRFrequency> a rdfs:Class ;
    rdfs:label "NRFrequency" ;
    rdfs:comment "Represents certain NR frequency properties." .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-nrfrequency" ;
    dcterms:description """Defines the YANG mapping of the NRFrequency Information Object
Class (IOC) that is part of the NR Network Resource Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-nrfrequency" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-04-25 (CR-1526 CR-1527)" .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency/NRFrequency/absoluteFrequencySSB> a rdf:Property ;
    rdfs:label "NRFrequency.absoluteFrequencySSB" ;
    rdfs:comment """The absolute frequency applicable for a downlink NR carrier
frequency associated with the SSB, in terms of NR-ARFCN.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency/NRFrequency> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency/NRFrequency/id> a rdf:Property ;
    rdfs:label "NRFrequency.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency/NRFrequency> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency/NRFrequency/multiFrequencyBandListNR> a rdf:Property ;
    rdfs:label "NRFrequency.multiFrequencyBandListNR" ;
    rdfs:comment """List of additional frequency bands the frequency belongs to.
The list is automatically set by the gNB.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency/NRFrequency> ;
    rdfs:range xsd:unsignedShort .

<urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency/NRFrequency/ssBSubCarrierSpacing> a rdf:Property ;
    rdfs:label "NRFrequency.ssBSubCarrierSpacing" ;
    rdfs:comment """Sub-carrier spacing of the SSB.
Note that the allowed values of SSB used for representing data,
by e.g. a BWP, are: 15, 30, 60 and 120 in units of kHz.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-nrfrequency/NRFrequency> ;
    rdfs:range xsd:unsignedByte .

