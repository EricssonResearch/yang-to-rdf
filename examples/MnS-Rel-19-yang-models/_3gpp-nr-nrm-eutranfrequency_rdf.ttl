@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency> a rdfs:Class ;
    rdfs:label "EUtranFrequency" ;
    rdfs:comment "Represents certain E-UTRAN frequency properties." .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-eutranfrequency" ;
    dcterms:description """Defines the YANG mapping of the EUtranFrequency Information
Object Class (IOC), that is part of the NR Network Resource Model (NRM).
Copyright 2025, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source """3GPP TS 28.541 5G Network Resource Model (NRM),
3GPP TS 28.658 (E-UTRAN) Network Resource Model (NRM)""" ;
    dcterms:title "_3gpp-nr-nrm-eutranfrequency" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-04-25 (CR-1526 CR-1527)" .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency/earfcnDL> a rdf:Property ;
    rdfs:label "EUtranFrequency.earfcnDL" ;
    rdfs:comment "Specifies the channel number for the central DL frequency." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency> ;
    rdfs:range xsd:unsignedInt .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency/id> a rdf:Property ;
    rdfs:label "EUtranFrequency.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency> ;
    rdfs:range xsd:string .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency/multiBandInfoListEutra> a rdf:Property ;
    rdfs:label "EUtranFrequency.multiBandInfoListEutra" ;
    rdfs:comment "List of additional frequency bands the frequency belongs to." ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency> ;
    rdfs:range xsd:unsignedShort .

