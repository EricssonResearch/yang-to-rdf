            sh:minCount 1 ;
            sh:path udm3gpp:SupportedPerfMetricGroups.reportingMethods ],
        [ sh:datatype xsd:unsignedInt ;
            sh:description """Reporting periods supported for the associated
measurement types. The period is defined in seconds.""" ;
            sh:path udm3gpp:SupportedPerfMetricGroups.reportingPeriods ] ;
    sh:targetClass udm3gpp:SupportedPerfMetricGroups .

