@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix nrm: <https://3gpp.org/nrm/vocab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranetwork/EUtraNetwork> a rdfs:Class ;
    rdfs:label "EUtraNetwork" ;
    rdfs:comment "A subnetwork containing gNB external E-UTRAN entities." ;
    nrm:nameContains <urn:3gpp:sa5:_3gpp-nr-nrm-eutranfrequency/EUtranFrequency>,
        <urn:3gpp:sa5:_3gpp-nr-nrm-externalenbfunction/ExternalENBFunction> .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranetwork> a owl:Ontology ;
    rdfs:label "_3gpp-nr-nrm-eutranetwork" ;
    dcterms:description """Defines the YANG mapping of the EUtraNetwork Information Object
Class (IOC) that is part of the NR Network Resource Model (NRM).
Copyright 2023, 3GPP Organizational Partners (ARIB, ATIS, CCSA, ETSI, TSDSI,
TTA, TTC). All rights reserved.""" ;
    dcterms:publisher "3GPP SA5" ;
    dcterms:source "3GPP TS 28.541 5G Network Resource Model (NRM)" ;
    dcterms:title "_3gpp-nr-nrm-eutranetwork" ;
    rdfs:seeAlso "https://www.3gpp.org/DynaReport/TSG-WG--S5--officials.htm?Itemid=464" ;
    owl:versionInfo "revision 2025-04-25 (CR-1526 CR-1527)" .

<urn:3gpp:sa5:_3gpp-nr-nrm-eutranetwork/EUtraNetwork/id> a rdf:Property ;
    rdfs:label "EUtraNetwork.id" ;
    rdfs:comment """Key leaf (namingAttribute) for a class/list.
Should be used as a key leaf for lists representing
stage 2 classes.""" ;
    rdfs:domain <urn:3gpp:sa5:_3gpp-nr-nrm-eutranetwork/EUtraNetwork> ;
    rdfs:range xsd:string .

